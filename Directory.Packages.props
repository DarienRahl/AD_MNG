<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.13" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup Label="AdMng Watchdog">
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="MailKitLite" Version="4.18.1" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="SmtpServer" Version="11.1.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup Label="Messages (U1c)">
    <!-- HTML5 (WHATWG) parser of the message sanitizer shared by AD Manager and the Watchdog validator (pure managed). -->
    <PackageVersion Include="AngleSharp" Version="1.8.4" />
    <!-- The rendered preview of HTML bodies (AdMng.App only; Evergreen runtime, fallback to the source view). -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup Label="AD Manager – computers (K1)">
    <PackageVersion Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup Label="AD Manager – event logs (E)">
    <!-- System.Diagnostics.Eventing.Reader (EventLogSession, MS-EVEN6) for AdMng.EventLogs; Windows only at run time. -->
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="AD Manager – PowerShell window (R)">
    <!-- The embedded PowerShell 7 engine (LTS line 7.6.x, MIT) for AdMng.PowerShell; AdMng.App only, never in the Watchdog
         package. Every PowerShell security update is a new version here and a new AD Manager release (ADR-0010). -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.10" />
    <!-- Excluded from every output by PowerShellEngineConsumer.props (not OSI licensed); the versions are the SDK's. -->
    <PackageVersion Include="runtime.native.System.Data.SqlClient.sni" Version="4.4.0" />
    <PackageVersion Include="runtime.win-arm64.runtime.native.System.Data.SqlClient.sni" Version="4.4.0" />
    <PackageVersion Include="runtime.win-x64.runtime.native.System.Data.SqlClient.sni" Version="4.4.0" />
    <PackageVersion Include="runtime.win-x86.runtime.native.System.Data.SqlClient.sni" Version="4.4.0" />
  </ItemGroup>
</Project>
