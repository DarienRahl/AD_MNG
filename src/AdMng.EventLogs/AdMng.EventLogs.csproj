<Project Sdk="Microsoft.NET.Sdk">
  <!-- Track E reader (docs/dev/e-event-logs.md 3): Windows event logs of computers over MS-EVEN6 (EventLogSession,
       Kerberos only, the connection window's credential) and operator-chosen .evtx files. Windows only at run time (every
       Windows call is guarded); compiles everywhere. Keeps records only in memory while they stream to the caller and never
       logs hosts, accounts or event content (CLAUDE.md rules 1 and 2). Used by the App only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdMng.EventLogs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdMng.Core\AdMng.Core.csproj" />
    <ProjectReference Include="..\AdMng.Directory\AdMng.Directory.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- System.Diagnostics.Eventing.Reader is not part of Microsoft.NETCore.App (only of the ASP.NET Core and Windows
         Desktop shared frameworks), so a plain net10.0 library needs the package. -->
    <PackageReference Include="System.Diagnostics.EventLog" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AdMng.EventLogs.Tests" />
  </ItemGroup>
</Project>
