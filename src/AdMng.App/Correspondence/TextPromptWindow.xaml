<!--
  A text prompt of Korespondencja (TextPromptViewModel, modal, design note 9.4): the message, one line or a multiline box
  (typed addresses, exclusions, the link of the editor) and OK / Cancel. Enter confirms a one-line prompt; in the multiline
  box Enter is a new line and Ctrl+Enter confirms.
-->
<Window x:Class="AdMng.App.Correspondence.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="520"
        MinWidth="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <Window.InputBindings>
    <KeyBinding Key="Return"
                Command="{Binding OkCommand}"
                Modifiers="Control" />
  </Window.InputBindings>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="OkButton"
                Command="{Binding OkCommand}"
                Content="{l:Tr Common.Ok}"
                IsDefault="True"
                Style="{StaticResource Ad.AccentDialogButton}" />
        <Button x:Name="CancelButton"
                Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24,18,24,12">
      <TextBlock x:Name="MessageText"
                 Margin="0,0,0,10"
                 Text="{Binding Message, Mode=OneWay}"
                 TextWrapping="Wrap"
                 Visibility="{Binding Message, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      <TextBox x:Name="PromptTextBox"
               AutomationProperties.Name="{l:Tr Correspondence.App.Prompt.Text}"
               Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
  </DockPanel>
</Window>
