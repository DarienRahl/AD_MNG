<!-- A text prompt of Korespondencja (TextPromptViewModel, modal, design note 9.4). Scaffold: the App track adds the
     message, the one-line / multiline box and the OK / Cancel buttons. -->
<Window x:Class="AdMng.App.Correspondence.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="520"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <TextBlock x:Name="MessageText"
             Margin="24"
             Text="{Binding Message, Mode=OneWay}"
             TextWrapping="Wrap" />
</Window>
