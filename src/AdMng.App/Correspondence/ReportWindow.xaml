<!-- A read-only report of Korespondencja (ReportViewModel, modal, design note 9.4). Scaffold: the App track adds the
     monospace text box and the "Kopiuj" / "Zamknij" buttons. -->
<Window x:Class="AdMng.App.Correspondence.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="760"
        Height="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <TextBlock x:Name="ReportText"
             Margin="24"
             Text="{Binding Text, Mode=OneWay}"
             TextWrapping="Wrap" />
</Window>
