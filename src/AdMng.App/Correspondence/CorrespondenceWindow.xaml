<!-- Korespondencja (CorrespondenceViewModel, modeless, U5 design note docs/dev/u5-outlook-correspondence.md 9.1). Scaffold:
     the App track replaces this with the tabbed window (CorrespondenceTabs: Skrzynki, Odbiorcy, Wiadomość, Podgląd,
     Wysyłka, Odpowiedzi) and its status bar. -->
<Window x:Class="AdMng.App.Correspondence.CorrespondenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1320"
        Height="900"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
  <TextBlock x:Name="StatusText"
             Margin="24"
             Text="{Binding StatusText, Mode=OneWay}"
             TextWrapping="Wrap" />
</Window>
