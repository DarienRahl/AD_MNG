<!--
  Korespondencja (CorrespondenceViewModel, modeless, U5 design note docs/dev/u5-outlook-correspondence.md 6.4 and 9.1):
  MailerWPiA's workflow through classic Outlook per connection window. Tabs (CorrespondenceTabs): "Skrzynki" (mailbox owner
  query, shown when started for mailbox owners or after "Właściciele skrzynek…"), "1 · Odbiorcy", "2 · Wiadomość",
  "3 · Podgląd", "4 · Wysyłka", "5 · Odpowiedzi"; the status bar shows the window's status and the Outlook connection.
  Every page binds through its page view model (Recipients, Message, …) - the window keeps one data context. Recipients,
  previews, matches and results exist in memory only (rule 1); the field columns of the recipient grid are built by the
  code-behind from Recipients.Columns.
-->
<Window x:Class="AdMng.App.Correspondence.CorrespondenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:AdMng.App.Behaviors"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:cr="clr-namespace:AdMng.Presentation.Correspondence;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:local="clr-namespace:AdMng.App.Correspondence"
        xmlns:mb="clr-namespace:AdMng.Core.Correspondence.Mailboxes;assembly=AdMng.Core"
        xmlns:ol="clr-namespace:AdMng.Core.Correspondence.Outlook;assembly=AdMng.Core"
        xmlns:ps="clr-namespace:AdMng.Presentation.Settings;assembly=AdMng.Presentation"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1320"
        Height="900"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <!-- A candidate chosen in a row of the mailbox grid survives scrolling (recycled rows clear their combo boxes). -->
    <local:KeepChoiceConverter x:Key="KeepChoice" />
    <local:ChoiceConverter x:Key="Choice" />

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,8,0,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="InlineLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ErrorLine" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardHeader" TargetType="TextBlock" BasedOn="{StaticResource Ad.SectionHeader}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Ad.Card}">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="AccentBarButton" TargetType="Button" BasedOn="{StaticResource Ad.AccentDialogButton}">
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource Ad.SmallIconButton}">
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="26" />
    </Style>

    <Style x:Key="ListRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
    </Style>

    <!-- A recipient row: excluded ("Nie wysyłać") and already sent rows are dimmed; the automation name is the address. -->
    <Style x:Key="RecipientRow" TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Email, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExcluded, Mode=OneWay}" Value="True">
          <Setter Property="Opacity" Value="0.55" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsAlreadySent, Mode=OneWay}" Value="True">
          <Setter Property="Opacity" Value="0.55" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MailboxRow" TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
      <Setter Property="Height" Value="34" />
      <Setter Property="AutomationProperties.Name" Value="{Binding MailboxName, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding RowState, Mode=OneWay}" Value="{x:Static cr:MailboxOwnerRowState.Excluded}">
          <Setter Property="Opacity" Value="0.55" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ResponseRow" TargetType="ListViewItem" BasedOn="{StaticResource ListRow}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Recipient, Mode=OneWay}" />
    </Style>

    <!-- What happened to a recipient in this window: sent (green), failed (red), skipped (grey). -->
    <Style x:Key="RecipientStatus" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Status, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:RecipientStatusKind.Sent}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:RecipientStatusKind.Draft}">
          <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:RecipientStatusKind.Test}">
          <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:RecipientStatusKind.Failed}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:RecipientStatusKind.Skipped}">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The match of a mailbox row: ready (green), to review (amber), not usable (red). -->
    <Style x:Key="MailboxStatus" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="ToolTip" Value="{Binding DetailText, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:MailboxRowStatusKind.Ok}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:MailboxRowStatusKind.Warning}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="{x:Static cr:MailboxRowStatusKind.Error}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A vote: yes (green), no (red), none (grey). -->
    <Style x:Key="ResponseText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Response, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static cr:ResponseKind.Yes}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static cr:ResponseKind.No}">
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static cr:ResponseKind.None}">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- An editable AD field (name and U1 expression) of the recipients and the mailbox owners pages. -->
    <DataTemplate x:Key="DirectoryFieldEditor" DataType="{x:Type cr:DirectoryFieldViewModel}">
      <StackPanel Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox AutomationProperties.Name="{l:Tr Correspondence.App.FieldName}"
                   Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{l:Tr Correspondence.App.FieldName}" />
          <TextBox Grid.Column="2"
                   AutomationProperties.Name="{l:Tr Correspondence.App.FieldExpression}"
                   FontFamily="Cascadia Mono, Consolas"
                   Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{l:Tr Correspondence.App.FieldExpression}" />
          <Button Grid.Column="3"
                  AutomationProperties.Name="{l:Tr Common.Remove}"
                  Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding Mode=OneWay}"
                  Content="{x:Static c:Glyphs.Delete}"
                  Style="{StaticResource RowIconButton}"
                  ToolTip="{l:Tr Common.Remove}" />
        </Grid>
        <TextBlock Style="{StaticResource ErrorLine}"
                   Text="{Binding Error, Mode=OneWay}"
                   Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      </StackPanel>
    </DataTemplate>

    <!-- A field of mailbox rows: whose value it is (the mailbox or its owner), then name and expression. -->
    <DataTemplate x:Key="MailboxFieldEditor" DataType="{x:Type cr:DirectoryFieldViewModel}">
      <StackPanel Margin="0,0,0,6">
        <TextBlock Margin="0,0,0,2" FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
              <Setter Property="Text" Value="{l:Tr Correspondence.App.Mailboxes.TargetPerson}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Target, Mode=OneWay}" Value="{x:Static ps:DirectoryFieldTarget.Mailbox}">
                  <Setter Property="Text" Value="{l:Tr Correspondence.App.Mailboxes.TargetMailbox}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ContentPresenter Content="{Binding Mode=OneWay}" ContentTemplate="{StaticResource DirectoryFieldEditor}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Status bar: busy, the window's status, the Outlook connection, help and close. -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Margin="16,0,6,0"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Mail}" />
          <TextBlock x:Name="OutlookStateText"
                     MaxWidth="360"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{l:Tr Correspondence.App.OutlookState}"
                     FontWeight="SemiBold"
                     Text="{Binding Outlook.StateText, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Outlook.StateText, Mode=OneWay}" />
          <Button x:Name="HelpButton"
                  Margin="0,0,6,0"
                  Command="{Binding HelpCommand}"
                  Content="{l:Tr Correspondence.App.Help}" />
          <Button x:Name="CloseButton"
                  Command="{Binding CloseCommand}"
                  Content="{l:Tr Common.Close}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ProgressBar x:Name="BusyIndicator"
                       Width="60"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock x:Name="StatusText"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding StatusText, Mode=OneWay}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The session ended (AD actions disabled, Outlook keeps working) and the window's error. -->
    <StackPanel Margin="16,8,16,0" DockPanel.Dock="Top">
      <Border x:Name="SessionEndedBar"
              Margin="0,0,0,8"
              Style="{StaticResource Ad.WarningBar}"
              Visibility="{Binding SessionEndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock Text="{Binding SessionEndedMessage, Mode=OneWay}" TextWrapping="Wrap" />
      </Border>
      <Border x:Name="ErrorBar"
              Margin="0,0,0,8"
              Style="{StaticResource Ad.ErrorBar}"
              Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock x:Name="ErrorText"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{Binding Error, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <TabControl x:Name="CorrespondenceTabs"
                Margin="16,4,16,12"
                SelectedValue="{Binding SelectedTab}"
                SelectedValuePath="Tag">

      <!-- ==================== Skrzynki: mailbox owner query (U5c) ==================== -->
      <TabItem x:Name="MailboxesTab"
               Header="{l:Tr Correspondence.App.Tab.Mailboxes}"
               Tag="{x:Static cr:CorrespondenceTab.Mailboxes}"
               Visibility="{Binding IsMailboxesTabVisible, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- What to look for -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Mailboxes.Scope}" />
                  <!-- The objects selected for "Zapytaj właścicieli skrzynek…" (only a window opened with them), the domain or an OU. -->
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Request.Start, Mode=OneWay}" Value="{x:Static cr:CorrespondenceStart.MailboxOwners}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <RadioButton x:Name="ScopeSelectionButton"
                                 Margin="0,0,0,4"
                                 Content="{l:Tr Correspondence.App.Mailboxes.ScopeSelection}"
                                 GroupName="MailboxScope"
                                 IsChecked="{Binding Mailboxes.ScopeKind, Converter={StaticResource Choice}, ConverterParameter={x:Static cr:MailboxScopeKind.Selection}}" />
                  </Border>
                  <RadioButton x:Name="ScopeDomainButton"
                               Margin="0,0,0,4"
                               Content="{l:Tr Correspondence.App.Mailboxes.ScopeDomain}"
                               GroupName="MailboxScope"
                               IsChecked="{Binding Mailboxes.ScopeKind, Converter={StaticResource Choice}, ConverterParameter={x:Static cr:MailboxScopeKind.Domain}}" />
                  <RadioButton x:Name="ScopeOuButton"
                               Content="{l:Tr Correspondence.App.Mailboxes.ScopeOu}"
                               GroupName="MailboxScope"
                               IsChecked="{Binding Mailboxes.ScopeKind, Converter={StaticResource Choice}, ConverterParameter={x:Static cr:MailboxScopeKind.OrganizationalUnit}}" />
                  <TextBlock x:Name="ScopeText"
                             Margin="0,6,0,0"
                             FontWeight="SemiBold"
                             Text="{Binding Mailboxes.ScopeText, Mode=OneWay}"
                             TextWrapping="Wrap"
                             Visibility="{Binding Mailboxes.ScopeText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                  <Button x:Name="BrowseScopeButton"
                          Margin="0,6,0,0"
                          HorizontalAlignment="Left"
                          Command="{Binding Mailboxes.BrowseScopeCommand}"
                          Content="{l:Tr Correspondence.App.Mailboxes.BrowseScope}" />

                  <TextBlock Style="{StaticResource Label}" Text="{l:Tr Correspondence.App.Mailboxes.Selection}" />
                  <ComboBox x:Name="SelectionBox"
                            AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.Selection}"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding Mailboxes.SelectionChoices, Mode=OneWay}"
                            SelectedItem="{Binding Mailboxes.Selection}" />
                  <TextBlock x:Name="NoExchangeHint"
                             Style="{StaticResource Hint}"
                             Text="{l:Tr Correspondence.App.Mailboxes.NoExchange}"
                             Visibility="{Binding Mailboxes.IsExchangeSchemaPresent, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />

                  <TextBlock Style="{StaticResource Label}" Text="{l:Tr Correspondence.App.Mailboxes.ExtraFilter}" />
                  <TextBox x:Name="ExtraFilterBox"
                           AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.ExtraFilter}"
                           FontFamily="Cascadia Mono, Consolas"
                           Text="{Binding Mailboxes.ExtraFilter, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock x:Name="ExtraFilterErrorText"
                             Style="{StaticResource ErrorLine}"
                             Text="{Binding Mailboxes.ExtraFilterError, Mode=OneWay}"
                             Visibility="{Binding Mailboxes.ExtraFilterError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Correspondence.App.Mailboxes.ExtraFilterHint}" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Mailboxes.Owners}" />
                  <TextBlock Margin="0,0,0,4" Text="{l:Tr Correspondence.App.Mailboxes.NameSource}" TextWrapping="Wrap" />
                  <ComboBox x:Name="NameSourceBox"
                            AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.NameSource}"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding Mailboxes.NameSourceChoices, Mode=OneWay}"
                            SelectedItem="{Binding Mailboxes.NameSource}" />
                  <DockPanel Margin="0,6,0,0">
                    <DockPanel.Style>
                      <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Mailboxes.NameSource.Value, Mode=OneWay}" Value="{x:Static mb:OwnerNameSource.Attribute}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DockPanel.Style>
                    <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr Correspondence.App.Mailboxes.NameAttribute}" />
                    <TextBox x:Name="NameAttributeBox"
                             AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.NameAttribute}"
                             FontFamily="Cascadia Mono, Consolas"
                             Text="{Binding Mailboxes.NameAttribute, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>

                  <TextBlock Style="{StaticResource Label}" Text="{l:Tr Correspondence.App.Mailboxes.PersonBase}" />
                  <TextBlock x:Name="PersonBaseText"
                             FontWeight="SemiBold"
                             Text="{Binding Mailboxes.PersonBaseText, Mode=OneWay}"
                             TextWrapping="Wrap" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="BrowsePersonBaseButton"
                            Command="{Binding Mailboxes.BrowsePersonBaseCommand}"
                            Content="{l:Tr Correspondence.App.Mailboxes.BrowsePersonBase}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ClearPersonBaseButton"
                            Command="{Binding Mailboxes.ClearPersonBaseCommand}"
                            Content="{l:Tr Correspondence.App.Mailboxes.WholeDomain}"
                            Style="{StaticResource BarButton}" />
                  </WrapPanel>
                  <CheckBox x:Name="EnabledOwnersOnlyBox"
                            Margin="0,2,0,0"
                            Content="{l:Tr Correspondence.App.Mailboxes.EnabledOwnersOnly}"
                            IsChecked="{Binding Mailboxes.EnabledOwnersOnly}" />
                  <CheckBox x:Name="GroupByOwnerBox"
                            Margin="0,6,0,0"
                            Content="{l:Tr Correspondence.App.Mailboxes.GroupByOwner}"
                            IsChecked="{Binding Mailboxes.GroupByOwner}" />
                </StackPanel>
              </Border>

              <Expander x:Name="MailboxFieldsExpander"
                        Margin="0,0,0,10"
                        Header="{l:Tr Correspondence.App.Mailboxes.Fields}">
                <StackPanel Margin="0,6,0,0">
                  <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource Ad.Format}">
                        <l:TrBinding Key="Correspondence.App.Mailboxes.FieldsHint" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <ItemsControl x:Name="MailboxFieldsList"
                                AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.Fields}"
                                Focusable="False"
                                ItemTemplate="{StaticResource MailboxFieldEditor}"
                                ItemsSource="{Binding Mailboxes.MailboxFields, Mode=OneWay}"
                                Tag="{Binding Mailboxes.RemoveMailboxFieldCommand, Mode=OneWay}" />
                  <WrapPanel>
                    <Button x:Name="AddMailboxFieldButton"
                            Command="{Binding Mailboxes.AddMailboxFieldCommand}"
                            Content="{l:Tr Correspondence.App.AddField}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ResetMailboxFieldsButton"
                            Command="{Binding Mailboxes.ResetMailboxFieldsCommand}"
                            Content="{l:Tr Common.ResetToDefault}"
                            Style="{StaticResource BarButton}" />
                  </WrapPanel>
                </StackPanel>
              </Expander>

              <WrapPanel>
                <Button x:Name="FindOwnersButton"
                        MinWidth="160"
                        Command="{Binding Mailboxes.FindOwnersCommand}"
                        Content="{l:Tr Correspondence.App.Mailboxes.Find}"
                        Style="{StaticResource AccentBarButton}" />
                <Button x:Name="CancelFindButton"
                        Margin="0,0,6,6"
                        Command="{Binding Mailboxes.CancelCommand}"
                        Content="{l:Tr Common.Stop}"
                        Style="{StaticResource Ad.CollapsedWhenDisabledButton}" />
              </WrapPanel>
              <DockPanel>
                <ProgressBar Width="40"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Left"
                             IsIndeterminate="True"
                             Visibility="{Binding Mailboxes.IsRunning, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                <TextBlock x:Name="MailboxProgressText"
                           AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource Hint}"
                           Text="{Binding Mailboxes.ProgressText, Mode=OneWay}" />
              </DockPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- The mailboxes found and their owners -->
          <DockPanel Grid.Column="2">
            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
              <ComboBox x:Name="MailboxFilterBox"
                        Width="200"
                        AutomationProperties.Name="{l:Tr Common.Filter}"
                        DisplayMemberPath="Text"
                        DockPanel.Dock="Left"
                        ItemsSource="{Binding Mailboxes.FilterChoices, Mode=OneWay}"
                        SelectedItem="{Binding Mailboxes.Filter}" />
              <TextBlock x:Name="MailboxSummaryText"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{Binding Mailboxes.SummaryText, Mode=OneWay}" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
              <Button x:Name="AddToRecipientsButton"
                      MinWidth="220"
                      Margin="0"
                      Command="{Binding Mailboxes.AddToRecipientsCommand}"
                      Content="{l:Tr Correspondence.App.Mailboxes.AddToRecipients}"
                      DockPanel.Dock="Right"
                      Style="{StaticResource Ad.AccentDialogButton}" />
              <TextBlock Margin="0,0,12,0"
                         Style="{StaticResource Hint}"
                         Text="{l:Tr Correspondence.App.Mailboxes.ReviewHint}" />
            </DockPanel>
            <Grid>
              <ListView x:Name="MailboxesGrid"
                        AutomationProperties.Name="{l:Tr Correspondence.App.Tab.Mailboxes}"
                        ItemContainerStyle="{StaticResource MailboxRow}"
                        ItemsSource="{Binding Mailboxes.View, Mode=OneWay}"
                        ScrollViewer.CanContentScroll="True"
                        SelectionMode="Single"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="58" Header="{l:Tr Correspondence.App.ColumnInclude}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:MailboxOwnerRowViewModel}">
                          <CheckBox AutomationProperties.Name="{l:Tr Correspondence.App.ColumnInclude}" IsChecked="{Binding Include}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="170" Header="{l:Tr Correspondence.App.Mailboxes.ColumnMailbox}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:MailboxOwnerRowViewModel}">
                          <StackPanel ToolTip="{Binding MailboxLocation, Mode=OneWay}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding MailboxName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11"
                                       Style="{StaticResource Ad.SecondaryText}"
                                       Text="{Binding MailboxTypeText, Mode=OneWay}" />
                          </StackPanel>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="180"
                                    DisplayMemberBinding="{Binding MailboxAddress, Mode=OneWay}"
                                    Header="{l:Tr Correspondence.App.Mailboxes.ColumnAddress}" />
                    <GridViewColumn Width="140"
                                    DisplayMemberBinding="{Binding OwnerNameText, Mode=OneWay}"
                                    Header="{l:Tr Correspondence.App.Mailboxes.ColumnOwnerName}" />
                    <GridViewColumn Width="150" Header="{l:Tr Correspondence.App.Mailboxes.ColumnStatus}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:MailboxOwnerRowViewModel}">
                          <TextBlock Style="{StaticResource MailboxStatus}" Text="{Binding StatusText, Mode=OneWay}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="280" Header="{l:Tr Correspondence.App.Mailboxes.ColumnOwner}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:MailboxOwnerRowViewModel}">
                          <Grid>
                            <ComboBox AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.ColumnOwner}"
                                      DisplayMemberPath="Text"
                                      ItemsSource="{Binding Candidates, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedCandidate, Converter={StaticResource KeepChoice}}"
                                      ToolTip="{Binding DetailText, Mode=OneWay}"
                                      Visibility="{Binding HasCandidates, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding OwnerDisplayName, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasCandidates, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
                          </Grid>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200"
                                    DisplayMemberBinding="{Binding OwnerAddress, Mode=OneWay}"
                                    Header="{l:Tr Correspondence.App.Mailboxes.ColumnOwnerAddress}" />
                    <GridViewColumn Width="110"
                                    DisplayMemberBinding="{Binding OwnerDepartment, Mode=OneWay}"
                                    Header="{l:Tr Correspondence.App.Mailboxes.ColumnDepartment}" />
                    <GridViewColumn Width="124" Header="{l:Tr Correspondence.App.Mailboxes.ColumnActions}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:MailboxOwnerRowViewModel}">
                          <StackPanel Orientation="Horizontal">
                            <Button AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.PickOwner}"
                                    Command="{Binding DataContext.Mailboxes.PickOwnerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="{x:Static c:Glyphs.User}"
                                    Style="{StaticResource RowIconButton}"
                                    ToolTip="{l:Tr Correspondence.App.Mailboxes.PickOwner}" />
                            <Button AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.TypeAddress}"
                                    Command="{Binding DataContext.Mailboxes.TypeOwnerAddressCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="{x:Static c:Glyphs.Mail}"
                                    Style="{StaticResource RowIconButton}"
                                    ToolTip="{l:Tr Correspondence.App.Mailboxes.TypeAddress}" />
                            <Button AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.Exclude}"
                                    Command="{Binding DataContext.Mailboxes.ExcludeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="{x:Static c:Glyphs.Cancel}"
                                    Style="{StaticResource RowIconButton}"
                                    ToolTip="{l:Tr Correspondence.App.Mailboxes.Exclude}" />
                            <Button AutomationProperties.Name="{l:Tr Correspondence.App.Mailboxes.Restore}"
                                    Command="{Binding DataContext.Mailboxes.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="{x:Static c:Glyphs.Back}"
                                    Style="{StaticResource RowIconButton}"
                                    ToolTip="{l:Tr Correspondence.App.Mailboxes.Restore}" />
                          </StackPanel>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="160"
                                    DisplayMemberBinding="{Binding MailboxLocation, Mode=OneWay}"
                                    Header="{l:Tr Correspondence.App.Mailboxes.ColumnLocation}" />
                    <GridViewColumn Width="300" Header="{l:Tr Correspondence.App.Mailboxes.ColumnDetail}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:MailboxOwnerRowViewModel}">
                          <TextBlock Text="{Binding DetailText, Mode=OneWay}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding DetailText, Mode=OneWay}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
              <TextBlock x:Name="NoMailboxesHint"
                         MaxWidth="460"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Text="{l:Tr Correspondence.App.Mailboxes.Empty}"
                         TextAlignment="Center"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Mailboxes.Rows.Count, Mode=OneWay}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ==================== 1 · Odbiorcy ==================== -->
      <TabItem x:Name="RecipientsTab"
               Header="{l:Tr Correspondence.App.Tab.Recipients}"
               Tag="{x:Static cr:CorrespondenceTab.Recipients}">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>

          <DockPanel>
            <!-- Files, clipboard, typed text -->
            <WrapPanel DockPanel.Dock="Top">
              <Button x:Name="ImportFromDownloadsButton"
                      Command="{Binding Recipients.ImportFromDownloadsCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.FromDownloads}"
                      Style="{StaticResource BarButton}"
                      ToolTip="{l:Tr Correspondence.App.Recipients.FromDownloadsHint}" />
              <Button x:Name="ImportFilesButton"
                      Command="{Binding Recipients.ImportFilesCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.FromFiles}"
                      Style="{StaticResource BarButton}" />
              <Button x:Name="PasteRecipientsButton"
                      Command="{Binding Recipients.PasteCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.Paste}"
                      Style="{StaticResource BarButton}"
                      ToolTip="{l:Tr Correspondence.App.Recipients.PasteHint}" />
              <Button x:Name="AddManualButton"
                      Command="{Binding Recipients.AddManualCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.Manual}"
                      Style="{StaticResource BarButton}" />
            </WrapPanel>
            <!-- AD: the window's session; disabled after it ended -->
            <WrapPanel DockPanel.Dock="Top" IsEnabled="{Binding Recipients.CanUseDirectory, Mode=OneWay}">
              <TextBlock Margin="0,0,8,6"
                         Style="{StaticResource InlineLabel}"
                         Text="{l:Tr Correspondence.App.Recipients.Directory}" />
              <Button x:Name="AddFromSelectionButton"
                      Command="{Binding Recipients.AddFromSelectionCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.FromSelection}"
                      Style="{StaticResource BarButton}"
                      ToolTip="{l:Tr Correspondence.App.Recipients.FromSelectionHint}" />
              <Button x:Name="PickUsersButton"
                      Command="{Binding Recipients.PickUsersCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.PickUsers}"
                      Style="{StaticResource BarButton}" />
              <Button x:Name="AddGroupMembersButton"
                      Command="{Binding Recipients.AddGroupMembersCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.GroupMembers}"
                      Style="{StaticResource BarButton}" />
              <Button x:Name="ShowMailboxesButton"
                      Command="{Binding ShowMailboxesCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.MailboxOwners}"
                      Style="{StaticResource BarButton}"
                      ToolTip="{l:Tr Correspondence.App.Recipients.MailboxOwnersHint}"
                      Visibility="{Binding IsMailboxesTabVisible, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
            </WrapPanel>

            <!-- Counts and the list commands -->
            <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
              <TextBlock x:Name="CountsText"
                         Margin="0,0,14,6"
                         VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite"
                         FontWeight="SemiBold"
                         Text="{Binding Recipients.CountsText, Mode=OneWay}" />
              <Button x:Name="IncludeAllButton"
                      Command="{Binding Recipients.IncludeAllCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.IncludeAll}"
                      Style="{StaticResource BarButton}" />
              <Button x:Name="IncludeNoneButton"
                      Command="{Binding Recipients.IncludeNoneCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.IncludeNone}"
                      Style="{StaticResource BarButton}" />
              <Button x:Name="RemoveSelectedButton"
                      Command="{Binding Recipients.RemoveSelectedCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.RemoveSelected}"
                      Style="{StaticResource BarButton}" />
              <Button x:Name="ExportRecipientsButton"
                      Command="{Binding Recipients.ExportCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.Export}"
                      Style="{StaticResource BarButton}" />
              <Button x:Name="ClearRecipientsButton"
                      Command="{Binding Recipients.ClearCommand}"
                      Content="{l:Tr Correspondence.App.Recipients.Clear}"
                      Style="{StaticResource BarButton}" />
            </WrapPanel>

            <DockPanel Margin="0,4,0,8" DockPanel.Dock="Top">
              <TextBlock Margin="0,0,8,0"
                         DockPanel.Dock="Left"
                         Style="{StaticResource Ad.GlyphText}"
                         Text="{x:Static c:Glyphs.Search}" />
              <TextBox x:Name="SearchBox"
                       AutomationProperties.Name="{l:Tr Common.Search}"
                       Text="{Binding Recipients.SearchText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{l:Tr Correspondence.App.Recipients.SearchHint}" />
            </DockPanel>

            <!-- The recipients: fixed columns, then one column per field (built from Recipients.Columns); files can be dropped here. -->
            <Grid>
              <ListView x:Name="RecipientsGrid"
                        AllowDrop="True"
                        AutomationProperties.Name="{l:Tr Correspondence.App.Recipients.Grid}"
                        DragEnter="OnFileDragOver"
                        DragOver="OnFileDragOver"
                        Drop="OnRecipientsDrop"
                        ItemContainerStyle="{StaticResource RecipientRow}"
                        ItemsSource="{Binding Recipients.View, Mode=OneWay}"
                        ScrollViewer.CanContentScroll="True"
                        SelectionMode="Extended"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                  <GridView x:Name="RecipientsGridView" AllowsColumnReorder="False">
                    <GridViewColumn Width="58" Header="{l:Tr Correspondence.App.ColumnInclude}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:CorrespondenceRecipientViewModel}">
                          <CheckBox AutomationProperties.Name="{l:Tr Correspondence.App.ColumnInclude}" IsChecked="{Binding Include}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="230" Header="{l:Tr Correspondence.App.Recipients.ColumnEmail}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:CorrespondenceRecipientViewModel}">
                          <TextBlock Text="{Binding Email, Mode=OneWay}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsValid, Mode=OneWay}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200"
                                    DisplayMemberBinding="{Binding Name, Mode=OneWay}"
                                    Header="{l:Tr Correspondence.App.Recipients.ColumnName}" />
                    <GridViewColumn Width="120"
                                    DisplayMemberBinding="{Binding Source, Mode=OneWay}"
                                    Header="{l:Tr Correspondence.App.Recipients.ColumnSource}" />
                    <GridViewColumn Width="170" Header="{l:Tr Correspondence.App.Recipients.ColumnStatus}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:CorrespondenceRecipientViewModel}">
                          <TextBlock Style="{StaticResource RecipientStatus}" Text="{Binding Status, Mode=OneWay}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="190" Header="{l:Tr Correspondence.App.Recipients.ColumnPreviouslySent}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type cr:CorrespondenceRecipientViewModel}">
                          <TextBlock Style="{StaticResource Ad.SecondaryText}"
                                     Text="{Binding PreviouslySentText, Mode=OneWay}"
                                     ToolTip="{Binding PreviouslySentText, Mode=OneWay}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
              <TextBlock x:Name="NoRecipientsHint"
                         MaxWidth="460"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Text="{l:Tr Correspondence.App.Recipients.Empty}"
                         TextAlignment="Center"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Recipients.Items.Count, Mode=OneWay}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>

          <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
              <!-- "Nie wysyłać" and the journal "już wysłane" -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Recipients.Exclusions}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Correspondence.App.Recipients.ExclusionsHint}" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="ExclusionsFromFileButton"
                            Command="{Binding Recipients.ExclusionsFromFileCommand}"
                            Content="{l:Tr Correspondence.App.Recipients.ExclusionsFromFile}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ExclusionsFromClipboardButton"
                            Command="{Binding Recipients.ExclusionsFromClipboardCommand}"
                            Content="{l:Tr Correspondence.App.Recipients.ExclusionsPaste}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ClearExclusionsButton"
                            Command="{Binding Recipients.ClearExclusionsCommand}"
                            Content="{l:Tr Common.Clear}"
                            Style="{StaticResource BarButton}" />
                  </WrapPanel>
                  <CheckBox x:Name="SkipAlreadySentBox"
                            Margin="0,2,0,6"
                            Content="{l:Tr Correspondence.App.Recipients.SkipAlreadySent}"
                            IsChecked="{Binding Recipients.SkipAlreadySent}" />
                  <TextBlock x:Name="ExclusionsText"
                             Style="{StaticResource Hint}"
                             Text="{Binding Recipients.ExclusionsText, Mode=OneWay}" />
                  <Button x:Name="ShowJournalButton"
                          Margin="0,8,0,0"
                          HorizontalAlignment="Left"
                          Command="{Binding Recipients.ShowJournalCommand}"
                          Content="{l:Tr Correspondence.App.Journal}" />
                </StackPanel>
              </Border>

              <!-- The fields of AD rows (U1 template expressions, decision D2) -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Recipients.DirectoryFields}" />
                  <TextBlock Margin="0,0,0,8" Style="{StaticResource Hint}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource Ad.Format}">
                        <l:TrBinding Key="Correspondence.App.Recipients.DirectoryFieldsHint" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <ItemsControl x:Name="DirectoryFieldsList"
                                AutomationProperties.Name="{l:Tr Correspondence.App.Recipients.DirectoryFields}"
                                Focusable="False"
                                ItemTemplate="{StaticResource DirectoryFieldEditor}"
                                ItemsSource="{Binding Recipients.DirectoryFields, Mode=OneWay}"
                                Tag="{Binding Recipients.RemoveDirectoryFieldCommand, Mode=OneWay}" />
                  <WrapPanel>
                    <Button x:Name="AddDirectoryFieldButton"
                            Command="{Binding Recipients.AddDirectoryFieldCommand}"
                            Content="{l:Tr Correspondence.App.AddField}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ResetDirectoryFieldsButton"
                            Command="{Binding Recipients.ResetDirectoryFieldsCommand}"
                            Content="{l:Tr Common.ResetToDefault}"
                            Style="{StaticResource BarButton}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ==================== 2 · Wiadomość ==================== -->
      <TabItem x:Name="MessageTab"
               Header="{l:Tr Correspondence.App.Tab.Message}"
               Tag="{x:Static cr:CorrespondenceTab.Message}">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
          </Grid.ColumnDefinitions>

          <Border Padding="12" Style="{StaticResource Ad.Card}">
            <DockPanel>
              <!-- Sender: the Outlook account, "w imieniu", connect and check -->
              <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Margin="0,0,0,4" Text="{l:Tr Correspondence.App.Message.SendAs}" />
                  <ComboBox x:Name="AccountBox"
                            AutomationProperties.Name="{l:Tr Correspondence.App.Message.SendAs}"
                            ItemsSource="{Binding Outlook.Accounts, Mode=OneWay}"
                            SelectedItem="{Binding Outlook.SelectedAccount}"
                            ToolTip="{l:Tr Correspondence.App.Message.SendAsHint}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type ol:OutlookAccount}">
                        <TextBlock TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding DisplayName, Mode=OneWay}" />
                          <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SmtpAddress, Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Margin="0,0,0,4" Text="{l:Tr Correspondence.App.Message.OnBehalfOf}" />
                  <TextBox x:Name="OnBehalfOfBox"
                           AutomationProperties.Name="{l:Tr Correspondence.App.Message.OnBehalfOf}"
                           Text="{Binding Outlook.OnBehalfOf, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                  <Button x:Name="ConnectOutlookButton"
                          Margin="0,0,6,0"
                          Command="{Binding Outlook.ConnectCommand}"
                          Content="{l:Tr Correspondence.App.Connect}" />
                  <Button x:Name="CheckOutlookButton"
                          Command="{Binding Outlook.CheckCommand}"
                          Content="{l:Tr Correspondence.App.CheckOutlook}" />
                </StackPanel>
              </Grid>

              <!-- Subject (fields allowed) and the salutation of {{zwrot}} -->
              <Grid Margin="0,10,0,0" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Margin="0,0,0,4" Text="{l:Tr Correspondence.App.Message.Subject}" />
                  <DockPanel>
                    <Button x:Name="InsertSubjectFieldButton"
                            Margin="6,0,0,0"
                            Command="{Binding Message.InsertFieldCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=SubjectFieldBox}"
                            Content="{l:Tr Correspondence.App.Editor.InsertField}"
                            DockPanel.Dock="Right"
                            Focusable="False"
                            ToolTip="{l:Tr Correspondence.App.Message.InsertFieldHint}" />
                    <ComboBox x:Name="SubjectFieldBox"
                              Width="150"
                              Margin="6,0,0,0"
                              AutomationProperties.Name="{l:Tr Correspondence.App.Editor.Field}"
                              DockPanel.Dock="Right"
                              Focusable="False"
                              ItemsSource="{Binding Message.FieldChoices, Mode=OneWay}"
                              ToolTip="{l:Tr Correspondence.App.Message.InsertFieldHint}" />
                    <TextBox x:Name="SubjectBox"
                             AutomationProperties.Name="{l:Tr Correspondence.App.Message.Subject}"
                             Text="{Binding Message.Subject, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Margin="0,0,0,4"
                             Text="{l:Tr Correspondence.App.Message.Salutation}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBox x:Name="SalutationBox"
                           AutomationProperties.Name="{l:Tr Correspondence.App.Message.Salutation}"
                           Text="{Binding Message.Salutation, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{l:Tr Correspondence.App.Message.SalutationHint}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,12,0,4"
                         DockPanel.Dock="Top"
                         Style="{StaticResource Hint}"
                         Text="{l:Tr Correspondence.App.Message.BodyHint}" />
              <TextBlock x:Name="PasteProblemsText"
                         DockPanel.Dock="Bottom"
                         Foreground="{DynamicResource SystemFillColorCautionBrush}"
                         Style="{StaticResource Hint}"
                         Text="{Binding Message.PasteProblemsText, Mode=OneWay}"
                         Visibility="{Binding Message.PasteProblemsText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
              <c:RichMessageEditor x:Name="MessageEditor"
                                   MinHeight="240"
                                   FieldChoices="{Binding Message.FieldChoices, Mode=OneWay}"
                                   Host="{Binding Message, Mode=OneWay}"
                                   Html="{Binding Message.BodyHtml, Mode=TwoWay}" />
            </DockPanel>
          </Border>

          <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
              <!-- Signature -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Message.Signature}" />
                  <DockPanel>
                    <Button x:Name="RefreshSignaturesButton"
                            Margin="6,0,0,0"
                            AutomationProperties.Name="{l:Tr Commands.Refresh}"
                            Command="{Binding Message.RefreshSignaturesCommand}"
                            Content="{x:Static c:Glyphs.Refresh}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Ad.IconButton}"
                            ToolTip="{l:Tr Commands.Refresh}" />
                    <ComboBox x:Name="SignatureBox"
                              AutomationProperties.Name="{l:Tr Correspondence.App.Message.Signature}"
                              DisplayMemberPath="Text"
                              ItemsSource="{Binding Message.Signatures, Mode=OneWay}"
                              SelectedItem="{Binding Message.SelectedSignature}" />
                  </DockPanel>
                  <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Correspondence.App.Message.SignatureHint}" />
                  <TextBlock x:Name="SignatureProblemsText"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                             Style="{StaticResource Hint}"
                             Text="{Binding Message.SignatureProblemsText, Mode=OneWay}"
                             Visibility="{Binding Message.SignatureProblemsText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                </StackPanel>
              </Border>

              <!-- Attachments: added to every message of the run; files can be dropped on the list -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="AttachmentsHeader" Text="{Binding Message.AttachmentsHeaderText, Mode=OneWay}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CardHeader}">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Message.Attachments.Count, Mode=OneWay}" Value="0">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ListBox x:Name="AttachmentsList"
                           Height="96"
                           AllowDrop="True"
                           AutomationProperties.Name="{l:Tr Correspondence.App.Message.Attachments}"
                           DragEnter="OnFileDragOver"
                           DragOver="OnFileDragOver"
                           Drop="OnAttachmentsDrop"
                           ItemsSource="{Binding Message.Attachments, Mode=OneWay}"
                           SelectionMode="Extended"
                           ToolTip="{l:Tr Correspondence.App.Message.AttachmentsDropHint}">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type cr:AttachmentViewModel}">
                        <DockPanel ToolTip="{Binding Path, Mode=OneWay}">
                          <TextBlock Margin="8,0,0,0"
                                     DockPanel.Dock="Right"
                                     Style="{StaticResource Ad.SecondaryText}"
                                     Text="{Binding SizeText, Mode=OneWay}" />
                          <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Exists, Mode=OneWay}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="AddAttachmentsButton"
                            Command="{Binding Message.AddAttachmentsCommand}"
                            Content="{l:Tr Correspondence.App.Message.AddAttachments}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="RemoveAttachmentsButton"
                            Command="{Binding Message.RemoveAttachmentsCommand}"
                            Content="{l:Tr Common.Remove}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ClearAttachmentsButton"
                            Command="{Binding Message.ClearAttachmentsCommand}"
                            Content="{l:Tr Common.Clear}"
                            Style="{StaticResource BarButton}" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Correspondence.App.Message.AttachmentsHint}" />
                </StackPanel>
              </Border>

              <!-- Sending options -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Message.Sending}" />
                  <ComboBox x:Name="SendModeBox"
                            AutomationProperties.Name="{l:Tr Correspondence.App.Message.SendMode}"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding Message.SendModeChoices, Mode=OneWay}"
                            SelectedItem="{Binding Message.SendMode}"
                            ToolTip="{l:Tr Correspondence.App.Message.SendModeHint}" />
                  <DockPanel Margin="0,6,0,0">
                    <DockPanel.Style>
                      <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Message.SendMode.Value, Mode=OneWay}" Value="{x:Static ps:CorrespondenceSendMode.Bcc}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DockPanel.Style>
                    <TextBox x:Name="BccChunkBox"
                             Width="70"
                             AutomationProperties.Name="{l:Tr Correspondence.App.Message.BccChunk}"
                             DockPanel.Dock="Right"
                             Text="{Binding Message.BccChunkSize, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right" />
                    <TextBlock Style="{StaticResource InlineLabel}"
                               Text="{l:Tr Correspondence.App.Message.BccChunk}"
                               TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel Margin="0,6,0,0">
                    <TextBox x:Name="DelayBox"
                             Width="70"
                             AutomationProperties.Name="{l:Tr Correspondence.App.Message.Delay}"
                             DockPanel.Dock="Right"
                             Text="{Binding Message.DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right" />
                    <TextBlock Style="{StaticResource InlineLabel}"
                               Text="{l:Tr Correspondence.App.Message.Delay}"
                               TextWrapping="Wrap" />
                  </DockPanel>
                  <CheckBox x:Name="ReadReceiptBox"
                            Margin="0,8,0,0"
                            Content="{l:Tr Correspondence.App.Message.ReadReceipt}"
                            IsChecked="{Binding Message.ReadReceipt}" />
                  <CheckBox x:Name="DeliverLaterBox"
                            Margin="0,8,0,0"
                            Content="{l:Tr Correspondence.App.Message.DeliverLater}"
                            IsChecked="{Binding Message.DeliverLater}" />
                  <StackPanel Margin="26,6,0,0" IsEnabled="{Binding Message.DeliverLater, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                      <DatePicker x:Name="DeliverDatePicker"
                                  Width="150"
                                  AutomationProperties.Name="{l:Tr Correspondence.App.Message.DeliverDate}"
                                  b:DatePickerWatermark.Text="{l:Tr Ui.SelectDate}"
                                  SelectedDate="{Binding Message.DeliverDate}" />
                      <TextBox x:Name="DeliverTimeBox"
                               Width="70"
                               Margin="6,0,0,0"
                               AutomationProperties.Name="{l:Tr Correspondence.App.Message.DeliverTime}"
                               Text="{Binding Message.DeliverTime, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{l:Tr Correspondence.App.Message.DeliverTime}" />
                    </StackPanel>
                    <TextBlock x:Name="DeliverErrorText"
                               Style="{StaticResource ErrorLine}"
                               Text="{Binding Message.DeliverError, Mode=OneWay}"
                               Visibility="{Binding Message.DeliverError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Correspondence.App.Message.DeliverHint}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Voting buttons (read back on "5 · Odpowiedzi") -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="UseVotingBox"
                            Content="{l:Tr Correspondence.App.Message.UseVoting}"
                            FontWeight="SemiBold"
                            IsChecked="{Binding Message.UseVoting}" />
                  <TextBox x:Name="VotingOptionsBox"
                           Margin="0,6,0,0"
                           AutomationProperties.Name="{l:Tr Correspondence.App.Message.VotingOptions}"
                           IsEnabled="{Binding Message.UseVoting, Mode=OneWay}"
                           Text="{Binding Message.VotingOptions, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{l:Tr Correspondence.App.Message.VotingOptions}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Correspondence.App.Message.VotingHint}" />
                </StackPanel>
              </Border>

              <!-- Own fields, grouping by address and the {{lista}} item -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Message.CustomFields}" />
                  <TextBlock Margin="0,0,0,6"
                             Style="{StaticResource Hint}"
                             Text="{l:Tr Correspondence.App.Message.CustomFieldsHint}" />
                  <ItemsControl x:Name="CustomFieldsList"
                                AutomationProperties.Name="{l:Tr Correspondence.App.Message.CustomFields}"
                                Focusable="False"
                                ItemsSource="{Binding Message.CustomFields, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type cr:CustomFieldViewModel}">
                        <StackPanel Margin="0,0,0,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="100" />
                              <ColumnDefinition Width="6" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="{l:Tr Correspondence.App.FieldName}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:Tr Correspondence.App.FieldName}" />
                            <TextBox Grid.Column="2"
                                     AutomationProperties.Name="{l:Tr Correspondence.App.FieldValue}"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:Tr Correspondence.App.FieldValue}" />
                            <Button Grid.Column="3"
                                    AutomationProperties.Name="{l:Tr Common.Remove}"
                                    Command="{Binding DataContext.Message.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="{x:Static c:Glyphs.Delete}"
                                    Style="{StaticResource RowIconButton}"
                                    ToolTip="{l:Tr Common.Remove}" />
                          </Grid>
                          <TextBlock Style="{StaticResource ErrorLine}"
                                     Text="{Binding Error, Mode=OneWay}"
                                     Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="AddCustomFieldButton"
                          HorizontalAlignment="Left"
                          Command="{Binding Message.AddCustomFieldCommand}"
                          Content="{l:Tr Correspondence.App.AddField}"
                          Style="{StaticResource BarButton}" />
                  <CheckBox x:Name="GroupByAddressBox"
                            Margin="0,4,0,0"
                            IsChecked="{Binding Message.GroupByAddress}">
                    <TextBlock Text="{l:Tr Correspondence.App.Message.GroupByAddress}" TextWrapping="Wrap" />
                  </CheckBox>
                  <StackPanel Margin="26,6,0,0" Visibility="{Binding Message.GroupByAddress, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,4" Text="{l:Tr Correspondence.App.Message.ListItem}" TextWrapping="Wrap" />
                    <TextBox x:Name="ListItemTemplateBox"
                             AutomationProperties.Name="{l:Tr Correspondence.App.Message.ListItem}"
                             Text="{Binding Message.ListItemTemplate, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Templates: built-ins and saved ones -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Message.Templates}" />
                  <DockPanel>
                    <Button x:Name="DeleteTemplateButton"
                            Margin="6,0,0,0"
                            AutomationProperties.Name="{l:Tr Correspondence.App.Message.DeleteTemplate}"
                            Command="{Binding Message.DeleteTemplateCommand}"
                            Content="{x:Static c:Glyphs.Delete}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Ad.IconButton}"
                            ToolTip="{l:Tr Correspondence.App.Message.DeleteTemplate}" />
                    <ComboBox x:Name="TemplateBox"
                              AutomationProperties.Name="{l:Tr Correspondence.App.Message.Template}"
                              DisplayMemberPath="Text"
                              ItemsSource="{Binding Message.Templates, Mode=OneWay}"
                              SelectedItem="{Binding Message.SelectedTemplate}" />
                  </DockPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{l:Tr Correspondence.App.Message.TemplateName}" />
                  <DockPanel>
                    <Button x:Name="SaveTemplateButton"
                            Margin="6,0,0,0"
                            Command="{Binding Message.SaveTemplateCommand}"
                            Content="{l:Tr Common.Save}"
                            DockPanel.Dock="Right" />
                    <TextBox x:Name="TemplateNameBox"
                             AutomationProperties.Name="{l:Tr Correspondence.App.Message.TemplateName}"
                             Text="{Binding Message.TemplateName, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="NewMessageButton"
                            Command="{Binding Message.NewMessageCommand}"
                            Content="{l:Tr Correspondence.App.Message.NewMessage}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ExportTemplatesButton"
                            Command="{Binding Message.ExportTemplatesCommand}"
                            Content="{l:Tr Correspondence.App.Message.ExportTemplates}"
                            Style="{StaticResource BarButton}" />
                    <Button x:Name="ImportTemplatesButton"
                            Command="{Binding Message.ImportTemplatesCommand}"
                            Content="{l:Tr Correspondence.App.Message.ImportTemplates}"
                            Style="{StaticResource BarButton}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ==================== 3 · Podgląd ==================== -->
      <TabItem x:Name="PreviewTab"
               Header="{l:Tr Correspondence.App.Tab.Preview}"
               Tag="{x:Static cr:CorrespondenceTab.Preview}">
        <DockPanel Margin="0,10,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
              <WrapPanel>
                <TextBlock Margin="0,0,8,6"
                           Style="{StaticResource InlineLabel}"
                           Text="{l:Tr Correspondence.App.Preview.Recipient}" />
                <ComboBox x:Name="PreviewRecipientBox"
                          Width="320"
                          Margin="0,0,8,6"
                          AutomationProperties.Name="{l:Tr Correspondence.App.Preview.Recipient}"
                          DisplayMemberPath="Text"
                          ItemsSource="{Binding Preview.PreviewRecipients, Mode=OneWay}"
                          SelectedItem="{Binding Preview.SelectedRecipient}" />
                <ComboBox x:Name="PreviewWidthBox"
                          Width="180"
                          Margin="0,0,8,6"
                          AutomationProperties.Name="{l:Tr Correspondence.App.Preview.Width}"
                          DisplayMemberPath="Text"
                          ItemsSource="{Binding Preview.WidthChoices, Mode=OneWay}"
                          SelectedItem="{Binding Preview.Width}" />
                <Button x:Name="RefreshPreviewButton"
                        Command="{Binding Preview.RefreshCommand}"
                        Content="{l:Tr Commands.Refresh}"
                        Style="{StaticResource BarButton}" />
                <Button x:Name="PreviewViaOutlookButton"
                        Command="{Binding Preview.PreviewViaOutlookCommand}"
                        Content="{l:Tr Correspondence.App.Preview.ViaOutlook}"
                        Style="{StaticResource BarButton}"
                        ToolTip="{l:Tr Correspondence.App.Preview.ViaOutlookHint}" />
                <Button x:Name="OpenInBrowserButton"
                        Command="{Binding Preview.OpenInBrowserCommand}"
                        Content="{l:Tr Correspondence.App.Preview.OpenInBrowser}"
                        Style="{StaticResource BarButton}"
                        ToolTip="{l:Tr Correspondence.App.Preview.OpenInBrowserHint}" />
                <Button x:Name="SaveHtmlButton"
                        Command="{Binding Preview.SaveHtmlCommand}"
                        Content="{l:Tr Correspondence.App.Preview.SaveHtml}"
                        Style="{StaticResource BarButton}" />
              </WrapPanel>
              <TextBlock x:Name="PreviewInfoText"
                         Style="{StaticResource Hint}"
                         Text="{Binding Preview.InfoText, Mode=OneWay}"
                         Visibility="{Binding Preview.InfoText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
              <TextBlock x:Name="PreviewFromOutlookText"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                         Style="{StaticResource Hint}"
                         Text="{l:Tr Correspondence.App.Preview.FromOutlook}"
                         Visibility="{Binding Preview.IsFromOutlook, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
              <TextBlock x:Name="PreviewOkText"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                         Style="{StaticResource Hint}"
                         Text="{Binding Preview.OkText, Mode=OneWay}"
                         Visibility="{Binding Preview.HasWarnings, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
              <ItemsControl x:Name="PreviewWarningsList"
                            Margin="0,6,0,0"
                            AutomationProperties.Name="{l:Tr Correspondence.App.Preview.Warnings}"
                            Focusable="False"
                            ItemsSource="{Binding Preview.Warnings, Mode=OneWay}"
                            Visibility="{Binding Preview.HasWarnings, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sys:String}">
                    <DockPanel Margin="0,2,0,0">
                      <TextBlock Margin="0,0,8,0"
                                 VerticalAlignment="Top"
                                 FontSize="14"
                                 Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                 Style="{StaticResource Ad.GlyphText}"
                                 Text="{x:Static c:Glyphs.Warning}" />
                      <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- The card as the recipient sees it: rendered from memory (WebView2), else the HTML source. -->
          <Border Padding="1" Style="{StaticResource Ad.Card}">
            <c:HtmlPreviewView x:Name="PreviewView" Preview="{Binding Preview.Preview, Mode=OneWay}" />
          </Border>
        </DockPanel>
      </TabItem>

      <!-- ==================== 4 · Wysyłka ==================== -->
      <TabItem x:Name="SendTab"
               Header="{l:Tr Correspondence.App.Tab.Send}"
               Tag="{x:Static cr:CorrespondenceTab.Send}">
        <DockPanel Margin="0,10,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <DockPanel>
              <Button x:Name="RefreshSummaryButton"
                      VerticalAlignment="Top"
                      Command="{Binding Send.RefreshSummaryCommand}"
                      Content="{l:Tr Commands.Refresh}"
                      DockPanel.Dock="Right" />
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource CardHeader}" Text="{l:Tr Correspondence.App.Send.Summary}" />
                <TextBox x:Name="SummaryText"
                         AutomationProperties.Name="{l:Tr Correspondence.App.Send.Summary}"
                         BorderThickness="0"
                         Style="{StaticResource Ad.SelectableText}"
                         Text="{Binding Send.SummaryText, Mode=OneWay}"
                         TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>

          <WrapPanel Margin="0,0,0,4" DockPanel.Dock="Top">
            <Button x:Name="SendTestButton"
                    Command="{Binding Send.SendTestCommand}"
                    Content="{l:Tr Correspondence.App.Send.Test}"
                    Style="{StaticResource BarButton}"
                    ToolTip="{l:Tr Correspondence.App.Send.TestHint}" />
            <Button x:Name="CreateDraftsButton"
                    Command="{Binding Send.CreateDraftsCommand}"
                    Content="{l:Tr Correspondence.App.Send.Drafts}"
                    Style="{StaticResource BarButton}"
                    ToolTip="{l:Tr Correspondence.App.Send.DraftsHint}" />
            <Button x:Name="SendButton"
                    MinWidth="140"
                    Command="{Binding Send.SendCommand}"
                    Content="{l:Tr Correspondence.App.Send.Send}"
                    Style="{StaticResource AccentBarButton}" />
            <Button x:Name="StopButton"
                    Command="{Binding Send.StopCommand}"
                    Content="{l:Tr Common.Stop}"
                    Style="{StaticResource BarButton}" />
            <Button x:Name="RetryFailedButton"
                    Command="{Binding Send.RetryFailedCommand}"
                    Content="{l:Tr Correspondence.App.Send.RetryFailed}"
                    Style="{StaticResource BarButton}" />
          </WrapPanel>

          <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <ProgressBar x:Name="SendProgress"
                           Height="8"
                           AutomationProperties.Name="{l:Tr Correspondence.App.Send.Progress}"
                           Maximum="{Binding Send.ProgressMaximum, Mode=OneWay}"
                           Value="{Binding Send.ProgressValue, Mode=OneWay}" />
              <TextBlock x:Name="ProgressText"
                         Margin="0,6,0,0"
                         AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource Hint}"
                         Text="{Binding Send.ProgressText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
              <TextBlock Margin="0,0,4,0"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{l:Tr Correspondence.App.Send.Sent}" />
              <TextBlock x:Name="SentCountText"
                         FontWeight="Bold"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                         Text="{Binding Send.SentCount, Mode=OneWay}" />
              <TextBlock Margin="14,0,4,0"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{l:Tr Correspondence.App.Send.Failed}" />
              <TextBlock x:Name="FailedCountText"
                         FontWeight="Bold"
                         Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                         Text="{Binding Send.FailedCount, Mode=OneWay}" />
              <TextBlock Margin="14,0,4,0"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{l:Tr Correspondence.App.Send.Skipped}" />
              <TextBlock x:Name="SkippedCountText"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="{Binding Send.SkippedCount, Mode=OneWay}" />
            </StackPanel>
          </Grid>

          <Border Padding="0" Style="{StaticResource Ad.Card}">
            <DockPanel>
              <TextBlock Margin="14,12,14,6"
                         DockPanel.Dock="Top"
                         Style="{StaticResource CardHeader}"
                         Text="{l:Tr Correspondence.App.Send.Results}" />
              <WrapPanel Margin="12,8,12,6" DockPanel.Dock="Bottom">
                <Button x:Name="ExportReportButton"
                        Command="{Binding Send.ExportReportCommand}"
                        Content="{l:Tr Correspondence.App.Send.ExportReport}"
                        Style="{StaticResource BarButton}" />
                <Button x:Name="SendJournalButton"
                        Command="{Binding Recipients.ShowJournalCommand}"
                        Content="{l:Tr Correspondence.App.Journal}"
                        Style="{StaticResource BarButton}" />
              </WrapPanel>
              <ListBox x:Name="ResultsList"
                       Margin="6,0"
                       AutomationProperties.Name="{l:Tr Correspondence.App.Send.Results}"
                       BorderThickness="0"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="12.5"
                       ItemsSource="{Binding Send.Results, Mode=OneWay}"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type cr:SendResultLine}">
                    <TextBlock Text="{Binding Text, Mode=OneWay}" TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess, Mode=OneWay}" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- ==================== 5 · Odpowiedzi ==================== -->
      <TabItem x:Name="ResponsesTab"
               Header="{l:Tr Correspondence.App.Tab.Responses}"
               Tag="{x:Static cr:CorrespondenceTab.Responses}">
        <DockPanel Margin="0,10,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
              <WrapPanel>
                <TextBlock Margin="0,0,8,6"
                           Style="{StaticResource InlineLabel}"
                           Text="{l:Tr Correspondence.App.Responses.Since}" />
                <DatePicker x:Name="SinceDatePicker"
                            Width="150"
                            Margin="0,0,8,6"
                            AutomationProperties.Name="{l:Tr Correspondence.App.Responses.Since}"
                            b:DatePickerWatermark.Text="{l:Tr Ui.SelectDate}"
                            SelectedDate="{Binding Responses.Since}" />
                <Button x:Name="LoadCampaignsButton"
                        Command="{Binding Responses.LoadCampaignsCommand}"
                        Content="{l:Tr Correspondence.App.Responses.LoadCampaigns}"
                        Style="{StaticResource BarButton}" />
                <ComboBox x:Name="CampaignBox"
                          Width="360"
                          Margin="8,0,8,6"
                          AutomationProperties.Name="{l:Tr Correspondence.App.Responses.Campaign}"
                          DisplayMemberPath="Text"
                          ItemsSource="{Binding Responses.Campaigns, Mode=OneWay}"
                          SelectedItem="{Binding Responses.SelectedCampaign}" />
                <Button x:Name="LoadResponsesButton"
                        Command="{Binding Responses.LoadResponsesCommand}"
                        Content="{l:Tr Correspondence.App.Responses.LoadResponses}"
                        Style="{StaticResource AccentBarButton}" />
                <Button x:Name="ExportResponsesButton"
                        Command="{Binding Responses.ExportCommand}"
                        Content="{l:Tr Correspondence.App.Responses.Export}"
                        Style="{StaticResource BarButton}" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Correspondence.App.Responses.Hint}" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="ResponsesSummaryText"
                     Margin="0,0,0,8"
                     AutomationProperties.LiveSetting="Polite"
                     DockPanel.Dock="Top"
                     FontWeight="SemiBold"
                     Text="{Binding Responses.SummaryText, Mode=OneWay}"
                     Visibility="{Binding Responses.SummaryText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          <ListView x:Name="ResponsesGrid"
                    AutomationProperties.Name="{l:Tr Correspondence.App.Tab.Responses}"
                    ItemContainerStyle="{StaticResource ResponseRow}"
                    ItemsSource="{Binding Responses.Rows, Mode=OneWay}"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="260"
                                DisplayMemberBinding="{Binding Recipient, Mode=OneWay}"
                                Header="{l:Tr Correspondence.App.Responses.ColumnRecipient}" />
                <GridViewColumn Width="320" Header="{l:Tr Correspondence.App.Responses.ColumnMailboxes}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cr:ResponseRowViewModel}">
                      <TextBlock Text="{Binding KeysText, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding KeysText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="260" Header="{l:Tr Correspondence.App.Responses.ColumnResponse}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cr:ResponseRowViewModel}">
                      <TextBlock Style="{StaticResource ResponseText}" Text="{Binding Response, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="160"
                                DisplayMemberBinding="{Binding RespondedAtText, Mode=OneWay}"
                                Header="{l:Tr Correspondence.App.Responses.ColumnRespondedAt}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
