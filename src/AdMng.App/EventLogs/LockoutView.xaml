<!--
  "Skąd blokada konta – <konto>" (LockoutDocumentViewModel, track E2, docs/dev/e-event-logs.md 4.1) in the K6 diagnostics
  layout: the account's actions and the window at the top, the summary and the notes, then the sources, the timeline, the
  domain controllers and the audit evidence (with "Pokaż w modelu" and "Diagnostyka zasad grupy") in tabs, and beside them,
  behind a splitter, the details of the selected source with "Sprawdź komputer źródłowy" (K1 pivot) and "Otwórz zdalne akcje".
-->
<UserControl x:Class="AdMng.App.EventLogs.LockoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:gp="clr-namespace:AdMng.App.GroupPolicy"
             xmlns:evt="clr-namespace:AdMng.Presentation.EventLogs;assembly=AdMng.Presentation"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AdMng;component/EventLogs/EventLogResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Margin="8,6,8,8">
    <!-- Header: the title trimmed in its column, the actions in their own -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <c:ObjectIconView Margin="0,0,8,0" VerticalAlignment="Center" Icon="{Binding Icon, Mode=OneWay}" Size="18" />
      <TextBlock x:Name="TitleText"
                 Grid.Column="1"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="{Binding Title, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Title, Mode=OneWay}" />
      <WrapPanel Grid.Column="2" VerticalAlignment="Center">
        <Button x:Name="RunButton"
                Margin="0,0,6,0"
                Command="{Binding RunCommand}"
                Content="{l:Tr EvtLock.Run}"
                Style="{StaticResource AccentButtonStyle}" />
        <Button x:Name="CancelButton" Margin="0,0,12,0" Command="{Binding CancelCommand}" Content="{l:Tr Common.Cancel}" />
        <Button x:Name="UnlockButton" Margin="0,0,6,0" Command="{Binding UnlockCommand}" Content="{l:Tr Commands.Unlock}" />
        <Button x:Name="AccountButton" Margin="0,0,6,0" Command="{Binding OpenAccountCommand}" Content="{l:Tr Commands.Properties}" />
        <Button x:Name="WatchdogHistoryButton"
                Margin="0,0,12,0"
                Command="{Binding WatchdogHistoryCommand}"
                Content="{l:Tr EvtLock.WatchdogHistory}"
                Visibility="{Binding IsWatchdogHistoryAvailable, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="ExportCsvButton" Margin="0,0,6,0" Command="{Binding ExportCsvCommand}" Content="{l:Tr EvtLog.ExportCsv}" />
        <Button x:Name="ExportHtmlButton" Command="{Binding ExportHtmlCommand}" Content="{l:Tr EvtLog.ExportHtml}" />
      </WrapPanel>
    </Grid>

    <Border x:Name="NotSupportedBar"
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding IsNotSupported, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <DockPanel>
        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Warning}" />
        <TextBlock x:Name="NotSupportedText" VerticalAlignment="Center" Text="{Binding NotSupportedText, Mode=OneWay}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- The window and the status (or the progress) -->
    <WrapPanel Margin="0,0,0,6" DockPanel.Dock="Top">
      <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Tr EvtLock.WindowLabel}" />
      <ComboBox x:Name="WindowBox"
                MinWidth="240"
                Margin="0,0,8,0"
                AutomationProperties.Name="{l:Tr EvtLock.WindowLabel}"
                DisplayMemberPath="Text"
                ItemsSource="{Binding TimePresetOptions, Mode=OneWay}"
                SelectedItem="{Binding SelectedTimePreset}" />
      <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomTime, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Tr EvtLog.FromLabel}" />
        <DatePicker Margin="0,0,8,0" AutomationProperties.Name="{l:Tr EvtLog.FromLabel}" SelectedDate="{Binding CustomFrom}" />
        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Tr EvtLog.ToLabel}" />
        <DatePicker Margin="0,0,8,0" AutomationProperties.Name="{l:Tr EvtLog.ToLabel}" SelectedDate="{Binding CustomTo}" />
      </StackPanel>
      <ProgressBar x:Name="RunProgress"
                   Width="180"
                   Height="4"
                   Margin="8,0,10,0"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
                   IsIndeterminate="True"
                   Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <TextBlock x:Name="StatusLine"
                 VerticalAlignment="Center"
                 AutomationProperties.LiveSetting="Polite"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding StatusText, Mode=OneWay}" />
    </WrapPanel>

    <!-- Summary -->
    <Border x:Name="SummaryCard"
            Margin="0,0,0,6"
            Padding="12,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.Card}"
            Visibility="{Binding HasReport, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <StackPanel>
        <TextBlock x:Name="LockStateText" FontWeight="SemiBold" Text="{Binding LockStateText, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock x:Name="LastLockoutText" Text="{Binding LastLockoutText, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock x:Name="PolicyText" Text="{Binding PolicyText, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Ad.SecondaryText}" TextWrapping="Wrap">
          <Run Text="{Binding CountsText, Mode=OneWay}" />
          <Run Text=" " />
          <Run Text="{Binding WindowText, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Notes of the analysis (warnings first) -->
    <Expander x:Name="NotesExpander"
              Margin="0,0,0,6"
              DockPanel.Dock="Top"
              Header="{l:Tr EvtLock.NotesHeading}"
              IsExpanded="True"
              Visibility="{Binding HasNotes, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="NotesList"
                      Focusable="False"
                      ItemTemplate="{StaticResource EventLog.NoteTemplate}"
                      ItemsSource="{Binding Notes, Mode=OneWay}" />
      </ScrollViewer>
    </Expander>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="380" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <TabControl x:Name="ReportTabs">
        <TabItem x:Name="SourcesTab" Header="{l:Tr EvtLock.SourcesHeading}">
          <Grid>
            <ListView x:Name="SourcesList"
                      AutomationProperties.Name="{l:Tr EvtLock.SourcesHeading}"
                      ItemContainerStyle="{StaticResource EventLog.Row}"
                      ItemsSource="{Binding Sources, Mode=OneWay}"
                      SelectedItem="{Binding SelectedSource}"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="40" Header="{l:Tr EvtLock.ColumnRank}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock Text="{Binding Rank, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="160" Header="{l:Tr EvtLock.ColumnKind}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock Text="{Binding KindText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="190" Header="{l:Tr EvtLock.ColumnSource}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Value, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="80" Header="{l:Tr EvtLock.ColumnFailures}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock Text="{Binding FailuresText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="120" Header="{l:Tr EvtLock.ColumnContributing}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock Text="{Binding ContributingText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="80" Header="{l:Tr EvtLock.ColumnLockouts}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock Text="{Binding LockoutsText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="150" Header="{l:Tr EvtLock.ColumnLast}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock Text="{Binding LastText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="160" Header="{l:Tr EvtLock.ColumnDcs}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutSourceRow}">
                        <TextBlock Text="{Binding DomainControllersText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock Margin="16,48,16,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{Binding SourcesNote, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Visibility="{Binding SourcesNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          </Grid>
        </TabItem>
        <TabItem x:Name="TimelineTab" Header="{l:Tr EvtLock.TimelineHeading}">
          <ListView x:Name="TimelineList"
                    AutomationProperties.Name="{l:Tr EvtLock.TimelineHeading}"
                    ItemContainerStyle="{StaticResource EventLog.Row}"
                    ItemsSource="{Binding Timeline, Mode=OneWay}"
                    VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="150" Header="{l:Tr EvtLog.ColumnTime}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type evt:LockoutTimelineRow}">
                      <TextBlock Text="{Binding TimeText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="110" Header="{l:Tr EvtLock.ColumnDc}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type evt:LockoutTimelineRow}">
                      <TextBlock Text="{Binding HostText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="130" Header="{l:Tr EvtLock.ColumnKind}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type evt:LockoutTimelineRow}">
                      <TextBlock x:Name="KindText" Text="{Binding KindText, Mode=OneWay}" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLockout, Mode=OneWay}" Value="True">
                          <Setter TargetName="KindText" Property="FontWeight" Value="SemiBold" />
                          <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="110" Header="{l:Tr EvtLog.ColumnId}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type evt:LockoutTimelineRow}">
                      <TextBlock Text="{Binding EventIdText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="200" Header="{l:Tr EvtLock.ColumnSource}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type evt:LockoutTimelineRow}">
                      <TextBlock Text="{Binding SourceText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="320" Header="{l:Tr EvtLock.ColumnCodes}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type evt:LockoutTimelineRow}">
                      <TextBlock Text="{Binding CodeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CodeText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </TabItem>
        <TabItem x:Name="DomainControllersTab" Header="{l:Tr EvtLock.DomainControllersHeading}">
          <DockPanel>
            <Expander Margin="0,6,0,0"
                      DockPanel.Dock="Bottom"
                      Header="{l:Tr EvtLog.HostsHeading}"
                      IsExpanded="{Binding HasHostProblems, Mode=OneWay}">
              <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl Focusable="False" ItemTemplate="{StaticResource EventLog.HostTemplate}" ItemsSource="{Binding Hosts, Mode=OneWay}" />
              </ScrollViewer>
            </Expander>
            <ListView x:Name="DomainControllersList"
                      AutomationProperties.Name="{l:Tr EvtLock.DomainControllersHeading}"
                      ItemContainerStyle="{StaticResource EventLog.Row}"
                      ItemsSource="{Binding DomainControllerRows, Mode=OneWay}">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="110" Header="{l:Tr EvtLock.ColumnDc}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding HostText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="190" Header="{l:Tr EvtLock.ColumnRoles}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock Text="{Binding RolesText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="150" Header="{l:Tr EvtLock.ColumnLocked}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock Text="{Binding LockedText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="170" Header="{l:Tr EvtLock.ColumnBadPwdCount}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock Text="{Binding BadPasswordCountText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="150" Header="{l:Tr EvtLock.ColumnBadPasswordTime}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock Text="{Binding BadPasswordTimeText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="150" Header="{l:Tr EvtLock.ColumnLastLogon}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock Text="{Binding LastLogonText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="180" Header="{l:Tr EvtLock.ColumnRecords}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock Text="{Binding RecordsText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="320" Header="{l:Tr EvtLog.ColumnCoverage}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:LockoutDcRowViewModel}">
                        <TextBlock Text="{Binding CoverageText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CoverageText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="AuditTab" Header="{l:Tr EvtLock.AuditHeading}">
          <DockPanel>
            <TextBlock Margin="0,0,0,6" DockPanel.Dock="Top" Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr EvtLock.AuditHint}" TextWrapping="Wrap" />
            <ListView x:Name="AuditList"
                      AutomationProperties.Name="{l:Tr EvtLock.AuditHeading}"
                      ItemsSource="{Binding AuditRows, Mode=OneWay}">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="110" Header="{l:Tr EvtLock.ColumnDc}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:AuditEvidenceRow}">
                        <TextBlock Text="{Binding HostText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="140" Header="{l:Tr EvtLog.ColumnId}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:AuditEvidenceRow}">
                        <TextBlock Text="{Binding EventText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="240" Header="{l:Tr EvtLock.ColumnSubcategory}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:AuditEvidenceRow}">
                        <TextBlock Text="{Binding SubcategoryText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubcategoryText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="300" Header="{l:Tr EvtLog.ColumnState}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:AuditEvidenceRow}">
                        <TextBlock x:Name="StateText" Text="{Binding StateText, Mode=OneWay}" TextWrapping="Wrap" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsProbablyNotAudited, Mode=OneWay}" Value="True">
                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="330">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type evt:AuditEvidenceRow}">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsProbablyNotAudited, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                          <Button Margin="0,0,6,0"
                                  Command="{Binding DataContext.ShowInModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Mode=OneWay}"
                                  Content="{l:Tr EvtLock.ShowInModel}" />
                          <Button Command="{Binding DataContext.OpenGroupPolicyDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Mode=OneWay}"
                                  Content="{l:Tr EvtLock.GroupPolicyDiagnostics}" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
      </TabControl>

      <gp:PaneSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- The selected source and the pivot to its computer -->
      <Border Grid.Column="2" Padding="12,8" Style="{StaticResource Ad.Card}">
        <ScrollViewer x:Name="SourceScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SourceDetails" DataContext="{Binding SelectedSource, Mode=OneWay}">
            <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding KindText, Mode=OneWay}" />
            <TextBlock x:Name="SourceValueText"
                       Margin="0,0,0,6"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding Value, Mode=OneWay}"
                       TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource EventLog.Text}">
              <Run Text="{l:Tr EvtLock.ColumnFailures}" />
              <Run Text=": " />
              <Run Text="{Binding FailuresText, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{l:Tr EvtLock.ColumnBadPasswords}" />
              <Run Text=": " />
              <Run Text="{Binding BadPasswordsText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource EventLog.Text}">
              <Run Text="{Binding FirstText, Mode=OneWay}" />
              <Run Text=" – " />
              <Run Text="{Binding LastText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Style="{StaticResource EventLog.Text}"
                       Text="{Binding ProxyText, Mode=OneWay}"
                       Visibility="{Binding IsLikelyProxy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
            <TextBlock Style="{StaticResource EventLog.Text}"
                       Text="{Binding DomainControllerText, Mode=OneWay}"
                       Visibility="{Binding DomainControllerText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
            <TextBlock Style="{StaticResource EventLog.Text}"
                       Text="{Binding RelatedText, Mode=OneWay}"
                       Visibility="{Binding RelatedText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
            <TextBlock Style="{StaticResource EventLog.Heading}" Text="{l:Tr EvtLock.ColumnCodes}" />
            <TextBlock x:Name="SourceCodesText" Style="{StaticResource EventLog.Text}" Text="{Binding CodesText, Mode=OneWay}" />

            <TextBlock Style="{StaticResource EventLog.Heading}" Text="{l:Tr EvtLock.PivotHeadingLabel}" />
            <WrapPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Button x:Name="PivotButton" Margin="0,0,6,4" Command="{Binding PivotCommand}" Content="{l:Tr EvtLock.Pivot}" />
              <Button x:Name="OpenRemoteButton"
                      Margin="0,0,6,4"
                      Command="{Binding OpenRemoteActionsCommand}"
                      Content="{l:Tr EvtLock.OpenRemote}"
                      Visibility="{Binding CanOpenRemoteActions, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
            </WrapPanel>
            <StackPanel x:Name="PivotPanel" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <TextBlock x:Name="PivotHeadingText"
                         FontWeight="SemiBold"
                         Text="{Binding PivotHeading, Mode=OneWay}"
                         TextWrapping="Wrap"
                         Visibility="{Binding PivotHeading, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
              <ItemsControl x:Name="PivotLinesList"
                            AutomationProperties.LiveSetting="Polite"
                            Focusable="False"
                            ItemsSource="{Binding PivotLines, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Style="{StaticResource EventLog.Text}" Text="{Binding Mode=OneWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
