<!-- "Uruchom ponownie…" (RestartComputerViewModel, modal, K1 design note 4.5): delay, the message shown to the logged-on
     users, "close applications without asking" and, for a server or a DC, the computer name typed as confirmation. -->
<Window x:Class="AdMng.App.Computers.RestartComputerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="560"
        MinWidth="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="ConfirmButton"
                Command="{Binding ConfirmCommand}"
                Content="{l:Tr RemoteActions.RestartConfirm}"
                IsDefault="True"
                Style="{StaticResource Ad.DangerDialogButton}" />
        <Button x:Name="CancelButton"
                Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <StackPanel Margin="24,18,24,16">
      <TextBlock Style="{StaticResource Ad.Title}" Text="{Binding WindowTitle, Mode=OneWay}" />
      <TextBlock x:Name="SummaryText"
                 Margin="0,6,0,0"
                 AutomationProperties.LiveSetting="Polite"
                 Text="{Binding Summary, Mode=OneWay}"
                 TextWrapping="Wrap" />

      <DockPanel Margin="0,16,0,0">
        <TextBox x:Name="DelayBox"
                 Width="90"
                 HorizontalContentAlignment="Right"
                 AutomationProperties.Name="{l:Tr RemoteActions.RestartDelay}"
                 DockPanel.Dock="Right"
                 Text="{Binding DelayMinutes, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock VerticalAlignment="Center" Text="{l:Tr RemoteActions.RestartDelay}" />
      </DockPanel>

      <DockPanel Margin="0,14,0,4">
        <TextBlock x:Name="MessageLengthText"
                   DockPanel.Dock="Right"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding MessageLength, Mode=OneWay}" />
        <TextBlock Text="{l:Tr RemoteActions.RestartMessage}" />
      </DockPanel>
      <TextBox x:Name="RestartMessageBox"
               Height="96"
               AcceptsReturn="True"
               AutomationProperties.Name="{l:Tr RemoteActions.RestartMessage}"
               Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />

      <CheckBox x:Name="ForceBox"
                Margin="0,12,0,0"
                Content="{l:Tr RemoteActions.RestartForce}"
                IsChecked="{Binding Force}" />

      <!-- A server or a domain controller: the name is typed. -->
      <StackPanel Margin="0,16,0,0" Visibility="{Binding NeedsTypedName, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Text="{Binding TypeNamePrompt, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBox x:Name="TypedNameBox"
                 Margin="0,6,0,0"
                 AutomationProperties.Name="{Binding TypeNamePrompt, Mode=OneWay}"
                 Text="{Binding TypedName, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <DockPanel Margin="0,12,0,0" Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock Margin="0,1,8,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Warning}" />
        <TextBlock x:Name="ErrorText"
                   AutomationProperties.LiveSetting="Polite"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding Error, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </StackPanel>
  </DockPanel>
</Window>
