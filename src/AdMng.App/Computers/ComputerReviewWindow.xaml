<!--
  "Przegląd komputerów" (ComputerReviewViewModel, modeless, one per connection window, K1 design note 4.5): scope as in the
  account review, parameters and reports, "Sprawdź" (F5) streams one paged query, tiles per report (one tile per release of
  the releases report), the list of the selected tile with its own columns (built by the code-behind from
  ViewModel.Columns) and a details pane. Every change goes through the change plan; the results exist only in memory.
-->
<Window x:Class="AdMng.App.Computers.ComputerReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:AdMng.Presentation.Computers;assembly=AdMng.Presentation"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1320"
        Height="860"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- Commands for the column headers, the context menu and key bindings, independent of their DataContext. -->
    <c:BindingProxy x:Key="ReviewProxy" Data="{Binding}" />

    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DaysBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="64" />
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="ReviewRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
    </Style>

    <!-- The name column: the type icon (workstation, server, DC, disabled) and the name; the DN as tooltip. -->
    <DataTemplate x:Key="NameCell" DataType="{x:Type cv:ComputerReviewRowViewModel}">
      <DockPanel ToolTip="{Binding Dn, Mode=OneWay}">
        <c:ObjectIconView Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          DockPanel.Dock="Left"
                          Icon="{Binding Icon, Mode=OneWay}"
                          Size="16" />
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding Name, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </DataTemplate>

    <!-- A tile: area, number of computers, report (or release); the accent marks a problem report with findings. -->
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type cv:ComputerReportTileViewModel}">
      <Grid Width="182" Height="76" ToolTip="{Binding Hint, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Accent"
                Margin="0,4"
                Background="Transparent"
                CornerRadius="2" />
        <StackPanel Grid.Column="1" Margin="10,4,6,4">
          <TextBlock FontSize="11"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding AreaTitle, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="CountText"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Text="{Binding CountText, Mode=OneWay}" />
          <TextBlock Text="{Binding Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasFindings, Mode=OneWay}" Value="True" />
            <Condition Binding="{Binding IsProblem, Mode=OneWay}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasFindings, Mode=OneWay}" Value="True" />
            <Condition Binding="{Binding IsProblem, Mode=OneWay}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Accent" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding HasFindings, Mode=OneWay}" Value="False">
          <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RunCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Footer: progress, "stan na godz.", selection, Close. -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <Button x:Name="CloseButton"
                Command="{Binding CloseCommand}"
                Content="{l:Tr Common.Close}"
                DockPanel.Dock="Right"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ProgressBar x:Name="RunProgress"
                       Width="60"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock x:Name="StatusText"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding StatusText, Mode=OneWay}" />
          <TextBlock x:Name="SelectionText"
                     Margin="16,0,0,0"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding SelectionText, Mode=OneWay}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Scope and Check / Stop. -->
    <Grid Margin="16,12,16,0" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource Label}" Text="{l:Tr AccountReview.ScopeLabel}" />
      <ComboBox x:Name="ScopeKindBox"
                Grid.Column="1"
                MinWidth="260"
                AutomationProperties.Name="{l:Tr AccountReview.ScopeLabel}"
                DisplayMemberPath="Text"
                ItemsSource="{Binding ScopeKinds, Mode=OneWay}"
                SelectedItem="{Binding ScopeKind}" />
      <DockPanel Grid.Column="2" Margin="12,0,12,0">
        <Button x:Name="ChooseScopeButton"
                Command="{Binding BrowseScopeCommand}"
                Content="{l:Tr AccountReview.ChooseScope}"
                DockPanel.Dock="Right"
                Visibility="{Binding NeedsScopeTarget, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <ComboBox x:Name="SavedViewBox"
                  MinWidth="220"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="{l:Tr AccountReview.SavedViewLabel}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding SavedViews, Mode=OneWay}"
                  SelectedItem="{Binding SavedView}"
                  Visibility="{Binding IsViewScope, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <TextBlock x:Name="ScopeText"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Text="{Binding ScopeText, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ScopeDn, Mode=OneWay}"
                   Visibility="{Binding IsViewScope, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
      </DockPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button x:Name="StopButton"
                Margin="0,0,8,0"
                Command="{Binding StopCommand}"
                Content="{l:Tr Common.Stop}"
                Style="{StaticResource Ad.CollapsedWhenDisabledButton}" />
        <Button x:Name="RunButton"
                MinWidth="120"
                Command="{Binding RunCommand}"
                Content="{l:Tr ComputerReview.Run}"
                Style="{StaticResource Ad.AccentDialogButton}" />
      </StackPanel>
    </Grid>

    <!-- Session ended (the window belongs to the previous session), the run failed, the catalogue is old. -->
    <Border x:Name="SessionEndedBar"
            Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding SessionEndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock Text="{Binding SessionEndedMessage, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>
    <Border x:Name="ErrorBar"
            Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock x:Name="ErrorText"
                 AutomationProperties.LiveSetting="Assertive"
                 Text="{Binding Error, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Border>
    <Border x:Name="CatalogStaleBar"
            Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding IsCatalogStale, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <TextBlock Text="{Binding CatalogStaleText, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>

    <!-- Parameters and reports. -->
    <Expander x:Name="ParametersExpander"
              Margin="16,10,16,0"
              DockPanel.Dock="Top"
              Header="{l:Tr ComputerReview.Parameters}"
              IsExpanded="True">
      <StackPanel Margin="0,8,0,0">
        <DockPanel>
          <TextBlock x:Name="CatalogText"
                     VerticalAlignment="Center"
                     DockPanel.Dock="Right"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding CatalogText, Mode=OneWay}" />
          <WrapPanel>
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr ComputerReview.InactiveDays}" />
            <TextBox x:Name="InactiveDaysBox"
                     AutomationProperties.Name="{l:Tr ComputerReview.InactiveDays}"
                     Style="{StaticResource DaysBox}"
                     Text="{Binding InactiveDays, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr ComputerReview.EndingSoonDays}" />
            <TextBox x:Name="EndingSoonDaysBox"
                     AutomationProperties.Name="{l:Tr ComputerReview.EndingSoonDays}"
                     Style="{StaticResource DaysBox}"
                     Text="{Binding EndingSoonDays, UpdateSourceTrigger=PropertyChanged}" />
          </WrapPanel>
        </DockPanel>
        <TextBlock Margin="0,10,0,4"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr ComputerReview.Reports}" />
        <ItemsControl x:Name="ReportOptionsList" Focusable="False" ItemsSource="{Binding ReportOptions, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type cv:ComputerReportOptionViewModel}">
              <CheckBox Width="250"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                        Content="{Binding Title, Mode=OneWay}"
                        IsChecked="{Binding IsEnabled}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>

    <!-- Tiles: one per report of the run (one per release for the releases report); the selected one shows its list. -->
    <ListBox x:Name="TilesList"
             MaxHeight="190"
             Margin="16,10,16,0"
             AutomationProperties.Name="{l:Tr ComputerReview.Reports}"
             DockPanel.Dock="Top"
             ItemTemplate="{StaticResource TileTemplate}"
             ItemsSource="{Binding Tiles, Mode=OneWay}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectedItem="{Binding SelectedTile}"
             Visibility="{Binding HasRun, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneWay}" />
          <Setter Property="Margin" Value="0,0,6,6" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>

    <!-- The actions of the selection (or the list). -->
    <WrapPanel x:Name="ActionsPanel"
               Margin="16,10,16,0"
               DockPanel.Dock="Top"
               Visibility="{Binding HasRun, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <Button x:Name="PropertiesButton"
              Command="{Binding OpenCommand}"
              Content="{l:Tr Commands.Properties}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="BatchEditButton"
              Command="{Binding BatchEditCommand}"
              Content="{l:Tr Commands.BatchEdit}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="ExportButton"
              Command="{Binding ExportCsvCommand}"
              Content="{l:Tr ComputerReview.ExportCsv}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="ExactLastLogonButton"
              Command="{Binding ReadExactLastLogonCommand}"
              Content="{l:Tr ComputerReview.ExactLastLogon}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="ResolveSitesButton"
              Command="{Binding ResolveSitesCommand}"
              Content="{l:Tr ComputerReview.ResolveSites}"
              Style="{StaticResource ActionButton}"
              ToolTip="{l:Tr ComputerReview.SitesTooltip}"
              Visibility="{Binding CanResolveSites, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <Button x:Name="RemoteActionsButton"
              Command="{Binding RemoteActionsCommand}"
              Content="{l:Tr Computers.RemoteActionsCommand}"
              Style="{StaticResource ActionButton}"
              Visibility="{Binding CanUseRemote, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <Button x:Name="RemoteDesktopButton"
              Command="{Binding RemoteDesktopCommand}"
              Content="{l:Tr Computers.RemoteDesktop}"
              Style="{StaticResource ActionButton}"
              Visibility="{Binding CanUseTools, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <Button x:Name="PingButton"
              Command="{Binding PingCommand}"
              Content="{l:Tr Computers.Ping}"
              Style="{StaticResource ActionButton}"
              Visibility="{Binding CanUseRemote, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <Button x:Name="SetOwnerButton"
              Command="{Binding SetOwnerCommand}"
              Content="{l:Tr ComputerReview.SetOwner}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="DisableButton"
              Command="{Binding DisableCommand}"
              Content="{l:Tr Commands.Disable}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="MoveButton"
              Command="{Binding MoveCommand}"
              Content="{l:Tr Commands.Move}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="ResetAccountButton"
              Command="{Binding ResetAccountCommand}"
              Content="{l:Tr Computers.ResetAccountCommand}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="DeleteButton"
              Command="{Binding DeleteCommand}"
              Content="{l:Tr Commands.Delete}"
              Style="{StaticResource ActionButton}" />
    </WrapPanel>

    <TextBlock x:Name="ListHintText"
               Margin="16,0,16,6"
               DockPanel.Dock="Top"
               Style="{StaticResource Ad.SecondaryText}"
               Text="{Binding ListHint, Mode=OneWay}"
               TextWrapping="Wrap"
               Visibility="{Binding ListHint, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />

    <!-- The list of the selected tile and the details of the selected computer. -->
    <Grid Margin="16,4,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="340" MinWidth="220" />
      </Grid.ColumnDefinitions>
      <ListView x:Name="ItemsList"
                AutomationProperties.Name="{Binding WindowTitle, Mode=OneWay}"
                ItemContainerStyle="{StaticResource ReviewRowStyle}"
                ItemsSource="{Binding Items, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem}"
                SelectionChanged="OnItemsSelectionChanged"
                SelectionMode="Extended"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding Data.OpenCommand, Source={StaticResource ReviewProxy}}" />
        </ListView.InputBindings>
        <ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Command="{Binding Data.OpenCommand, Source={StaticResource ReviewProxy}}"
                      FontWeight="SemiBold"
                      Header="{l:Tr Commands.Properties}"
                      InputGestureText="Enter" />
            <MenuItem Command="{Binding Data.RemoteActionsCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Computers.RemoteActionsCommand}" />
            <MenuItem Command="{Binding Data.RemoteDesktopCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Computers.RemoteDesktop}" />
            <MenuItem Command="{Binding Data.PingCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Computers.Ping}" />
            <Separator />
            <MenuItem Command="{Binding Data.BatchEditCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Commands.BatchEdit}" />
            <MenuItem Command="{Binding Data.ExportCsvCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr ComputerReview.ExportCsv}" />
            <Separator />
            <MenuItem Command="{Binding Data.DisableCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Commands.Disable}" />
            <MenuItem Command="{Binding Data.MoveCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Commands.Move}" />
            <MenuItem Command="{Binding Data.ResetAccountCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Computers.ResetAccountCommand}" />
            <MenuItem Command="{Binding Data.DeleteCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Commands.Delete}" />
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView x:Name="ItemsGrid" AllowsColumnReorder="False" />
        </ListView.View>
      </ListView>
      <ProgressBar Height="3"
                   VerticalAlignment="Top"
                   IsIndeterminate="True"
                   Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <TextBlock x:Name="EmptyHint"
                 Margin="0,60,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr ComputerReview.Empty}"
                 Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <TextBlock x:Name="NotRunHint"
                 MaxWidth="520"
                 Margin="0,60,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr ComputerReview.NotRun}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasRun, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />

      <GridSplitter Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    ResizeBehavior="PreviousAndNext" />

      <!-- Details of the selected computer: facts, findings, the catalogue row. -->
      <Border Grid.Column="2" Style="{StaticResource Ad.Card}">
        <DockPanel>
          <TextBlock Margin="0,0,0,6"
                     DockPanel.Dock="Top"
                     Style="{StaticResource Ad.SectionHeader}"
                     Text="{l:Tr ComputerReview.Details}" />
          <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DetailsList" Focusable="False" ItemsSource="{Binding Details, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type cv:ComputerDetailViewModel}">
                  <StackPanel Margin="0,0,0,6">
                    <TextBlock FontSize="11"
                               Style="{StaticResource Ad.SecondaryText}"
                               Text="{Binding Label, Mode=OneWay}" />
                    <TextBox Style="{StaticResource Ad.SelectableText}" Text="{Binding Value, Mode=OneWay}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
