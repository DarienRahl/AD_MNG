<!--
  Design tokens of the interface renewal (track V, docs/dev/v-interface-renewal.md 4.2 and 4.3): the values the Fluent
  theme does not have. Merged into App.Resources before Controls.xaml; views and styles read them with StaticResource
  (a token never changes while the application runs).

  Spacing (Thickness)      Ad.Space.Page 16,12 (page margin) · Ad.Space.Card 12 (card padding) ·
                           Ad.Space.Toolbar 4,2 (padding of the toolbar card) · Ad.Space.Panel 4 (padding of a workspace panel)
  Density (Double)         Ad.Size.Control 28 · Ad.Size.Row 26 · Ad.Size.ColumnHeader 28 · Ad.Size.PointerTarget 24 ·
                           Ad.Size.PanelGap 8 (gap between workspace panels = width of their splitters)
  Type ramp (Double)       Ad.FontSize.Caption 12 · Ad.FontSize.Compact 12 (list rows, tree rows, details values) ·
                           Ad.FontSize.Body 14 · Ad.FontSize.Subtitle 20 · Ad.FontSize.Title 28
  Radii (CornerRadius)     Ad.Radius.Control 4 · Ad.Radius.Card 8 (cards, panels, popups, toasts) · Ad.Radius.Pill 12 (at height 24)
  Surfaces (Border styles) Ad.Surface.Panel (a workspace panel on the window background) · Ad.Surface.Toolbar (the toolbar card)

  Rules:
  * No colour token. Light, dark and High Contrast are switched while the application runs, so every brush stays
    {DynamicResource <Fluent key>} where it is used; the set of Fluent brush keys in use is kept closed by
    XamlSourceTests.FluentBrushKeysInUse_AreTheDocumentedSet. Never alias a key with a StaticResource element as a
    dictionary entry (x:Key + ResourceKey): it is resolved once, so it would keep the brush of the old theme, and
    the markup compiler of the SDK writes a wrong key table for such an entry.
  * No duration and no easing here: motion tokens live in Themes/Motion.xaml.
  * Only string keys with the prefix "Ad." (see Controls.xaml).
  * A token that overrides a Fluent key (the column header height) is applied with b:Density, not with a resource
    entry under the Fluent key.
  * Why a panel has padding 4 with radius 8: children are rectangles and WPF does not clip them to the rounded
    corners; with at least 2.4 px of padding the corner of a child stays inside the rounded outline. Nothing here
    uses an opacity mask, a clip geometry or an effect, which would draw the lists through an intermediate surface.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Spacing (4 px grid) -->
  <Thickness x:Key="Ad.Space.Page">16,12</Thickness>
  <Thickness x:Key="Ad.Space.Card">12</Thickness>
  <Thickness x:Key="Ad.Space.Toolbar">4,2</Thickness>
  <Thickness x:Key="Ad.Space.Panel">4</Thickness>

  <!-- Density: the compact sizes of an administrator's tool (the theme's own are 32, 40 and 32) -->
  <sys:Double x:Key="Ad.Size.Control">28</sys:Double>
  <sys:Double x:Key="Ad.Size.Row">26</sys:Double>
  <sys:Double x:Key="Ad.Size.ColumnHeader">28</sys:Double>
  <sys:Double x:Key="Ad.Size.PointerTarget">24</sys:Double>
  <sys:Double x:Key="Ad.Size.PanelGap">8</sys:Double>

  <!-- Type ramp: the theme's steps, plus the compact size -->
  <sys:Double x:Key="Ad.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="Ad.FontSize.Compact">12</sys:Double>
  <sys:Double x:Key="Ad.FontSize.Body">14</sys:Double>
  <sys:Double x:Key="Ad.FontSize.Subtitle">20</sys:Double>
  <sys:Double x:Key="Ad.FontSize.Title">28</sys:Double>

  <!-- Radii -->
  <CornerRadius x:Key="Ad.Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Ad.Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="Ad.Radius.Pill">12</CornerRadius>

  <!-- Surfaces: elevation 1 = fill and a 1 px stroke, no shadow (4.3) -->
  <Style x:Key="Ad.Surface.Panel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Ad.Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Ad.Space.Panel}" />
  </Style>

  <Style x:Key="Ad.Surface.Toolbar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Ad.Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Ad.Space.Toolbar}" />
  </Style>
</ResourceDictionary>
