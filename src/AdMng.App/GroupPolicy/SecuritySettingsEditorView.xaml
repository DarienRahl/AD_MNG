<!--
  "Ustawienia zabezpieczeń" of one GPO (SecuritySettingsEditorViewModel, K4): local groups (Restricted Groups and GPP local
  groups side by side), user rights, account policies and security options, audit (legacy categories and advanced
  subcategories) and services, with "Zapisz zmiany…" (one plan through the change plan preview).
-->
<UserControl x:Class="AdMng.App.GroupPolicy.SecuritySettingsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:gp="clr-namespace:AdMng.App.GroupPolicy"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:ss="clr-namespace:AdMng.Presentation.GroupPolicy.SecuritySettings;assembly=AdMng.Presentation"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
    <c:BindingProxy x:Key="Editor" Data="{Binding}" />
    <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style x:Key="TallRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,1" />
    </Style>
    <Style x:Key="PanelHeader" TargetType="TextBlock" BasedOn="{StaticResource Ad.SectionHeader}">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="FieldHeader" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,8,0,3" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A principal: its name, a warning glyph for a typed name (resolved on each client); the SID or the hint as tooltip. -->
    <DataTemplate x:Key="PrincipalTemplate" DataType="{x:Type ss:SecurityPrincipalViewModel}">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip, Mode=OneWay}">
        <TextBlock Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Warning}"
                   Visibility="{Binding IsTypedName, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName, Mode=OneWay}" />
      </StackPanel>
    </DataTemplate>

    <!-- The changed mark of a row. -->
    <DataTemplate x:Key="ChangedMarkTemplate" DataType="{x:Type ss:SecuritySettingRowBase}">
      <TextBlock AutomationProperties.Name="{l:Tr SecSettings.ChangedMark}"
                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                 Style="{StaticResource Ad.GlyphText}"
                 Text="{x:Static c:Glyphs.Edit}"
                 ToolTip="{l:Tr SecSettings.ChangedMark}"
                 Visibility="{Binding IsChanged, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
    </DataTemplate>

    <!-- One audit row: name, state, changed mark. -->
    <DataTemplate x:Key="AuditRowTemplate" DataType="{x:Type ss:AuditRowViewModel}">
      <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ChangedMarkTemplate}" />
        <TextBlock Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}" TextWrapping="Wrap" />
        <ComboBox Grid.Column="2"
                  AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                  DisplayMemberPath="Label"
                  IsEnabled="{Binding CanEdit, Mode=OneWay}"
                  ItemsSource="{Binding States, Mode=OneWay}"
                  SelectedItem="{Binding SelectedState}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="8,6,8,8">
    <!-- Header -->
    <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="SaveButton" Margin="0,0,6,0" Command="{Binding SaveCommand}" Content="{l:Tr SecSettings.Save}" Style="{StaticResource AccentButtonStyle}" />
        <Button x:Name="DiscardButton" Margin="0,0,6,0" Command="{Binding DiscardCommand}" Content="{l:Tr SecSettings.Discard}" />
        <Button x:Name="RefreshButton"
                AutomationProperties.Name="{l:Tr GroupPolicy.RefreshCommand}"
                Command="{Binding RefreshCommand}"
                Content="{x:Static c:Glyphs.Refresh}"
                Style="{StaticResource Ad.IconButton}"
                ToolTip="{l:Tr GroupPolicy.RefreshCommand}" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <c:ObjectIconView Margin="0,0,8,0" VerticalAlignment="Center" Icon="GroupPolicy" Size="18" />
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ChangedText"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Text="{Binding SelectionText, Mode=OneWay}" />
      </StackPanel>
    </DockPanel>
    <gp:GroupPolicyBanners DockPanel.Dock="Top" />
    <Border x:Name="ConflictBar"
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding ConflictNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding ConflictNote, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>
    <Border x:Name="FileBar"
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding FileNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock Text="{Binding FileNote, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>

    <TabControl x:Name="Pages">
      <!-- 1. Grupy lokalne -->
      <TabItem x:Name="GroupsTab" Header="{l:Tr SecSettings.TabGroups}">
        <DockPanel Margin="4,8,4,4">
          <Border Margin="0,0,0,8" Padding="12,6" DockPanel.Dock="Top" Style="{StaticResource Ad.Card}">
            <DockPanel>
              <TextBlock Margin="0,1,10,0"
                         VerticalAlignment="Top"
                         DockPanel.Dock="Left"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                         Style="{StaticResource Ad.GlyphText}"
                         Text="{x:Static c:Glyphs.Info}" />
              <TextBlock x:Name="PrecedenceText" Text="{l:Tr SecSettings.PrecedenceNote}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="320" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Restricted Groups -->
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="{l:Tr SecSettings.RestrictedGroupsHeader}" />
              <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                <Button x:Name="RemoveRestrictedGroupButton" Margin="6,0,0,0" Command="{Binding RemoveRestrictedGroupCommand}" Content="{l:Tr SecSettings.RemoveGroup}" DockPanel.Dock="Right" />
                <Button x:Name="PickRestrictedGroupButton" Margin="6,0,0,0" Command="{Binding PickRestrictedGroupCommand}" Content="{l:Tr SecSettings.PickGroup}" DockPanel.Dock="Right" />
                <Button x:Name="AddRestrictedGroupButton" Margin="6,0,0,0" Command="{Binding AddRestrictedGroupCommand}" Content="{l:Tr SecSettings.AddGroup}" DockPanel.Dock="Right" />
                <ComboBox x:Name="NewRestrictedGroupBox"
                          AutomationProperties.Name="{l:Tr SecSettings.GroupPlaceholder}"
                          DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsEnabled="{Binding CanEditTemplate, Mode=OneWay}"
                          ItemsSource="{Binding LocalGroupChoices, Mode=OneWay}"
                          Text="{Binding NewRestrictedGroupText, UpdateSourceTrigger=PropertyChanged}"
                          TextSearch.TextPath="DisplayName"
                          ToolTip="{l:Tr SecSettings.GroupPlaceholder}" />
              </DockPanel>
              <Border Margin="0,6,0,0" Padding="10,6" DockPanel.Dock="Bottom" Style="{StaticResource Ad.Card}">
                <Grid>
                  <TextBlock Style="{StaticResource Ad.SecondaryText}"
                             Text="{l:Tr SecSettings.SelectRestrictedGroup}"
                             Visibility="{Binding SelectedRestrictedGroup, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
                  <ContentControl x:Name="RestrictedGroupEditor" Content="{Binding SelectedRestrictedGroup, Mode=OneWay}" Focusable="False">
                    <ContentControl.ContentTemplate>
                      <DataTemplate DataType="{x:Type ss:RestrictedGroupRowViewModel}">
                        <StackPanel IsEnabled="{Binding CanEdit, Mode=OneWay}">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Group.DisplayName, Mode=OneWay}" ToolTip="{Binding Group.ToolTip, Mode=OneWay}" />
                          <CheckBox x:Name="MembersDefinedCheck" Margin="0,6,0,0" Content="{l:Tr SecSettings.MembersDefined}" IsChecked="{Binding MembersDefined}" />
                          <TextBlock Style="{StaticResource FieldHeader}" Text="{l:Tr SecSettings.MembersHeader}" />
                          <ListBox x:Name="RestrictedMembersList"
                                   MinHeight="40"
                                   MaxHeight="110"
                                   AutomationProperties.Name="{l:Tr SecSettings.MembersHeader}"
                                   IsEnabled="{Binding MembersDefined, Mode=OneWay}"
                                   ItemTemplate="{StaticResource PrincipalTemplate}"
                                   ItemsSource="{Binding Members, Mode=OneWay}" />
                          <DockPanel Margin="0,4,0,0">
                            <Button Margin="4,0,0,0"
                                    Command="{Binding Data.RemoveRestrictedMemberCommand, Source={StaticResource Editor}}"
                                    CommandParameter="{Binding SelectedItem, ElementName=RestrictedMembersList}"
                                    Content="{l:Tr SecSettings.Remove}"
                                    DockPanel.Dock="Right" />
                            <Button Margin="4,0,0,0" Command="{Binding Data.AddRestrictedMemberCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddFromDirectory}" DockPanel.Dock="Right" />
                            <Button Margin="4,0,0,0" Command="{Binding Data.AddRestrictedMemberByNameCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddByName}" DockPanel.Dock="Right" />
                            <ComboBox AutomationProperties.Name="{l:Tr SecSettings.PrincipalPlaceholder}"
                                      DisplayMemberPath="DisplayName"
                                      IsEditable="True"
                                      ItemsSource="{Binding Data.PrincipalChoices, Source={StaticResource Editor}}"
                                      Text="{Binding Data.NewRestrictedMemberText, Source={StaticResource Editor}, UpdateSourceTrigger=PropertyChanged}"
                                      TextSearch.TextPath="DisplayName"
                                      ToolTip="{l:Tr SecSettings.PrincipalPlaceholder}" />
                          </DockPanel>
                          <TextBlock Style="{StaticResource FieldHeader}" Text="{l:Tr SecSettings.MemberOfHeader}" />
                          <ListBox x:Name="RestrictedMemberOfList"
                                   MinHeight="40"
                                   MaxHeight="110"
                                   AutomationProperties.Name="{l:Tr SecSettings.MemberOfHeader}"
                                   ItemTemplate="{StaticResource PrincipalTemplate}"
                                   ItemsSource="{Binding MemberOf, Mode=OneWay}" />
                          <DockPanel Margin="0,4,0,0">
                            <Button Margin="4,0,0,0"
                                    Command="{Binding Data.RemoveRestrictedMemberOfCommand, Source={StaticResource Editor}}"
                                    CommandParameter="{Binding SelectedItem, ElementName=RestrictedMemberOfList}"
                                    Content="{l:Tr SecSettings.Remove}"
                                    DockPanel.Dock="Right" />
                            <Button Margin="4,0,0,0" Command="{Binding Data.AddRestrictedMemberOfCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddFromDirectory}" DockPanel.Dock="Right" />
                            <Button Margin="4,0,0,0" Command="{Binding Data.AddRestrictedMemberOfByNameCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddByName}" DockPanel.Dock="Right" />
                            <ComboBox AutomationProperties.Name="{l:Tr SecSettings.GroupPlaceholder}"
                                      DisplayMemberPath="DisplayName"
                                      IsEditable="True"
                                      ItemsSource="{Binding Data.LocalGroupChoices, Source={StaticResource Editor}}"
                                      Text="{Binding Data.NewRestrictedMemberOfText, Source={StaticResource Editor}, UpdateSourceTrigger=PropertyChanged}"
                                      TextSearch.TextPath="DisplayName"
                                      ToolTip="{l:Tr SecSettings.GroupPlaceholder}" />
                          </DockPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                </Grid>
              </Border>
              <ListView x:Name="RestrictedGroupList"
                        AutomationProperties.Name="{l:Tr SecSettings.RestrictedGroupsHeader}"
                        ItemContainerStyle="{StaticResource RowStyle}"
                        ItemsSource="{Binding RestrictedGroups, Mode=OneWay}"
                        SelectedItem="{Binding SelectedRestrictedGroup}">
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="24" CellTemplate="{StaticResource ChangedMarkTemplate}" />
                    <GridViewColumn Width="180" Header="{l:Tr SecSettings.ColumnGroup}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ss:RestrictedGroupRowViewModel}">
                          <ContentPresenter Content="{Binding Group, Mode=OneWay}" ContentTemplate="{StaticResource PrincipalTemplate}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200" DisplayMemberBinding="{Binding MembersText, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnMembers}" />
                    <GridViewColumn Width="160" DisplayMemberBinding="{Binding MemberOfText, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnMemberOf}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>

            <!-- GPP local groups -->
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="{l:Tr SecSettings.GppGroupsHeader}" />
              <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                <Button x:Name="RemoveGppGroupButton" Margin="6,0,0,0" Command="{Binding RemoveGppGroupCommand}" Content="{l:Tr SecSettings.RemoveGroup}" DockPanel.Dock="Right" />
                <Button x:Name="AddGppGroupButton" Margin="6,0,0,0" Command="{Binding AddGppGroupCommand}" Content="{l:Tr SecSettings.AddGroup}" DockPanel.Dock="Right" />
                <ComboBox x:Name="NewGppGroupBox"
                          AutomationProperties.Name="{l:Tr SecSettings.GroupPlaceholder}"
                          DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsEnabled="{Binding CanEditGroups, Mode=OneWay}"
                          ItemsSource="{Binding LocalGroupChoices, Mode=OneWay}"
                          Text="{Binding NewGppGroupText, UpdateSourceTrigger=PropertyChanged}"
                          TextSearch.TextPath="DisplayName"
                          ToolTip="{l:Tr SecSettings.GroupPlaceholder}" />
              </DockPanel>
              <Border Margin="0,6,0,0" Padding="10,6" DockPanel.Dock="Bottom" Style="{StaticResource Ad.Card}">
                <Grid>
                  <TextBlock Style="{StaticResource Ad.SecondaryText}"
                             Text="{l:Tr SecSettings.SelectGppGroup}"
                             Visibility="{Binding SelectedGppGroup, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
                  <ContentControl x:Name="GppGroupEditor" Content="{Binding SelectedGppGroup, Mode=OneWay}" Focusable="False">
                    <ContentControl.ContentTemplate>
                      <DataTemplate DataType="{x:Type ss:GppGroupItemViewModel}">
                        <StackPanel IsEnabled="{Binding CanEdit, Mode=OneWay}">
                          <TextBlock FontWeight="SemiBold" Text="{Binding GroupName, Mode=OneWay}" ToolTip="{Binding GroupDetail, Mode=OneWay}" />
                          <WrapPanel Margin="0,2,0,0">
                            <TextBlock Margin="0,0,12,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Text="{l:Tr SecSettings.TargetingBadge}"
                                       Visibility="{Binding HasTargeting, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Text="{l:Tr SecSettings.DisabledBadge}"
                                       Visibility="{Binding IsDisabled, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                          </WrapPanel>
                          <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{l:Tr SecSettings.ColumnAction}" />
                            <ComboBox x:Name="GppActionBox"
                                      MinWidth="160"
                                      AutomationProperties.Name="{l:Tr SecSettings.ColumnAction}"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding Actions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedAction}" />
                          </StackPanel>
                          <CheckBox Margin="0,6,0,0" Content="{l:Tr SecSettings.DeleteAllUsers}" IsChecked="{Binding DeleteAllUsers}" />
                          <CheckBox Margin="0,2,0,0" Content="{l:Tr SecSettings.DeleteAllGroups}" IsChecked="{Binding DeleteAllGroups}" />
                          <TextBlock Style="{StaticResource FieldHeader}" Text="{l:Tr SecSettings.ColumnMemberChanges}" />
                          <ListBox x:Name="GppMembersList"
                                   MinHeight="40"
                                   MaxHeight="130"
                                   AutomationProperties.Name="{l:Tr SecSettings.ColumnMemberChanges}"
                                   ItemsSource="{Binding Members, Mode=OneWay}">
                            <ListBox.ItemTemplate>
                              <DataTemplate DataType="{x:Type ss:GppMemberViewModel}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Width="70" VerticalAlignment="Center" Style="{StaticResource Ad.SecondaryText}" Text="{Binding ActionText, Mode=OneWay}" />
                                  <ContentPresenter Content="{Binding Principal, Mode=OneWay}" ContentTemplate="{StaticResource PrincipalTemplate}" />
                                </StackPanel>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <DockPanel Margin="0,4,0,0">
                            <Button Margin="4,0,0,0"
                                    Command="{Binding Data.RemoveGppMemberCommand, Source={StaticResource Editor}}"
                                    CommandParameter="{Binding SelectedItem, ElementName=GppMembersList}"
                                    Content="{l:Tr SecSettings.Remove}"
                                    DockPanel.Dock="Right" />
                            <Button Margin="4,0,0,0" Command="{Binding Data.AddGppMemberCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddFromDirectory}" DockPanel.Dock="Right" />
                            <Button Margin="4,0,0,0" Command="{Binding Data.AddGppMemberByNameCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddByName}" DockPanel.Dock="Right" />
                            <ComboBox AutomationProperties.Name="{l:Tr SecSettings.PrincipalPlaceholder}"
                                      DisplayMemberPath="DisplayName"
                                      IsEditable="True"
                                      ItemsSource="{Binding Data.PrincipalChoices, Source={StaticResource Editor}}"
                                      Text="{Binding Data.NewGppMemberText, Source={StaticResource Editor}, UpdateSourceTrigger=PropertyChanged}"
                                      TextSearch.TextPath="DisplayName"
                                      ToolTip="{l:Tr SecSettings.PrincipalPlaceholder}" />
                          </DockPanel>
                          <CheckBox Margin="0,4,0,0" Content="{l:Tr SecSettings.GppNewMemberRemoves}" IsChecked="{Binding Data.NewGppMemberRemoves, Source={StaticResource Editor}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                </Grid>
              </Border>
              <ListView x:Name="GppGroupList"
                        AutomationProperties.Name="{l:Tr SecSettings.GppGroupsHeader}"
                        ItemContainerStyle="{StaticResource RowStyle}"
                        ItemsSource="{Binding GppGroups, Mode=OneWay}"
                        SelectedItem="{Binding SelectedGppGroup}">
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="24" CellTemplate="{StaticResource ChangedMarkTemplate}" />
                    <GridViewColumn Width="170" Header="{l:Tr SecSettings.ColumnGroup}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ss:GppGroupItemViewModel}">
                          <StackPanel Orientation="Horizontal" ToolTip="{Binding GroupDetail, Mode=OneWay}">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Style="{StaticResource Ad.GlyphText}"
                                       Text="{x:Static c:Glyphs.Filter}"
                                       ToolTip="{l:Tr SecSettings.TargetingBadge}"
                                       Visibility="{Binding HasTargeting, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Style="{StaticResource Ad.GlyphText}"
                                       Text="{x:Static c:Glyphs.Cancel}"
                                       ToolTip="{l:Tr SecSettings.DisabledBadge}"
                                       Visibility="{Binding IsDisabled, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding GroupName, Mode=OneWay}" />
                          </StackPanel>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="90" DisplayMemberBinding="{Binding SelectedAction.Label, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnAction}" />
                    <GridViewColumn Width="240" DisplayMemberBinding="{Binding MembersText, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnMemberChanges}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- 2. Prawa użytkownika -->
      <TabItem x:Name="RightsTab" Header="{l:Tr SecSettings.TabRights}">
        <Grid Margin="4,8,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="380" MinWidth="300" />
          </Grid.ColumnDefinitions>
          <ListView x:Name="RightList"
                    AutomationProperties.Name="{l:Tr SecSettings.TabRights}"
                    ItemContainerStyle="{StaticResource RowStyle}"
                    ItemsSource="{Binding UserRights, Mode=OneWay}"
                    SelectedItem="{Binding SelectedRight}"
                    VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="24" CellTemplate="{StaticResource ChangedMarkTemplate}" />
                <GridViewColumn Width="400" Header="{l:Tr SecSettings.ColumnRight}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type ss:UserRightRowViewModel}">
                      <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Constant, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="320" Header="{l:Tr SecSettings.ColumnHolders}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type ss:UserRightRowViewModel}">
                      <TextBlock Text="{Binding HoldersText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HoldersText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <Border Grid.Column="2" Padding="12,8" Style="{StaticResource Ad.Card}">
            <Grid>
              <TextBlock Style="{StaticResource Ad.SecondaryText}"
                         Text="{l:Tr SecSettings.SelectRight}"
                         TextWrapping="Wrap"
                         Visibility="{Binding SelectedRight, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
              <ContentControl x:Name="RightEditor" Content="{Binding SelectedRight, Mode=OneWay}" Focusable="False">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="{x:Type ss:UserRightRowViewModel}">
                    <DockPanel IsEnabled="{Binding CanEdit, Mode=OneWay}">
                      <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding Constant, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Ad.SecondaryText}"
                                   Text="{l:Tr SecSettings.UnknownRight}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsKnown, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
                        <CheckBox x:Name="DefineRightCheck" Margin="0,8,0,0" Content="{l:Tr SecSettings.DefineRight}" IsChecked="{Binding IsDefined}" />
                        <TextBlock Style="{StaticResource FieldHeader}" Text="{l:Tr SecSettings.HoldersHeader}" />
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Bottom">
                        <DockPanel Margin="0,4,0,0">
                          <Button Margin="4,0,0,0" Command="{Binding Data.AddRightHolderByNameCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddByName}" DockPanel.Dock="Right" />
                          <ComboBox AutomationProperties.Name="{l:Tr SecSettings.PrincipalPlaceholder}"
                                    DisplayMemberPath="DisplayName"
                                    IsEditable="True"
                                    ItemsSource="{Binding Data.PrincipalChoices, Source={StaticResource Editor}}"
                                    Text="{Binding Data.NewRightHolderText, Source={StaticResource Editor}, UpdateSourceTrigger=PropertyChanged}"
                                    TextSearch.TextPath="DisplayName"
                                    ToolTip="{l:Tr SecSettings.PrincipalPlaceholder}" />
                        </DockPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                          <Button Margin="0,0,4,0" Command="{Binding Data.AddRightHolderCommand, Source={StaticResource Editor}}" Content="{l:Tr SecSettings.AddFromDirectory}" />
                          <Button Command="{Binding Data.RemoveRightHolderCommand, Source={StaticResource Editor}}"
                                  CommandParameter="{Binding SelectedItem, ElementName=RightHoldersList}"
                                  Content="{l:Tr SecSettings.Remove}" />
                        </StackPanel>
                      </StackPanel>
                      <ListBox x:Name="RightHoldersList"
                               MinHeight="60"
                               AutomationProperties.Name="{l:Tr SecSettings.HoldersHeader}"
                               IsEnabled="{Binding IsDefined, Mode=OneWay}"
                               ItemTemplate="{StaticResource PrincipalTemplate}"
                               ItemsSource="{Binding Holders, Mode=OneWay}" />
                    </DockPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- 3. Zasady kont i opcje zabezpieczeń -->
      <TabItem x:Name="OptionsTab" Header="{l:Tr SecSettings.TabOptions}">
        <Grid Margin="4,8,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="180" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="360" />
          </Grid.ColumnDefinitions>
          <ListBox x:Name="OptionGroupList"
                   AutomationProperties.Name="{l:Tr SecSettings.TabOptions}"
                   DisplayMemberPath="Name"
                   ItemsSource="{Binding OptionGroups, Mode=OneWay}"
                   SelectedItem="{Binding SelectedOptionGroup}" />
          <DockPanel Grid.Column="2">
            <Border Margin="0,0,0,6"
                    Padding="12,6"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Ad.Card}"
                    Visibility="{Binding SelectedOptionGroup.Note, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}, FallbackValue=Collapsed}">
              <TextBlock x:Name="OptionGroupNote" Text="{Binding SelectedOptionGroup.Note, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
            </Border>

            <!-- Options of the group -->
            <Grid Visibility="{Binding IsRawGroupSelected, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ListView x:Name="OptionList"
                        AutomationProperties.Name="{l:Tr SecSettings.ColumnSetting}"
                        ItemContainerStyle="{StaticResource RowStyle}"
                        ItemsSource="{Binding Options, Mode=OneWay}"
                        SelectedItem="{Binding SelectedOption}">
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="24" CellTemplate="{StaticResource ChangedMarkTemplate}" />
                    <GridViewColumn Width="460" Header="{l:Tr SecSettings.ColumnSetting}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ss:SecurityOptionRowViewModel}">
                          <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name, Mode=OneWay}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="260" Header="{l:Tr SecSettings.ColumnValue}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ss:SecurityOptionRowViewModel}">
                          <TextBlock Text="{Binding ValueText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValueText, Mode=OneWay}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
              <Border Grid.Row="1" Margin="0,6,0,0" Padding="12,8" Style="{StaticResource Ad.Card}">
                <Grid>
                  <TextBlock Style="{StaticResource Ad.SecondaryText}"
                             Text="{l:Tr SecSettings.SelectOption}"
                             Visibility="{Binding SelectedOption, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
                  <ContentControl x:Name="OptionEditor" Content="{Binding SelectedOption, Mode=OneWay}" Focusable="False">
                    <ContentControl.ContentTemplate>
                      <DataTemplate DataType="{x:Type ss:SecurityOptionRowViewModel}">
                        <StackPanel IsEnabled="{Binding CanEdit, Mode=OneWay}">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" TextWrapping="Wrap" />
                          <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding KeyText, Mode=OneWay}" TextWrapping="Wrap" />
                          <CheckBox x:Name="DefineOptionCheck" Margin="0,8,0,0" Content="{l:Tr SecSettings.DefineOption}" IsChecked="{Binding IsDefined}" />
                          <StackPanel Margin="0,6,0,0" IsEnabled="{Binding IsDefined, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding UsesText, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                              <TextBox x:Name="OptionTextBox" MinWidth="220" AutomationProperties.Name="{Binding Name, Mode=OneWay}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                              <TextBlock Margin="10,0,0,0"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource Ad.SecondaryText}"
                                         Text="{Binding RangeText, Mode=OneWay}"
                                         Visibility="{Binding RangeText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding UsesMultiLine, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                              <TextBox MinLines="3"
                                       MaxHeight="140"
                                       AcceptsReturn="True"
                                       AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                                       Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                       VerticalScrollBarVisibility="Auto" />
                              <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr SecSettings.MultiTextHint}" />
                            </StackPanel>
                            <ComboBox MinWidth="260"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding Choices, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedChoice}"
                                      Visibility="{Binding UsesChoice, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                          </StackPanel>
                          <TextBlock Margin="0,6,0,0"
                                     AutomationProperties.LiveSetting="Polite"
                                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                     Text="{Binding Problem, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding Problem, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                </Grid>
              </Border>
            </Grid>

            <!-- Other template entries -->
            <DockPanel Visibility="{Binding IsRawGroupSelected, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
              <DockPanel Margin="0,6,0,0" DockPanel.Dock="Bottom" IsEnabled="{Binding CanEditTemplate, Mode=OneWay}">
                <Button x:Name="RemoveRawButton" Margin="6,0,0,0" Command="{Binding RemoveRawEntryCommand}" Content="{l:Tr SecSettings.RemoveRawEntry}" DockPanel.Dock="Right" />
                <Button x:Name="ReplaceRawButton" Margin="6,0,0,0" Command="{Binding ReplaceRawValueCommand}" Content="{l:Tr SecSettings.ReplaceRawValue}" DockPanel.Dock="Right" />
                <TextBox x:Name="RawValueBox" AutomationProperties.Name="{l:Tr SecSettings.ColumnValue}" Text="{Binding RawValueText, UpdateSourceTrigger=PropertyChanged}" />
              </DockPanel>
              <ListView x:Name="RawList"
                        AutomationProperties.Name="{l:Tr SecSettings.RawGroup}"
                        ItemContainerStyle="{StaticResource RowStyle}"
                        ItemsSource="{Binding RawEntries, Mode=OneWay}"
                        SelectedItem="{Binding SelectedRawEntry}">
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="24" CellTemplate="{StaticResource ChangedMarkTemplate}" />
                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding Section, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnSection}" />
                    <GridViewColumn Width="420" DisplayMemberBinding="{Binding Key, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnKey}" />
                    <GridViewColumn Width="200" DisplayMemberBinding="{Binding Value, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnValue}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- 4. Inspekcja -->
      <TabItem x:Name="AuditTab" Header="{l:Tr SecSettings.TabAudit}">
        <DockPanel Margin="4,8,4,4">
          <Border x:Name="AuditBar"
                  Margin="0,0,0,6"
                  DockPanel.Dock="Top"
                  Style="{StaticResource Ad.WarningBar}"
                  Visibility="{Binding AuditNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
            <TextBlock Text="{Binding AuditNote, Mode=OneWay}" TextWrapping="Wrap" />
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource PanelHeader}" Text="{l:Tr SecSettings.LegacyAuditHeader}" />
              <ItemsControl x:Name="LegacyAuditList" Focusable="False" ItemTemplate="{StaticResource AuditRowTemplate}" ItemsSource="{Binding LegacyAudit, Mode=OneWay}" />
              <TextBlock Margin="0,16,0,6" Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr SecSettings.AdvancedAuditHeader}" />
              <ItemsControl x:Name="AdvancedAuditList" Focusable="False" ItemsSource="{Binding AdvancedAuditCategories, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type ss:AuditCategoryViewModel}">
                    <StackPanel Margin="0,6,0,0">
                      <TextBlock Margin="0,0,0,2" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                      <ItemsControl Focusable="False" ItemTemplate="{StaticResource AuditRowTemplate}" ItemsSource="{Binding Rows, Mode=OneWay}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- 5. Usługi -->
      <TabItem x:Name="ServicesTab" Header="{l:Tr SecSettings.TabServices}">
        <DockPanel Margin="4,8,4,4">
          <TextBlock Margin="0,0,0,6" DockPanel.Dock="Top" Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr SecSettings.ServiceSecurityNote}" TextWrapping="Wrap" />
          <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top" IsEnabled="{Binding CanEditTemplate, Mode=OneWay}">
            <Button x:Name="RemoveServiceButton" Margin="6,0,0,0" Command="{Binding RemoveServiceCommand}" Content="{l:Tr SecSettings.RemoveService}" DockPanel.Dock="Right" />
            <Button x:Name="AddServiceButton" Margin="6,0,0,0" Command="{Binding AddServiceCommand}" Content="{l:Tr SecSettings.AddService}" DockPanel.Dock="Right" />
            <ComboBox x:Name="NewServiceModeBox"
                      MinWidth="140"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="{l:Tr SecSettings.ColumnStartMode}"
                      DisplayMemberPath="Label"
                      DockPanel.Dock="Right"
                      ItemsSource="{Binding ServiceModes, Mode=OneWay}"
                      SelectedItem="{Binding NewServiceMode}" />
            <Grid>
              <TextBox x:Name="NewServiceNameBox" AutomationProperties.Name="{l:Tr SecSettings.ServiceNamePlaceholder}" Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource Ad.HintText}"
                         Text="{l:Tr SecSettings.ServiceNamePlaceholder}"
                         Visibility="{Binding Text, ElementName=NewServiceNameBox, Converter={StaticResource Ad.EmptyToVisible}}" />
            </Grid>
          </DockPanel>
          <ListView x:Name="ServiceList"
                    AutomationProperties.Name="{l:Tr SecSettings.TabServices}"
                    ItemContainerStyle="{StaticResource TallRowStyle}"
                    ItemsSource="{Binding Services, Mode=OneWay}"
                    SelectedItem="{Binding SelectedService}">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="24" CellTemplate="{StaticResource ChangedMarkTemplate}" />
                <GridViewColumn Width="220" DisplayMemberBinding="{Binding Name, Mode=OneWay}" Header="{l:Tr SecSettings.ColumnService}" />
                <GridViewColumn Width="190" Header="{l:Tr SecSettings.ColumnStartMode}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type ss:ServiceRowViewModel}">
                      <Grid>
                        <ComboBox MinWidth="160"
                                  AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                                  DisplayMemberPath="Label"
                                  IsEnabled="{Binding CanEdit, Mode=OneWay}"
                                  ItemsSource="{Binding Modes, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedMode}"
                                  Visibility="{Binding IsModeEditable, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ModeText, Mode=OneWay}"
                                   Visibility="{Binding IsModeEditable, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="420" Header="{l:Tr SecSettings.ColumnSecurity}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type ss:ServiceRowViewModel}">
                      <TextBlock VerticalAlignment="Center"
                                 Style="{StaticResource Ad.SecondaryText}"
                                 Text="{Binding SecurityText, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding SecurityText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
