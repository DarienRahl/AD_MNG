<!-- A new or edited WMI filter (WmiFilterEditorViewModel, modal): name, description and the WQL queries. -->
<Window x:Class="AdMng.App.GroupPolicy.WmiFilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gpm="clr-namespace:AdMng.Presentation.GroupPolicy;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="760"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="OkButton"
                  Command="{Binding OkCommand}"
                  Content="{l:Tr Common.Ok}"
                  IsDefault="True"
                  Style="{StaticResource Ad.AccentDialogButton}" />
          <Button x:Name="CancelButton"
                  Command="{Binding CancelCommand}"
                  Content="{l:Tr Common.Cancel}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
        <TextBlock x:Name="ValidationText"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding ValidationError, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Grid Margin="24,16,24,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr GroupPolicy.LabelName}" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="{l:Tr GroupPolicy.LabelName}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Row="1">
        <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr GroupPolicy.LabelDescription}" />
        <TextBox x:Name="DescriptionBox" AutomationProperties.Name="{l:Tr GroupPolicy.LabelDescription}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <Border Grid.Row="2"
              Margin="0,10,0,0"
              Style="{StaticResource Ad.WarningBar}"
              Visibility="{Binding HasUnparsedQueries, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Text="{l:Tr GroupPolicy.WmiUnparsedNote}" TextWrapping="Wrap" />
      </Border>
      <DockPanel Grid.Row="3" Margin="0,10,0,4">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="AddQueryButton" Margin="0,0,6,0" Command="{Binding AddQueryCommand}" Content="{l:Tr GroupPolicy.AddQuery}" />
          <Button x:Name="RemoveQueryButton" Command="{Binding RemoveQueryCommand}" Content="{l:Tr GroupPolicy.RemoveQuery}" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr GroupPolicy.LabelQueries}" />
      </DockPanel>
      <ListView x:Name="QueriesList"
                Grid.Row="4"
                AutomationProperties.Name="{l:Tr GroupPolicy.LabelQueries}"
                ItemsSource="{Binding Queries, Mode=OneWay}"
                SelectedItem="{Binding SelectedQuery}">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2,4" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Width="150" Header="{l:Tr GroupPolicy.ColumnNamespace}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type gpm:WmiQueryRowViewModel}">
                  <TextBox MinWidth="130" AutomationProperties.Name="{l:Tr GroupPolicy.ColumnNamespace}" Text="{Binding Namespace, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="520" Header="{l:Tr GroupPolicy.ColumnQuery}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type gpm:WmiQueryRowViewModel}">
                  <TextBox MinWidth="490"
                           AutomationProperties.Name="{l:Tr GroupPolicy.ColumnQuery}"
                           FontFamily="Consolas"
                           Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock Grid.Row="5"
                 Margin="0,8,0,0"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr GroupPolicy.WmiTestLater}"
                 TextWrapping="Wrap" />
    </Grid>
  </DockPanel>
</Window>
