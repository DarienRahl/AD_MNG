<!--
  One GPO (GroupPolicyObjectDocumentViewModel), GPMC's tabs: Zakres (links, security filtering, WMI filter), Szczegóły
  (domain, owner, dates, versions of AD and SYSVOL, GUID, GPO status), Ustawienia (the settings in GPMC's words, grouped
  like GPMC's report, search, "Edytuj to ustawienie", "Raport HTML…"; read-only, secrets never shown), Delegowanie (GPMC
  levels) and Stan (the GPO diagnostics, GroupPolicyHealthPanel, with "Napraw…", "Wyrównaj wersje" and "Napraw
  uprawnienia folderu"). Every change opens the change plan preview.
-->
<UserControl x:Class="AdMng.App.GroupPolicy.GroupPolicyObjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:gp="clr-namespace:AdMng.App.GroupPolicy"
             xmlns:gpm="clr-namespace:AdMng.Presentation.GroupPolicy;assembly=AdMng.Presentation"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
    <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style x:Key="Value" TargetType="TextBox" BasedOn="{StaticResource Ad.SelectableText}">
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,16,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="8,6,8,8">
    <!-- Header: the name and GUID trimmed in their column, the buttons in their own -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <c:ObjectIconView Margin="0,0,8,0" VerticalAlignment="Center" Icon="GroupPolicy" Size="18" />
      <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText"
                   FontWeight="SemiBold"
                   Text="{Binding Title, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Title, Mode=OneWay}" />
        <TextBlock x:Name="GuidTextBlock"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding GuidText, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding GuidText, Mode=OneWay}" />
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <Button x:Name="EditTemplatesButton" Margin="0,0,6,0" Command="{Binding EditTemplatesCommand}" Content="{l:Tr AdmTemplates.EditCommand}" />
        <Button x:Name="EditSecuritySettingsButton" Margin="0,0,6,0" Command="{Binding EditSecuritySettingsCommand}" Content="{l:Tr SecSettings.EditCommand}" />
        <Button x:Name="RenameButton" Margin="0,0,6,0" Command="{Binding RenameCommand}" Content="{l:Tr GroupPolicy.RenameCommand}" />
        <Button x:Name="BackupButton" Margin="0,0,6,0" Command="{Binding BackupCommand}" Content="{l:Tr GroupPolicy.BackupCommand}" />
        <Button x:Name="CompareButton" Margin="0,0,6,0" Command="{Binding CompareCommand}" Content="{l:Tr GroupPolicy.CompareWithCommand}" />
        <Button x:Name="HistoryButton" Margin="0,0,6,0" Command="{Binding HistoryCommand}" Content="{l:Tr GroupPolicy.HistoryCommand}" />
        <Button x:Name="DeleteButton" Margin="0,0,6,0" Command="{Binding DeleteCommand}" Content="{l:Tr GroupPolicy.DeleteCommand}" />
        <Button x:Name="RefreshButton"
                AutomationProperties.Name="{l:Tr GroupPolicy.RefreshCommand}"
                Command="{Binding RefreshCommand}"
                Content="{x:Static c:Glyphs.Refresh}"
                Style="{StaticResource Ad.IconButton}"
                ToolTip="{l:Tr GroupPolicy.RefreshCommand}" />
      </StackPanel>
    </Grid>
    <gp:GroupPolicyBanners DockPanel.Dock="Top" />
    <Border Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding HasOrphanedFolder, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <Button x:Name="DeleteOrphanButton" HorizontalAlignment="Left" Command="{Binding DeleteOrphanedFolderCommand}" Content="{l:Tr GroupPolicy.DeleteOrphanedFolder}" />
    </Border>

    <TabControl x:Name="GpoTabs" SelectedIndex="{Binding SelectedTabIndex}">
      <!-- Zakres -->
      <TabItem x:Name="ScopeTab" Header="{l:Tr GroupPolicy.TabScope}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,4">
            <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr GroupPolicy.LinksHeading}" />
            <TextBlock Margin="0,0,0,4" Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr GroupPolicy.LinksHint}" TextWrapping="Wrap" />
            <ListView x:Name="LinksList"
                      MinHeight="90"
                      MaxHeight="220"
                      AutomationProperties.Name="{l:Tr GroupPolicy.LinksHeading}"
                      ItemContainerStyle="{StaticResource RowStyle}"
                      ItemsSource="{Binding Links, Mode=OneWay}"
                      SelectedItem="{Binding SelectedLink}">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="210" Header="{l:Tr GroupPolicy.ColumnLocation}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoLinkRowViewModel}">
                        <TextBlock Text="{Binding ContainerName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContainerName, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="280" Header="{l:Tr GroupPolicy.ColumnPath}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoLinkRowViewModel}">
                        <TextBlock Text="{Binding PathText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="150" Header="{l:Tr GroupPolicy.ColumnKind}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoLinkRowViewModel}">
                        <TextBlock Text="{Binding KindText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding KindText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="130" Header="{l:Tr GroupPolicy.ColumnEnforced}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoLinkRowViewModel}">
                        <TextBlock Text="{Binding EnforcedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnforcedText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="170" Header="{l:Tr GroupPolicy.ColumnLinkEnabled}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoLinkRowViewModel}">
                        <TextBlock Text="{Binding EnabledText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnabledText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <WrapPanel Margin="0,6,0,12">
              <Button x:Name="OpenContainerButton" Margin="0,0,6,4" Command="{Binding OpenLinkContainerCommand}" Content="{l:Tr GroupPolicy.OpenContainer}" />
              <Button x:Name="ToggleEnforcedButton" Margin="0,0,6,4" Command="{Binding ToggleEnforcedCommand}" Content="{l:Tr GroupPolicy.ToggleEnforced}" />
              <Button x:Name="ToggleEnabledButton" Margin="0,0,6,4" Command="{Binding ToggleEnabledCommand}" Content="{l:Tr GroupPolicy.ToggleEnabled}" />
              <Button x:Name="UnlinkButton" Margin="0,0,6,4" Command="{Binding UnlinkCommand}" Content="{l:Tr GroupPolicy.Unlink}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr GroupPolicy.SecurityFilteringHeading}" />
            <TextBlock Margin="0,0,0,4" Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr GroupPolicy.SecurityFilteringHint}" TextWrapping="Wrap" />
            <ListView x:Name="SecurityFilterList"
                      MinHeight="80"
                      MaxHeight="200"
                      AutomationProperties.Name="{l:Tr GroupPolicy.SecurityFilteringHeading}"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding SecurityFilter, Mode=OneWay}"
                      SelectedItem="{Binding SelectedFilterTrustee}" />
            <WrapPanel Margin="0,6,0,12">
              <Button x:Name="AddFilterButton" Margin="0,0,6,4" Command="{Binding AddSecurityFilterCommand}" Content="{l:Tr GroupPolicy.Add}" />
              <Button x:Name="RemoveFilterButton" Margin="0,0,6,4" Command="{Binding RemoveSecurityFilterCommand}" Content="{l:Tr GroupPolicy.Remove}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr GroupPolicy.WmiFilteringHeading}" />
            <TextBlock Margin="0,0,0,4" Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr GroupPolicy.WmiFilteringHint}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
              <ComboBox x:Name="WmiFilterBox"
                        MinWidth="260"
                        AutomationProperties.Name="{l:Tr GroupPolicy.WmiFilteringHeading}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding WmiFilters, Mode=OneWay}"
                        SelectedItem="{Binding SelectedWmiFilter}" />
              <Button x:Name="ApplyWmiButton" Margin="8,0,0,0" Command="{Binding ApplyWmiFilterCommand}" Content="{l:Tr GroupPolicy.Apply}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Szczegóły -->
      <TabItem x:Name="DetailsTab" Header="{l:Tr GroupPolicy.TabDetails}">
        <Grid Margin="8,10,8,8" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelDomain}" />
          <TextBox Grid.Column="1" AutomationProperties.Name="{l:Tr GroupPolicy.LabelDomain}" Style="{StaticResource Value}" Text="{Binding DomainText, Mode=OneWay}" />
          <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelOwner}" />
          <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{l:Tr GroupPolicy.LabelOwner}" Style="{StaticResource Value}" Text="{Binding OwnerText, Mode=OneWay}" />
          <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelCreated}" />
          <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.Name="{l:Tr GroupPolicy.LabelCreated}" Style="{StaticResource Value}" Text="{Binding CreatedText, Mode=OneWay}" />
          <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelModified}" />
          <TextBox Grid.Row="3" Grid.Column="1" AutomationProperties.Name="{l:Tr GroupPolicy.LabelModified}" Style="{StaticResource Value}" Text="{Binding ChangedText, Mode=OneWay}" />
          <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelUserVersion}" />
          <TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.Name="{l:Tr GroupPolicy.LabelUserVersion}" Style="{StaticResource Value}" Text="{Binding UserVersionText, Mode=OneWay}" />
          <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelComputerVersion}" />
          <TextBox Grid.Row="5" Grid.Column="1" AutomationProperties.Name="{l:Tr GroupPolicy.LabelComputerVersion}" Style="{StaticResource Value}" Text="{Binding ComputerVersionText, Mode=OneWay}" />
          <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelGuid}" />
          <TextBox Grid.Row="6" Grid.Column="1" AutomationProperties.Name="{l:Tr GroupPolicy.LabelGuid}" Style="{StaticResource Value}" Text="{Binding GuidText, Mode=OneWay}" />
          <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="{l:Tr GroupPolicy.LabelGpoStatus}" />
          <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal">
            <ComboBox x:Name="StatusBox"
                      MinWidth="320"
                      AutomationProperties.Name="{l:Tr GroupPolicy.LabelGpoStatus}"
                      DisplayMemberPath="Text"
                      ItemsSource="{Binding StatusOptions, Mode=OneWay}"
                      SelectedItem="{Binding SelectedStatus}" />
            <Button x:Name="ApplyStatusButton" Margin="8,0,0,0" Command="{Binding ApplyStatusCommand}" Content="{l:Tr GroupPolicy.Apply}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Ustawienia: the settings in GPMC's words (K6 20.1), grouped like GPMC's settings report -->
      <TabItem x:Name="SettingsTab" Header="{l:Tr GroupPolicy.TabSettings}">
        <DockPanel Margin="4,8,4,4">
          <DockPanel.Resources>
            <Style x:Key="SettingRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
              <Setter Property="MinHeight" Value="28" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Padding" Value="2,0" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
              <Setter Property="gp:GpoSettingsUi.DoubleClickCommand" Value="{Binding DataContext.EditSettingCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
            </Style>
          </DockPanel.Resources>
          <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
            <Button x:Name="SettingsEditSecuritySettingsButton"
                    Margin="6,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding EditSecuritySettingsCommand}"
                    Content="{l:Tr SecSettings.EditCommand}"
                    DockPanel.Dock="Right" />
            <Button x:Name="SettingsEditTemplatesButton"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding EditTemplatesCommand}"
                    Content="{l:Tr AdmTemplates.EditCommand}"
                    DockPanel.Dock="Right" />
            <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr GroupPolicy.SettingsHint}" TextWrapping="Wrap" />
          </DockPanel>
          <!-- Search and the row commands -->
          <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="EditSettingButton" Margin="6,0,0,0" Command="{Binding EditSettingCommand}" Content="{l:Tr GpoSettings.EditSetting}" />
              <Button x:Name="CopySettingButton" Margin="6,0,0,0" Command="{Binding CopySettingCommand}" Content="{l:Tr GpoSettings.CopySetting}" />
              <Button x:Name="SettingsReportButton" Margin="6,0,0,0" Command="{Binding HtmlReportCommand}" Content="{l:Tr GpoSettings.HtmlReport}" />
              <Button x:Name="SearchAllGposButton"
                      Margin="6,0,0,0"
                      Command="{Binding SearchAllGposCommand}"
                      Content="{l:Tr GpoSearch.FindInAll}"
                      ToolTip="{l:Tr GpoSearch.FindInAllHint}" />
            </StackPanel>
            <Grid>
              <TextBox x:Name="SettingsSearchBox"
                       gp:GpoSettingsUi.FocusWhenRequested="True"
                       gp:GroupPolicyUi.IsDocumentSearch="True"
                       AutomationProperties.Name="{l:Tr GpoSettings.SearchPlaceholder}"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                       ToolTip="{l:Tr GpEditing.SearchHint}" />
              <TextBlock Style="{StaticResource Ad.HintText}"
                         Text="{l:Tr GpoSettings.SearchPlaceholder}"
                         Visibility="{Binding Text, ElementName=SettingsSearchBox, Converter={StaticResource Ad.EmptyToVisible}}" />
            </Grid>
          </DockPanel>
          <TextBlock x:Name="SettingsNote"
                     Margin="0,0,0,6"
                     DockPanel.Dock="Top"
                     Text="{Binding SettingsNote, Mode=OneWay}"
                     TextWrapping="Wrap"
                     Visibility="{Binding SettingsNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          <TextBlock x:Name="DefinitionsNoteText"
                     Margin="0,0,0,6"
                     DockPanel.Dock="Top"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding DefinitionsNote, Mode=OneWay}"
                     TextWrapping="Wrap"
                     Visibility="{Binding DefinitionsNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          <TextBlock x:Name="SettingsSummaryText"
                     Margin="0,0,0,6"
                     DockPanel.Dock="Top"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding SettingsSummary, Mode=OneWay}"
                     Visibility="{Binding SettingsSummary, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" MinHeight="140" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="170" MinHeight="70" />
            </Grid.RowDefinitions>
            <ListView x:Name="SettingsList"
                      gp:GroupPolicyUi.KeepsSelectionInView="True"
                      AutomationProperties.Name="{l:Tr GroupPolicy.TabSettings}"
                      ItemContainerStyle="{StaticResource SettingRowStyle}"
                      gp:GpoSettingsUi.GroupBy="Configuration,Group"
                      gp:GpoSettingsUi.GroupedItemsSource="{Binding Settings, Mode=OneWay}"
                      IsSynchronizedWithCurrentItem="False"
                      ScrollViewer.CanContentScroll="True"
                      SelectedItem="{Binding SelectedSetting}"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.VirtualizationMode="Recycling">
              <ListView.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding EditSettingCommand}" />
                <KeyBinding Key="C" Command="{Binding CopySettingCommand}" Modifiers="Control" />
              </ListView.InputBindings>
              <ListView.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="EditSettingMenuItem" Command="{Binding EditSettingCommand}" Header="{l:Tr GpoSettings.EditSetting}" InputGestureText="Enter" />
                  <MenuItem x:Name="CopySettingMenuItem" Command="{Binding CopySettingCommand}" Header="{l:Tr GpoSettings.CopySetting}" InputGestureText="Ctrl+C" />
                  <Separator />
                  <MenuItem x:Name="SettingsReportMenuItem" Command="{Binding HtmlReportCommand}" Header="{l:Tr GpoSettings.HtmlReport}" />
                </ContextMenu>
              </ListView.ContextMenu>
              <ListView.GroupStyle>
                <!-- Konfiguracja komputera / Konfiguracja użytkownika -->
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="{x:Type GroupItem}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type GroupItem}">
                            <Expander Margin="0,6,0,0" IsExpanded="True">
                              <Expander.Header>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name, Mode=OneWay}" />
                              </Expander.Header>
                              <ItemsPresenter />
                            </Expander>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
                <!-- GPMC's folder path below the configuration -->
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="{x:Type GroupItem}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type GroupItem}">
                            <Expander Margin="14,2,0,2" IsExpanded="True">
                              <Expander.Header>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name, Mode=OneWay}">
                                  <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                              </Expander.Header>
                              <ItemsPresenter />
                            </Expander>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
              </ListView.GroupStyle>
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="380" Header="{l:Tr GroupPolicy.ColumnSetting}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoSettingRowViewModel}">
                        <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Technical, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="400" Header="{l:Tr GroupPolicy.ColumnValue}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoSettingRowViewModel}">
                        <TextBlock Text="{Binding Value, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="220" Header="{l:Tr GroupPolicy.ColumnSource}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoSettingRowViewModel}">
                        <TextBlock Text="{Binding Source, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <gp:PaneSplitter Grid.Row="1" ResizeDirection="Rows" />
            <!-- The selected setting in full: where GPMC lists it, its value and parts, the note and the technical key -->
            <Border x:Name="SettingDetails" Grid.Row="2" Padding="12,8" Style="{StaticResource Ad.Card}">
              <Grid>
                <TextBlock x:Name="SettingDetailsHint"
                           Style="{StaticResource Ad.SecondaryText}"
                           Text="{l:Tr GpoSettings.DetailsHint}"
                           TextWrapping="Wrap"
                           Visibility="{Binding SelectedSetting, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedSetting, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
                  <StackPanel DataContext="{Binding SelectedSetting, Mode=OneWay}">
                    <TextBox x:Name="SettingDetailsName"
                             AutomationProperties.Name="{l:Tr GroupPolicy.ColumnSetting}"
                             FontWeight="SemiBold"
                             Style="{StaticResource Ad.SelectableText}"
                             Text="{Binding Name, Mode=OneWay}"
                             TextWrapping="Wrap" />
                    <TextBox x:Name="SettingDetailsPath"
                             AutomationProperties.Name="{l:Tr GpoSettings.DetailsWhere}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Style="{StaticResource Ad.SelectableText}"
                             Text="{Binding GroupPath, Mode=OneWay}"
                             TextWrapping="Wrap" />
                    <TextBox x:Name="SettingDetailsValue"
                             Margin="0,6,0,0"
                             AutomationProperties.Name="{l:Tr GroupPolicy.ColumnValue}"
                             Style="{StaticResource Ad.SelectableText}"
                             Text="{Binding Value, Mode=OneWay}"
                             TextWrapping="Wrap" />
                    <ItemsControl x:Name="SettingDetailsElements"
                                  Margin="12,2,0,0"
                                  Focusable="False"
                                  ItemsSource="{Binding Elements, Mode=OneWay}"
                                  Visibility="{Binding HasElements, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource Ad.SelectableText}" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SettingDetailsExplanation"
                               Margin="0,6,0,0"
                               Style="{StaticResource Ad.SecondaryText}"
                               Text="{Binding Explanation, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasExplanation, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                    <DockPanel Margin="0,6,0,0">
                      <TextBlock Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource Ad.SecondaryText}"
                                 Text="{l:Tr GpoSettings.DetailsTechnical}" />
                      <TextBox x:Name="SettingDetailsTechnical"
                               AutomationProperties.Name="{l:Tr GpoSettings.DetailsTechnical}"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource Ad.SelectableText}"
                               Text="{Binding Technical, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    </DockPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- Delegowanie -->
      <TabItem x:Name="DelegationTab" Header="{l:Tr GroupPolicy.TabDelegation}">
        <DockPanel Margin="4,8,4,4">
          <TextBlock Margin="0,0,0,4" DockPanel.Dock="Top" Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr GroupPolicy.DelegationHint}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,6,0,0" DockPanel.Dock="Bottom">
            <TextBlock Margin="0,0,8,4" VerticalAlignment="Center" Text="{l:Tr GroupPolicy.LabelLevel}" />
            <ComboBox x:Name="LevelBox"
                      MinWidth="300"
                      Margin="0,0,8,4"
                      AutomationProperties.Name="{l:Tr GroupPolicy.LabelLevel}"
                      DisplayMemberPath="Text"
                      ItemsSource="{Binding LevelOptions, Mode=OneWay}"
                      SelectedItem="{Binding SelectedLevel}" />
            <Button x:Name="AddDelegationButton" Margin="0,0,6,4" Command="{Binding AddDelegationCommand}" Content="{l:Tr GroupPolicy.Add}" />
            <Button x:Name="ChangeLevelButton" Margin="0,0,6,4" Command="{Binding ChangeLevelCommand}" Content="{l:Tr GroupPolicy.ChangeLevel}" />
            <Button x:Name="RemoveDelegationButton" Margin="0,0,6,4" Command="{Binding RemoveDelegationCommand}" Content="{l:Tr GroupPolicy.Remove}" />
          </WrapPanel>
          <ListView x:Name="DelegationList"
                    AutomationProperties.Name="{l:Tr GroupPolicy.TabDelegation}"
                    ItemContainerStyle="{StaticResource RowStyle}"
                    ItemsSource="{Binding Delegation, Mode=OneWay}"
                    SelectedItem="{Binding SelectedTrustee}">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="300" Header="{l:Tr GroupPolicy.ColumnTrustee}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type gpm:GpoTrusteeRowViewModel}">
                      <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sid, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="400" Header="{l:Tr GroupPolicy.ColumnLevel}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoTrusteeRowViewModel}">
                        <TextBlock Text="{Binding LevelText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LevelText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                <GridViewColumn Width="150" Header="{l:Tr GroupPolicy.ColumnInherited}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type gpm:GpoTrusteeRowViewModel}">
                        <TextBlock Text="{Binding InheritedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InheritedText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>

      <!-- Stan: the diagnostics engine for this GPO (GroupPolicyHealthPanel.xaml) -->
      <TabItem x:Name="StatusTab" Header="{l:Tr GroupPolicy.TabStatus}">
        <gp:GroupPolicyHealthPanel x:Name="HealthPanel" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
