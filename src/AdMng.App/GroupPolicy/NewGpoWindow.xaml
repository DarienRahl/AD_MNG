<!-- New GPO, copy and rename (NewGpoViewModel, modal): the name, the link target and for a copy its permissions. -->
<Window x:Class="AdMng.App.GroupPolicy.NewGpoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="520"
        MinWidth="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="OkButton"
                Command="{Binding OkCommand}"
                Content="{l:Tr Common.Ok}"
                IsDefault="True"
                Style="{StaticResource Ad.AccentDialogButton}" />
        <Button x:Name="CancelButton"
                Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24,18,24,12">
      <TextBlock Style="{StaticResource Ad.Title}" Text="{Binding WindowTitle, Mode=OneWay}" />
      <TextBlock x:Name="SourceTextBlock"
                 Margin="0,6,0,0"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding SourceText, Mode=OneWay}"
                 Visibility="{Binding HasSource, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr GroupPolicy.LabelName}" />
      <TextBox x:Name="NameBox"
               AutomationProperties.Name="{l:Tr GroupPolicy.LabelName}"
               Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock x:Name="NameErrorText"
                 Margin="0,4,0,0"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                 Text="{Binding NameError, Mode=OneWay}"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasNameError, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <TextBlock x:Name="LinkTargetTextBlock"
                 Margin="0,10,0,0"
                 Text="{Binding LinkTargetText, Mode=OneWay}"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasLinkTarget, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <StackPanel Visibility="{Binding IsCopy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr GroupPolicy.LabelPermissions}" />
        <RadioButton x:Name="DefaultPermissionsRadio"
                     Content="{l:Tr GroupPolicy.PermissionsDefault}"
                     IsChecked="{Binding CopyPermissions, Converter={StaticResource Ad.InverseBool}}" />
        <RadioButton x:Name="KeepPermissionsRadio"
                     Margin="0,4,0,0"
                     Content="{l:Tr GroupPolicy.PermissionsKeep}"
                     IsChecked="{Binding CopyPermissions}" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
