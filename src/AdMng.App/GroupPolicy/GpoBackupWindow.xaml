<!--
  Backup, restore, import and the backup before a delete (GpoBackupViewModel, modal). Backups go only to the folder the
  operator chooses (CLAUDE.md rule 1); restore and import read a backup of that folder and open the change plan preview.
-->
<Window x:Class="AdMng.App.GroupPolicy.GpoBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gpm="clr-namespace:AdMng.Presentation.GroupPolicy;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="780"
        Height="600"
        MinWidth="560"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
    <Style x:Key="BackupRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOtherDomain, Mode=OneWay}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="RunButton"
                  Command="{Binding RunCommand}"
                  Content="{Binding RunText, Mode=OneWay}"
                  IsDefault="True"
                  Style="{StaticResource Ad.AccentDialogButton}" />
          <Button x:Name="CloseButton"
                  Command="{Binding CloseCommand}"
                  Content="{l:Tr Common.Close}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ProgressBar Width="72"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock x:Name="StatusTextBlock"
                     VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding StatusText, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="24,16,24,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource Ad.Title}" Text="{Binding WindowTitle, Mode=OneWay}" />
        <TextBlock x:Name="GposTextBlock"
                   Margin="0,6,0,0"
                   Text="{Binding GposText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsBackup, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <CheckBox x:Name="BackupFirstBox"
                  Margin="0,10,0,0"
                  Content="{l:Tr GroupPolicy.BackupFirst}"
                  IsChecked="{Binding BackupFirst}"
                  Visibility="{Binding IsBeforeDelete, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      </StackPanel>

      <!-- The folder the operator chooses -->
      <StackPanel Grid.Row="1">
        <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr GroupPolicy.LabelFolder}" />
        <DockPanel>
          <Button x:Name="BrowseButton"
                  Margin="8,0,0,0"
                  Command="{Binding BrowseCommand}"
                  Content="{l:Tr GroupPolicy.Browse}"
                  DockPanel.Dock="Right" />
          <TextBox x:Name="FolderBox"
                   AutomationProperties.Name="{l:Tr GroupPolicy.LabelFolder}"
                   Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
      </StackPanel>

      <!-- Backup: comment and the PowerShell equivalent -->
      <StackPanel Grid.Row="2" Visibility="{Binding IsBackup, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr GroupPolicy.LabelComment}" />
        <TextBox x:Name="CommentBox" AutomationProperties.Name="{l:Tr GroupPolicy.LabelComment}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <Border x:Name="ErrorBar"
              Grid.Row="3"
              Margin="0,10,0,0"
              Style="{StaticResource Ad.ErrorBar}"
              Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Text="{Binding Error, Mode=OneWay}" TextWrapping="Wrap" />
      </Border>

      <!-- Restore / import: the backups of the folder -->
      <DockPanel Grid.Row="4"
                 Margin="0,10,0,0"
                 Visibility="{Binding ListsBackups, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="BackupDetailsText"
                     Margin="0,6,0,0"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding BackupDetails, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <CheckBox x:Name="RestoreLinksBox"
                    Margin="0,6,0,0"
                    Content="{Binding RestoreLinksText, Mode=OneWay}"
                    IsChecked="{Binding RestoreLinks}"
                    IsEnabled="{Binding CanRestoreLinks, Mode=OneWay}"
                    Visibility="{Binding IsRestore, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        </StackPanel>
        <ListView x:Name="BackupList"
                  AutomationProperties.Name="{Binding WindowTitle, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource BackupRowStyle}"
                  ItemsSource="{Binding Backups, Mode=OneWay}"
                  SelectedItem="{Binding SelectedBackup}"
                  SelectionMode="Single">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="230" DisplayMemberBinding="{Binding Name, Mode=OneWay}" Header="{l:Tr GroupPolicy.ColumnName}" />
              <GridViewColumn Width="130" DisplayMemberBinding="{Binding Domain, Mode=OneWay}" Header="{l:Tr GroupPolicy.ColumnDomain}" />
              <GridViewColumn Width="140" DisplayMemberBinding="{Binding TimeText, Mode=OneWay}" Header="{l:Tr GroupPolicy.ColumnTime}" />
              <GridViewColumn Width="200" Header="{l:Tr GroupPolicy.ColumnComment}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type gpm:GpoBackupRowViewModel}">
                    <TextBlock Text="{Binding Comment, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GuidText, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>

      <DockPanel Grid.Row="4"
                 Margin="0,10,0,0"
                 Visibility="{Binding IsBackup, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
          <Button x:Name="CopyPowerShellButton"
                  Command="{Binding CopyPowerShellCommand}"
                  Content="{l:Tr GroupPolicy.CopyPowerShell}"
                  DockPanel.Dock="Right" />
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr GroupPolicy.BackupPowerShellHeading}" />
        </DockPanel>
        <TextBox x:Name="PowerShellBox"
                 AutomationProperties.Name="{l:Tr GroupPolicy.BackupPowerShellHeading}"
                 FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Text="{Binding PowerShell, Mode=OneWay}"
                 VerticalScrollBarVisibility="Auto" />
      </DockPanel>

      <TextBlock x:Name="CompatibilityNoteText"
                 Grid.Row="5"
                 Margin="0,10,0,0"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding CompatibilityNote, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Grid>
  </DockPanel>
</Window>
