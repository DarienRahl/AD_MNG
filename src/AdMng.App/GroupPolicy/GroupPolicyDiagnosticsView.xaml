<!--
  "Diagnostyka zasad grupy" (GroupPolicyDiagnosticsDocumentViewModel, K6, design note docs/dev/k-computers-and-gpo.md 20.2):
  quick and full check (action buttons: while one runs, its button is its Cancel), the status line (the check with its
  stages, the number of findings with when and how deep the GPOs were checked, "Group Policy has changed since the last
  check" with "Sprawdź ponownie"), the notes about what the check could not evaluate, the summary chips per severity, the
  filters (severity, area, GPO, text -
  Ctrl+F, Esc), the virtualized list of findings and, beside it behind a splitter, the details of the selected finding with
  "Napraw…" (the change plan preview), "Otwórz GPO", "Edytuj to ustawienie", "Pokaż w modelu" and "Kopiuj"; exports to CSV
  and HTML. Headers never truncate: the title is trimmed in its own column, the list columns are wider than their headers.
-->
<UserControl x:Class="AdMng.App.GroupPolicy.GroupPolicyDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:gp="clr-namespace:AdMng.App.GroupPolicy"
             xmlns:gpd="clr-namespace:AdMng.Presentation.GroupPolicy.Diagnostics;assembly=AdMng.Presentation"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AdMng;component/GroupPolicy/GroupPolicyDiagnosticsResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
      <Style x:Key="FindingRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneWay}" />
      </Style>
      <Style x:Key="FilterLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Margin="8,6,8,8">
    <!-- Header: the title trimmed in its column, the checks and exports in their own -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <c:ObjectIconView Margin="0,0,8,0" VerticalAlignment="Center" Icon="{Binding Icon, Mode=OneWay}" Size="18" />
      <TextBlock x:Name="TitleText"
                 Grid.Column="1"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="{Binding Title, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Title, Mode=OneWay}" />
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <!-- The checks: while one of them runs, its button is its Cancel (the line says how far it is, "Stopping…" after the press). -->
        <c:ActionButton x:Name="QuickCheckButton"
                        Margin="0,0,6,0"
                        CancelCommand="{Binding Status.CancelCommand, Mode=OneWay}"
                        Command="{Binding QuickCheckCommand}"
                        Content="{l:Tr GpoDiag.QuickCheck}"
                        IsCancelling="{Binding Status.IsCancelling, Mode=OneWay}"
                        IsRunning="{Binding IsQuickChecking, Mode=OneWay}"
                        Style="{StaticResource Ad.AccentActionButton}"
                        ToolTip="{l:Tr GpoDiag.QuickCheckHint}" />
        <c:ActionButton x:Name="FullCheckButton"
                        Margin="0,0,12,0"
                        CancelCommand="{Binding Status.CancelCommand, Mode=OneWay}"
                        Command="{Binding FullCheckCommand}"
                        Content="{l:Tr GpoDiag.FullCheck}"
                        IsCancelling="{Binding Status.IsCancelling, Mode=OneWay}"
                        IsRunning="{Binding IsFullChecking, Mode=OneWay}"
                        Style="{StaticResource Ad.ActionButton}"
                        ToolTip="{l:Tr GpoDiag.FullCheckHint}" />
        <Button x:Name="ExportCsvButton" Margin="0,0,6,0" Command="{Binding ExportCsvCommand}" Content="{l:Tr GpoDiag.ExportCsv}" />
        <Button x:Name="ExportHtmlButton" Command="{Binding ExportHtmlCommand}" Content="{l:Tr GpoDiag.ExportHtml}" />
      </StackPanel>
    </Grid>

    <!--
      Status line (design note 6.1): the check with its stages and Stop, the summary (the number of findings, when and
      how deep the GPOs were checked, the selected finding), why it could not be read, "Group Policy has changed since
      the last check" with "Sprawdź ponownie", and what became of a repair that is prepared for the change plan preview.
      Always present, so nothing under it moves while the tab works. Under it the notes about SYSVOL and the PDC emulator
      (GroupPolicyNotes), then the notes of this view.
    -->
    <c:StatusLine x:Name="PageStatus"
                  Margin="0,0,0,6"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  DockPanel.Dock="Top"
                  Status="{Binding Status.Current, Mode=OneWay}" />
    <gp:GroupPolicyNotes x:Name="DocumentNotes" DockPanel.Dock="Top" />

    <!-- What the check could not evaluate: how complete the findings are - notes about them, true for as long as they are shown. -->
    <ContentControl x:Name="NotesBar"
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Ad.Note.Attention}"
                    Visibility="{Binding HasNotes, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <ItemsControl x:Name="NotesList" AutomationProperties.LiveSetting="Polite" Focusable="False" ItemsSource="{Binding Notes, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type sys:String}">
            <TextBlock Margin="0,0,0,2" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ContentControl>

    <!-- Summary chips (click: only that severity) -->
    <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
      <Button x:Name="ClearFiltersButton"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Command="{Binding ClearFiltersCommand}"
              Content="{l:Tr GpoDiag.ClearFilters}"
              DockPanel.Dock="Right"
              Visibility="{Binding IsFiltered, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <ItemsControl x:Name="ChipsList" AutomationProperties.Name="{l:Tr GpoDiag.SummaryLabel}" Focusable="False" ItemsSource="{Binding Chips, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type gpd:GpoSeverityChipViewModel}">
            <ToggleButton Margin="0,0,6,4"
                          Padding="10,3"
                          AutomationProperties.Name="{Binding Text, Mode=OneWay}"
                          IsChecked="{Binding IsSelected}"
                          IsEnabled="{Binding HasFindings, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource GpoDiag.SeverityDot}" Tag="{Binding Severity, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Text, Mode=OneWay}" />
              </StackPanel>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- Filters: severity, area, GPO, text (Ctrl+F, Esc) -->
    <WrapPanel Margin="0,0,0,6" DockPanel.Dock="Top">
      <StackPanel Margin="0,0,16,4" Orientation="Horizontal">
        <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr GpoDiag.FilterSeverity}" />
        <ComboBox x:Name="SeverityBox"
                  MinWidth="150"
                  AutomationProperties.Name="{l:Tr GpoDiag.FilterSeverity}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding SeverityOptions, Mode=OneWay}"
                  SelectedItem="{Binding SelectedSeverity}" />
      </StackPanel>
      <StackPanel Margin="0,0,16,4" Orientation="Horizontal">
        <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr GpoDiag.FilterArea}" />
        <ComboBox x:Name="AreaBox"
                  MinWidth="160"
                  AutomationProperties.Name="{l:Tr GpoDiag.FilterArea}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding AreaOptions, Mode=OneWay}"
                  SelectedItem="{Binding SelectedArea}" />
      </StackPanel>
      <StackPanel Margin="0,0,16,4" Orientation="Horizontal">
        <TextBlock Style="{StaticResource FilterLabel}" Text="{l:Tr GpoDiag.FilterGpo}" />
        <ComboBox x:Name="GpoBox"
                  MinWidth="200"
                  MaxWidth="360"
                  AutomationProperties.Name="{l:Tr GpoDiag.FilterGpo}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding GpoOptions, Mode=OneWay}"
                  SelectedItem="{Binding SelectedGpo}" />
      </StackPanel>
      <Grid Width="340" Margin="0,0,0,4">
        <TextBox x:Name="SearchBox"
                 gp:GroupPolicyUi.IsDocumentSearch="True"
                 AutomationProperties.Name="{l:Tr GpoDiag.SearchPlaceholder}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                 ToolTip="{l:Tr GpEditing.SearchHint}" />
        <TextBlock Style="{StaticResource Ad.HintText}"
                   Text="{l:Tr GpoDiag.SearchPlaceholder}"
                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Ad.EmptyToVisible}}" />
      </Grid>
    </WrapPanel>

    <!-- The findings and, behind the splitter, the details of the selected one -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="400" MinWidth="260" />
      </Grid.ColumnDefinitions>
      <Grid>
        <ListView x:Name="FindingsList"
                  gp:GroupPolicyUi.KeepsSelectionInView="True"
                  AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource FindingRowStyle}"
                  ItemsSource="{Binding Rows, Mode=OneWay}"
                  ScrollViewer.CanContentScroll="True"
                  SelectedItem="{Binding SelectedRow}"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="130" Header="{l:Tr GpoDiag.ColumnSeverity}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type gpd:GpoFindingRowViewModel}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource GpoDiag.SeverityDot}" Tag="{Binding Severity, Mode=OneWay}" />
                      <TextBlock Style="{StaticResource GpoDiag.SeverityText}" Tag="{Binding Severity, Mode=OneWay}" Text="{Binding SeverityText, Mode=OneWay}" />
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="140" Header="{l:Tr GpoDiag.ColumnArea}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type gpd:GpoFindingRowViewModel}">
                    <TextBlock Text="{Binding AreaText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="220" Header="{l:Tr GroupPolicy.ColumnGpo}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type gpd:GpoFindingRowViewModel}">
                    <TextBlock Text="{Binding GpoText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpoText, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="240" Header="{l:Tr GpoDiag.ColumnWhere}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type gpd:GpoFindingRowViewModel}">
                    <TextBlock Text="{Binding WhereText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WhereText, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="520" Header="{l:Tr GpoDiag.ColumnFinding}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type gpd:GpoFindingRowViewModel}">
                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Message, Mode=OneWay}">
                      <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                      <Run Text=" – " />
                      <Run Text="{Binding Message, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock x:Name="ListNoteText"
                   Margin="16,48,16,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding ListNote, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding ListNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      </Grid>

      <gp:PaneSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Border Grid.Column="2" Padding="12,8" Style="{StaticResource Ad.Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr GpoDiag.DetailsHeading}" />
          <WrapPanel x:Name="ActionsPanel" Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <Button x:Name="FixButton"
                    Margin="0,0,6,4"
                    Command="{Binding FixCommand}"
                    Content="{l:Tr GpoDiag.Fix}"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="OpenGpoButton" Margin="0,0,6,4" Command="{Binding OpenGpoCommand}" Content="{l:Tr GpoDiag.OpenGpo}" />
            <Button x:Name="EditSettingButton" Margin="0,0,6,4" Command="{Binding EditSettingCommand}" Content="{l:Tr GpoDiag.EditSetting}" />
            <Button x:Name="ShowInModelButton" Margin="0,0,6,4" Command="{Binding ShowInModelCommand}" Content="{l:Tr GpoDiag.ShowInModel}" />
            <Button x:Name="CopyButton" Margin="0,0,6,4" Command="{Binding CopyCommand}" Content="{l:Tr Common.Copy}" />
          </WrapPanel>
          <Grid>
            <TextBlock x:Name="DetailsEmptyText"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{l:Tr GpoDiag.DetailsEmpty}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSelection, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
            <ScrollViewer x:Name="DetailsScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
              <StackPanel x:Name="DetailsPanel" DataContext="{Binding SelectedRow, Mode=OneWay}">
                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                  <Ellipse Style="{StaticResource GpoDiag.SeverityDot}" Tag="{Binding Severity, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource GpoDiag.SeverityText}" Tag="{Binding Severity, Mode=OneWay}" Text="{Binding SeverityText, Mode=OneWay}" />
                  <TextBlock Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Ad.SecondaryText}" Text="·" />
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource Ad.SecondaryText}" Text="{Binding AreaText, Mode=OneWay}" />
                </StackPanel>
                <TextBlock x:Name="DetailsTitle"
                           Margin="0,0,0,6"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding Title, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="DetailsMessage"
                         AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                         Style="{StaticResource Ad.SelectableText}"
                         Text="{Binding Message, Mode=OneWay}"
                         TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource GpoDiag.DetailHeading}" Text="{l:Tr GpoDiag.WhyHeading}" />
                <TextBlock x:Name="DetailsExplanation" Style="{StaticResource GpoDiag.DetailText}" Text="{Binding Explanation, Mode=OneWay}" />
                <TextBlock Style="{StaticResource GpoDiag.DetailHeading}" Text="{l:Tr GpoDiag.WhatHeading}" />
                <TextBlock x:Name="DetailsRecommendation" Style="{StaticResource GpoDiag.DetailText}" Text="{Binding Recommendation, Mode=OneWay}" />
                <TextBlock Style="{StaticResource GpoDiag.DetailHeading}" Text="{l:Tr GpoDiag.AffectedHeading}" />
                <ItemsControl x:Name="AffectedList" Focusable="False" ItemsSource="{Binding AffectedLines, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sys:String}">
                      <TextBlock Margin="0,1" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DetailsFix"
                           Margin="0,8,0,0"
                           Style="{StaticResource Ad.SecondaryText}"
                           Text="{Binding FixText, Mode=OneWay}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
