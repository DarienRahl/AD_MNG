<!--
  Shared resources of "Diagnostyka zasad grupy" and the GPO document's "Stan" tab (K6, design note 20.2), merged by
  GroupPolicyDiagnosticsView and GroupPolicyHealthPanel. Severity colours as the Watchdog tab (Themes/Watchdog.xaml):
  Critical/High SystemFillColorCriticalBrush (Critical with a ring in the text colour), Medium SystemFillColorCautionBrush,
  Low AccentFillColorDefaultBrush, Info TextFillColorSecondaryBrush. The styles read the severity from the element's Tag.
  Theme brushes are DynamicResource only (light, dark and high contrast).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:diag="clr-namespace:AdMng.Core.GroupPolicy.Diagnostics;assembly=AdMng.Core">

  <!-- Severity dot (Tag = GpoFindingSeverity). -->
  <Style x:Key="GpoDiag.SeverityDot" TargetType="Ellipse">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static diag:GpoFindingSeverity.Critical}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="-1,0,7,0" />
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static diag:GpoFindingSeverity.High}">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static diag:GpoFindingSeverity.Medium}">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static diag:GpoFindingSeverity.Low}">
        <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Severity text next to the dot: Critical is semibold in the critical colour, Info is secondary (Tag = GpoFindingSeverity). -->
  <Style x:Key="GpoDiag.SeverityText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static diag:GpoFindingSeverity.Critical}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static diag:GpoFindingSeverity.Info}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A heading inside the details of a finding ("Dlaczego to ważne", "Co zrobić", "Czego dotyczy"). -->
  <Style x:Key="GpoDiag.DetailHeading" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,10,0,2" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- A paragraph of the details. -->
  <Style x:Key="GpoDiag.DetailText" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>
