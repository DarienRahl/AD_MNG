<!--
  The bars above every Group Policy document (GroupPolicyDocumentBase): the load error, "SYSVOL niedostępny: …" (SYSVOL
  writes are disabled, LDAP reads still shown) and the PDC note with "Zmień kontroler…" (the window never switches the DC
  by itself, CLAUDE.md rule 4).
-->
<UserControl x:Class="AdMng.App.GroupPolicy.GroupPolicyBanners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             Focusable="False">
  <StackPanel>
    <Border x:Name="ErrorBar"
            Margin="0,0,0,6"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock x:Name="ErrorText"
                 AutomationProperties.LiveSetting="Assertive"
                 Text="{Binding Error, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Border>
    <Border x:Name="SysvolBar"
            Margin="0,0,0,6"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding HasSysvolWarning, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <DockPanel>
        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Warning}" />
        <TextBlock x:Name="SysvolText"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding SysvolWarning, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border x:Name="PdcBar"
            Margin="0,0,0,6"
            Padding="12,6"
            Style="{StaticResource Ad.Card}"
            Visibility="{Binding HasPdcNote, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <DockPanel>
        <Button x:Name="ChangeDcButton"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ChangeDomainControllerCommand}"
                Content="{l:Tr GroupPolicy.ChangeDcCommand}"
                DockPanel.Dock="Right" />
        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Info}" />
        <TextBlock x:Name="PdcText"
                   VerticalAlignment="Center"
                   Text="{Binding PdcNote, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
