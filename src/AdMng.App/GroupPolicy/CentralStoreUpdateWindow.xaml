<!--
  "Zaktualizuj szablony ADMX" (CentralStoreUpdateViewModel, modal, K3): the package (a file, a folder, the templates of
  this computer or a download of Edge, Chrome or Firefox), its trust and the files it skips, the languages, the files of
  the central store that change, the backup of the store to a folder the operator picks, and "Zaktualizuj…" (the change
  plan preview). The one status line (design note 6.1 and "V2b-3 as built") says what runs while a package loads, the store
  is compared or updated - with Stop -, what the comparison found, how a load or an update ended, and why there is no
  comparison to show (with Retry); what the package and the store are stays in notes.
-->
<Window x:Class="AdMng.App.GroupPolicy.CentralStoreUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:at="clr-namespace:AdMng.Presentation.GroupPolicy.AdministrativeTemplates;assembly=AdMng.Presentation"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="900"
        Height="716"
        MinWidth="640"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
    <Style x:Key="FileRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Path, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChange, Mode=OneWay}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <!--
          "Zaktualizuj…" is an action button: while the backup and the plan it started run, the same button is their Cancel
          (it keeps the keyboard focus), then "Stopping…". The change plan preview that follows is a window of its own.
        -->
        <c:ActionButton x:Name="UpdateButton"
                        CancelCommand="{Binding Status.CancelCommand, Mode=OneWay}"
                        Command="{Binding UpdateCommand}"
                        Content="{l:Tr CentralStore.Update}"
                        IsCancelling="{Binding Status.IsCancelling, Mode=OneWay}"
                        IsDefault="True"
                        IsRunning="{Binding IsUpdating, Mode=OneWay}"
                        Style="{StaticResource Ad.AccentDialogActionButton}" />
        <Button x:Name="CloseButton"
                Command="{Binding CloseCommand}"
                Content="{l:Tr CentralStore.Close}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <!--
      Status line: at the top, above the target and the sources; declared after the footer, so Tab goes from the buttons
      to what the line offers and then to the sources. Its picture stands over the left edge of the content.
    -->
    <c:StatusLine x:Name="PageStatus"
                  Margin="12,8,12,0"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  DockPanel.Dock="Top"
                  Status="{Binding Status.Current, Mode=OneWay}" />

    <Grid Margin="20,8,20,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Target and sources -->
      <StackPanel>
        <TextBlock x:Name="TargetText" Style="{StaticResource Ad.SecondaryText}" Text="{Binding TargetText, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Margin="0,10,0,4" Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr CentralStore.Sources}" />
        <WrapPanel>
          <Button x:Name="OpenFileButton" Margin="0,0,6,6" Command="{Binding OpenFileCommand}" Content="{l:Tr CentralStore.OpenFile}" />
          <Button x:Name="OpenFolderButton" Margin="0,0,6,6" Command="{Binding OpenFolderCommand}" Content="{l:Tr CentralStore.OpenFolder}" />
          <Button x:Name="LocalStoreButton" Margin="0,0,18,6" Command="{Binding UseLocalStoreCommand}" Content="{l:Tr CentralStore.UseLocalStore}" />
          <Button x:Name="EdgeButton" Margin="0,0,6,6" Command="{Binding DownloadEdgeCommand}" Content="{l:Tr CentralStore.DownloadEdge}" />
          <Button x:Name="ChromeButton" Margin="0,0,6,6" Command="{Binding DownloadChromeCommand}" Content="{l:Tr CentralStore.DownloadChrome}" />
          <Button x:Name="FirefoxButton" Margin="0,0,6,6" Command="{Binding DownloadFirefoxCommand}" Content="{l:Tr CentralStore.DownloadFirefox}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr CentralStore.SourcesHint}" TextWrapping="Wrap" />
        <TextBlock Margin="0,2,0,0"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr CentralStore.InstallersWindowsOnly}"
                   TextWrapping="Wrap"
                   Visibility="{Binding CanExtractInstallers, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
      </StackPanel>

      <!-- The package -->
      <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,8" Style="{StaticResource Ad.Card}">
        <StackPanel>
          <TextBlock x:Name="PackageText" FontWeight="SemiBold" Text="{Binding PackageText, Mode=OneWay}" TextWrapping="Wrap" />
          <DockPanel Margin="0,4,0,0" Visibility="{Binding HasPackage, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
            <TextBlock Margin="0,1,8,0"
                       VerticalAlignment="Top"
                       DockPanel.Dock="Left"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Style="{StaticResource Ad.GlyphText}"
                       Text="{x:Static c:Glyphs.Warning}"
                       Visibility="{Binding IsUntrusted, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
            <TextBlock x:Name="TrustText" Style="{StaticResource Ad.SecondaryText}" Text="{Binding TrustText, Mode=OneWay}" TextWrapping="Wrap" />
          </DockPanel>
          <!-- Files the package does not use (a second template of a name, a file too large): never skipped unnoticed. -->
          <DockPanel Margin="0,4,0,0" Visibility="{Binding HasPackageIssues, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
            <TextBlock Margin="0,5,8,0"
                       VerticalAlignment="Top"
                       DockPanel.Dock="Left"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Style="{StaticResource Ad.GlyphText}"
                       Text="{x:Static c:Glyphs.Warning}" />
            <Expander x:Name="PackageIssuesExpander" Header="{Binding PackageIssuesTitle, Mode=OneWay}">
              <ItemsControl x:Name="PackageIssuesList" MaxHeight="96" ItemsSource="{Binding PackageIssues, Mode=OneWay}">
                <ItemsControl.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Margin="0,1" Style="{StaticResource Ad.SecondaryText}" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Languages -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding HasPackage, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Margin="0,0,0,4" Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr CentralStore.Languages}" />
        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="CultureList"
                        IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.InverseBool}}"
                        ItemsSource="{Binding Cultures, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type at:CultureChoiceViewModel}">
                <CheckBox MinWidth="200"
                          Margin="0,0,12,2"
                          AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}"
                          Content="{Binding DisplayName, Mode=OneWay}"
                          IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- Files -->
      <DockPanel Grid.Row="3" Margin="0,10,0,0">
        <TextBlock Margin="0,0,0,4" DockPanel.Dock="Top" Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr CentralStore.Files}" />
        <!-- The store does not exist yet: true of the files below for as long as they are shown. -->
        <ContentControl x:Name="StoreNoteBar"
                        Margin="0,0,0,6"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Ad.Note.Attention}"
                        Visibility="{Binding StoreNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
          <TextBlock x:Name="StoreNoteText"
                     AutomationProperties.LiveSetting="Polite"
                     Text="{Binding StoreNote, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </ContentControl>
        <ListView x:Name="FileList"
                  AutomationProperties.Name="{l:Tr CentralStore.Files}"
                  ItemContainerStyle="{StaticResource FileRowStyle}"
                  ItemsSource="{Binding Rows, Mode=OneWay}"
                  VirtualizingPanel.IsVirtualizing="True">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="300" DisplayMemberBinding="{Binding Path, Mode=OneWay}" Header="{l:Tr CentralStore.ColumnFile}" />
              <GridViewColumn Width="220" DisplayMemberBinding="{Binding StatusText, Mode=OneWay}" Header="{l:Tr CentralStore.ColumnStatus}" />
              <GridViewColumn Width="300" DisplayMemberBinding="{Binding DetailText, Mode=OneWay}" Header="{l:Tr CentralStore.ColumnDetail}" />
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>

      <!-- Options -->
      <StackPanel Grid.Row="4" Margin="0,10,0,0">
        <CheckBox x:Name="ReplaceCollidingBox"
                  IsChecked="{Binding ReplaceCollidingFiles}"
                  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.InverseBool}}">
          <TextBlock Text="{l:Tr CentralStore.ReplaceColliding}" TextWrapping="Wrap" />
        </CheckBox>
        <DockPanel Margin="0,8,0,0">
          <Button x:Name="ChooseBackupButton"
                  Margin="8,0,0,0"
                  Command="{Binding ChooseBackupFolderCommand}"
                  Content="{l:Tr CentralStore.ChooseFolder}"
                  DockPanel.Dock="Right" />
          <CheckBox x:Name="MakeBackupBox" Margin="0,0,8,0" VerticalAlignment="Center" Content="{l:Tr CentralStore.MakeBackup}" IsChecked="{Binding MakeBackup}" />
          <TextBox x:Name="BackupFolderBox"
                   AutomationProperties.Name="{l:Tr CentralStore.BackupFolderTitle}"
                   IsEnabled="{Binding MakeBackup, Mode=OneWay}"
                   Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
