<!-- Choose GPOs of the domain (GpoPickerViewModel, modal): "Połącz istniejący GPO…", "Porównaj z…". -->
<Window x:Class="AdMng.App.GroupPolicy.GpoPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:gpm="clr-namespace:AdMng.Presentation.GroupPolicy;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="640"
        Height="520"
        MinWidth="460"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
    <Style x:Key="PickerRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="OkButton"
                Command="{Binding OkCommand}"
                Content="{l:Tr Common.Ok}"
                IsDefault="True"
                Style="{StaticResource Ad.AccentDialogButton}" />
        <Button x:Name="CancelButton"
                Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>
    <Grid Margin="16,12,16,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <TextBox x:Name="FilterBox"
                 AutomationProperties.Name="{l:Tr GroupPolicy.PickerFilter}"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
        <TextBlock Style="{StaticResource Ad.HintText}"
                   Text="{l:Tr GroupPolicy.PickerFilter}"
                   Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource Ad.EmptyToVisible}}" />
      </Grid>
      <Border x:Name="ErrorBar"
              Grid.Row="1"
              Margin="0,8,0,0"
              Style="{StaticResource Ad.ErrorBar}"
              Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock Text="{Binding Error, Mode=OneWay}" TextWrapping="Wrap" />
      </Border>
      <ListView x:Name="GpoList"
                Grid.Row="2"
                Margin="0,8,0,0"
                AutomationProperties.Name="{Binding WindowTitle, Mode=OneWay}"
                ItemContainerStyle="{StaticResource PickerRowStyle}"
                ItemsSource="{Binding Items, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem}"
                SelectionMode="Single">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Width="44">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type gpm:GpoPickerItem}">
                  <CheckBox MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                            IsChecked="{Binding IsChecked}"
                            Visibility="{Binding DataContext.MultiSelect, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Ad.BoolToVisibility}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="330" Header="{l:Tr GroupPolicy.ColumnName}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type gpm:GpoPickerItem}">
                  <DockPanel>
                    <c:ObjectIconView Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left" Icon="GroupPolicy" Size="16" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="220" DisplayMemberBinding="{Binding StatusText, Mode=OneWay}" Header="{l:Tr GroupPolicy.ColumnStatus}" />
          </GridView>
        </ListView.View>
      </ListView>
      <ProgressBar Grid.Row="2"
                   Width="120"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsIndeterminate="True"
                   Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</Window>
