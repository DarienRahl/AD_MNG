<!--
  "Gotowość środowiska" (ReadinessDocumentViewModel, stage S, design note docs/dev/s-pilot-readiness.md 2): the quick and the
  full check with progress and cancel, the test computer of the full check (typed or picked from AD), the last run or the
  progress, the stale bar after a change of the connection, the read-only and export notes, and the areas with their checks
  (status glyph, title and host, what was found, what to do, the chapter to read). Copy and exports to CSV and HTML.
  Theme brushes are DynamicResource only (light, dark and high contrast).
-->
<UserControl x:Class="AdMng.App.Readiness.ReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:rd="clr-namespace:AdMng.Presentation.Readiness;assembly=AdMng.Presentation"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <!-- Status glyph (Tag = ReadinessStatus): a check mark, a warning, an error, or the secondary info glyph of "not checked". -->
    <Style x:Key="Readiness.StatusGlyph" TargetType="TextBlock" BasedOn="{StaticResource Ad.GlyphText}">
      <Setter Property="Margin" Value="0,2,10,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Text" Value="{x:Static c:Glyphs.Info}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="{x:Static rd:ReadinessStatus.Ok}">
          <Setter Property="Text" Value="{x:Static c:Glyphs.Completed}" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static rd:ReadinessStatus.Warning}">
          <Setter Property="Text" Value="{x:Static c:Glyphs.Warning}" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static rd:ReadinessStatus.Error}">
          <Setter Property="Text" Value="{x:Static c:Glyphs.Error}" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Readiness.Paragraph" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="8,6,8,8">
    <!-- Header: the title trimmed in its column, the checks, copy and exports in their own -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <c:ObjectIconView Margin="0,0,8,0" VerticalAlignment="Center" Icon="{Binding Icon, Mode=OneWay}" Size="18" />
      <TextBlock x:Name="TitleText"
                 Grid.Column="1"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="{Binding Title, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Title, Mode=OneWay}" />
      <WrapPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <Button x:Name="QuickCheckButton"
                Margin="0,0,6,0"
                Command="{Binding QuickCheckCommand}"
                Content="{l:Tr Readiness.QuickCheck}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTip="{l:Tr Readiness.QuickCheckHint}" />
        <Button x:Name="FullCheckButton"
                Margin="0,0,6,0"
                Command="{Binding FullCheckCommand}"
                Content="{l:Tr Readiness.FullCheck}"
                ToolTip="{l:Tr Readiness.FullCheckHint}" />
        <Button x:Name="CancelButton" Margin="0,0,12,0" Command="{Binding CancelCommand}" Content="{l:Tr Common.Cancel}" />
        <Button x:Name="CopyButton" Margin="0,0,6,0" Command="{Binding CopyCommand}" Content="{l:Tr Readiness.Copy}" />
        <Button x:Name="ExportCsvButton"
                Margin="0,0,6,0"
                Command="{Binding ExportCsvCommand}"
                Content="{l:Tr Readiness.ExportCsv}"
                ToolTip="{l:Tr Readiness.ExportNote}" />
        <Button x:Name="ExportHtmlButton" Command="{Binding ExportHtmlCommand}" Content="{l:Tr Readiness.ExportHtml}" ToolTip="{l:Tr Readiness.ExportNote}" />
      </WrapPanel>
    </Grid>

    <!-- The test computer of the full check: typed, or picked from AD -->
    <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
      <TextBlock Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 DockPanel.Dock="Left"
                 Text="{l:Tr Readiness.TestComputerLabel}" />
      <Grid Width="320" DockPanel.Dock="Left">
        <TextBox x:Name="TestComputerBox"
                 AutomationProperties.Name="{l:Tr Readiness.TestComputerLabel}"
                 Text="{Binding TestComputerText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{l:Tr Readiness.TestComputerHint}" />
        <TextBlock Style="{StaticResource Ad.HintText}"
                   Text="{l:Tr Readiness.TestComputerPlaceholder}"
                   Visibility="{Binding Text, ElementName=TestComputerBox, Converter={StaticResource Ad.EmptyToVisible}}" />
      </Grid>
      <Button x:Name="PickTestComputerButton"
              Margin="6,0,12,0"
              Command="{Binding PickTestComputerCommand}"
              Content="{l:Tr Readiness.PickTestComputer}"
              DockPanel.Dock="Left" />
      <TextBlock VerticalAlignment="Center"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr Readiness.TestComputerHint}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{l:Tr Readiness.TestComputerHint}" />
    </DockPanel>

    <!-- The last check, or the progress of the running one -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <TextBlock x:Name="LastRunText"
                 VerticalAlignment="Center"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding LastRunText, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding LastRunText, Mode=OneWay}"
                 Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
      <DockPanel x:Name="ProgressPanel" Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <ProgressBar x:Name="CheckProgress"
                     Width="220"
                     Height="4"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding ProgressText, Mode=OneWay}"
                     DockPanel.Dock="Left"
                     Maximum="100"
                     Value="{Binding ProgressValue, Mode=OneWay}" />
        <TextBlock x:Name="ProgressText"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding ProgressText, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Grid>

    <!-- The connection changed after the shown check -->
    <Border x:Name="StaleBar"
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding IsStale, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <DockPanel>
        <Button x:Name="CheckAgainButton"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding CheckAgainCommand}"
                Content="{l:Tr Readiness.CheckAgain}"
                DockPanel.Dock="Right" />
        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Warning}" />
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Readiness.Stale}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- What the check is (read-only) and what an export holds (host names); a cancelled run says so -->
    <Border x:Name="NotesBar"
            Margin="0,0,0,6"
            Padding="12,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.Card}">
      <DockPanel>
        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Info}" />
        <StackPanel>
          <TextBlock x:Name="CancelledText"
                     Margin="0,0,0,2"
                     FontWeight="SemiBold"
                     Text="{l:Tr Readiness.Cancelled}"
                     TextWrapping="Wrap"
                     Visibility="{Binding WasCancelled, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock Text="{l:Tr Readiness.ReadOnlyNote}" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{l:Tr Readiness.ExportNote}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock x:Name="SummaryTextBlock"
               Margin="0,0,0,6"
               DockPanel.Dock="Top"
               FontWeight="SemiBold"
               Text="{Binding SummaryText, Mode=OneWay}"
               Visibility="{Binding HasResult, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />

    <!-- The areas with their checks -->
    <ScrollViewer x:Name="ResultsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="GroupsList"
                    AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                    Focusable="False"
                    ItemsSource="{Binding Groups, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type rd:ReadinessGroupViewModel}">
            <Border Margin="0,0,0,8" Padding="12,8" Style="{StaticResource Ad.Card}">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
                             DockPanel.Dock="Left"
                             Style="{StaticResource Readiness.StatusGlyph}"
                             Tag="{Binding Status, Mode=OneWay}"
                             ToolTip="{Binding StatusText, Mode=OneWay}" />
                  <TextBlock Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Right"
                             Style="{StaticResource Ad.SecondaryText}"
                             Text="{Binding SummaryText, Mode=OneWay}" />
                  <TextBlock VerticalAlignment="Center"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Text="{Binding Title, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ItemsControl AutomationProperties.Name="{Binding Title, Mode=OneWay}" Focusable="False" ItemsSource="{Binding Rows, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type rd:ReadinessRowViewModel}">
                      <DockPanel Margin="0,4,0,6" AutomationProperties.Name="{Binding Title, Mode=OneWay}">
                        <TextBlock AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
                                   DockPanel.Dock="Left"
                                   Style="{StaticResource Readiness.StatusGlyph}"
                                   Tag="{Binding Status, Mode=OneWay}"
                                   ToolTip="{Binding StatusText, Mode=OneWay}" />
                        <StackPanel>
                          <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Host, Mode=OneWay}" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Style="{StaticResource Readiness.Paragraph}" Text="{Binding Explanation, Mode=OneWay}" />
                          <TextBlock Style="{StaticResource Readiness.Paragraph}"
                                     Text="{Binding RemedyText, Mode=OneWay}"
                                     Visibility="{Binding HasRemedy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                          <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Style="{StaticResource Readiness.Paragraph}"
                                     Text="{Binding DocumentationText, Mode=OneWay}"
                                     Visibility="{Binding ShowsDocumentation, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
