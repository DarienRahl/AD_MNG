<!--
  "Gotowość na silne mapowanie i NTAuth" (PkiReadinessDocumentViewModel, P1 W6, design note docs/dev/p-certificate-services.md
  2.5) - a PKI-area document, not the stage-S readiness check: "Odczytaj ponownie", "Sprawdź certyfikaty LDAPS" (the only
  action that connects to the domain controllers, decision 1), copy and the CSV export; the last read or the progress, the
  read-only note, the summary and the six areas (weak mappings, authentication templates without the SID extension, CAs
  outside NTAuth, DC LDAPS, the KDC indicator, the KDC events of P5) with their rows: status glyph, the item and its status,
  what was found, what to do and the row's "Otwórz konto / szablon / urząd". Theme brushes are DynamicResource only.
-->
<UserControl x:Class="AdMng.App.Pki.PkiReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:pki="clr-namespace:AdMng.Presentation.Pki;assembly=AdMng.Presentation"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <!-- Status glyph (Tag = PkiReadinessStatus): a check mark, a warning, an error, or the secondary info glyph of "nie sprawdzono". -->
    <Style x:Key="PkiReady.StatusGlyph" TargetType="TextBlock" BasedOn="{StaticResource Ad.GlyphText}">
      <Setter Property="Margin" Value="0,2,10,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Text" Value="{x:Static c:Glyphs.Info}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="{x:Static pki:PkiReadinessStatus.Ok}">
          <Setter Property="Text" Value="{x:Static c:Glyphs.Completed}" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static pki:PkiReadinessStatus.Warning}">
          <Setter Property="Text" Value="{x:Static c:Glyphs.Warning}" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static pki:PkiReadinessStatus.Problem}">
          <Setter Property="Text" Value="{x:Static c:Glyphs.Error}" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PkiReady.Paragraph" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="8,6,8,8">
    <!-- Header: the title trimmed in its column, the read, the LDAPS check, copy and export in their own -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <c:ObjectIconView Margin="0,0,8,0" VerticalAlignment="Center" Icon="{Binding Icon, Mode=OneWay}" Size="18" />
      <TextBlock x:Name="TitleText"
                 Grid.Column="1"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="{Binding Title, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Title, Mode=OneWay}" />
      <WrapPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <Button x:Name="CheckAgainButton"
                Margin="0,0,6,0"
                Command="{Binding RefreshCommand}"
                Content="{l:Tr PkiReady.CheckAgain}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTip="{l:Tr PkiReady.CheckAgainHint}" />
        <Button x:Name="CheckLdapsButton"
                Margin="0,0,12,0"
                Command="{Binding CheckLdapsCommand}"
                Content="{l:Tr PkiReady.CheckLdaps}"
                ToolTip="{l:Tr PkiReady.CheckLdapsHint}"
                ToolTipService.ShowOnDisabled="True" />
        <Button x:Name="CopyButton" Margin="0,0,6,0" Command="{Binding CopyCommand}" Content="{l:Tr PkiReady.Copy}" />
        <Button x:Name="ExportCsvButton" Command="{Binding ExportCsvCommand}" Content="{l:Tr PkiReady.ExportCsv}" />
      </WrapPanel>
    </Grid>

    <!-- The last read, or the progress of the running read or LDAPS check -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <TextBlock x:Name="LastRunText"
                 VerticalAlignment="Center"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding LastRunText, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding LastRunText, Mode=OneWay}"
                 Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
      <DockPanel x:Name="ProgressPanel" Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <ProgressBar x:Name="ReadProgress"
                     Width="220"
                     Height="4"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding ProgressText, Mode=OneWay}"
                     DockPanel.Dock="Left"
                     IsIndeterminate="{Binding IsBusy, Mode=OneWay}" />
        <TextBlock x:Name="ProgressText"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding ProgressText, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Grid>

    <!-- What the report is (read-only; the LDAPS check only on its button) -->
    <Border x:Name="NotesBar"
            Margin="0,0,0,6"
            Padding="12,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.Card}">
      <DockPanel>
        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Info}" />
        <TextBlock x:Name="ReadOnlyNoteText" Text="{l:Tr PkiReady.ReadOnlyNote}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <TextBlock x:Name="SummaryTextBlock"
               Margin="0,0,0,6"
               DockPanel.Dock="Top"
               FontWeight="SemiBold"
               Text="{Binding SummaryText, Mode=OneWay}"
               Visibility="{Binding HasResult, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />

    <!-- The areas with their rows -->
    <ScrollViewer x:Name="ResultsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="GroupsList"
                    AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                    Focusable="False"
                    ItemsSource="{Binding Groups, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type pki:PkiReadinessGroupViewModel}">
            <Border Margin="0,0,0,8" Padding="12,8" Style="{StaticResource Ad.Card}">
              <StackPanel>
                <DockPanel Margin="0,0,0,2">
                  <TextBlock AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
                             DockPanel.Dock="Left"
                             Style="{StaticResource PkiReady.StatusGlyph}"
                             Tag="{Binding Status, Mode=OneWay}"
                             ToolTip="{Binding StatusText, Mode=OneWay}" />
                  <TextBlock Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             DockPanel.Dock="Right"
                             Style="{StaticResource Ad.SecondaryText}"
                             Text="{Binding SummaryText, Mode=OneWay}" />
                  <TextBlock VerticalAlignment="Center"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Text="{Binding Title, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Title, Mode=OneWay}" />
                </DockPanel>
                <TextBlock Margin="0,0,0,6"
                           Style="{StaticResource Ad.SecondaryText}"
                           Text="{Binding Description, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasDescription, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                <ItemsControl AutomationProperties.Name="{Binding Title, Mode=OneWay}" Focusable="False" ItemsSource="{Binding Rows, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiReadinessRowViewModel}">
                      <DockPanel Margin="0,4,0,6" AutomationProperties.Name="{Binding Title, Mode=OneWay}">
                        <TextBlock AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
                                   DockPanel.Dock="Left"
                                   Style="{StaticResource PkiReady.StatusGlyph}"
                                   Tag="{Binding Status, Mode=OneWay}"
                                   ToolTip="{Binding StatusText, Mode=OneWay}" />
                        <Button Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding OpenCommand, Mode=OneWay}"
                                Content="{Binding OpenText, Mode=OneWay}"
                                DockPanel.Dock="Right"
                                Visibility="{Binding HasOpen, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                        <StackPanel>
                          <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Style="{StaticResource PkiReady.Paragraph}" Text="{Binding Detail, Mode=OneWay}" />
                          <TextBlock Style="{StaticResource PkiReady.Paragraph}"
                                     Text="{Binding RemedyText, Mode=OneWay}"
                                     Visibility="{Binding HasRemedy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
