<!--
  "Usługi kluczy publicznych" (PkiOverviewDocumentViewModel, P1, docs/dev/p-certificate-services.md 2.5): the summary of the
  window's PKI snapshot and the notices of the read, then the tabs – enterprise CAs (list and the selected CA's certificate,
  path, templates to issue with "Otwórz szablon", CES, "Otwórz komputer" / "Zdalne akcje"), trusted CAs and NTAuth, CRLs, key
  recovery agents, OIDs (the linked group opens), the pkiview-style health with "Sprawdź adresy HTTP" (the operator's button
  only) and the DC LDAPS certificates (probed on the tab's first activation or its button). Read-only; layout and palette as
  "Diagnostyka zasad grupy".
-->
<UserControl x:Class="AdMng.App.Pki.PkiOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:gp="clr-namespace:AdMng.App.GroupPolicy"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:pki="clr-namespace:AdMng.Presentation.Pki;assembly=AdMng.Presentation"
             xmlns:pkicore="clr-namespace:AdMng.Core.Pki;assembly=AdMng.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AdMng;component/GroupPolicy/GroupPolicyDiagnosticsResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
      <Style x:Key="PkiRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="2,0" />
      </Style>
      <!-- The state dot of a certificate, CRL or health row (Tag = PkiHealthStatus). -->
      <Style x:Key="Pki.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
          <Trigger Property="Tag" Value="{x:Static pkicore:PkiHealthStatus.Ok}">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          </Trigger>
          <Trigger Property="Tag" Value="{x:Static pkicore:PkiHealthStatus.Expiring}">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
          </Trigger>
          <Trigger Property="Tag" Value="{x:Static pkicore:PkiHealthStatus.Expired}">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
          </Trigger>
          <Trigger Property="Tag" Value="{x:Static pkicore:PkiHealthStatus.Unavailable}">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="StatusCell">
        <StackPanel Orientation="Horizontal">
          <Ellipse Style="{StaticResource Pki.StatusDot}" Tag="{Binding Status, Mode=OneWay}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DataTemplate>
      <!-- One label/value line of a details pane. -->
      <DataTemplate x:Key="DetailLine" DataType="{x:Type pki:PkiDetailLine}">
        <StackPanel Margin="0,0,0,4">
          <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding Label, Mode=OneWay}" />
          <TextBox AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                   Style="{StaticResource Ad.SelectableText}"
                   Text="{Binding Value, Mode=OneWay}"
                   TextWrapping="Wrap" />
        </StackPanel>
      </DataTemplate>
      <Style x:Key="EmptyListText" TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
        <Setter Property="Margin" Value="16,48,16,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,6,4" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Margin="8,6,8,8">
    <!-- Header: the title, F5 -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <c:ObjectIconView Margin="0,0,8,0" VerticalAlignment="Center" Icon="{Binding Icon, Mode=OneWay}" Size="18" />
      <TextBlock x:Name="TitleText"
                 Grid.Column="1"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="{Binding Title, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Title, Mode=OneWay}" />
      <Button x:Name="RefreshButton"
              Grid.Column="2"
              VerticalAlignment="Center"
              Command="{Binding RefreshCommand}"
              Content="{l:Tr Pki.RefreshCommand}" />
    </Grid>

    <!-- The summary of the read, or its progress -->
    <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
      <StackPanel Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}">
        <TextBlock x:Name="SummaryText" Text="{Binding SummaryText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ReadAtText" Style="{StaticResource Ad.SecondaryText}" Text="{Binding ReadAtText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <DockPanel x:Name="ProgressPanel" Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <ProgressBar Width="220"
                     Height="4"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
                     DockPanel.Dock="Left"
                     IsIndeterminate="True" />
        <TextBlock x:Name="ProgressText"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding StatusText, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Grid>

    <Border x:Name="ErrorBar"
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Text="{Binding Error, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>

    <!-- What the read observed (no AD CS, a hidden container, an unreadable descriptor …) -->
    <Border x:Name="NoticesBar"
            Margin="0,0,0,6"
            Padding="12,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.Card}"
            Visibility="{Binding HasNotices, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <DockPanel>
        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Info}" />
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="{l:Tr Pki.NoticesHeading}" />
          <ItemsControl x:Name="NoticesList" ItemsSource="{Binding Notices, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type sys:String}">
                <TextBlock Margin="0,1" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock Margin="0,0,0,6"
               DockPanel.Dock="Bottom"
               Style="{StaticResource Ad.SecondaryText}"
               Text="{Binding ReadOnlyNote, Mode=OneWay}"
               TextWrapping="Wrap" />

    <TabControl x:Name="OverviewTabs" SelectedIndex="{Binding SelectedTabIndex}">
      <!-- Enterprise CAs -->
      <TabItem x:Name="AuthoritiesTab" Header="{l:Tr Pki.SectionAuthorities}">
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="440" MinWidth="280" />
          </Grid.ColumnDefinitions>
          <Grid>
            <ListView x:Name="AuthoritiesList"
                      AutomationProperties.Name="{l:Tr Pki.SectionAuthorities}"
                      ItemContainerStyle="{StaticResource PkiRowStyle}"
                      ItemsSource="{Binding Authorities, Mode=OneWay}"
                      SelectedItem="{Binding SelectedAuthority}"
                      SelectionMode="Single">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="220" Header="{l:Tr Pki.ColumnName}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCaRowViewModel}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Dn, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="180" Header="{l:Tr Pki.ColumnHost}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCaRowViewModel}">
                        <TextBlock Text="{Binding Host, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="100" Header="{l:Tr Pki.ColumnValidTo}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCaRowViewModel}">
                        <TextBlock Text="{Binding ValidToText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="110" CellTemplate="{StaticResource StatusCell}" Header="{l:Tr Pki.ColumnStatus}" />
                  <GridViewColumn Width="150" Header="{l:Tr Pki.ColumnNtAuth}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCaRowViewModel}">
                        <TextBlock Text="{Binding NtAuthText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="80" Header="{l:Tr Pki.ColumnTemplates}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCaRowViewModel}">
                        <TextBlock Text="{Binding TemplatesText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock Style="{StaticResource EmptyListText}"
                       Text="{l:Tr Pki.NoneFound}"
                       Visibility="{Binding HasSelectedAuthority, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
          </Grid>

          <gp:PaneSplitter Grid.Column="1" ResizeDirection="Columns" />

          <Border Grid.Column="2" Padding="12,8" Style="{StaticResource Ad.Card}">
            <Grid>
              <TextBlock Style="{StaticResource Ad.SecondaryText}"
                         Text="{l:Tr Pki.CaDetailsEmpty}"
                         TextWrapping="Wrap"
                         Visibility="{Binding HasSelectedAuthority, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
              <ScrollViewer x:Name="CaDetailsScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding HasSelectedAuthority, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                <StackPanel x:Name="CaDetails">
                  <TextBlock Margin="0,0,0,6"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Text="{Binding SelectedAuthority.Name, Mode=OneWay}"
                             TextWrapping="Wrap" />
                  <Border Margin="0,0,0,6"
                          Style="{StaticResource Ad.WarningBar}"
                          Visibility="{Binding SelectedAuthority.HasNtAuthWarning, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock x:Name="NtAuthWarningText" Text="{Binding SelectedAuthority.NtAuthWarning, Mode=OneWay}" TextWrapping="Wrap" />
                  </Border>
                  <WrapPanel>
                    <Button x:Name="OpenComputerButton" Command="{Binding OpenComputerCommand}" Content="{l:Tr Pki.OpenComputer}" Style="{StaticResource ActionButton}" />
                    <Button x:Name="RemoteActionsButton"
                            Command="{Binding OpenRemoteActionsCommand}"
                            Content="{l:Tr Pki.RemoteActions}"
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding CanOpenRemoteActionsAtAll, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource Ad.SecondaryText}"
                             Text="{Binding SelectedAuthority.ComputerNote, Mode=OneWay}"
                             TextWrapping="Wrap"
                             Visibility="{Binding SelectedAuthority.HasComputerNote, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}, FallbackValue=Collapsed}" />
                  <TextBlock Style="{StaticResource GpoDiag.DetailHeading}" Text="{l:Tr Pki.CaCertificate}" />
                  <ItemsControl x:Name="CaDetailLines" Focusable="False" ItemTemplate="{StaticResource DetailLine}" ItemsSource="{Binding SelectedAuthority.Details, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource GpoDiag.DetailHeading}" Text="{l:Tr Pki.Chain}" />
                  <ItemsControl x:Name="ChainList" Focusable="False" ItemsSource="{Binding SelectedAuthority.Chain, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Margin="0,1" Text="{Binding Mode=OneWay, StringFormat={}↳ {0}}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource GpoDiag.DetailHeading}" Text="{l:Tr Pki.PublishedTemplates}" />
                  <ItemsControl x:Name="PublishedTemplatesList" Focusable="False" ItemsSource="{Binding SelectedAuthority.PublishedTemplates, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type sys:String}">
                        <Button Padding="8,2"
                                AutomationProperties.Name="{Binding Mode=OneWay}"
                                Command="{Binding DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Mode=OneWay}"
                                Content="{Binding Mode=OneWay}"
                                Style="{StaticResource ActionButton}"
                                ToolTip="{l:Tr Pki.OpenTemplate}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Visibility="{Binding SelectedAuthority.HasEnrollmentServers, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Style="{StaticResource GpoDiag.DetailHeading}" Text="{l:Tr Pki.EnrollmentServers}" />
                    <ItemsControl x:Name="EnrollmentServersList" Focusable="False" ItemsSource="{Binding SelectedAuthority.EnrollmentServers, Mode=OneWay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type sys:String}">
                          <TextBox Margin="0,1" Style="{StaticResource Ad.SelectableText}" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Trusted root and intermediate CAs, NTAuth -->
      <TabItem x:Name="TrustTab" Header="{l:Tr Pki.SectionTrust}">
        <DockPanel Margin="0,6,0,0">
          <TextBlock x:Name="NtAuthSummaryText" Margin="0,0,0,6" DockPanel.Dock="Top" Text="{Binding NtAuthText, Mode=OneWay}" TextWrapping="Wrap" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="360" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="400" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="TrustList"
                      AutomationProperties.Name="{l:Tr Pki.SectionTrust}"
                      ItemContainerStyle="{StaticResource PkiRowStyle}"
                      ItemsSource="{Binding TrustRows, Mode=OneWay}"
                      SelectedItem="{Binding SelectedCertificate}"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="150" Header="{l:Tr Pki.ColumnStore}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCertificateRowViewModel}">
                        <TextBlock Text="{Binding StoreText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="200" Header="{l:Tr Pki.ColumnSubject}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCertificateRowViewModel}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Subject, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="180" Header="{l:Tr Pki.ColumnIssuer}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCertificateRowViewModel}">
                        <TextBlock Text="{Binding Issuer, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="100" Header="{l:Tr Pki.ColumnValidTo}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCertificateRowViewModel}">
                        <TextBlock Text="{Binding ValidToText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="110" CellTemplate="{StaticResource StatusCell}" Header="{l:Tr Pki.ColumnStatus}" />
                  <GridViewColumn Width="190" Header="{l:Tr Pki.ColumnEnterpriseCa}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCertificateRowViewModel}">
                        <TextBlock Text="{Binding EnterpriseCaText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="300" Header="{l:Tr Pki.ColumnThumbprint}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiCertificateRowViewModel}">
                        <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding Thumbprint, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <gp:PaneSplitter Grid.Column="1" ResizeDirection="Columns" />
            <Border Grid.Column="2" Padding="12,8" Style="{StaticResource Ad.Card}">
              <Grid>
                <TextBlock Style="{StaticResource Ad.SecondaryText}"
                           Text="{l:Tr Pki.CertificateDetailsEmpty}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasSelectedCertificate, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelectedCertificate, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                  <ItemsControl x:Name="CertificateDetailLines" Focusable="False" ItemTemplate="{StaticResource DetailLine}" ItemsSource="{Binding SelectedCertificate.Details, Mode=OneWay}" />
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- CRLs of CN=CDP -->
      <TabItem x:Name="CrlsTab" Header="{l:Tr Pki.SectionCrls}">
        <Grid Margin="0,6,0,0">
          <ListView x:Name="CrlList"
                    AutomationProperties.Name="{l:Tr Pki.SectionCrls}"
                    ItemContainerStyle="{StaticResource PkiRowStyle}"
                    ItemsSource="{Binding CrlRows, Mode=OneWay}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="200" Header="{l:Tr Pki.ColumnCa}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiCrlRowViewModel}">
                      <TextBlock FontWeight="SemiBold" Text="{Binding CaText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="110" Header="{l:Tr Pki.ColumnHost}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiCrlRowViewModel}">
                      <TextBlock Text="{Binding Host, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="230" Header="{l:Tr Pki.ColumnKind}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiCrlRowViewModel}">
                      <TextBlock Text="{Binding KindText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="70" Header="{l:Tr Pki.ColumnNumber}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiCrlRowViewModel}">
                      <TextBlock Text="{Binding NumberText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="140" Header="{l:Tr Pki.ColumnThisUpdate}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiCrlRowViewModel}">
                      <TextBlock Text="{Binding ThisUpdateText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="140" Header="{l:Tr Pki.ColumnNextUpdate}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiCrlRowViewModel}">
                      <TextBlock Text="{Binding NextUpdateText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="80" Header="{l:Tr Pki.ColumnRevoked}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiCrlRowViewModel}">
                      <TextBlock Text="{Binding RevokedText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="110" CellTemplate="{StaticResource StatusCell}" Header="{l:Tr Pki.ColumnStatus}" />
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Style="{StaticResource EmptyListText}"
                     Text="{l:Tr Pki.NoneFound}"
                     Visibility="{Binding HasCrls, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
        </Grid>
      </TabItem>

      <!-- Key recovery agents -->
      <TabItem x:Name="KraTab" Header="{l:Tr Pki.SectionKra}">
        <Grid Margin="0,6,0,0">
          <ListView x:Name="KraList"
                    AutomationProperties.Name="{l:Tr Pki.SectionKra}"
                    ItemContainerStyle="{StaticResource PkiRowStyle}"
                    ItemsSource="{Binding KraRows, Mode=OneWay}"
                    SelectionMode="Single">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="220" Header="{l:Tr Pki.ColumnAgent}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiKraRowViewModel}">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="220" Header="{l:Tr Pki.ColumnSubject}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiKraRowViewModel}">
                      <TextBlock Text="{Binding Subject, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="200" Header="{l:Tr Pki.ColumnIssuer}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiKraRowViewModel}">
                      <TextBlock Text="{Binding Issuer, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="100" Header="{l:Tr Pki.ColumnValidTo}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiKraRowViewModel}">
                      <TextBlock Text="{Binding ValidToText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="110" CellTemplate="{StaticResource StatusCell}" Header="{l:Tr Pki.ColumnStatus}" />
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Style="{StaticResource EmptyListText}"
                     Text="{l:Tr Pki.NoneFound}"
                     Visibility="{Binding HasKra, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
        </Grid>
      </TabItem>

      <!-- OIDs and their group links -->
      <TabItem x:Name="OidsTab" Header="{l:Tr Pki.SectionOids}">
        <Grid Margin="0,6,0,0">
          <ListView x:Name="OidList"
                    AutomationProperties.Name="{l:Tr Pki.SectionOids}"
                    ItemContainerStyle="{StaticResource PkiRowStyle}"
                    ItemsSource="{Binding OidRows, Mode=OneWay}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="240" Header="{l:Tr Pki.ColumnDisplayName}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiOidRowViewModel}">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="160" Header="{l:Tr Pki.ColumnKind}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiOidRowViewModel}">
                      <TextBlock Text="{Binding KindText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="360" Header="{l:Tr Pki.ColumnOid}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiOidRowViewModel}">
                      <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding OidText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OidText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="220" Header="{l:Tr Pki.ColumnGroupLink}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiOidRowViewModel}">
                      <Button Padding="8,0"
                              AutomationProperties.Name="{Binding GroupLinkText, Mode=OneWay}"
                              Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding Mode=OneWay}"
                              Content="{Binding GroupLinkText, Mode=OneWay}"
                              ToolTip="{l:Tr Pki.OpenGroup}"
                              Visibility="{Binding HasGroupLink, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Style="{StaticResource EmptyListText}"
                     Text="{l:Tr Pki.NoneFound}"
                     Visibility="{Binding HasOids, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
        </Grid>
      </TabItem>

      <!-- Health (pkiview) with "Sprawdź adresy HTTP" -->
      <TabItem x:Name="HealthTab" Header="{l:Tr Pki.SectionHealth}">
        <DockPanel Margin="0,6,0,0">
          <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
            <Button x:Name="CheckHttpButton"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding CheckHttpCommand}"
                    Content="{l:Tr Pki.CheckHttp}"
                    DockPanel.Dock="Right"
                    ToolTip="{l:Tr Pki.CheckHttpHint}" />
            <StackPanel>
              <TextBlock x:Name="HealthSummaryText" FontWeight="SemiBold" Text="{Binding HealthSummaryText, Mode=OneWay}" TextWrapping="Wrap" />
              <TextBlock x:Name="ThresholdsText" Style="{StaticResource Ad.SecondaryText}" Text="{Binding ThresholdsText, Mode=OneWay}" TextWrapping="Wrap" />
              <TextBlock x:Name="HttpStatusText"
                         AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{Binding HttpStatusText, Mode=OneWay}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Expander x:Name="HttpResultsExpander"
                    Margin="0,6,0,0"
                    DockPanel.Dock="Bottom"
                    Header="{l:Tr Pki.HttpResultsHeading}"
                    Visibility="{Binding HasHttpRows, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
            <ListView x:Name="HttpList"
                      MaxHeight="220"
                      AutomationProperties.Name="{l:Tr Pki.HttpResultsHeading}"
                      ItemContainerStyle="{StaticResource PkiRowStyle}"
                      ItemsSource="{Binding HttpRows, Mode=OneWay}">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="180" Header="{l:Tr Pki.ColumnKind}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHttpRowViewModel}">
                        <TextBlock Text="{Binding KindText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="460" Header="{l:Tr Pki.ColumnUrl}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHttpRowViewModel}">
                        <TextBlock Text="{Binding Url, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="260" Header="{l:Tr Pki.ColumnOutcome}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHttpRowViewModel}">
                        <TextBlock Text="{Binding OutcomeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Expander>
          <Grid>
            <ListView x:Name="HealthList"
                      AutomationProperties.Name="{l:Tr Pki.SectionHealth}"
                      ItemContainerStyle="{StaticResource PkiRowStyle}"
                      ItemsSource="{Binding HealthRows, Mode=OneWay}"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="190" Header="{l:Tr Pki.ColumnCa}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHealthRowViewModel}">
                        <TextBlock Text="{Binding CaText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="230" Header="{l:Tr Pki.ColumnItem}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHealthRowViewModel}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ItemText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="120" CellTemplate="{StaticResource StatusCell}" Header="{l:Tr Pki.ColumnStatus}" />
                  <GridViewColumn Width="140" Header="{l:Tr Pki.ColumnValidTo}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHealthRowViewModel}">
                        <TextBlock Text="{Binding ValidUntilText, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="380" Header="{l:Tr Pki.ColumnUrl}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHealthRowViewModel}">
                        <TextBlock Text="{Binding Url, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="200" Header="{l:Tr Pki.ColumnOutcome}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type pki:PkiHealthRowViewModel}">
                        <TextBlock Text="{Binding HttpText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock Style="{StaticResource EmptyListText}"
                       Text="{l:Tr Pki.HealthEmpty}"
                       Visibility="{Binding HasHealthRows, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- DC LDAPS certificates (TLS probe on the first activation or the button) -->
      <TabItem x:Name="LdapsTab" Header="{l:Tr Pki.SectionLdaps}">
        <DockPanel Margin="0,6,0,0">
          <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
            <Button x:Name="ProbeLdapsButton"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding ProbeLdapsCommand}"
                    Content="{l:Tr Pki.ProbeLdaps}"
                    DockPanel.Dock="Right"
                    ToolTip="{l:Tr Pki.ProbeLdapsHint}" />
            <StackPanel>
              <TextBlock x:Name="LdapsStatusText"
                         AutomationProperties.LiveSetting="Polite"
                         Text="{Binding LdapsStatusText, Mode=OneWay}"
                         TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding KdcNote, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <ListView x:Name="LdapsList"
                    AutomationProperties.Name="{l:Tr Pki.SectionLdaps}"
                    ItemContainerStyle="{StaticResource PkiRowStyle}"
                    ItemsSource="{Binding LdapsRows, Mode=OneWay}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="200" Header="{l:Tr Pki.ColumnDc}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiLdapsRowViewModel}">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Host, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="140" Header="{l:Tr Pki.ColumnPort}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiLdapsRowViewModel}">
                      <TextBlock Text="{Binding PortText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="220" Header="{l:Tr Pki.ColumnOutcome}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiLdapsRowViewModel}">
                      <TextBlock Text="{Binding OutcomeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChainStatusText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="320" Header="{l:Tr Pki.ColumnChecks}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiLdapsRowViewModel}">
                      <TextBlock x:Name="ChecksCell" Text="{Binding ChecksText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChecksText, Mode=OneWay}" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsWarning, Mode=OneWay}" Value="True">
                          <Setter TargetName="ChecksCell" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsProblem, Mode=OneWay}" Value="True">
                          <Setter TargetName="ChecksCell" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="100" Header="{l:Tr Pki.ColumnValidTo}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiLdapsRowViewModel}">
                      <TextBlock Text="{Binding ValidToText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="260" Header="{l:Tr Pki.ColumnKdc}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pki:PkiLdapsRowViewModel}">
                      <TextBlock Text="{Binding KdcText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding KdcText, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
