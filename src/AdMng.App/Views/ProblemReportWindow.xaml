<!-- Problem report (ProblemReportViewModel): the value-free report of this connection window, read-only; Refresh / Copy /
     Save as…. Nothing is written to disk unless the operator saves it. -->
<Window x:Class="AdMng.App.Views.ProblemReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="900"
        Height="640"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="RefreshButton"
                Command="{Binding RefreshCommand}"
                Content="{l:Tr Commands.Refresh}"
                Style="{StaticResource Ad.DialogButton}" />
        <Button x:Name="CopyButton"
                Command="{Binding CopyCommand}"
                Content="{l:Tr Common.Copy}"
                Style="{StaticResource Ad.DialogButton}" />
        <Button x:Name="SaveButton"
                Command="{Binding SaveCommand}"
                Content="{l:Tr ProblemReport.SaveAs}"
                Style="{StaticResource Ad.DialogButton}" />
        <Button x:Name="CloseButton"
                Command="{Binding CloseCommand}"
                Content="{l:Tr Common.Close}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <DockPanel Margin="16,12,16,12">
      <TextBlock x:Name="IntroText"
                 Margin="0,0,0,10"
                 DockPanel.Dock="Top"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr ProblemReport.Intro}"
                 TextWrapping="Wrap" />
      <TextBox x:Name="ReportBox"
               AcceptsReturn="True"
               AutomationProperties.Name="{Binding WindowTitle, Mode=OneWay}"
               FontFamily="Cascadia Mono, Consolas"
               FontSize="12"
               HorizontalScrollBarVisibility="Auto"
               IsReadOnly="True"
               IsReadOnlyCaretVisible="True"
               Text="{Binding Text, Mode=OneWay}"
               TextWrapping="NoWrap"
               VerticalContentAlignment="Top"
               VerticalScrollBarVisibility="Auto" />
    </DockPanel>
  </DockPanel>
</Window>
