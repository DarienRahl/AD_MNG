<!--
  Messages to users (UserMessageComposerViewModel, modeless, README U1): compose (template, PL/EN text, condition,
  recipients, inputs) → preview of every message (filter, exclude, test message to me) → sending with progress → report
  (retry failed, CSV on demand). The rendered messages exist only in memory while the window is open; the SMTP password
  box hands its value to the view model only when sending.
-->
<Window x:Class="AdMng.App.Views.UserMessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:um="clr-namespace:AdMng.Presentation.UserMessages;assembly=AdMng.Presentation"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1180"
        Height="820"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="InlineLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="ReadOnlyText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="MessageRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding PlanCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Footer: status, then the commands of the current stage. -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BackButton"
                  Command="{Binding BackCommand}"
                  Content="{l:Tr UserMessages.BackToEdit}"
                  Style="{StaticResource Ad.CollapsedWhenDisabledButton}" />
          <Button x:Name="SendTestButton"
                  Margin="6,0,0,0"
                  Command="{Binding SendTestCommand}"
                  Content="{l:Tr UserMessages.SendTest}"
                  Visibility="{Binding IsPreview, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <Button x:Name="PlanButton"
                  MinWidth="140"
                  Margin="6,0,0,0"
                  Command="{Binding PlanCommand}"
                  Content="{l:Tr UserMessages.Plan}"
                  Style="{StaticResource Ad.AccentDialogButton}"
                  Visibility="{Binding IsCompose, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <Button x:Name="SendButton"
                  MinWidth="120"
                  Margin="6,0,0,0"
                  Command="{Binding SendCommand}"
                  Content="{Binding SendButtonText, Mode=OneWay}"
                  Style="{StaticResource Ad.AccentDialogButton}"
                  Visibility="{Binding IsPreview, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <Button x:Name="StopButton"
                  Margin="6,0,0,0"
                  Command="{Binding CancelSendCommand}"
                  Content="{l:Tr Common.Stop}"
                  Style="{StaticResource Ad.CollapsedWhenDisabledButton}" />
          <Button x:Name="RetryFailedButton"
                  Margin="6,0,0,0"
                  Command="{Binding RetryFailedCommand}"
                  Content="{l:Tr UserMessages.RetryFailed}"
                  Visibility="{Binding IsReport, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <Button x:Name="ExportReportButton"
                  Margin="6,0,0,0"
                  Command="{Binding ExportReportCommand}"
                  Content="{l:Tr UserMessages.ExportReport}"
                  Style="{StaticResource Ad.CollapsedWhenDisabledButton}" />
          <Button x:Name="CloseButton"
                  Margin="6,0,0,0"
                  Command="{Binding CloseCommand}"
                  Content="{l:Tr Common.Close}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ProgressBar Width="60"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock x:Name="StatusText"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding StatusText, Mode=OneWay}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Transport and recipients, the SMTP password when needed, session and error bars. -->
    <StackPanel Margin="16,12,16,0" DockPanel.Dock="Top">
      <DockPanel>
        <TextBlock x:Name="RecipientsCountText"
                   Margin="16,0,0,0"
                   DockPanel.Dock="Right"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding RecipientsText, Mode=OneWay}" />
        <TextBlock Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Mail}" />
        <TextBlock x:Name="TransportText"
                   VerticalAlignment="Center"
                   Text="{Binding TransportText, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <DockPanel Margin="0,8,0,0" Visibility="{Binding NeedsSmtpPassword, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock DockPanel.Dock="Left"
                   Style="{StaticResource InlineLabel}"
                   Text="{l:Tr UserMessages.SmtpPassword}" />
        <PasswordBox x:Name="SmtpPasswordBox"
                     Width="240"
                     AutomationProperties.Name="{l:Tr UserMessages.SmtpPassword}"
                     DockPanel.Dock="Left" />
        <TextBlock Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr UserMessages.SmtpPasswordHint}"
                   TextWrapping="Wrap" />
      </DockPanel>
      <Border x:Name="SessionEndedBar"
              Margin="0,10,0,0"
              Style="{StaticResource Ad.WarningBar}"
              Visibility="{Binding SessionEndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock Text="{Binding SessionEndedMessage, Mode=OneWay}" TextWrapping="Wrap" />
      </Border>
      <Border x:Name="ErrorBar"
              Margin="0,10,0,0"
              Style="{StaticResource Ad.ErrorBar}"
              Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock x:Name="ErrorText"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{Binding Error, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <Grid Margin="16,10,16,12">
      <!-- ==== Compose ==== -->
      <Grid x:Name="ComposePanel" Visibility="{Binding IsCompose, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Recipients -->
        <DockPanel>
          <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
            <Button x:Name="RemoveRecipientButton"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="{l:Tr Common.Remove}"
                    Command="{Binding RemoveRecipientCommand}"
                    Content="{x:Static c:Glyphs.Delete}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Ad.IconButton}"
                    ToolTip="{l:Tr Common.Remove}" />
            <Button x:Name="AddRecipientsButton"
                    Command="{Binding AddRecipientsCommand}"
                    Content="{l:Tr UserMessages.AddRecipients}"
                    DockPanel.Dock="Right" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource Ad.SectionHeader}"
                       Text="{l:Tr UserMessages.Recipients}" />
          </DockPanel>
          <ListBox x:Name="RecipientsList"
                   AutomationProperties.Name="{l:Tr UserMessages.Recipients}"
                   ItemsSource="{Binding Recipients, Mode=OneWay}"
                   SelectedItem="{Binding SelectedRecipient}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type um:UserMessageRecipientViewModel}">
                <StackPanel Margin="0,2" ToolTip="{Binding DistinguishedName, Mode=OneWay}">
                  <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  <TextBlock FontSize="11"
                             Style="{StaticResource Ad.SecondaryText}"
                             Text="{Binding Location, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Template and text -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,8,0">
            <DockPanel>
              <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Template}" />
              <Button Margin="6,0,0,0"
                      Command="{Binding ImportTemplatesCommand}"
                      Content="{l:Tr UserMessages.ImportTemplates}"
                      DockPanel.Dock="Right" />
              <Button Margin="6,0,0,0"
                      Command="{Binding ExportTemplatesCommand}"
                      Content="{l:Tr UserMessages.ExportTemplates}"
                      DockPanel.Dock="Right" />
              <Button x:Name="DeleteTemplateButton"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="{l:Tr UserMessages.DeleteTemplate}"
                      Command="{Binding DeleteTemplateCommand}"
                      Content="{x:Static c:Glyphs.Delete}"
                      DockPanel.Dock="Right"
                      Style="{StaticResource Ad.IconButton}"
                      ToolTip="{l:Tr UserMessages.DeleteTemplate}" />
              <ComboBox x:Name="TemplateBox"
                        AutomationProperties.Name="{l:Tr UserMessages.Template}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding Templates, Mode=OneWay}"
                        SelectedItem="{Binding SelectedTemplate}" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
              <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.TemplateName}" />
              <Button x:Name="SaveTemplateButton"
                      Margin="6,0,0,0"
                      Command="{Binding SaveTemplateCommand}"
                      Content="{l:Tr UserMessages.SaveTemplate}"
                      DockPanel.Dock="Right" />
              <TextBox x:Name="TemplateNameBox"
                       AutomationProperties.Name="{l:Tr UserMessages.TemplateName}"
                       Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{l:Tr UserMessages.BuiltInHint}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsBuiltInTemplate, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />

            <WrapPanel Margin="0,12,0,0">
              <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Condition}" />
              <ComboBox x:Name="ConditionBox"
                        MinWidth="260"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="{l:Tr UserMessages.Condition}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding Conditions, Mode=OneWay}"
                        SelectedItem="{Binding Condition}" />
              <StackPanel Margin="0,0,18,0"
                          Orientation="Horizontal"
                          Visibility="{Binding ShowConditionDays, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.ConditionDays}" />
                <TextBox x:Name="ConditionDaysBox"
                         Width="64"
                         HorizontalContentAlignment="Right"
                         AutomationProperties.Name="{l:Tr UserMessages.ConditionDays}"
                         Text="{Binding ConditionDays, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.RecipientMode}" />
              <ComboBox x:Name="RecipientModeBox"
                        MinWidth="260"
                        AutomationProperties.Name="{l:Tr UserMessages.RecipientMode}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding RecipientModes, Mode=OneWay}"
                        SelectedItem="{Binding RecipientMode}" />
            </WrapPanel>

            <!-- U1d: the template's salutation options ("Zwroty") -->
            <WrapPanel x:Name="SalutationOptionsPanel" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Salutation.Group}" />
              <CheckBox x:Name="UseTitlesBox"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center"
                        Content="{l:Tr UserMessages.Salutation.UseTitles}"
                        IsChecked="{Binding UseTitles}" />
              <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Salutation.UnknownGender}" />
              <ComboBox x:Name="TemplateUnknownGenderBox"
                        MinWidth="240"
                        AutomationProperties.Name="{l:Tr UserMessages.Salutation.UnknownGender}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding UnknownGenderChoices, Mode=OneWay}"
                        SelectedItem="{Binding TemplateUnknownGender}" />
            </WrapPanel>

            <DockPanel Margin="0,12,0,0">
              <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.TextLanguage}" />
              <ComboBox x:Name="EditLanguageBox"
                        Width="140"
                        AutomationProperties.Name="{l:Tr UserMessages.TextLanguage}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding Languages, Mode=OneWay}"
                        SelectedItem="{Binding EditLanguage}" />
              <TextBlock Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{l:Tr UserMessages.LanguageHint}"
                         TextWrapping="Wrap" />
            </DockPanel>

            <TextBlock Style="{StaticResource Label}" Text="{l:Tr UserMessages.Subject}" />
            <TextBox x:Name="SubjectBox"
                     AutomationProperties.Name="{l:Tr UserMessages.Subject}"
                     Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />
            <DockPanel Margin="0,10,0,4">
              <Button x:Name="InsertFieldButton"
                      Margin="6,0,0,0"
                      Command="{Binding InsertFieldCommand}"
                      CommandParameter="{Binding SelectedItem, ElementName=FieldBox}"
                      Content="{l:Tr UserMessages.InsertField}"
                      DockPanel.Dock="Right" />
              <ComboBox x:Name="FieldBox"
                        Width="280"
                        AutomationProperties.Name="{l:Tr UserMessages.InsertField}"
                        DockPanel.Dock="Right"
                        ItemsSource="{Binding FieldExamples, Mode=OneWay}"
                        SelectedIndex="0" />
              <TextBlock VerticalAlignment="Bottom" Text="{l:Tr UserMessages.Body}" />
            </DockPanel>
            <TextBox x:Name="BodyBox"
                     Height="220"
                     AcceptsReturn="True"
                     AutomationProperties.Name="{l:Tr UserMessages.Body}"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <Expander Margin="0,10,0,0" Header="{l:Tr UserMessages.Html}">
              <TextBox x:Name="HtmlBox"
                       Height="160"
                       Margin="0,6,0,0"
                       AcceptsReturn="True"
                       AutomationProperties.Name="{l:Tr UserMessages.Html}"
                       FontFamily="Cascadia Mono, Consolas"
                       Text="{Binding Html, UpdateSourceTrigger=PropertyChanged}"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" />
            </Expander>

            <StackPanel Visibility="{Binding HasInputs, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
              <TextBlock Style="{StaticResource Label}" Text="{l:Tr UserMessages.Inputs}" />
              <ItemsControl x:Name="InputsList" Focusable="False" ItemsSource="{Binding Inputs, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type um:UserMessageInputViewModel}">
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Width="160"
                                 Style="{StaticResource InlineLabel}"
                                 Text="{Binding Name, Mode=OneWay}" />
                      <TextBox AutomationProperties.Name="{Binding Name, Mode=OneWay}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border x:Name="TemplateErrorsBar"
                    Margin="0,10,0,0"
                    Style="{StaticResource Ad.ErrorBar}"
                    Visibility="{Binding TemplateErrors, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
              <TextBlock x:Name="TemplateErrorsText"
                         Text="{Binding TemplateErrors, Mode=OneWay}"
                         TextWrapping="Wrap" />
            </Border>
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{l:Tr UserMessages.FooterNote}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ==== Preview ==== -->
      <Grid x:Name="PreviewPanel" Visibility="{Binding IsPreview, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <DockPanel>
          <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
            <ComboBox x:Name="FilterBox"
                      Width="190"
                      AutomationProperties.Name="{l:Tr Common.Filter}"
                      DisplayMemberPath="Text"
                      DockPanel.Dock="Left"
                      ItemsSource="{Binding Filters, Mode=OneWay}"
                      SelectedItem="{Binding Filter}" />
            <TextBlock x:Name="SummaryText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{Binding SummaryText, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Grid>
            <ListView x:Name="ItemsList"
                      AutomationProperties.Name="{l:Tr UserMessages.PreviewTitle}"
                      ItemContainerStyle="{StaticResource MessageRowStyle}"
                      ItemsSource="{Binding Items, Mode=OneWay}"
                      SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Single">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="54" Header="{l:Tr UserMessages.Include}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type um:UserMessageItemViewModel}">
                        <CheckBox AutomationProperties.Name="{l:Tr UserMessages.Include}"
                                  IsChecked="{Binding IsIncluded}"
                                  IsEnabled="{Binding CanInclude, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="190"
                                  DisplayMemberBinding="{Binding Name, Mode=OneWay}"
                                  Header="{l:Tr UserMessages.ColumnName}" />
                  <GridViewColumn Width="220"
                                  DisplayMemberBinding="{Binding ToText, Mode=OneWay}"
                                  Header="{l:Tr UserMessages.ColumnRecipient}" />
                  <GridViewColumn Width="100"
                                  DisplayMemberBinding="{Binding StatusText, Mode=OneWay}"
                                  Header="{l:Tr UserMessages.ColumnStatus}" />
                  <GridViewColumn Width="60"
                                  DisplayMemberBinding="{Binding LanguageText, Mode=OneWay}"
                                  Header="{l:Tr UserMessages.ColumnLanguage}" />
                  <!-- U1d: the salutation with ≈ (guessed) or ⚠ (fallback) -->
                  <GridViewColumn Width="210" Header="{l:Tr UserMessages.Salutation.ColumnSalutation}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type um:UserMessageItemViewModel}">
                        <TextBlock Text="{Binding SalutationColumnText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SalutationToolTip, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="300"
                                  DisplayMemberBinding="{Binding IssuesText, Mode=OneWay}"
                                  Header="{l:Tr UserMessages.ColumnIssues}" />
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock x:Name="NoMessagesHint"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{l:Tr UserMessages.NoMessages}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Items.Count, Mode=OneWay}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>

        <!-- The selected message -->
        <DockPanel Grid.Column="2" DataContext="{Binding SelectedItem, Mode=OneWay}">
          <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.From}" />
            <TextBlock Grid.Column="1" Text="{Binding FromText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.To}" />
            <TextBlock x:Name="SelectedToText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding ToText, Mode=OneWay}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Cc}" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding CcText, Mode=OneWay}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.ReplyTo}" />
            <TextBlock Grid.Row="3"
                       Grid.Column="1"
                       Text="{Binding ReplyToText, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="4" Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Subject}" />
            <TextBlock x:Name="SelectedSubjectText"
                       Grid.Row="4"
                       Grid.Column="1"
                       FontWeight="SemiBold"
                       Text="{Binding Subject, Mode=OneWay}"
                       TextWrapping="Wrap" />
          </Grid>
          <!-- U1d: "Pola wyliczone" and the gender of this message for this send only -->
          <Border x:Name="DerivedFieldsPanel"
                  Margin="0,8,0,0"
                  DockPanel.Dock="Top"
                  Style="{StaticResource Ad.Card}"
                  Visibility="{Binding HasDerived, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{l:Tr UserMessages.Salutation.DerivedFields}" />
              <ItemsControl x:Name="DerivedFieldsList"
                            Grid.IsSharedSizeScope="True"
                            Focusable="False"
                            ItemsSource="{Binding DerivedRows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type um:DerivedValueRow}">
                    <Grid Margin="0,2,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DerivedLabel" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Margin="0,0,8,0" Style="{StaticResource Ad.SecondaryText}" Text="{Binding Label, Mode=OneWay}" />
                      <TextBlock Grid.Column="1" Text="{Binding Mark, Mode=OneWay}" />
                      <TextBlock Grid.Column="2" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{Binding Value, Mode=OneWay}" />
                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Source, Mode=OneWay, StringFormat='({0})'}" />
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,6,0,0" Visibility="{Binding HasAccountDerived, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Salutation.GenderOverride}" />
                <ComboBox x:Name="GenderOverrideBox"
                          Width="160"
                          AutomationProperties.Name="{l:Tr UserMessages.Salutation.GenderOverride}"
                          DisplayMemberPath="Text"
                          DockPanel.Dock="Left"
                          ItemsSource="{Binding DataContext.GenderChoices, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                          SelectedValue="{Binding GenderChoice}"
                          SelectedValuePath="Value" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Ad.SecondaryText}"
                           Text="{l:Tr UserMessages.Salutation.GenderOverrideHint}"
                           TextWrapping="Wrap" />
              </DockPanel>
              <!-- Manager fields ({$managerSalutation} …): the manager's gender has its own selector -->
              <DockPanel Margin="0,6,0,0" Visibility="{Binding HasManagerDerived, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource InlineLabel}" Text="{l:Tr UserMessages.Salutation.ManagerGenderOverride}" />
                <ComboBox x:Name="ManagerGenderOverrideBox"
                          Width="160"
                          AutomationProperties.Name="{l:Tr UserMessages.Salutation.ManagerGenderOverride}"
                          DisplayMemberPath="Text"
                          DockPanel.Dock="Left"
                          ItemsSource="{Binding DataContext.GenderChoices, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                          SelectedValue="{Binding ManagerGenderChoice}"
                          SelectedValuePath="Value" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Ad.SecondaryText}"
                           Text="{l:Tr UserMessages.Salutation.GenderOverrideHint}"
                           TextWrapping="Wrap" />
              </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock Margin="0,8,0,0"
                     DockPanel.Dock="Top"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}"
                     Text="{Binding IssuesText, Mode=OneWay}"
                     TextWrapping="Wrap"
                     Visibility="{Binding IssuesText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          <TextBlock x:Name="TestResultText"
                     Margin="0,8,0,0"
                     DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                     DockPanel.Dock="Bottom"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding TestResultText, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <TabControl Margin="0,10,0,0">
            <TabItem Header="{l:Tr UserMessages.TextTab}">
              <TextBox x:Name="SelectedTextBody"
                       AutomationProperties.Name="{l:Tr UserMessages.TextTab}"
                       Style="{StaticResource ReadOnlyText}"
                       Text="{Binding TextBody, Mode=OneWay}" />
            </TabItem>
            <TabItem Header="{l:Tr UserMessages.HtmlTab}">
              <TextBox AutomationProperties.Name="{l:Tr UserMessages.HtmlTab}"
                       FontFamily="Cascadia Mono, Consolas"
                       Style="{StaticResource ReadOnlyText}"
                       Text="{Binding HtmlBody, Mode=OneWay}" />
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>

      <!-- ==== Sending ==== -->
      <StackPanel x:Name="SendingPanel"
                  MaxWidth="640"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsSending, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Margin="0,0,0,10"
                   Style="{StaticResource Ad.SectionHeader}"
                   Text="{l:Tr UserMessages.SendingTitle}" />
        <ProgressBar x:Name="SendProgress"
                     Height="8"
                     Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                     Value="{Binding ProgressValue, Mode=OneWay}" />
        <TextBlock x:Name="ProgressText"
                   Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding ProgressText, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- ==== Report ==== -->
      <DockPanel x:Name="ReportPanel" Visibility="{Binding IsReport, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock x:Name="ReportSummaryText"
                   Margin="0,0,0,8"
                   DockPanel.Dock="Top"
                   FontWeight="SemiBold"
                   Text="{Binding ReportSummary, Mode=OneWay}"
                   TextWrapping="Wrap" />
        <ListView x:Name="ReportList"
                  AutomationProperties.Name="{l:Tr UserMessages.ReportTitle}"
                  ItemContainerStyle="{StaticResource MessageRowStyle}"
                  ItemsSource="{Binding Items, Mode=OneWay}">
          <ListView.View>
            <GridView>
              <GridViewColumn Width="200"
                              DisplayMemberBinding="{Binding Name, Mode=OneWay}"
                              Header="{l:Tr UserMessages.ColumnName}" />
              <GridViewColumn Width="230"
                              DisplayMemberBinding="{Binding ToText, Mode=OneWay}"
                              Header="{l:Tr UserMessages.ColumnRecipient}" />
              <GridViewColumn Width="170"
                              DisplayMemberBinding="{Binding ReportText, Mode=OneWay}"
                              Header="{l:Tr UserMessages.ColumnStatus}" />
              <GridViewColumn Width="80"
                              DisplayMemberBinding="{Binding ReportTime, Mode=OneWay}"
                              Header="{l:Tr UserMessages.ColumnTime}" />
              <GridViewColumn Width="420"
                              DisplayMemberBinding="{Binding ReportDetail, Mode=OneWay}"
                              Header="{l:Tr UserMessages.ColumnDetail}" />
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
