<!--
  Reset Password (modal) for one or many accounts. One account: typed password + confirmation (PasswordBoxes handed to
  the view model, never bound) or a generated one; several accounts: unique generated passwords. After the reset the
  results are listed; generated passwords are masked until the operator reveals or copies them.
-->
<Window x:Class="AdMng.App.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:dlg="clr-namespace:AdMng.Presentation.Dialogs;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="620"
        MinWidth="480"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>

    <!-- The view model, for the copy buttons inside the result rows. -->
    <c:BindingProxy x:Key="DialogProxy" Data="{Binding}" />

    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Ad.FieldLabel}">
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>

    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="ResultRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
    </Style>

    <!-- "Cancel" before the reset, "Close" afterwards. -->
    <Style x:Key="CancelOrCloseButton" TargetType="Button" BasedOn="{StaticResource Ad.DialogButton}">
      <Setter Property="Content" Value="{l:Tr Common.Cancel}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompleted, Mode=OneWay}" Value="True">
          <Setter Property="Content" Value="{l:Tr Common.Close}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <ProgressBar Width="72"
                     VerticalAlignment="Center"
                     DockPanel.Dock="Left"
                     IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button Margin="12,0,0,0"
                Command="{Binding ExportCommand}"
                Content="{l:Tr Batch.ExportResults}"
                DockPanel.Dock="Left"
                Style="{StaticResource Ad.DialogButton}"
                Visibility="{Binding IsCompleted, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="ResetButton"
                  Command="{Binding ResetCommand}"
                  Content="{l:Tr Common.Ok}"
                  IsDefault="True"
                  Style="{StaticResource Ad.AccentDialogButton}"
                  Visibility="{Binding IsCompleted, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
          <Button x:Name="CloseButton"
                  Command="{Binding CancelCommand}"
                  IsCancel="True"
                  Style="{StaticResource CancelOrCloseButton}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Margin="24,14,24,16">
      <!-- Accounts -->
      <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr Batch.Targets}" />
      <ListBox MaxHeight="120"
               AutomationProperties.Name="{l:Tr Batch.Targets}"
               ItemsSource="{Binding Targets, Mode=OneWay}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
            <StackPanel Orientation="Horizontal">
              <c:ObjectIconView Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Icon="{Binding Icon, Mode=OneWay}"
                                Size="16" />
              <TextBlock VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}" />
              <TextBlock Margin="10,0,0,0"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{Binding Path, Mode=OneWay}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Password and options (until the reset ran) -->
      <StackPanel Visibility="{Binding IsCompleted, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}">
        <CheckBox Margin="0,12,0,0"
                  Content="{l:Tr ResetPassword.Generate}"
                  IsChecked="{Binding GeneratePassword}"
                  Visibility="{Binding CanChooseMode, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />

        <Grid Visibility="{Binding IsSingle, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel IsEnabled="{Binding CanTypePassword, Mode=OneWay}">
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr ResetPassword.NewPassword}" />
            <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{l:Tr ResetPassword.NewPassword}" />
          </StackPanel>
          <StackPanel Grid.Column="2" IsEnabled="{Binding CanTypePassword, Mode=OneWay}">
            <TextBlock Style="{StaticResource Label}" Text="{l:Tr ResetPassword.ConfirmPassword}" />
            <PasswordBox x:Name="ConfirmPasswordBox" AutomationProperties.Name="{l:Tr ResetPassword.ConfirmPassword}" />
          </StackPanel>
        </Grid>

        <StackPanel Visibility="{Binding GeneratePassword, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <TextBlock Style="{StaticResource Label}">
            <Run Text="{l:Tr ObjectDialogs.PasswordLength}" /><Run Text=": " /><Run FontWeight="SemiBold" Text="{Binding GeneratedLength, Mode=OneWay}" />
          </TextBlock>
          <!-- 12 = PasswordGenerator.MinimumLength (x:Static would hand an int to the double property). -->
          <Slider AutomationProperties.Name="{l:Tr ObjectDialogs.PasswordLength}"
                  IsSnapToTickEnabled="True"
                  LargeChange="4"
                  Maximum="64"
                  Minimum="12"
                  SmallChange="1"
                  TickFrequency="1"
                  Value="{Binding GeneratedLength}" />
        </StackPanel>

        <CheckBox Margin="0,12,0,0"
                  Content="{l:Tr ResetPassword.MustChange}"
                  IsChecked="{Binding MustChangeAtNextLogon}" />
        <CheckBox Margin="0,6,0,0"
                  Content="{l:Tr ResetPassword.Unlock}"
                  IsChecked="{Binding UnlockAccount}" />
        <DockPanel Margin="28,2,0,0" Visibility="{Binding IsAnyLocked, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <TextBlock Margin="0,0,6,0"
                     DockPanel.Dock="Left"
                     FontSize="12"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Lock}" />
          <TextBlock Style="{StaticResource Ad.SecondaryText}"
                     Text="{l:Tr Errors.AccountLockedOut}"
                     TextWrapping="Wrap" />
        </DockPanel>
      </StackPanel>

      <!-- Results -->
      <StackPanel Visibility="{Binding IsCompleted, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Margin="0,14,0,6"
                   AutomationProperties.LiveSetting="Polite"
                   FontWeight="SemiBold"
                   Text="{Binding ResultSummary, Mode=OneWay}"
                   TextWrapping="Wrap" />
        <ListView x:Name="ResultsList"
                  MaxHeight="300"
                  AutomationProperties.Name="{Binding ResultSummary, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource ResultRow}"
                  ItemsSource="{Binding Results, Mode=OneWay}"
                  SelectionMode="Single">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="180" Header="{l:Tr Common.Name}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type dlg:PasswordResultViewModel}">
                    <DockPanel>
                      <Grid Margin="0,0,6,0" DockPanel.Dock="Left">
                        <TextBlock AutomationProperties.Name="{l:Tr SessionLog.Succeeded}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Style="{StaticResource Ad.GlyphText}"
                                   Text="{x:Static c:Glyphs.Completed}"
                                   ToolTip="{l:Tr SessionLog.Succeeded}"
                                   Visibility="{Binding Succeeded, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                        <TextBlock AutomationProperties.Name="{l:Tr SessionLog.Failed}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Style="{StaticResource Ad.GlyphText}"
                                   Text="{x:Static c:Glyphs.Error}"
                                   ToolTip="{l:Tr SessionLog.Failed}"
                                   Visibility="{Binding Succeeded, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
                      </Grid>
                      <TextBlock VerticalAlignment="Center"
                                 Text="{Binding Name, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="250" Header="{l:Tr Batch.Password}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type dlg:PasswordResultViewModel}">
                    <DockPanel Visibility="{Binding HasPassword, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                      <Button Margin="2,0,0,0"
                              AutomationProperties.Name="{l:Tr Common.Copy}"
                              Command="{Binding Data.CopyPasswordCommand, Source={StaticResource DialogProxy}}"
                              CommandParameter="{Binding Mode=OneWay}"
                              Content="{x:Static c:Glyphs.Copy}"
                              DockPanel.Dock="Right"
                              Style="{StaticResource Ad.SmallIconButton}"
                              ToolTip="{l:Tr Common.Copy}" />
                      <ToggleButton Margin="2,0,0,0"
                                    AutomationProperties.Name="{l:Tr ResetPassword.Reveal}"
                                    Content="{x:Static c:DialogGlyphs.Reveal}"
                                    DockPanel.Dock="Right"
                                    FontFamily="{StaticResource Ad.IconFont}"
                                    FontSize="10"
                                    Height="22"
                                    MinHeight="0"
                                    IsChecked="{Binding IsRevealed}"
                                    MinWidth="22"
                                    Padding="2"
                                    ToolTip="{l:Tr ResetPassword.Reveal}" />
                      <TextBlock VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono, Consolas"
                                 Text="{Binding DisplayedPassword, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="300" Header="{l:Tr Batch.Message}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type dlg:PasswordResultViewModel}">
                    <TextBlock Text="{Binding Message, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Message, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr ObjectDialogs.GeneratedPasswordsHint}"
                   TextWrapping="Wrap"
                   Visibility="{Binding GeneratePassword, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      </StackPanel>

      <!-- Validation / execution error -->
      <Border Margin="0,14,0,0"
              Style="{StaticResource Ad.ErrorBar}"
              Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <DockPanel>
          <TextBlock Margin="0,1,10,0"
                     VerticalAlignment="Top"
                     DockPanel.Dock="Left"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Error}" />
          <TextBlock AutomationProperties.LiveSetting="Assertive"
                     Text="{Binding Error, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </DockPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
