<!--
  Editor of a saved view (SavedViewEditorViewModel, modal): name, search base, scope, LDAP filter, a test count on the DC.
  Feedback (design note 6.7 and "V2b-2 as built"): the test of the view is said by the status line at the top; a filter
  that cannot be read is a note under the filter.
-->
<Window x:Class="AdMng.App.Views.SavedViewEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="600"
        MinWidth="460"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="SaveButton"
                Command="{Binding SaveCommand}"
                Content="{l:Tr Common.Save}"
                IsDefault="True"
                Style="{StaticResource Ad.AccentDialogButton}" />
        <Button Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <!--
      Status line (design note 6.1 and "V2b-2 as built", Dialogs): at the top, above the name; declared after the
      footer, so Tab goes from the buttons to what the line offers. It says the test of the view - counting the
      matching objects (with Stop), how many there are, why it failed or was not started. Its picture stands over the
      left edge of the fields.
    -->
    <c:StatusLine x:Name="PageStatus"
                  Margin="16,8,16,0"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  DockPanel.Dock="Top"
                  Status="{Binding Status.Current, Mode=OneWay}" />

    <StackPanel Margin="24,0,24,16">
      <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr Views.Name}" />
      <TextBox x:Name="NameBox"
               AutomationProperties.Name="{l:Tr Views.Name}"
               Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr Views.BaseDn}" />
      <DockPanel>
        <Button Margin="6,0,0,0"
                Command="{Binding BrowseBaseDnCommand}"
                Content="{l:Tr Common.Browse}"
                DockPanel.Dock="Right" />
        <TextBox AutomationProperties.Name="{l:Tr Views.BaseDn}" Text="{Binding BaseDn, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>
      <TextBlock Margin="0,4,0,0"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding BaseDnDisplay, Mode=OneWay}" />

      <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr Views.Scope}" />
      <ComboBox AutomationProperties.Name="{l:Tr Views.Scope}"
                DisplayMemberPath="Text"
                ItemsSource="{Binding Scopes, Mode=OneWay}"
                SelectedValue="{Binding Scope}"
                SelectedValuePath="Value" />

      <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr Views.Filter}" />
      <TextBox x:Name="FilterBox"
               MinHeight="72"
               VerticalContentAlignment="Top"
               AcceptsReturn="False"
               AutomationProperties.Name="{l:Tr Views.Filter}"
               FontFamily="Cascadia Mono, Consolas"
               Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr Views.FilterHint}" />
      <!-- A filter that cannot be read: a note under the filter - why Save and Test are not possible. -->
      <ContentControl x:Name="FilterErrorNote"
                      Margin="0,8,0,0"
                      Style="{StaticResource Ad.Note.Error}"
                      Visibility="{Binding FilterError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock x:Name="FilterErrorText"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{Binding FilterError, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </ContentControl>

      <!-- Counts the matching objects on the domain controller; while it counts the button is the Cancel of the test. -->
      <c:ActionButton x:Name="TestButton"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Left"
                      CancelCommand="{Binding Status.CancelCommand, Mode=OneWay}"
                      Command="{Binding TestCommand}"
                      Content="{l:Tr Views.Test}"
                      IsCancelling="{Binding Status.IsCancelling, Mode=OneWay}"
                      IsRunning="{Binding Status.IsWorking, Mode=OneWay}" />
    </StackPanel>
  </DockPanel>
</Window>
