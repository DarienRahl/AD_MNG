<UserControl x:Class="AdMng.App.Views.ObjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:AdMng.App.Behaviors"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             AutomationProperties.Name="{Binding Title, Mode=OneWay}">
  <UserControl.Resources>
    <!--
      Compact density for the list (ADUC-like). Rows: the style below (height 26 = Ad.Size.Row, the theme's minimum of
      40 switched off). Column headers: b:Density.ColumnHeaderHeight on the list (Ad.Size.ColumnHeader).
    -->
    <Style x:Key="ObjectRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
      <Style.Triggers>
        <!-- Disabled accounts are dimmed (the icon also carries the ADUC down-arrow badge). -->
        <DataTrigger Binding="{Binding IsDisabled, Mode=OneWay}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ChipsRowStyle" TargetType="DockPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <Trigger Property="b:ViewState.ShowFilterChips" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SavedChipsRowStyle" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SavedFilterChips.Count, Mode=OneWay}" Value="0">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- "No items" hint: only when nothing is loading, there is no error and the list is empty. -->
    <Style x:Key="EmptyHintStyle" TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Rows.Count, Mode=OneWay}" Value="0" />
            <Condition Binding="{Binding IsLoading, Mode=OneWay}" Value="False" />
            <Condition Binding="{Binding Error, Mode=OneWay}" Value="{x:Null}" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: location, quick filter -->
    <DockPanel Margin="8,6,8,4" LastChildFill="True">
      <Grid Width="260"
            DockPanel.Dock="Right">
        <TextBox x:Name="QuickFilterBox"
                 Padding="8,4,28,4"
                 AutomationProperties.Name="{l:Tr List.QuickFilterPlaceholder}"
                 PreviewKeyDown="OnQuickFilterKeyDown"
                 Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
        <TextBlock Margin="9,0,28,0"
                   Style="{StaticResource Ad.HintText}"
                   Text="{l:Tr List.QuickFilterPlaceholder}"
                   Visibility="{Binding Text, ElementName=QuickFilterBox, Converter={StaticResource Ad.EmptyToVisible}}" />
        <Button Margin="0,0,3,0"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{l:Tr Common.Clear}"
                Command="{Binding ClearQuickFilterCommand}"
                Content="{x:Static c:Glyphs.Cancel}"
                Style="{StaticResource Ad.SmallIconButton}"
                ToolTip="{l:Tr Common.Clear}"
                Visibility="{Binding Text, ElementName=QuickFilterBox, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      </Grid>
      <!--
        Group Policy (K2): "Zasady grupy" of the domain or OU shown (or selected) - the picture of a group policy object
        and the name of the command. The command comes from the shell of the main window (b:CommandMenu); a host
        without it (the Find window) has no such button instead of one that does nothing.
      -->
      <Button x:Name="GroupPolicyButton"
              Margin="0,0,8,0"
              Padding="8,3,10,3"
              VerticalAlignment="Center"
              b:CommandMenu.Id="gpo.containerPolicies"
              DockPanel.Dock="Right">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <Trigger Property="Command" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal">
          <c:ObjectIconView Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Icon="GroupPolicy"
                            Size="16" />
          <TextBlock VerticalAlignment="Center" Text="{l:Tr GroupPolicy.ContainerPoliciesCommand}" />
        </StackPanel>
      </Button>
      <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <c:ObjectIconView Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Icon="{Binding Icon, Mode=OneWay}"
                          Size="18" />
        <TextBlock VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="{Binding Title, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Margin="12,0,0,0"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding QuickFilterStatus, Mode=OneWay}" />
      </StackPanel>
    </DockPanel>

    <!--
      Status line (track V, stage V2; design note 6.1): the one place where the list says what it is doing and what
      happened - the summary of what is loaded and selected, a running load with Stop, a stopped load with Refresh, a
      failed one with Retry. Always there and of a fixed height: the rows under it never jump. A host that shows the
      status of this list in its own line (the Find window) switches it off with ShowStatusLine="False".
    -->
    <c:StatusLine x:Name="PageStatus"
                  Grid.Row="1"
                  Margin="0,0,0,2"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  Status="{Binding Status.Current, Mode=OneWay}" />

    <!-- Server side quick filters (chips) -->
    <DockPanel Grid.Row="2"
               Margin="8,0,8,2"
               Style="{StaticResource ChipsRowStyle}">
      <TextBlock Margin="0,4,8,0"
                 VerticalAlignment="Top"
                 DockPanel.Dock="Left"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr List.ServerFilters}" />
      <StackPanel>
        <ItemsControl Focusable="False" ItemsSource="{Binding FilterChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                            Content="{Binding Title, Mode=OneWay}"
                            IsChecked="{Binding IsActive}"
                            Style="{StaticResource Ad.ChipToggleButton}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The operator's saved filters (README U4): AND-ed like the quick filters; hidden while there are none. -->
        <DockPanel x:Name="SavedFilterChipsRow" Style="{StaticResource SavedChipsRowStyle}">
          <TextBlock Margin="0,4,8,0"
                     VerticalAlignment="Top"
                     DockPanel.Dock="Left"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{l:Tr Filters.ChipsLabel}" />
          <ItemsControl x:Name="SavedFilterChipsList" Focusable="False" ItemsSource="{Binding SavedFilterChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                              Content="{Binding Title, Mode=OneWay}"
                              IsChecked="{Binding IsActive}"
                              Style="{StaticResource Ad.ChipToggleButton}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="3">
      <ListView x:Name="List"
                b:Density.ColumnHeaderHeight="{StaticResource Ad.Size.ColumnHeader}"
                b:DynamicColumns.SortCommand="{Binding SortCommand}"
                b:DynamicColumns.Source="{Binding Columns}"
                AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                BorderThickness="0,1,0,0"
                ItemContainerStyle="{StaticResource ObjectRowStyle}"
                ItemsSource="{Binding Rows, Mode=OneWay}"
                PreviewKeyDown="OnListKeyDown"
                PreviewMouseLeftButtonDown="OnListMouseDown"
                PreviewMouseLeftButtonUp="OnListMouseUp"
                PreviewMouseMove="OnListMouseMove"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.IsDeferredScrollingEnabled="False"
                SelectedItem="{Binding SelectedItem}"
                SelectionMode="Extended"
                TextSearch.TextPath="Name"
                VirtualizingPanel.IsContainerVirtualizable="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Item"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridView.ColumnHeaderContextMenu>
              <ContextMenu>
                <MenuItem b:CommandMenu.Id="view.columns" />
                <MenuItem b:CommandMenu.Id="view.export" />
              </ContextMenu>
            </GridView.ColumnHeaderContextMenu>
          </GridView>
        </ListView.View>
        <ListView.ContextMenu>
          <!-- ADUC "Action" menu of the selection. -->
          <ContextMenu>
            <MenuItem b:CommandMenu.Id="object.properties" FontWeight="SemiBold" />
            <MenuItem b:CommandMenu.Id="nav.openInNewTab" />
            <Separator />
            <MenuItem Header="{l:Tr Shell.MenuNew}">
              <MenuItem b:CommandMenu.Id="new.user" />
              <MenuItem b:CommandMenu.Id="new.group" />
              <MenuItem b:CommandMenu.Id="new.ou" />
              <MenuItem b:CommandMenu.Id="new.computer" />
              <MenuItem b:CommandMenu.Id="new.contact" />
              <Separator />
              <MenuItem b:CommandMenu.Id="new.bulkCreate" />
            </MenuItem>
            <Separator />
            <MenuItem b:CommandMenu.Id="object.addToGroup" />
            <MenuItem b:CommandMenu.Id="object.disable" />
            <MenuItem b:CommandMenu.Id="object.enable" />
            <MenuItem b:CommandMenu.Id="object.unlock" />
            <MenuItem b:CommandMenu.Id="events.lockout" />
            <MenuItem b:CommandMenu.Id="object.resetPassword" />
            <!-- Computers (K1). -->
            <MenuItem x:Name="ComputerContextMenuItem" Header="{l:Tr Computers.ComputerMenu}">
              <MenuItem b:CommandMenu.Id="computer.remote" />
              <MenuItem b:CommandMenu.Id="computer.remoteDesktop" />
              <MenuItem b:CommandMenu.Id="computer.manage" />
              <MenuItem b:CommandMenu.Id="computer.eventViewer" />
              <MenuItem b:CommandMenu.Id="events.computer" />
              <MenuItem b:CommandMenu.Id="computer.ping" />
              <MenuItem b:CommandMenu.Id="gpo.model" />
              <Separator />
              <MenuItem b:CommandMenu.Id="computer.reset" />
            </MenuItem>
            <MenuItem b:CommandMenu.Id="object.sendMessage" />
            <MenuItem b:CommandMenu.Id="object.correspondence" />
            <MenuItem b:CommandMenu.Id="object.mailboxOwners" />
            <MenuItem b:CommandMenu.Id="object.move" />
            <MenuItem b:CommandMenu.Id="gpo.containerPolicies" />
            <MenuItem b:CommandMenu.Id="gpo.modelUser" />
            <MenuItem b:CommandMenu.Id="object.batchEdit" />
            <Separator />
            <MenuItem b:CommandMenu.Id="object.copyRows" />
            <MenuItem b:CommandMenu.Id="object.copyRowsWithHeaders" />
            <MenuItem Header="{l:Tr CommandCategories.CopyAs}">
              <MenuItem b:CommandMenu.Id="copyAs.mail" />
              <MenuItem b:CommandMenu.Id="copyAs.upn" />
              <MenuItem b:CommandMenu.Id="copyAs.login" />
              <MenuItem b:CommandMenu.Id="copyAs.domainLogin" />
              <MenuItem b:CommandMenu.Id="copyAs.name" />
              <MenuItem b:CommandMenu.Id="copyAs.displayName" />
              <MenuItem b:CommandMenu.Id="object.copyDn" />
              <MenuItem b:CommandMenu.Id="copyAs.path" />
              <MenuItem b:CommandMenu.Id="copyAs.guid" />
              <MenuItem b:CommandMenu.Id="copyAs.sid" />
            </MenuItem>
            <MenuItem b:CommandMenu.Id="object.watchdogHistory" />
            <MenuItem b:CommandMenu.Id="object.compareWithConnection" />
            <MenuItem b:CommandMenu.Id="view.pin" />
            <Separator />
            <MenuItem b:CommandMenu.Id="object.delete" />
            <MenuItem b:CommandMenu.Id="object.rename" />
            <Separator />
            <MenuItem b:CommandMenu.Id="object.refresh" />
          </ContextMenu>
        </ListView.ContextMenu>
      </ListView>

      <TextBlock Margin="0,60,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Style="{StaticResource EmptyHintStyle}"
                 Text="{l:Tr List.Empty}" />

      <!-- Inline rename (F2): an editor placed over the name cell of the row. -->
      <Canvas x:Name="EditorLayer" ClipToBounds="True">
        <TextBox x:Name="RenameEditor"
                 AutomationProperties.Name="{l:Tr Commands.Rename}"
                 LostKeyboardFocus="OnRenameEditorLostFocus"
                 PreviewKeyDown="OnRenameEditorKeyDown"
                 Visibility="Collapsed" />
      </Canvas>
    </Grid>
  </Grid>
</UserControl>
