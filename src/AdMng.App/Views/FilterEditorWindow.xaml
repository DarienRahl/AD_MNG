<!--
  The filter builder (FilterEditorViewModel, modal, README U4): name and description, groups of conditions combined with
  I/LUB (attribute from the schema, condition, value, "Wybierz grupę..." for member-of), or a raw LDAP filter; the LDAP
  filter built only through LdapFilter as a live preview, the problems per condition, a test count on the DC, Save.
-->
<Window x:Class="AdMng.App.Views.FilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:f="clr-namespace:AdMng.Presentation.Filters;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="900"
        Height="720"
        MinWidth="640"
        MinHeight="480"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- Commands and the attribute list for the condition rows, independent of their DataContext. -->
    <c:BindingProxy x:Key="EditorProxy" Data="{Binding}" />

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="SaveButton"
                Command="{Binding SaveCommand}"
                Content="{l:Tr Common.Save}"
                IsDefault="True"
                Style="{StaticResource Ad.AccentDialogButton}" />
        <Button Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <!-- Name and description. -->
    <Grid Margin="24,12,24,0" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.4*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr Common.Name}" />
        <TextBox x:Name="NameBox"
                 AutomationProperties.Name="{l:Tr Common.Name}"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr Common.Description}" />
        <TextBox AutomationProperties.Name="{l:Tr Common.Description}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Grid>

    <!-- The generated (or typed) LDAP filter, the problems and the test. -->
    <StackPanel Margin="24,8,24,12" DockPanel.Dock="Bottom">
      <TextBlock Style="{StaticResource Ad.FieldLabel}" Text="{l:Tr Filters.Preview}" />
      <TextBox x:Name="PreviewBox"
               MinHeight="48"
               AutomationProperties.Name="{l:Tr Filters.Preview}"
               FontFamily="Cascadia Mono, Consolas"
               IsReadOnly="True"
               Text="{Binding Preview, Mode=OneWay}"
               TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding ClientCheckNote, Mode=OneWay}"
                 TextWrapping="Wrap"
                 Visibility="{Binding ClientCheckNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      <Border x:Name="ErrorBar"
              Margin="0,8,0,0"
              Style="{StaticResource Ad.ErrorBar}"
              Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock x:Name="ErrorText"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{Binding Error, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </Border>
      <DockPanel Margin="0,10,0,0">
        <Button x:Name="TestButton"
                Command="{Binding TestCommand}"
                Content="{l:Tr Views.Test}"
                DockPanel.Dock="Left" />
        <Button Margin="6,0,0,0"
                Command="{Binding TestCancelCommand}"
                Content="{l:Tr Common.Stop}"
                DockPanel.Dock="Left"
                Style="{StaticResource Ad.CollapsedWhenDisabledButton}" />
        <TextBlock Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding TestResult, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </StackPanel>

    <CheckBox x:Name="RawBox"
              Margin="24,10,24,0"
              AutomationProperties.Name="{l:Tr Filters.Raw}"
              Content="{l:Tr Filters.Raw}"
              DockPanel.Dock="Top"
              IsChecked="{Binding IsRaw}" />

    <!-- Raw LDAP filter (advanced). -->
    <TextBox x:Name="RawFilterBox"
             MinHeight="120"
             Margin="24,8,24,0"
             VerticalContentAlignment="Top"
             AutomationProperties.Name="{l:Tr Filters.Raw}"
             DockPanel.Dock="Top"
             FontFamily="Cascadia Mono, Consolas"
             Text="{Binding RawFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
             TextWrapping="Wrap"
             Visibility="{Binding IsRaw, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />

    <!-- The builder: groups of conditions. -->
    <DockPanel Margin="24,8,24,0" Visibility="{Binding IsBuilder, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
        <Button x:Name="AddGroupButton"
                Command="{Binding AddGroupCommand}"
                Content="{l:Tr Filters.AddGroup}"
                DockPanel.Dock="Right" />
        <TextBlock Style="{StaticResource Label}" Text="{l:Tr Filters.GroupsCombine}" />
        <ComboBox x:Name="CombinatorBox"
                  MinWidth="150"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="{l:Tr Filters.GroupsCombine}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding Combinators, Mode=OneWay}"
                  SelectedItem="{Binding Combinator}" />
      </DockPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="GroupsList" Focusable="False" ItemsSource="{Binding Groups, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type f:FilterGroupViewModel}">
              <Border Margin="0,0,0,8" Style="{StaticResource Ad.Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <Button AutomationProperties.Name="{l:Tr Filters.RemoveGroup}"
                            Command="{Binding Data.RemoveGroupCommand, Source={StaticResource EditorProxy}}"
                            CommandParameter="{Binding Mode=OneWay}"
                            Content="{x:Static c:Glyphs.Delete}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Ad.IconButton}"
                            ToolTip="{l:Tr Filters.RemoveGroup}" />
                    <TextBlock Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding Header, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Label}" Text="{l:Tr Filters.ConditionsCombine}" />
                    <ComboBox MinWidth="150"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="{l:Tr Filters.ConditionsCombine}"
                              DisplayMemberPath="Text"
                              ItemsSource="{Binding Combinators, Mode=OneWay}"
                              SelectedItem="{Binding Combinator}" />
                  </DockPanel>
                  <ItemsControl Focusable="False" ItemsSource="{Binding Conditions, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type f:FilterConditionViewModel}">
                        <StackPanel Margin="0,0,0,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="2*" />
                              <ColumnDefinition Width="8" />
                              <ColumnDefinition Width="1.6*" />
                              <ColumnDefinition Width="8" />
                              <ColumnDefinition Width="2.4*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox AutomationProperties.Name="{l:Tr Filters.Attribute}"
                                      IsEditable="True"
                                      IsEnabled="{Binding NeedsAttribute, Mode=OneWay}"
                                      IsTextSearchEnabled="True"
                                      ItemsSource="{Binding Data.Attributes, Source={StaticResource EditorProxy}}"
                                      Text="{Binding Attribute, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="2"
                                      AutomationProperties.Name="{l:Tr Filters.Operator}"
                                      DisplayMemberPath="Text"
                                      ItemsSource="{Binding Operators, Mode=OneWay}"
                                      SelectedItem="{Binding Operator}" />
                            <TextBox Grid.Column="4"
                                     AutomationProperties.Name="{l:Tr Filters.Value}"
                                     IsEnabled="{Binding NeedsValue, Mode=OneWay}"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                            <Button Grid.Column="5"
                                    Margin="4,0,0,0"
                                    Command="{Binding Data.PickGroupCommand, Source={StaticResource EditorProxy}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="{l:Tr Filters.ChooseGroup}"
                                    Visibility="{Binding IsMembership, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                            <Button Grid.Column="6"
                                    Margin="4,0,0,0"
                                    AutomationProperties.Name="{l:Tr Filters.RemoveCondition}"
                                    Command="{Binding Data.RemoveConditionCommand, Source={StaticResource EditorProxy}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="{x:Static c:Glyphs.Delete}"
                                    Style="{StaticResource Ad.IconButton}"
                                    ToolTip="{l:Tr Filters.RemoveCondition}" />
                          </Grid>
                          <TextBlock Margin="0,2,0,0"
                                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                     Text="{Binding Issue, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding Issue, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button HorizontalAlignment="Left"
                          Command="{Binding Data.AddConditionCommand, Source={StaticResource EditorProxy}}"
                          CommandParameter="{Binding Mode=OneWay}"
                          Content="{l:Tr Filters.AddCondition}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</Window>
