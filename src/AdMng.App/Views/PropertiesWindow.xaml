<!--
  ADUC-style property sheet of one object (modeless, one window per DN). Tabs come from PropertySheetViewModel.Pages and
  are templated by page type; fields are templated by field type (implicit DataTemplates below). Every field shares the
  FieldChrome template: label column, editor, dirty marker, lock glyph with the read-only reason, validation error and
  planner finding. Nothing here writes to the directory: Apply/OK go through the view model's change pipeline.

  Feedback (track V, stage V2b): one status line (PageStatus) between the header and the pages says what the sheet is
  doing and what happened - reading, saving, a read that failed, an object that is gone or out of date - and what the
  page in front has to say (its count, its own read, a tab that could not be read). No page has a banner or a progress
  bar of its own. What belongs to one field or one section stays there as a note (validation texts, planner findings,
  the warnings of the name mappings). "Refresh" of the nested list is an action button: while the list is read it is
  the Cancel of that read.
-->
<Window x:Class="AdMng.App.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:AdMng.App.Behaviors"
        xmlns:ad="clr-namespace:AdMng.Core.ActiveDirectory;assembly=AdMng.Core"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:conv="clr-namespace:AdMng.App.Converters"
        xmlns:cv="clr-namespace:AdMng.Presentation.Computers;assembly=AdMng.Presentation"
        xmlns:dlg="clr-namespace:AdMng.Presentation.Dialogs;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:pk="clr-namespace:AdMng.Presentation.Pki;assembly=AdMng.Presentation"
        xmlns:ps="clr-namespace:AdMng.Presentation.PropertySheets;assembly=AdMng.Presentation"
        xmlns:shell="clr-namespace:AdMng.Presentation.Shell;assembly=AdMng.Presentation"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="640"
        Height="754"
        MinWidth="480"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- Compact input density (Fluent reads these keys as dynamic resources). -->
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>

    <conv:GroupScopeEnabledConverter x:Key="GroupScopeEnabled" />
    <conv:NullableBoolRadioConverter x:Key="NullableBoolRadio" />

    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="CompactRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="72" />
    </Style>

    <!-- The small button of the pages as an action button (start, cancel where you started). -->
    <Style x:Key="SmallActionButton" TargetType="{x:Type c:ActionButton}" BasedOn="{StaticResource Ad.ActionButton}">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="72" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
    </Style>

    <!-- A referenced object in a small list: icon, name, folder. -->
    <DataTemplate x:Key="DirectoryItemTemplate" DataType="{x:Type dlg:DirectoryItem}">
      <StackPanel Orientation="Horizontal">
        <c:ObjectIconView Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Icon="{Binding Icon, Mode=OneWay}"
                          Size="16" />
        <TextBlock VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}" />
        <TextBlock Margin="10,0,0,0"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding Path, Mode=OneWay}" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="ReferenceItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnReferenceItemDoubleClick" />
    </Style>

    <!--
      Common frame of every field. Tag selects the layout: (none) = label left / editor right, "Stacked" = label above a
      full-width editor (lists), "Check" = no label column (check boxes, radio groups under a section header), "Copy" =
      label left / editor right, the editor also covering the copy column.
      Copy column: every field reserves it (an empty placeholder) and editors with a copy button ("Copy") put the button
      in their own FieldCopy column. The group is shared by the page, so it is as wide as a copy button when any field of
      the page has one (zero otherwise) and every editor of the page ends at the same x, with or without a copy button.
    -->
    <ControlTemplate x:Key="FieldChrome" TargetType="ContentControl">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="FieldCopy" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="FieldStatus" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="LabelText"
                   Grid.Row="1"
                   MaxWidth="190"
                   Margin="0,6,12,0"
                   VerticalAlignment="Top"
                   Text="{Binding Label, Mode=OneWay}"
                   TextWrapping="Wrap" />
        <ContentPresenter x:Name="Editor"
                          Grid.Row="1"
                          Grid.Column="1" />
        <StackPanel x:Name="StatusGlyphs"
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="6,7,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
          <TextBlock AutomationProperties.Name="{l:Tr ObjectDialogs.PendingChanges}"
                     FontSize="12"
                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Edit}"
                     ToolTip="{l:Tr ObjectDialogs.PendingChanges}"
                     Visibility="{Binding IsDirty, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <!-- AutomationProperties.Name rejects null (WPF validates it): editable fields have no reason. -->
          <TextBlock Margin="4,0,0,0"
                     AutomationProperties.Name="{Binding ReadOnlyReason, Mode=OneWay, TargetNullValue=''}"
                     FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Lock}"
                     ToolTip="{Binding ReadOnlyReason, Mode=OneWay}"
                     Visibility="{Binding ReadOnlyReason, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        </StackPanel>
        <TextBlock x:Name="ErrorLine"
                   Grid.Row="2"
                   Grid.Column="1"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding Error, Mode=OneWay}"
                   Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        <DockPanel x:Name="IssueLine"
                   Grid.Row="3"
                   Grid.Column="1"
                   Margin="0,3,0,0"
                   Visibility="{Binding Issue, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
          <Grid Margin="0,1,6,0"
                VerticalAlignment="Top"
                DockPanel.Dock="Left">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Style="{StaticResource Ad.GlyphText}"
                       Text="{x:Static c:Glyphs.Error}"
                       Visibility="{Binding IsIssueError, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Style="{StaticResource Ad.GlyphText}"
                       Text="{x:Static c:Glyphs.Warning}"
                       Visibility="{Binding IsIssueError, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
          </Grid>
          <TextBlock AutomationProperties.LiveSetting="Assertive"
                     Text="{Binding Issue, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </DockPanel>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="Stacked">
          <Setter TargetName="LabelText" Property="Grid.Row" Value="0" />
          <Setter TargetName="LabelText" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="LabelText" Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
          <Setter TargetName="LabelText" Property="Margin" Value="0,6,0,4" />
          <Setter TargetName="Editor" Property="Grid.Column" Value="0" />
          <Setter TargetName="Editor" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="StatusGlyphs" Property="Grid.Row" Value="0" />
          <Setter TargetName="ErrorLine" Property="Grid.Column" Value="0" />
          <Setter TargetName="ErrorLine" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="IssueLine" Property="Grid.Column" Value="0" />
          <Setter TargetName="IssueLine" Property="Grid.ColumnSpan" Value="2" />
        </Trigger>
        <Trigger Property="Tag" Value="Check">
          <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Editor" Property="Grid.Column" Value="0" />
          <Setter TargetName="Editor" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="StatusGlyphs" Property="Margin" Value="6,2,0,0" />
          <Setter TargetName="ErrorLine" Property="Grid.Column" Value="0" />
          <Setter TargetName="ErrorLine" Property="Grid.ColumnSpan" Value="2" />
          <Setter TargetName="IssueLine" Property="Grid.Column" Value="0" />
          <Setter TargetName="IssueLine" Property="Grid.ColumnSpan" Value="2" />
        </Trigger>
        <Trigger Property="Tag" Value="Copy">
          <Setter TargetName="Editor" Property="Grid.ColumnSpan" Value="2" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===== Fields ===== -->

    <!-- Single text value; informational fields are read-only text boxes (selectable), optional copy and "Other..." list. -->
    <DataTemplate DataType="{x:Type ps:FieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Copy"
                      Template="{StaticResource FieldChrome}">
        <!--
          [CONTOSO\] value [Other...] [copy]; the copy button's column is the page's shared copy column, reserved also
          when this field has no copy button. Tab order: the TabIndex values within this row, then the "Other" list.
        -->
        <Grid KeyboardNavigation.TabNavigation="Local">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldCopy" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!--
            ADUC's "CONTOSO\" in front of the pre-Windows 2000 logon name: copies CONTOSO\login. The prefix is shown in a
            TextBlock: as a string Content the button would read "_" in a NetBIOS name (MY_CORP) as an access key.
          -->
          <Button x:Name="QualifiedCopyButton"
                  Margin="0,0,4,0"
                  Padding="8,4"
                  VerticalAlignment="Top"
                  Command="{Binding CopyQualifiedCommand}"
                  KeyboardNavigation.TabIndex="0"
                  Visibility="{Binding QualifiedPrefix, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
            <Button.ToolTip>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="QualifiedValue" />
              </MultiBinding>
            </Button.ToolTip>
            <AutomationProperties.Name>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="QualifiedValue" />
              </MultiBinding>
            </AutomationProperties.Name>
            <TextBlock Text="{Binding QualifiedPrefix, Mode=OneWay}" />
          </Button>
          <TextBox x:Name="ValueBox"
                   Grid.Column="1"
                   AutomationProperties.Name="{Binding Label, Mode=OneWay, TargetNullValue=''}"
                   IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                   KeyboardNavigation.TabIndex="1"
                   MaxLength="{Binding MaxLength, Mode=OneWay}"
                   Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
          <ToggleButton x:Name="OthersToggle"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Top"
                        Content="{l:Tr Fields.Other}"
                        KeyboardNavigation.TabIndex="2"
                        Visibility="{Binding Others, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          <!-- One-click copy (e-mail, phones, logon name, Object page...): "Copy: <label>", check mark after the click. -->
          <Button x:Name="CopyButton"
                  Grid.Column="3"
                  Margin="4,0,0,0"
                  VerticalAlignment="Top"
                  b:CopyFeedback.IsEnabled="True"
                  Command="{Binding CopyCommand}"
                  Content="{x:Static c:Glyphs.Copy}"
                  KeyboardNavigation.TabIndex="3"
                  Style="{StaticResource Ad.IconButton}"
                  Visibility="{Binding CanCopy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
            <Button.ToolTip>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="Label" />
              </MultiBinding>
            </Button.ToolTip>
            <AutomationProperties.Name>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="Label" />
              </MultiBinding>
            </AutomationProperties.Name>
          </Button>
          <!-- Below the value, as wide as the other editors of the page (not under the copy column). -->
          <ContentControl Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Margin="0,4,0,0"
                          Content="{Binding Others, Mode=OneWay}"
                          Focusable="False"
                          Grid.IsSharedSizeScope="True"
                          IsTabStop="False"
                          Visibility="{Binding IsChecked, ElementName=OthersToggle, Converter={StaticResource Ad.BoolToVisibility}}" />
        </Grid>
      </ContentControl>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMultiline, Mode=OneWay}" Value="True">
          <Setter TargetName="ValueBox" Property="AcceptsReturn" Value="True" />
          <Setter TargetName="ValueBox" Property="TextWrapping" Value="Wrap" />
          <Setter TargetName="ValueBox" Property="MinHeight" Value="64" />
          <Setter TargetName="ValueBox" Property="VerticalContentAlignment" Value="Top" />
          <Setter TargetName="ValueBox" Property="VerticalScrollBarVisibility" Value="Auto" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Multi-valued text (otherTelephone, url...): list + add / edit / remove. -->
    <DataTemplate DataType="{x:Type ps:MultiValueFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Stacked"
                      Template="{StaticResource FieldChrome}">
        <StackPanel>
          <ListBox MinHeight="56"
                   MaxHeight="120"
                   AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                   ItemsSource="{Binding Values, Mode=OneWay}"
                   SelectedItem="{Binding SelectedValue}" />
          <DockPanel Margin="0,6,0,0" IsEnabled="{Binding IsEditable, Mode=OneWay}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Margin="6,0,0,0"
                      Command="{Binding AddCommand}"
                      Content="{l:Tr Common.Add}" />
              <Button Margin="6,0,0,0"
                      Command="{Binding EditCommand}"
                      Content="{l:Tr Common.Edit}" />
              <Button Margin="6,0,0,0"
                      Command="{Binding RemoveCommand}"
                      Content="{l:Tr Common.Remove}" />
            </StackPanel>
            <TextBox AutomationProperties.Name="{l:Tr ObjectDialogs.NewValue}" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
          <TextBlock Style="{StaticResource ErrorText}"
                     Text="{Binding NewValueError, Mode=OneWay}"
                     Visibility="{Binding NewValueError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        </StackPanel>
      </ContentControl>
    </DataTemplate>

    <!-- Check box (account options, unlock, must change password). -->
    <DataTemplate DataType="{x:Type ps:CheckFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Check"
                      Template="{StaticResource FieldChrome}"
                      Visibility="{Binding IsVisible, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <CheckBox AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                  IsChecked="{Binding IsChecked}"
                  IsEnabled="{Binding IsEditable, Mode=OneWay}">
          <TextBlock Text="{Binding Label, Mode=OneWay}" TextWrapping="Wrap" />
        </CheckBox>
      </ContentControl>
    </DataTemplate>

    <!-- userAccountControl option (same look as a check field). -->
    <DataTemplate DataType="{x:Type ps:FlagFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Check"
                      Template="{StaticResource FieldChrome}"
                      Visibility="{Binding IsVisible, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <CheckBox AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                  IsChecked="{Binding IsChecked}"
                  IsEnabled="{Binding IsEditable, Mode=OneWay}">
          <TextBlock Text="{Binding Label, Mode=OneWay}" TextWrapping="Wrap" />
        </CheckBox>
      </ContentControl>
    </DataTemplate>

    <!--
      Account state on the Account tab (README U2): lock, password and account expiry with the days left, last logon; on
      demand the lock state and the exact last logon on every DC. "Wyślij wiadomość…" is the U1 hook (hidden without it).
    -->
    <DataTemplate DataType="{x:Type ps:AccountStatusFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Check"
                      Template="{StaticResource FieldChrome}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Margin="0,2,12,2" Text="{l:Tr AccountStatus.State}" />
          <TextBlock x:Name="StatusStateText"
                     Grid.Column="1"
                     Margin="0,2"
                     Text="{Binding StateText, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Margin="0,2,12,2" Text="{l:Tr AccountStatus.Password}" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,2"
                     Text="{Binding PasswordText, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Margin="0,2,12,2" Text="{l:Tr AccountStatus.Account}" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,2"
                     Text="{Binding AccountText, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Margin="0,2,12,2" Text="{l:Tr AccountStatus.LastLogon}" />
          <TextBlock Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,2"
                     Text="{Binding LastLogonText, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <StackPanel Grid.Row="4"
                      Grid.Column="1"
                      Margin="0,6,0,0"
                      Orientation="Horizontal">
            <Button x:Name="CheckDomainControllersButton"
                    Command="{Binding CheckDomainControllersCommand}"
                    Content="{l:Tr AccountStatus.CheckDomainControllers}" />
            <Button Margin="6,0,0,0"
                    Command="{Binding SendMessageCommand}"
                    Content="{l:Tr AccountReview.SendMessage}"
                    Visibility="{Binding CanSendMessages, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
            <!-- Track E: "Skąd blokada konta…" opens the lockout source of this account in the main window. -->
            <Button x:Name="FindLockoutSourceButton"
                    Margin="6,0,0,0"
                    Command="{Binding FindLockoutSourceCommand}"
                    Content="{l:Tr EvtLog.LockoutCommand}"
                    Visibility="{Binding CanFindLockoutSource, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          </StackPanel>
          <TextBlock Grid.Row="5"
                     Grid.Column="1"
                     Margin="0,6,0,0"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding DomainControllersText, Mode=OneWay}"
                     TextWrapping="Wrap"
                     Visibility="{Binding DomainControllersText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        </Grid>
      </ContentControl>
    </DataTemplate>

    <!-- Account expires: Never / End of [date]. -->
    <DataTemplate DataType="{x:Type ps:ExpiryFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Check"
                      Template="{StaticResource FieldChrome}">
        <Grid IsEnabled="{Binding IsEditable, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <RadioButton Grid.ColumnSpan="2"
                       Content="{l:Tr Fields.Never}"
                       IsChecked="{Binding IsNever}" />
          <RadioButton Grid.Row="1"
                       Margin="0,6,0,0"
                       VerticalAlignment="Center"
                       Content="{l:Tr Fields.EndOf}"
                       IsChecked="{Binding IsNever, Converter={StaticResource Ad.InverseBool}}" />
          <DatePicker Grid.Row="1"
                      Grid.Column="1"
                      MinWidth="160"
                      MaxWidth="240"
                      Margin="10,6,0,0"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                      b:DatePickerWatermark.Text="{l:Tr Ui.SelectDate}"
                      IsEnabled="{Binding IsNever, Mode=OneWay, Converter={StaticResource Ad.InverseBool}}"
                      SelectedDate="{Binding EndOfDate}" />
        </Grid>
      </ContentControl>
    </DataTemplate>

    <!-- Reference to another object (manager, managed by) with picker, properties and the manager's details. -->
    <DataTemplate DataType="{x:Type ps:DnFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Copy"
                      Template="{StaticResource FieldChrome}">
        <!--
          Everything left of the page's shared copy column, the copy button in it. Tab order as on screen: the name, its
          copy button (TabIndex), then Browse / Properties / Clear.
        -->
        <Grid KeyboardNavigation.TabNavigation="Local">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldCopy" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Grid>
              <TextBox AutomationProperties.Name="{Binding Label, Mode=OneWay, TargetNullValue=''}"
                       IsReadOnly="True"
                       KeyboardNavigation.TabIndex="0"
                       Text="{Binding DisplayName, Mode=OneWay}"
                       ToolTip="{Binding Value, Mode=OneWay}" />
              <TextBlock Style="{StaticResource Ad.HintText}"
                         Text="{l:Tr Common.NotSet}"
                         Visibility="{Binding HasValue, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
            </Grid>
            <TextBlock Margin="2,2,0,0"
                       FontSize="11"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{Binding Path, Mode=OneWay}"
                       Visibility="{Binding Path, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
            <WrapPanel Margin="0,6,0,0">
              <Button Command="{Binding BrowseCommand}"
                      Content="{l:Tr Common.Browse}"
                      Style="{StaticResource SmallButton}" />
              <Button Command="{Binding OpenCommand}"
                      Content="{l:Tr Commands.Properties}"
                      Style="{StaticResource SmallButton}" />
              <Button Command="{Binding ClearCommand}"
                      Content="{l:Tr Common.Clear}"
                      Style="{StaticResource SmallButton}" />
            </WrapPanel>
            <ItemsControl Margin="0,8,0,0"
                          Focusable="False"
                          Grid.IsSharedSizeScope="True"
                          ItemsSource="{Binding Details, Mode=OneWay}"
                          Visibility="{Binding ShowsDetails, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type shell:SummaryField}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="DetailLabel" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Top"
                               Style="{StaticResource Ad.SecondaryText}"
                               Text="{Binding Label, Mode=OneWay}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value, Mode=OneWay}"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- Copies the referenced object's name (the manager's name for a ticket or an e-mail). -->
          <Button x:Name="CopyReferenceButton"
                  Grid.Column="1"
                  Margin="4,0,0,0"
                  VerticalAlignment="Top"
                  b:CopyFeedback.IsEnabled="True"
                  Command="{Binding CopyCommand}"
                  Content="{x:Static c:Glyphs.Copy}"
                  KeyboardNavigation.TabIndex="1"
                  Style="{StaticResource Ad.IconButton}">
            <Button.ToolTip>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="Label" />
              </MultiBinding>
            </Button.ToolTip>
            <AutomationProperties.Name>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="Label" />
              </MultiBinding>
            </AutomationProperties.Name>
          </Button>
        </Grid>
      </ContentControl>
    </DataTemplate>

    <!-- Read-only list of referenced objects (direct reports); double click opens their properties. -->
    <DataTemplate DataType="{x:Type ps:ReferenceListFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Stacked"
                      Template="{StaticResource FieldChrome}">
        <StackPanel>
          <ListBox MinHeight="56"
                   MaxHeight="140"
                   AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                   ItemContainerStyle="{StaticResource ReferenceItemStyle}"
                   ItemTemplate="{StaticResource DirectoryItemTemplate}"
                   ItemsSource="{Binding Items, Mode=OneWay}"
                   KeyDown="OnReferenceListKeyDown"
                   SelectedItem="{Binding SelectedItem}" />
          <WrapPanel Margin="0,6,0,0">
            <Button Command="{Binding OpenCommand}"
                    Content="{l:Tr Commands.Properties}"
                    Style="{StaticResource SmallButton}" />
          </WrapPanel>
        </StackPanel>
      </ContentControl>
    </DataTemplate>

    <!-- Country/region (writes c, co and countryCode). -->
    <DataTemplate DataType="{x:Type ps:CountryFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Template="{StaticResource FieldChrome}">
        <ComboBox AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                  DisplayMemberPath="Text"
                  IsEnabled="{Binding IsEditable, Mode=OneWay}"
                  ItemsSource="{Binding Options, Mode=OneWay}"
                  SelectedItem="{Binding SelectedOption}"
                  TextSearch.TextPath="Text">
          <ComboBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ComboBox.ItemsPanel>
        </ComboBox>
      </ContentControl>
    </DataTemplate>

    <!-- Home folder: local path, or a drive letter connected to a network path. -->
    <DataTemplate DataType="{x:Type ps:HomeFolderFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Check"
                      Template="{StaticResource FieldChrome}">
        <Grid IsEnabled="{Binding IsEditable, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <RadioButton VerticalAlignment="Center"
                       Content="{l:Tr Labels.LocalPath}"
                       IsChecked="{Binding UseLocalPath}" />
          <TextBox Grid.Column="1"
                   Grid.ColumnSpan="3"
                   Margin="10,0,0,0"
                   AutomationProperties.Name="{l:Tr Labels.LocalPath}"
                   IsEnabled="{Binding UseLocalPath, Mode=OneWay}"
                   Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" />
          <RadioButton Grid.Row="1"
                       Margin="0,6,0,0"
                       VerticalAlignment="Center"
                       Content="{l:Tr Labels.Connect}"
                       IsChecked="{Binding UseDrive}" />
          <ComboBox Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="72"
                    Margin="10,6,0,0"
                    AutomationProperties.Name="{l:Tr Labels.Connect}"
                    IsEnabled="{Binding UseDrive, Mode=OneWay}"
                    ItemsSource="{Binding Drives, Mode=OneWay}"
                    SelectedItem="{Binding Drive}" />
          <TextBlock Grid.Row="1"
                     Grid.Column="2"
                     Margin="10,6,0,0"
                     VerticalAlignment="Center"
                     Text="{l:Tr Labels.To}" />
          <TextBox Grid.Row="1"
                   Grid.Column="3"
                   Margin="8,6,0,0"
                   AutomationProperties.Name="{l:Tr Labels.To}"
                   IsEnabled="{Binding UseDrive, Mode=OneWay}"
                   Text="{Binding NetworkPath, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      </ContentControl>
    </DataTemplate>

    <!-- User logon name: prefix @ suffix. -->
    <DataTemplate DataType="{x:Type ps:UpnFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Copy"
                      Template="{StaticResource FieldChrome}">
        <!-- prefix @ [suffix] [copy]; the copy button in the page's shared copy column. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldCopy" />
          </Grid.ColumnDefinitions>
          <TextBox AutomationProperties.Name="{Binding Label, Mode=OneWay, TargetNullValue=''}"
                   IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                   Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Column="1"
                     Margin="6,0"
                     VerticalAlignment="Center"
                     Text="@" />
          <ComboBox Grid.Column="2"
                    MinWidth="140"
                    AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                    IsEnabled="{Binding IsEditable, Mode=OneWay}"
                    ItemsSource="{Binding Suffixes, Mode=OneWay}"
                    SelectedItem="{Binding Suffix}" />
          <!-- Copies prefix@suffix as it will be written. -->
          <Button x:Name="CopyUpnButton"
                  Grid.Column="3"
                  Margin="4,0,0,0"
                  VerticalAlignment="Top"
                  b:CopyFeedback.IsEnabled="True"
                  Command="{Binding CopyCommand}"
                  Content="{x:Static c:Glyphs.Copy}"
                  Style="{StaticResource Ad.IconButton}">
            <Button.ToolTip>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="Label" />
              </MultiBinding>
            </Button.ToolTip>
            <AutomationProperties.Name>
              <MultiBinding Converter="{StaticResource Ad.Format}" TargetNullValue="">
                <l:TrBinding Key="Copy.CopyValue" />
                <Binding Mode="OneWay" Path="Label" />
              </MultiBinding>
            </AutomationProperties.Name>
          </Button>
        </Grid>
      </ContentControl>
    </DataTemplate>

    <!-- Log On To: all computers or a list of computer names. -->
    <DataTemplate DataType="{x:Type ps:WorkstationsFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Check"
                      Template="{StaticResource FieldChrome}">
        <StackPanel IsEnabled="{Binding IsEditable, Mode=OneWay}">
          <RadioButton Content="{l:Tr Labels.AllComputers}" IsChecked="{Binding AllComputers}" />
          <RadioButton Margin="0,4,0,0"
                       Content="{l:Tr Labels.TheseComputers}"
                       IsChecked="{Binding AllComputers, Converter={StaticResource Ad.InverseBool}}" />
          <StackPanel Margin="28,6,0,0" IsEnabled="{Binding AllComputers, Mode=OneWay, Converter={StaticResource Ad.InverseBool}}">
            <DockPanel>
              <Button Margin="6,0,0,0"
                      Command="{Binding AddCommand}"
                      Content="{l:Tr Common.Add}"
                      DockPanel.Dock="Right" />
              <TextBox AutomationProperties.Name="{l:Tr Labels.ComputerName}" Text="{Binding NewComputer, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
              </TextBox>
            </DockPanel>
            <TextBlock Style="{StaticResource ErrorText}"
                       Text="{Binding NewComputerError, Mode=OneWay}"
                       Visibility="{Binding NewComputerError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
            <DockPanel Margin="0,6,0,0">
              <Button Margin="6,0,0,0"
                      VerticalAlignment="Top"
                      Command="{Binding RemoveCommand}"
                      Content="{l:Tr Common.Remove}"
                      DockPanel.Dock="Right" />
              <ListBox MinHeight="56"
                       MaxHeight="120"
                       AutomationProperties.Name="{l:Tr Labels.TheseComputers}"
                       ItemsSource="{Binding Computers, Mode=OneWay}"
                       SelectedItem="{Binding SelectedComputer}" />
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </ContentControl>
    </DataTemplate>

    <!-- Logon hours: summary in local time and the Logon Hours dialog (read-only without permission to write logonHours). -->
    <DataTemplate DataType="{x:Type ps:LogonHoursFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Template="{StaticResource FieldChrome}">
        <DockPanel>
          <!-- The summary is not focusable: the button's help text gives it to a screen reader. -->
          <Button Margin="8,0,0,0"
                  VerticalAlignment="Top"
                  AutomationProperties.HelpText="{Binding Summary, Mode=OneWay, TargetNullValue=''}"
                  Command="{Binding EditCommand}"
                  Content="{l:Tr Labels.LogonHoursButton}"
                  DockPanel.Dock="Right"
                  Style="{StaticResource SmallButton}" />
          <TextBlock Margin="0,6,0,0"
                     VerticalAlignment="Top"
                     Text="{Binding Summary, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </DockPanel>
      </ContentControl>
    </DataTemplate>

    <!-- Group scope and type with ADUC's conversion rules (disabled scopes cannot be reached directly). -->
    <DataTemplate DataType="{x:Type ps:GroupTypeFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Check"
                      Template="{StaticResource FieldChrome}">
        <Grid IsEnabled="{Binding IsEditable, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr Labels.GroupScope}" />
            <RadioButton Margin="0,2"
                         Content="{l:Tr GroupScope.DomainLocal}"
                         IsChecked="{Binding IsDomainLocal}"
                         IsEnabled="{Binding ScopeOptions, Mode=OneWay, Converter={StaticResource GroupScopeEnabled}, ConverterParameter={x:Static ad:GroupScope.DomainLocal}}" />
            <RadioButton Margin="0,2"
                         Content="{l:Tr GroupScope.Global}"
                         IsChecked="{Binding IsGlobal}"
                         IsEnabled="{Binding ScopeOptions, Mode=OneWay, Converter={StaticResource GroupScopeEnabled}, ConverterParameter={x:Static ad:GroupScope.Global}}" />
            <RadioButton Margin="0,2"
                         Content="{l:Tr GroupScope.Universal}"
                         IsChecked="{Binding IsUniversal}"
                         IsEnabled="{Binding ScopeOptions, Mode=OneWay, Converter={StaticResource GroupScopeEnabled}, ConverterParameter={x:Static ad:GroupScope.Universal}}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr Labels.GroupType}" />
            <RadioButton Margin="0,2"
                         Content="{l:Tr Labels.Security}"
                         IsChecked="{Binding IsSecurity}" />
            <RadioButton Margin="0,2"
                         Content="{l:Tr Labels.Distribution}"
                         IsChecked="{Binding IsDistribution}" />
          </StackPanel>
        </Grid>
      </ContentControl>
    </DataTemplate>

    <!-- Kerberos AES encryption types. -->
    <DataTemplate DataType="{x:Type ps:EncryptionTypesFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Stacked"
                      Template="{StaticResource FieldChrome}">
        <StackPanel IsEnabled="{Binding IsEditable, Mode=OneWay}">
          <CheckBox AutomationProperties.Name="{Binding Aes128Label, Mode=OneWay}" IsChecked="{Binding Aes128}">
            <TextBlock Text="{Binding Aes128Label, Mode=OneWay}" TextWrapping="Wrap" />
          </CheckBox>
          <CheckBox Margin="0,4,0,0"
                    AutomationProperties.Name="{Binding Aes256Label, Mode=OneWay}"
                    IsChecked="{Binding Aes256}">
            <TextBlock Text="{Binding Aes256Label, Mode=OneWay}" TextWrapping="Wrap" />
          </CheckBox>
        </StackPanel>
      </ContentControl>
    </DataTemplate>

    <!-- E-mail addresses (proxyAddresses) with the primary SMTP rule. -->
    <DataTemplate DataType="{x:Type ps:ProxyAddressesFieldViewModel}">
      <ContentControl Focusable="False"
                      IsTabStop="False"
                      Tag="Stacked"
                      Template="{StaticResource FieldChrome}">
        <StackPanel>
          <StackPanel.Resources>
            <!-- The field for the context menu (outside the visual tree). -->
            <c:BindingProxy x:Key="ProxyFieldProxy" Data="{Binding}" />
          </StackPanel.Resources>
          <ListView x:Name="ProxyAddressList"
                    Height="150"
                    AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource CompactRow}"
                    ItemsSource="{Binding Items, Mode=OneWay}"
                    KeyDown="OnProxyAddressListKeyDown"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionMode="Single">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding Data.CopyAddressCommand, Source={StaticResource ProxyFieldProxy}}"
                          Header="{l:Tr Copy.CopyAddress}"
                          InputGestureText="Ctrl+C" />
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="72" Header="{l:Tr Labels.AddressType}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type ps:ProxyAddressViewModel}">
                      <TextBlock x:Name="TypeText" Text="{Binding Type, Mode=OneWay}" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPrimary, Mode=OneWay}" Value="True">
                          <Setter TargetName="TypeText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="260" Header="{l:Tr Labels.Address}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type ps:ProxyAddressViewModel}">
                      <TextBlock x:Name="AddressText"
                                 Text="{Binding Address, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPrimary, Mode=OneWay}" Value="True">
                          <Setter TargetName="AddressText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="90" Header="{l:Tr ObjectDialogs.Primary}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type ps:ProxyAddressViewModel}">
                      <TextBlock HorizontalAlignment="Left"
                                 FontSize="12"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 Style="{StaticResource Ad.GlyphText}"
                                 Text="{x:Static c:Glyphs.Completed}"
                                 Visibility="{Binding IsPrimary, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <!-- Set primary / Remove need write access (their commands check it); Copy address works on read-only fields too. -->
          <WrapPanel Margin="0,6,0,0">
            <Button Command="{Binding SetPrimaryCommand}"
                    Content="{l:Tr Labels.SetPrimaryAddress}"
                    Style="{StaticResource SmallButton}" />
            <Button Command="{Binding RemoveCommand}"
                    Content="{l:Tr Common.Remove}"
                    Style="{StaticResource SmallButton}" />
            <Button x:Name="CopyAddressButton"
                    Command="{Binding CopyAddressCommand}"
                    Content="{l:Tr Copy.CopyAddress}"
                    Style="{StaticResource SmallButton}" />
          </WrapPanel>
          <DockPanel Margin="0,6,0,0" IsEnabled="{Binding IsEditable, Mode=OneWay}">
            <Button Margin="6,0,0,0"
                    Command="{Binding AddCommand}"
                    Content="{l:Tr Common.Add}"
                    DockPanel.Dock="Right" />
            <ComboBox Width="96"
                      Margin="0,0,6,0"
                      AutomationProperties.Name="{l:Tr Labels.AddressType}"
                      DockPanel.Dock="Left"
                      IsEditable="True"
                      ItemsSource="{Binding Types, Mode=OneWay}"
                      Text="{Binding NewType, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox AutomationProperties.Name="{l:Tr Labels.Address}" Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
          <TextBlock Style="{StaticResource ErrorText}"
                     Text="{Binding NewAddressError, Mode=OneWay}"
                     Visibility="{Binding NewAddressError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        </StackPanel>
      </ContentControl>
    </DataTemplate>

    <!-- ===== Pages ===== -->

    <DataTemplate x:Key="PageHeaderTemplate" DataType="{x:Type ps:PropertyPageViewModel}">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Text="{Binding Title, Mode=OneWay}" />
        <TextBlock Margin="5,0,0,0"
                   FontSize="10"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Edit}"
                   ToolTip="{l:Tr ObjectDialogs.PendingChanges}"
                   Visibility="{Binding HasChanges, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <TextBlock Margin="5,0,0,0"
                   FontSize="10"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Error}"
                   ToolTip="{l:Tr PropertySheet.FixErrors}"
                   Visibility="{Binding HasErrors, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <!-- General, Address, Account, Profile, Telephones, Organization, E-mail Addresses, Object... -->
    <DataTemplate DataType="{x:Type ps:FieldsPageViewModel}">
      <ScrollViewer Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl Margin="16,10,16,16"
                      Focusable="False"
                      Grid.IsSharedSizeScope="True"
                      ItemsSource="{Binding Sections, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type ps:FieldSectionViewModel}">
              <StackPanel Margin="0,0,0,10">
                <TextBlock Margin="0,8,0,2"
                           Style="{StaticResource Ad.SectionHeader}"
                           Text="{Binding Header, Mode=OneWay}"
                           Visibility="{Binding Header, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding Fields, Mode=OneWay}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DataTemplate>

    <!--
      Member Of / Members: filter, direct list with staged changes, lazily loaded "All (nested)" list. The count of
      the list in front, its read and a read that failed are said in the status line of the sheet: the page tells
      its view model which of its two lists is shown (SelectedListIndex).
    -->
    <DataTemplate x:Key="MembershipBody" DataType="{x:Type ps:MembershipPageViewModel}">
      <DockPanel>
        <DockPanel.Resources>
          <!-- The page for the list's context menu (outside the visual tree). -->
          <c:BindingProxy x:Key="MembershipPageProxy" Data="{Binding}" />
        </DockPanel.Resources>
        <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
          <Grid Width="260" HorizontalAlignment="Left">
            <TextBox x:Name="MembershipFilterBox"
                     AutomationProperties.Name="{l:Tr Common.Filter}"
                     KeyDown="OnFilterBoxKeyDown"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
            <TextBlock Style="{StaticResource Ad.HintText}"
                       Text="{l:Tr Common.Filter}"
                       Visibility="{Binding Text, ElementName=MembershipFilterBox, Converter={StaticResource Ad.EmptyToVisible}}" />
          </Grid>
        </DockPanel>
        <TabControl x:Name="MembershipTabs"
                    SelectedIndex="{Binding SelectedListIndex}"
                    SelectionChanged="OnMembershipTabChanged">
          <TabItem Header="{l:Tr Membership.Direct}">
            <DockPanel Margin="0,6,0,0">
              <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                <Button Command="{Binding AddCommand}"
                        Content="{l:Tr Common.Add}"
                        Style="{StaticResource SmallButton}" />
                <Button Command="{Binding RemoveCommand}"
                        Content="{l:Tr Common.Remove}"
                        Style="{StaticResource SmallButton}" />
                <Button Command="{Binding OpenCommand}"
                        Content="{l:Tr Commands.Properties}"
                        Style="{StaticResource SmallButton}" />
                <!-- Members page: every member's address for Outlook's To field ("; "). -->
                <Button x:Name="CopyAllMailButton"
                        Command="{Binding CopyAllMailCommand}"
                        Content="{l:Tr Copy.CopyAllMail}"
                        Style="{StaticResource SmallButton}"
                        Visibility="{Binding CanCopyAllMail, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
              </WrapPanel>
              <ListView x:Name="MembershipList"
                        AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                        ItemsSource="{Binding Items, Mode=OneWay}"
                        KeyDown="OnMembershipListKeyDown"
                        Loaded="OnMembershipListLoaded"
                        SelectedItem="{Binding SelectedItem}"
                        SelectionChanged="OnMembershipSelectionChanged"
                        SelectionMode="Extended"
                        Unloaded="OnMembershipListUnloaded">
                <ListView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Command="{Binding Data.OpenCommand, Source={StaticResource MembershipPageProxy}}"
                              FontWeight="SemiBold"
                              Header="{l:Tr Commands.Properties}"
                              InputGestureText="Enter" />
                    <Separator />
                    <MenuItem Command="{Binding Data.CopyNamesCommand, Source={StaticResource MembershipPageProxy}}"
                              Header="{l:Tr Copy.CopyName}"
                              InputGestureText="Ctrl+C" />
                    <MenuItem Command="{Binding Data.CopyDnsCommand, Source={StaticResource MembershipPageProxy}}"
                              Header="{l:Tr Commands.CopyDn}"
                              InputGestureText="Ctrl+Shift+C" />
                    <MenuItem Command="{Binding Data.CopyMailCommand, Source={StaticResource MembershipPageProxy}}"
                              Header="{l:Tr Copy.CopyMail}" />
                    <MenuItem Command="{Binding Data.CopyAllMailCommand, Source={StaticResource MembershipPageProxy}}"
                              Header="{l:Tr Copy.CopyAllMail}"
                              Visibility="{Binding Data.CanCopyAllMail, Source={StaticResource MembershipPageProxy}, Converter={StaticResource Ad.BoolToVisibility}}" />
                  </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactRow}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnMembershipItemDoubleClick" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="220" Header="{l:Tr Common.Name}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ps:MembershipItemViewModel}">
                          <DockPanel>
                            <c:ObjectIconView Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              DockPanel.Dock="Left"
                                              Icon="{Binding Icon, Mode=OneWay}"
                                              Size="16" />
                            <TextBlock x:Name="NameText"
                                       VerticalAlignment="Center"
                                       Text="{Binding Name, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPendingRemove, Mode=OneWay}" Value="True">
                              <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                              <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPendingAdd, Mode=OneWay}" Value="True">
                              <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPrimary, Mode=OneWay}" Value="True">
                              <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="140" Header="{l:Tr Columns.Type}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ps:MembershipItemViewModel}">
                          <TextBlock Text="{Binding TypeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200" Header="{l:Tr Labels.Folder}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ps:MembershipItemViewModel}">
                          <TextBlock Text="{Binding Path, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="130" Header="{l:Tr Batch.Status}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type ps:MembershipItemViewModel}">
                          <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding StatusText, Mode=OneWay}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </TabItem>
          <TabItem Header="{l:Tr Membership.Nested}">
            <DockPanel Margin="0,6,0,0">
              <!-- Refresh reads the list; while it is read the same button is the Cancel of that read. -->
              <c:ActionButton x:Name="NestedRefreshButton"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Left"
                              CancelCommand="{Binding NestedStatus.CancelCommand, Mode=OneWay}"
                              Command="{Binding LoadNestedCommand}"
                              Content="{l:Tr Commands.Refresh}"
                              DockPanel.Dock="Top"
                              IsCancelling="{Binding NestedStatus.IsCancelling, Mode=OneWay}"
                              IsRunning="{Binding NestedStatus.IsWorking, Mode=OneWay}"
                              Style="{StaticResource SmallActionButton}" />
              <ListView x:Name="NestedList"
                        AutomationProperties.Name="{l:Tr Membership.Nested}"
                        ItemsSource="{Binding NestedItems, Mode=OneWay}"
                        KeyDown="OnNestedListKeyDown"
                        SelectionMode="Single">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactRow}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnNestedItemDoubleClick" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="240" Header="{l:Tr Common.Name}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
                          <DockPanel>
                            <c:ObjectIconView Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              DockPanel.Dock="Left"
                                              Icon="{Binding Icon, Mode=OneWay}"
                                              Size="16" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Name, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="150" Header="{l:Tr Columns.Type}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
                          <TextBlock Text="{Binding TypeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="220" Header="{l:Tr Labels.Folder}">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
                          <TextBlock Text="{Binding Path, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type ps:MemberOfPageViewModel}">
      <DockPanel Margin="12,10,12,12">
        <DockPanel Margin="0,10,0,0"
                   DockPanel.Dock="Bottom"
                   Visibility="{Binding SupportsPrimaryGroup, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <Button Margin="12,0,0,0"
                  Command="{Binding SetPrimaryGroupCommand}"
                  Content="{l:Tr ObjectDialogs.SetPrimaryGroup}"
                  DockPanel.Dock="Right" />
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="{l:Tr Labels.PrimaryGroup}" /><Run Text=": " /><Run FontWeight="SemiBold" Text="{Binding PrimaryGroupName, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
        <ContentControl Content="{Binding Mode=OneWay}"
                        ContentTemplate="{StaticResource MembershipBody}"
                        Focusable="False"
                        IsTabStop="False" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type ps:MembersPageViewModel}">
      <ContentControl Margin="12,10,12,12"
                      Content="{Binding Mode=OneWay}"
                      ContentTemplate="{StaticResource MembershipBody}"
                      Focusable="False"
                      IsTabStop="False" />
    </DataTemplate>

    <!-- Attribute Editor: value editor panel (shown while AttributeEditorPageViewModel.Editor is set). -->
    <Style x:Key="SingleValueEditor" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.Text}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.Integer}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.LargeInteger}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.FileTime}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.DateTime}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.Dn}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MultiValueEditor" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.MultiText}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.MultiDn}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BooleanEditor" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.Boolean}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BinaryEditor" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.Binary}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BrowseDnButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.Dn}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static ps:AttributeEditorKind.MultiDn}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate DataType="{x:Type ps:AttributeValueEditorViewModel}">
      <!-- Code-behind moves the keyboard focus into the editor when it opens and back to the list when it closes. -->
      <DockPanel Loaded="OnValueEditorLoaded" Unloaded="OnValueEditorUnloaded">
        <!-- Enter / Esc act on the value editor, not on the sheet's OK / Cancel buttons. -->
        <DockPanel.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        </DockPanel.InputBindings>
        <TextBlock DockPanel.Dock="Top"
                   FontWeight="SemiBold"
                   Text="{Binding Title, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Margin="0,2,0,0"
                   DockPanel.Dock="Top"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding Hint, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding Hint, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        <DockPanel Margin="0,4,0,0"
                   DockPanel.Dock="Top"
                   Visibility="{Binding IsReadOnly, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <TextBlock Margin="0,0,6,0"
                     DockPanel.Dock="Left"
                     FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Lock}" />
          <TextBlock Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding Row.ReadOnlyReason, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </DockPanel>
        <StackPanel Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
          <Button Command="{Binding ClearCommand}"
                  Content="{l:Tr Common.Clear}"
                  Style="{StaticResource SmallButton}"
                  Visibility="{Binding IsReadOnly, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
          <Button Command="{Binding OkCommand}"
                  Content="{l:Tr Common.Ok}"
                  Style="{StaticResource SmallButton}" />
          <Button Margin="0"
                  Command="{Binding CancelCommand}"
                  Content="{l:Tr Common.Cancel}"
                  Style="{StaticResource SmallButton}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding Error, Mode=OneWay}"
                   Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        <Grid Margin="0,8,0,0">
          <!-- Text, numbers, dates, one DN -->
          <DockPanel Style="{StaticResource SingleValueEditor}">
            <Button Margin="6,0,0,0"
                    Command="{Binding BrowseCommand}"
                    Content="{l:Tr Common.Browse}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource BrowseDnButton}" />
            <TextBox AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                     IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding OkCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
          <!-- Several values -->
          <DockPanel Style="{StaticResource MultiValueEditor}">
            <DockPanel Margin="0,6,0,0" DockPanel.Dock="Bottom">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="6,0,0,0"
                        Command="{Binding AddValueCommand}"
                        Content="{l:Tr Common.Add}" />
                <Button Margin="6,0,0,0"
                        Command="{Binding RemoveValueCommand}"
                        Content="{l:Tr Common.Remove}" />
                <Button Margin="6,0,0,0"
                        Command="{Binding BrowseCommand}"
                        Content="{l:Tr Common.Browse}"
                        Style="{StaticResource BrowseDnButton}" />
              </StackPanel>
              <TextBox AutomationProperties.Name="{l:Tr ObjectDialogs.NewValue}"
                       IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                       Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AddValueCommand}" />
                </TextBox.InputBindings>
              </TextBox>
            </DockPanel>
            <ListBox MinHeight="60"
                     MaxHeight="130"
                     AutomationProperties.Name="{l:Tr ObjectDialogs.Values}"
                     ItemsSource="{Binding Values, Mode=OneWay}"
                     SelectedItem="{Binding SelectedValue}" />
          </DockPanel>
          <!-- TRUE / FALSE / not set -->
          <StackPanel Orientation="Horizontal" Style="{StaticResource BooleanEditor}">
            <RadioButton Margin="0,0,16,0"
                         Content="{l:Tr Format.True}"
                         IsChecked="{Binding BooleanValue, Converter={StaticResource NullableBoolRadio}, ConverterParameter=True}"
                         IsEnabled="{Binding IsReadOnly, Mode=OneWay, Converter={StaticResource Ad.InverseBool}}" />
            <RadioButton Margin="0,0,16,0"
                         Content="{l:Tr Format.False}"
                         IsChecked="{Binding BooleanValue, Converter={StaticResource NullableBoolRadio}, ConverterParameter=False}"
                         IsEnabled="{Binding IsReadOnly, Mode=OneWay, Converter={StaticResource Ad.InverseBool}}" />
            <RadioButton Content="{l:Tr AttributeEditor.NotSet}"
                         IsChecked="{Binding BooleanValue, Converter={StaticResource NullableBoolRadio}, ConverterParameter=Null}"
                         IsEnabled="{Binding IsReadOnly, Mode=OneWay, Converter={StaticResource Ad.InverseBool}}" />
          </StackPanel>
          <!--
            Binary: read-only hexadecimal view. The visibility style sits on a wrapper: an explicit Style on the TextBox
            would replace its implicit Fluent style.
          -->
          <Grid Style="{StaticResource BinaryEditor}">
            <TextBox MaxHeight="130"
                     AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                     FontFamily="Cascadia Mono, Consolas"
                     IsReadOnly="True"
                     Text="{Binding Value, Mode=OneWay}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
          </Grid>
        </Grid>
      </DockPanel>
    </DataTemplate>

    <!-- Computers (K1): "Stan" – type, system, support, last logon (exact on demand), site, creator, owner, LAPS, and the
         remote actions and tools of the computer. Read only. The two reads on demand say in the status line of the
         sheet what they read and how they ended. -->
    <DataTemplate DataType="{x:Type cv:ComputerStatusPageViewModel}">
      <DockPanel Margin="16,10,16,16">
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Margin="0,10,0,6"
                     Style="{StaticResource Ad.SectionHeader}"
                     Text="{l:Tr Computers.Status.Actions}"
                     Visibility="{Binding CanUseRemote, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <WrapPanel x:Name="ComputerStatusActions" Visibility="{Binding CanUseRemote, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
            <Button Margin="0,0,6,6"
                    Command="{Binding RemoteActionsCommand}"
                    Content="{l:Tr Computers.RemoteActionsCommand}"
                    Style="{StaticResource SmallButton}" />
            <Button Margin="0,0,6,6"
                    Command="{Binding RemoteDesktopCommand}"
                    Content="{l:Tr Computers.RemoteDesktop}"
                    Style="{StaticResource SmallButton}" />
            <Button Margin="0,0,6,6"
                    Command="{Binding ComputerManagementCommand}"
                    Content="{l:Tr Computers.ComputerManagement}"
                    Style="{StaticResource SmallButton}" />
            <Button Margin="0,0,6,6"
                    Command="{Binding EventViewerCommand}"
                    Content="{l:Tr Computers.EventViewer}"
                    Style="{StaticResource SmallButton}" />
            <Button Margin="0,0,6,6"
                    Command="{Binding PingCommand}"
                    Content="{l:Tr Computers.Ping}"
                    Style="{StaticResource SmallButton}" />
          </WrapPanel>
        </StackPanel>
        <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
          <!-- K5: "Co dostanie komputer…" opens the Group Policy model of this computer in the main window. -->
          <Button x:Name="ComputerModelGroupPolicyButton"
                  Margin="0,0,6,6"
                  Command="{Binding ModelGroupPolicyCommand}"
                  Content="{l:Tr GpModel.ComputerCommand}"
                  Style="{StaticResource SmallButton}"
                  Visibility="{Binding CanModelGroupPolicy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <!-- Track E: "Dziennik zdarzeń tego komputera" opens the reader of the main window preset to this computer. -->
          <Button x:Name="ComputerEventLogButton"
                  Margin="0,0,6,6"
                  Command="{Binding OpenEventLogCommand}"
                  Content="{l:Tr EvtLog.ComputerCommand}"
                  Style="{StaticResource SmallButton}"
                  Visibility="{Binding CanOpenEventLog, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <Button Margin="0,0,6,6"
                  Command="{Binding ReadExactLastLogonCommand}"
                  Content="{l:Tr Computers.Status.CheckAllDomainControllers}"
                  Style="{StaticResource SmallButton}"
                  Visibility="{Binding CanReadExactLastLogon, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <Button Margin="0,0,6,6"
                  Command="{Binding ResolveSiteCommand}"
                  Content="{l:Tr Computers.Status.ResolveSite}"
                  Style="{StaticResource SmallButton}"
                  ToolTip="{l:Tr ComputerReview.SitesTooltip}"
                  Visibility="{Binding CanResolveSite, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        </WrapPanel>
        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Focusable="False" Grid.IsSharedSizeScope="True" ItemsSource="{Binding Details, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type cv:ComputerDetailViewModel}">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="ComputerStatusLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Margin="0,4,12,0"
                             VerticalAlignment="Top"
                             Style="{StaticResource Ad.SecondaryText}"
                             Text="{Binding Label, Mode=OneWay}" />
                  <TextBox Grid.Column="1"
                           AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                           Style="{StaticResource Ad.SelectableText}"
                           Text="{Binding Value, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>

    <!-- P1 (W7, docs/dev/p-certificate-services.md 2.6): "Opublikowane certyfikaty" – userCertificate and userSMIMECertificate,
         the details of the selected certificate, "Kopiuj do pliku…" to a file the operator picks. Read only. The count
         (or that there is no certificate), the read and a read that failed are said in the status line of the sheet. -->
    <DataTemplate DataType="{x:Type pk:PublishedCertificatesPageViewModel}">
      <DockPanel Margin="12,10,12,12">
        <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
          <Button Margin="8,0,0,0"
                  VerticalAlignment="Top"
                  AutomationProperties.Name="{l:Tr Commands.Refresh}"
                  Command="{Binding RefreshCommand}"
                  Content="{x:Static c:Glyphs.Refresh}"
                  DockPanel.Dock="Right"
                  Style="{StaticResource Ad.IconButton}"
                  ToolTip="{l:Tr Commands.Refresh}" />
          <TextBlock Style="{StaticResource Ad.SecondaryText}"
                     Text="{l:Tr Cert.Published.Intro}"
                     TextWrapping="Wrap" />
        </DockPanel>
        <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
          <Button x:Name="CopyCertificateToFileButton"
                  Command="{Binding CopyToFileCommand}"
                  Content="{l:Tr Cert.Published.CopyToFile}"
                  Style="{StaticResource SmallButton}" />
          <Button Command="{Binding CopyThumbprintCommand}"
                  Content="{l:Tr Cert.Published.CopyThumbprint}"
                  Style="{StaticResource SmallButton}" />
        </WrapPanel>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.3*" MinHeight="90" />
          </Grid.RowDefinitions>
          <ListView x:Name="PublishedCertificateList"
                    AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                    ItemsSource="{Binding Rows, Mode=OneWay}"
                    SelectedItem="{Binding SelectedRow}"
                    SelectionMode="Single">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactRow}">
                <Setter Property="AutomationProperties.Name" Value="{Binding IssuedTo, Mode=OneWay}" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="150" Header="{l:Tr Cert.Published.ColumnIssuedTo}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock x:Name="IssuedToText"
                                 Text="{Binding IssuedTo, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsUnreadable, Mode=OneWay}" Value="True">
                          <Setter TargetName="IssuedToText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="150" Header="{l:Tr Cert.Published.ColumnIssuedBy}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock Text="{Binding IssuedBy, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="160" Header="{l:Tr Cert.Published.ColumnPurposes}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock Text="{Binding Purposes, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Purposes, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="90" Header="{l:Tr Cert.Published.ColumnValidTo}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock Text="{Binding ValidTo, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="150" Header="{l:Tr Cert.Published.ColumnStatus}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock x:Name="ValidityText"
                                 Text="{Binding ValidityText, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsExpiring, Mode=OneWay}" Value="True">
                          <Setter TargetName="ValidityText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExpired, Mode=OneWay}" Value="True">
                          <Setter TargetName="ValidityText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="130" Header="{l:Tr Cert.Published.ColumnTemplate}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock Text="{Binding Template, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="140" Header="{l:Tr Cert.Published.ColumnThumbprint}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock Style="{StaticResource Ad.SecondaryText}"
                                 Text="{Binding Thumbprint, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="140" Header="{l:Tr Cert.Published.ColumnAttribute}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:PublishedCertificateRowViewModel}">
                      <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding Attribute, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Grid.Row="1"
                     Margin="0,10,0,4"
                     Style="{StaticResource Ad.SectionHeader}"
                     Text="{l:Tr Cert.Published.DetailsHeader}" />
          <ScrollViewer Grid.Row="2"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CertificateDetails"
                          Focusable="False"
                          Grid.IsSharedSizeScope="True"
                          ItemsSource="{Binding Details, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pk:CertificateDetailViewModel}">
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="CertificateDetailLabel" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,4,12,0"
                               VerticalAlignment="Top"
                               Style="{StaticResource Ad.SecondaryText}"
                               Text="{Binding Label, Mode=OneWay}" />
                    <TextBox Grid.Column="1"
                             AutomationProperties.Name="{Binding Label, Mode=OneWay}"
                             Style="{StaticResource Ad.SelectableText}"
                             Text="{Binding Value, Mode=OneWay}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </DataTemplate>

    <!-- P1 (W7): "Mapowania nazw" – altSecurityIdentities with the KB5014754 strength, Kerberos names apart. Read only. -->
    <DataTemplate DataType="{x:Type pk:NameMappingsPageViewModel}">
      <DockPanel Margin="12,10,12,12">
        <TextBlock Margin="0,0,0,6"
                   DockPanel.Dock="Top"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr Cert.Mappings.Intro}"
                   TextWrapping="Wrap" />
        <!-- Notes of the list below: true for as long as these mappings are shown - not a status of the sheet. -->
        <ContentControl x:Name="WeakMappingsNote"
                        Margin="0,0,0,6"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Ad.Note.Attention}"
                        Visibility="{Binding WeakWarning, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
          <TextBlock x:Name="WeakMappingsWarning"
                     AutomationProperties.LiveSetting="Polite"
                     Text="{Binding WeakWarning, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </ContentControl>
        <ContentControl x:Name="InvalidMappingsNote"
                        Margin="0,0,0,6"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Ad.Note.Attention}"
                        Visibility="{Binding InvalidWarning, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
          <TextBlock x:Name="InvalidMappingsWarning"
                     Text="{Binding InvalidWarning, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </ContentControl>
        <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
          <Button Command="{Binding CopyValueCommand}"
                  Content="{l:Tr Common.Copy}"
                  Style="{StaticResource SmallButton}" />
        </WrapPanel>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
          </Grid.RowDefinitions>
          <TextBlock Margin="0,0,0,4"
                     Style="{StaticResource Ad.SectionHeader}"
                     Text="{l:Tr Cert.Mappings.X509Header}" />
          <ListView x:Name="X509MappingList"
                    Grid.Row="1"
                    AutomationProperties.Name="{l:Tr Cert.Mappings.X509Header}"
                    ItemsSource="{Binding X509Mappings, Mode=OneWay}"
                    SelectedItem="{Binding SelectedMapping}"
                    SelectionMode="Single">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactRow}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Value, Mode=OneWay}" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="160" Header="{l:Tr Cert.Mappings.ColumnMapping}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:NameMappingRowViewModel}">
                      <TextBlock Text="{Binding KindText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="110" Header="{l:Tr Cert.Mappings.ColumnStrength}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:NameMappingRowViewModel}">
                      <TextBlock x:Name="StrengthText" Text="{Binding StrengthText, Mode=OneWay}" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsWeak, Mode=OneWay}" Value="True">
                          <Setter TargetName="StrengthText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                          <Setter TargetName="StrengthText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInvalid, Mode=OneWay}" Value="True">
                          <Setter TargetName="StrengthText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="180" Header="{l:Tr Cert.Mappings.ColumnIssuer}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:NameMappingRowViewModel}">
                      <TextBlock Text="{Binding Issuer, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Issuer, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="180" Header="{l:Tr Cert.Mappings.ColumnSubjectOrIdentifier}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:NameMappingRowViewModel}">
                      <TextBlock Text="{Binding SubjectOrIdentifier, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding SubjectOrIdentifier, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="240" Header="{l:Tr Cert.Mappings.ColumnValue}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:NameMappingRowViewModel}">
                      <TextBlock Style="{StaticResource Ad.SecondaryText}"
                                 Text="{Binding Value, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Value, Mode=OneWay}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Grid.Row="1"
                     Margin="8,32,8,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     IsHitTestVisible="False"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{l:Tr Cert.Mappings.NoX509}"
                     Visibility="{Binding HasX509Mappings, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
          <TextBlock Grid.Row="2"
                     Margin="0,10,0,4"
                     Style="{StaticResource Ad.SectionHeader}"
                     Text="{l:Tr Cert.Mappings.KerberosHeader}" />
          <ListView x:Name="KerberosNameList"
                    Grid.Row="3"
                    AutomationProperties.Name="{l:Tr Cert.Mappings.KerberosHeader}"
                    ItemsSource="{Binding KerberosNames, Mode=OneWay}"
                    SelectedItem="{Binding SelectedKerberosName}"
                    SelectionMode="Single">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactRow}">
                <Setter Property="AutomationProperties.Name" Value="{Binding SubjectOrIdentifier, Mode=OneWay}" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="260" Header="{l:Tr Cert.Mappings.ColumnPrincipal}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:NameMappingRowViewModel}">
                      <TextBlock Text="{Binding SubjectOrIdentifier, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="280" Header="{l:Tr Cert.Mappings.ColumnValue}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type pk:NameMappingRowViewModel}">
                      <TextBlock Style="{StaticResource Ad.SecondaryText}"
                                 Text="{Binding Value, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Grid.Row="3"
                     Margin="8,32,8,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     IsHitTestVisible="False"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{l:Tr Cert.Mappings.NoKerberos}"
                     Visibility="{Binding HasKerberosNames, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
        </Grid>
      </DockPanel>
    </DataTemplate>

    <!-- P1 (W7): "Poświadczenia kluczy" – the msDS-KeyCredentialLink entries (metadata only, never the key). Read only.
         The count (or that there is none), the read and a read that failed are said in the status line of the sheet. -->
    <DataTemplate DataType="{x:Type pk:KeyCredentialsPageViewModel}">
      <DockPanel Margin="12,10,12,12">
        <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
          <Button Margin="8,0,0,0"
                  VerticalAlignment="Top"
                  AutomationProperties.Name="{l:Tr Commands.Refresh}"
                  Command="{Binding RefreshCommand}"
                  Content="{x:Static c:Glyphs.Refresh}"
                  DockPanel.Dock="Right"
                  Style="{StaticResource Ad.IconButton}"
                  ToolTip="{l:Tr Commands.Refresh}" />
          <StackPanel>
            <TextBlock Style="{StaticResource Ad.SecondaryText}"
                       Text="{l:Tr Cert.Keys.Intro}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{l:Tr Cert.Keys.Warning}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
        <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
          <Button Command="{Binding CopyKeyIdCommand}"
                  Content="{l:Tr Cert.Keys.CopyKeyId}"
                  Style="{StaticResource SmallButton}" />
          <Button Command="{Binding CopyDeviceIdCommand}"
                  Content="{l:Tr Cert.Keys.CopyDeviceId}"
                  Style="{StaticResource SmallButton}" />
        </WrapPanel>
        <ListView x:Name="KeyCredentialList"
                  AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                  ItemsSource="{Binding Rows, Mode=OneWay}"
                  SelectedItem="{Binding SelectedRow}"
                  SelectionMode="Single">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactRow}">
              <Setter Property="AutomationProperties.Name" Value="{Binding UsageText, Mode=OneWay}" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="150" Header="{l:Tr Cert.Keys.ColumnKeyId}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type pk:KeyCredentialRowViewModel}">
                    <TextBlock Text="{Binding KeyId, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding KeyId, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="150" Header="{l:Tr Cert.Keys.ColumnDeviceId}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type pk:KeyCredentialRowViewModel}">
                    <TextBlock Text="{Binding DeviceId, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DeviceId, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="110" Header="{l:Tr Cert.Keys.ColumnSource}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type pk:KeyCredentialRowViewModel}">
                    <TextBlock Text="{Binding SourceText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="150" Header="{l:Tr Cert.Keys.ColumnUsage}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type pk:KeyCredentialRowViewModel}">
                    <TextBlock Text="{Binding UsageText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="120" Header="{l:Tr Cert.Keys.ColumnCreated}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type pk:KeyCredentialRowViewModel}">
                    <TextBlock Text="{Binding Created, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="120" Header="{l:Tr Cert.Keys.ColumnLastLogon}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type pk:KeyCredentialRowViewModel}">
                    <TextBlock Text="{Binding LastLogon, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="200" Header="{l:Tr Cert.Keys.ColumnRemarks}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type pk:KeyCredentialRowViewModel}">
                    <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding Remarks, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Remarks, Mode=OneWay}"
                               Visibility="{Binding HasRemarks, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </DataTemplate>

    <!-- Attribute Editor: its read and a read that failed are said in the status line of the sheet. -->
    <DataTemplate DataType="{x:Type ps:AttributeEditorPageViewModel}">
      <DockPanel Margin="12,10,12,12">
        <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
          <Button Margin="8,0,0,0"
                  VerticalAlignment="Top"
                  AutomationProperties.Name="{l:Tr Commands.Refresh}"
                  Command="{Binding RefreshCommand}"
                  Content="{x:Static c:Glyphs.Refresh}"
                  DockPanel.Dock="Right"
                  Style="{StaticResource Ad.IconButton}"
                  ToolTip="{l:Tr Commands.Refresh}" />
          <Grid Width="220"
                VerticalAlignment="Top"
                DockPanel.Dock="Left">
            <TextBox x:Name="AttributeFilterBox"
                     AutomationProperties.Name="{l:Tr Common.Filter}"
                     KeyDown="OnFilterBoxKeyDown"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <TextBlock Style="{StaticResource Ad.HintText}"
                       Text="{l:Tr Common.Filter}"
                       Visibility="{Binding Text, ElementName=AttributeFilterBox, Converter={StaticResource Ad.EmptyToVisible}}" />
          </Grid>
          <WrapPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <CheckBox Margin="0,0,12,0"
                      Content="{l:Tr Labels.ShowOnlyWithValues}"
                      IsChecked="{Binding ShowOnlyWithValues}" />
            <CheckBox Content="{l:Tr Labels.ShowOnlyWritable}" IsChecked="{Binding ShowOnlyWritable}" />
          </WrapPanel>
        </DockPanel>
        <Border Margin="0,8,0,0"
                DockPanel.Dock="Bottom"
                Style="{StaticResource Ad.Card}"
                Visibility="{Binding Editor, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
          <ContentControl x:Name="ValueEditorHost"
                          Content="{Binding Editor, Mode=OneWay}"
                          Focusable="False"
                          IsTabStop="False" />
        </Border>
        <WrapPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
          <Button Command="{Binding EditCommand}"
                  Content="{l:Tr Common.Edit}"
                  Style="{StaticResource SmallButton}" />
          <Button Command="{Binding CopyValueCommand}"
                  Content="{l:Tr Common.Copy}"
                  Style="{StaticResource SmallButton}" />
        </WrapPanel>
        <ListView x:Name="AttributeList"
                  AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                  ItemsSource="{Binding Rows, Mode=OneWay}"
                  KeyDown="OnAttributeListKeyDown"
                  SelectedItem="{Binding SelectedRow}"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactRow}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Attribute, Mode=OneWay}" />
              <Setter Property="ToolTip" Value="{Binding DisplayName, Mode=OneWay}" />
              <EventSetter Event="MouseDoubleClick" Handler="OnAttributeRowDoubleClick" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="210" Header="{l:Tr Labels.Attribute}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type ps:AttributeRowViewModel}">
                    <DockPanel>
                      <TextBlock Margin="0,0,4,0"
                                 DockPanel.Dock="Right"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Style="{StaticResource Ad.GlyphText}"
                                 Text="{x:Static c:Glyphs.Lock}"
                                 ToolTip="{Binding ReadOnlyReason, Mode=OneWay}"
                                 Visibility="{Binding IsReadOnly, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                      <TextBlock Margin="0,0,4,0"
                                 DockPanel.Dock="Right"
                                 FontSize="11"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 Style="{StaticResource Ad.GlyphText}"
                                 Text="{x:Static c:Glyphs.Edit}"
                                 ToolTip="{l:Tr ObjectDialogs.PendingChanges}"
                                 Visibility="{Binding IsDirty, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                      <TextBlock x:Name="AttributeText"
                                 VerticalAlignment="Center"
                                 Text="{Binding Attribute, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsDirty, Mode=OneWay}" Value="True">
                        <Setter TargetName="AttributeText" Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="250" Header="{l:Tr Labels.Value}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type ps:AttributeRowViewModel}">
                    <TextBlock Text="{Binding ValueText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="130" Header="{l:Tr Labels.Syntax}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type ps:AttributeRowViewModel}">
                    <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding SyntaxText, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Footer: Refresh | OK Cancel Apply -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <Button x:Name="RefreshButton"
                Margin="0"
                Command="{Binding RefreshCommand}"
                Content="{l:Tr PropertySheet.Refresh}"
                DockPanel.Dock="Left"
                Style="{StaticResource Ad.DialogButton}" />
        <Button x:Name="WatchdogHistoryButton"
                Margin="8,0,0,0"
                Command="{Binding ShowWatchdogHistoryCommand}"
                Content="{l:Tr Commands.WatchdogHistory}"
                DockPanel.Dock="Left"
                Style="{StaticResource Ad.DialogButton}"
                Visibility="{Binding IsWatchdogHistoryAvailable, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="CompareWithConnectionButton"
                Margin="8,0,0,0"
                Command="{Binding CompareWithConnectionCommand}"
                Content="{l:Tr Comparison.CompareShort}"
                DockPanel.Dock="Left"
                Style="{StaticResource Ad.DialogButton}"
                Visibility="{Binding IsComparisonAvailable, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="OkButton"
                  Command="{Binding OkCommand}"
                  Content="{l:Tr Common.Ok}"
                  IsDefault="True"
                  Style="{StaticResource Ad.AccentDialogButton}" />
          <Button x:Name="CancelButton"
                  Command="{Binding CancelCommand}"
                  Content="{l:Tr Common.Cancel}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
          <Button x:Name="ApplyButton"
                  Command="{Binding ApplyCommand}"
                  Content="{l:Tr Common.Apply}"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Header: icon, name, type and folder -->
    <DockPanel Margin="16,12,16,8" DockPanel.Dock="Top">
      <c:ObjectIconView Margin="0,2,12,0"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Left"
                        Icon="{Binding Icon, Mode=OneWay}"
                        Size="32" />
      <StackPanel>
        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Text="{Binding Name, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Style="{StaticResource Ad.SecondaryText}">
          <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Path, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <!--
      Status line (design note 6.1 and 6.8): between the header and the pages. What the sheet is doing and what
      happened - reading the object (with Stop), saving, a read that failed (with Retry), an object that was deleted, a
      sheet that is out of date (with Refresh), the session of the window that ended - and what the page in front says.
    -->
    <c:StatusLine x:Name="PageStatus"
                  Margin="8,0,8,6"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  DockPanel.Dock="Top"
                  Status="{Binding Status.Current, Mode=OneWay}" />

    <!-- Findings of the planner that belong to no single field (notes: they stay while the values they are about do). -->
    <StackPanel Margin="16,0,16,0" DockPanel.Dock="Top">
      <ItemsControl Margin="0,0,0,8"
                    Focusable="False"
                    ItemsSource="{Binding Issues, Mode=OneWay}"
                    Visibility="{Binding Issues.Count, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type ps:SheetIssueViewModel}">
            <DockPanel Margin="0,2">
              <Grid Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Left">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Style="{StaticResource Ad.GlyphText}"
                           Text="{x:Static c:Glyphs.Error}"
                           Visibility="{Binding IsError, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Style="{StaticResource Ad.GlyphText}"
                           Text="{x:Static c:Glyphs.Warning}"
                           Visibility="{Binding IsError, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
              </Grid>
              <TextBlock AutomationProperties.LiveSetting="Polite"
                         Text="{Binding Text, Mode=OneWay}"
                         TextWrapping="Wrap" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Pages -->
    <TabControl x:Name="PageTabs"
                Margin="12,0,12,12"
                AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                ItemTemplate="{StaticResource PageHeaderTemplate}"
                ItemsSource="{Binding Pages, Mode=OneWay}"
                SelectedItem="{Binding SelectedPage}"
                SelectionChanged="OnPageChanged">
      <TabControl.ItemContainerStyle>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneWay}" />
        </Style>
      </TabControl.ItemContainerStyle>
    </TabControl>
  </DockPanel>
</Window>
