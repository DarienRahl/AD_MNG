<!--
  The Rules sub-tab (WatchdogRulesViewModel): exclusion suggestions of the service, the rule list (enabled toggle, name,
  built-in / locked badge, kinds, severity, delivery, exclusions, "would send N" during rollout, warnings) with New /
  Duplicate / Delete / Reset to default, the inline editor of the selected rule and the save bar.
-->
<UserControl x:Class="AdMng.App.Views.Watchdog.WatchdogRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:AdMng.App.Behaviors"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:wd="clr-namespace:AdMng.Presentation.Watchdog;assembly=AdMng.Presentation"
             xmlns:wdv="clr-namespace:AdMng.App.Views.Watchdog"
             AutomationProperties.Name="{l:Tr Watchdog.Tab.Rules}">
  <UserControl.Resources>
    <c:BindingProxy x:Key="RulesProxy" Data="{Binding}" />
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <Style x:Key="RuleRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource Wd.ListRow}">
      <Setter Property="Height" Value="44" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay, TargetNullValue=''}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsEnabled, Mode=OneWay}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <wdv:WatchdogConfigBar x:Name="ConfigBar"
                           DataContext="{Binding Session}"
                           DockPanel.Dock="Bottom" />

    <!-- Suggested exclusions (never applied automatically) -->
    <Border x:Name="SuggestionsCard"
            Margin="0,0,0,8"
            Padding="12,8"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.Card}"
            Visibility="{Binding Suggestions.Count, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr Watchdog.Ui.Suggestions}" />
        <ItemsControl x:Name="SuggestionsList"
                      AutomationProperties.Name="{l:Tr Watchdog.Ui.Suggestions}"
                      Focusable="False"
                      ItemsSource="{Binding Suggestions, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type wd:WatchdogSuggestionViewModel}">
              <DockPanel Margin="0,4,0,0">
                <Button Margin="10,0,0,0"
                        Command="{Binding Data.AddSuggestedExclusionCommand, Source={StaticResource RulesProxy}}"
                        CommandParameter="{Binding Mode=OneWay}"
                        Content="{l:Tr Watchdog.Ui.AddExclusion}"
                        DockPanel.Dock="Right" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding Text, Mode=OneWay}"
                           TextWrapping="Wrap" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="360" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="4*" MinWidth="340" />
      </Grid.ColumnDefinitions>

      <DockPanel>
        <!-- Rule commands -->
        <WrapPanel Margin="0,0,0,6" DockPanel.Dock="Top">
          <Button x:Name="NewRuleButton"
                  Command="{Binding NewRuleCommand}"
                  Style="{StaticResource Wd.ToolButton}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontSize="12"
                         Style="{StaticResource Ad.GlyphText}"
                         Text="{x:Static c:Glyphs.Add}" />
              <TextBlock Margin="6,0,0,0" Text="{l:Tr Watchdog.Ui.NewRule}" />
            </StackPanel>
          </Button>
          <Button x:Name="DuplicateRuleButton"
                  Command="{Binding DuplicateRuleCommand}"
                  Content="{l:Tr Watchdog.Ui.DuplicateRule}"
                  Style="{StaticResource Wd.ToolButton}" />
          <Button x:Name="DeleteRuleButton"
                  Command="{Binding DeleteRuleCommand}"
                  Content="{l:Tr Watchdog.Rules.Delete}"
                  Style="{StaticResource Wd.ToolButton}" />
          <Button x:Name="ResetRuleButton"
                  Command="{Binding ResetRuleCommand}"
                  Content="{l:Tr Common.ResetToDefault}"
                  Style="{StaticResource Wd.ToolButton}" />
        </WrapPanel>

        <!-- The columns fit the list (GridViewColumnFit): name, kinds and delivery share the width 4 : 3 : 3. -->
        <ListView x:Name="RulesList"
                  b:GridViewColumnFit.IsEnabled="True"
                  AutomationProperties.Name="{l:Tr Watchdog.Tab.Rules}"
                  ItemContainerStyle="{StaticResource RuleRowStyle}"
                  ItemsSource="{Binding Rules, Mode=OneWay}"
                  SelectedItem="{Binding SelectedRule}"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="44" b:GridViewColumnFit.MinWidth="40">
                <GridViewColumn.Header>
                  <TextBlock FontSize="12"
                             Style="{StaticResource Ad.GlyphText}"
                             Text="{x:Static c:Glyphs.Accept}"
                             ToolTip="{l:Tr Watchdog.Ui.RuleEnabled}" />
                </GridViewColumn.Header>
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type wd:WatchdogRuleRowViewModel}">
                    <CheckBox MinWidth="0"
                              AutomationProperties.Name="{l:Tr Watchdog.Ui.RuleEnabled}"
                              IsChecked="{Binding IsEnabled}"
                              IsEnabled="{Binding CanToggle, Mode=OneWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="250"
                              b:GridViewColumnFit.MinWidth="200"
                              b:GridViewColumnFit.Star="4"
                              Header="{l:Tr Common.Name}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type wd:WatchdogRuleRowViewModel}">
                    <StackPanel VerticalAlignment="Center">
                      <DockPanel>
                        <TextBlock x:Name="IssueGlyph"
                                   Margin="6,0,0,0"
                                   DockPanel.Dock="Right"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Style="{StaticResource Ad.GlyphText}"
                                   Text="{x:Static c:Glyphs.Error}"
                                   ToolTip="{l:Tr Watchdog.Ui.RuleHasIssues}"
                                   Visibility="{Binding HasIssues, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                        <TextBlock Margin="6,0,0,0"
                                   DockPanel.Dock="Right"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Style="{StaticResource Ad.GlyphText}"
                                   Text="{x:Static c:Glyphs.Warning}"
                                   ToolTip="{Binding WarningText, Mode=OneWay}"
                                   Visibility="{Binding WarningText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
                        <!-- A long name is cut: the tool tip shows it whole, with the rule's identifier. -->
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NameToolTip, Mode=OneWay}" />
                      </DockPanel>
                      <TextBlock Style="{StaticResource Ad.SecondaryText}">
                        <Run Text="{Binding BadgeText, Mode=OneWay}" />
                        <Run Text="{Binding RolloutText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="210"
                              b:GridViewColumnFit.MinWidth="140"
                              b:GridViewColumnFit.Star="3"
                              Header="{l:Tr Watchdog.Ui.RuleKinds}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type wd:WatchdogRuleRowViewModel}">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding KindsText, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding KindsText, Mode=OneWay}" />
                      <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding SeverityText, Mode=OneWay}" />
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="260"
                              b:GridViewColumnFit.MinWidth="150"
                              b:GridViewColumnFit.Star="3"
                              Header="{l:Tr Watchdog.Ui.RuleDelivery}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type wd:WatchdogRuleRowViewModel}">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DeliveryText, Mode=OneWay}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding DeliveryText, Mode=OneWay}" />
                      <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding ExclusionsText, Mode=OneWay}" />
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>

      <GridSplitter Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns" />

      <Grid Grid.Column="2">
        <TextBlock Margin="12"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr Watchdog.Ui.NoRuleSelected}"
                   TextWrapping="Wrap"
                   Visibility="{Binding Editor, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
        <wdv:WatchdogRuleEditorView x:Name="EditorView"
                                    DataContext="{Binding Editor, Mode=OneWay}"
                                    Visibility="{Binding Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}, FallbackValue=Collapsed}" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
