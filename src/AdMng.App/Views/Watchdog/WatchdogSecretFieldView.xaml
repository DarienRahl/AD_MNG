<!--
  A write-only secret (WatchdogSecretFieldViewModel): a password box that only sets a new value, the state ("set" /
  "not set" / "new value" / "will be removed"), the service's hint, "Clear" and "Undo". The value is never displayed and
  never bound; the box is emptied when the editor is rebuilt (after save or revert) or the input is undone.
  Set AutomationProperties.Name on this control: the password box takes it over.
-->
<UserControl x:Class="AdMng.App.Views.Watchdog.WatchdogSecretFieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization">
  <StackPanel>
    <DockPanel>
      <Button x:Name="UndoButton"
              Margin="4,0,0,0"
              AutomationProperties.Name="{l:Tr Watchdog.Ui.SecretUndo}"
              Command="{Binding UndoCommand}"
              Content="{x:Static c:Glyphs.Back}"
              DockPanel.Dock="Right"
              Style="{StaticResource Ad.IconButton}"
              ToolTip="{l:Tr Watchdog.Ui.SecretUndo}" />
      <Button x:Name="ClearButton"
              Margin="4,0,0,0"
              Command="{Binding ClearCommand}"
              Content="{l:Tr Watchdog.Ui.SecretClear}"
              DockPanel.Dock="Right"
              Visibility="{Binding IsSet, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <PasswordBox x:Name="Input"
                   AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=UserControl}}"
                   PasswordChanged="OnPasswordChanged" />
    </DockPanel>
    <TextBlock x:Name="StateText" Style="{StaticResource Wd.Hint}">
      <Run Text="{Binding StateText, Mode=OneWay}" />
      <Run Text="{Binding Hint, Mode=OneWay}" />
    </TextBlock>
    <TextBlock x:Name="ErrorText"
               AutomationProperties.LiveSetting="Assertive"
               Style="{StaticResource Wd.FieldError}"
               Text="{Binding Error, Mode=OneWay}" />
  </StackPanel>
</UserControl>
