<!--
  Save bar of the configuration editors (WatchdogConfigSession, shared by Rules, Channels and Digest): version, unsaved
  changes, result of the last save or validation, conflict ("changed by another administrator – reload"), the
  validation issues of the service, and Validate / Reload / Revert / Save. Viewers see why everything is read-only.
-->
<UserControl x:Class="AdMng.App.Views.Watchdog.WatchdogConfigBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:wd="clr-namespace:AdMng.Presentation.Watchdog;assembly=AdMng.Presentation">
  <StackPanel>
    <!-- Read-only (Viewer, redacted copy) -->
    <Border x:Name="ReadOnlyBar"
            Margin="0,6,0,0"
            Padding="10,6"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding IsReadOnly, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <DockPanel>
        <TextBlock Margin="0,0,8,0"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Lock}" />
        <StackPanel>
          <TextBlock x:Name="ReadOnlyText"
                     Text="{l:Tr Watchdog.Requires.Admin}"
                     TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Wd.Hint}"
                     Text="{l:Tr Watchdog.Ui.RedactedHint}"
                     Visibility="{Binding IsRedacted, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Validation issues of the service -->
    <Border Margin="0,6,0,0"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding Issues.Count, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <ScrollViewer MaxHeight="140"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="IssuesList"
                      AutomationProperties.Name="{l:Tr Watchdog.Ui.Issues}"
                      Focusable="False"
                      ItemsSource="{Binding Issues, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type wd:WatchdogIssueViewModel}">
              <DockPanel Margin="0,1">
                <TextBlock x:Name="IssueGlyph"
                           Margin="0,0,8,0"
                           VerticalAlignment="Top"
                           DockPanel.Dock="Left"
                           FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Style="{StaticResource Ad.GlyphText}"
                           Text="{x:Static c:Glyphs.Warning}" />
                <TextBlock Text="{Binding DisplayText, Mode=OneWay}" TextWrapping="Wrap" />
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError, Mode=OneWay}" Value="True">
                  <Setter TargetName="IssueGlyph" Property="Text" Value="{x:Static c:Glyphs.Error}" />
                  <Setter TargetName="IssueGlyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Border Margin="0,6,0,0"
            Padding="0,8,0,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ValidateButton"
                  Command="{Binding ValidateCommand}"
                  Content="{l:Tr Watchdog.Ui.Validate}"
                  Style="{StaticResource Ad.DialogButton}" />
          <Button x:Name="ReloadButton"
                  Command="{Binding ReloadCommand}"
                  Content="{l:Tr Watchdog.Ui.Reload}"
                  Style="{StaticResource Ad.DialogButton}" />
          <Button x:Name="RevertButton"
                  Command="{Binding RevertCommand}"
                  Content="{l:Tr Watchdog.Ui.Revert}"
                  Style="{StaticResource Ad.DialogButton}" />
          <Button x:Name="SaveButton"
                  Command="{Binding SaveCommand}"
                  Content="{l:Tr Common.Save}"
                  Style="{StaticResource Ad.AccentDialogButton}"
                  ToolTip="{Binding ReadOnlyReason, Mode=OneWay}"
                  ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ProgressBar Width="60"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
            <TextBlock x:Name="DirtyText"
                       Margin="0,0,12,0"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{l:Tr Watchdog.Ui.Unsaved}"
                       Visibility="{Binding IsDirty, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
            <TextBlock x:Name="VersionText"
                       Style="{StaticResource Ad.SecondaryText}"
                       Text="{Binding VersionText, Mode=OneWay}" />
          </StackPanel>
          <TextBlock x:Name="MessageText"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                     Text="{Binding Message, Mode=OneWay}"
                     TextWrapping="Wrap"
                     Visibility="{Binding Message, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
          <TextBlock x:Name="ErrorText"
                     AutomationProperties.LiveSetting="Assertive"
                     Style="{StaticResource Wd.FieldError}"
                     Text="{Binding Error, Mode=OneWay}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
