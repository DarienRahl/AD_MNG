<!--
  One Teams (Power Automate Workflows) or generic webhook channel (ChannelEditorViewModel): name, id, enabled, the
  write-only URL, detail level, Teams authentication, webhook signing secret ("Generate" shows a new whsec_ secret once for
  copying into the receiver), previous secret for rotation, GitHub signature, allowed hosts, timeout, heartbeat, rate
  limits and a test send with the unsaved settings.
-->
<UserControl x:Class="AdMng.App.Views.Watchdog.WatchdogChannelEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:wdv="clr-namespace:AdMng.App.Views.Watchdog"
             AutomationProperties.Name="{Binding DisplayText, Mode=OneWay}">
  <UserControl.Resources>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="110" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <StackPanel IsEnabled="{Binding CanEdit, Mode=OneWay}">
      <TextBlock Style="{StaticResource Wd.CardTitle}" Text="{Binding DisplayText, Mode=OneWay}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Wd.FormLabel}" Text="{l:Tr Common.Name}" />
        <StackPanel Grid.Column="1">
          <TextBox x:Name="NameBox"
                   Margin="0,8,0,0"
                   AutomationProperties.Name="{l:Tr Common.Name}"
                   Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[name], Mode=OneWay}" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Style="{StaticResource Wd.FormLabel}"
                   Text="{l:Tr Watchdog.Ui.ChannelId}" />
        <StackPanel Grid.Row="1" Grid.Column="1">
          <TextBox Margin="0,8,0,0"
                   AutomationProperties.Name="{l:Tr Watchdog.Ui.ChannelId}"
                   Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[id], Mode=OneWay}" />
        </StackPanel>
        <CheckBox Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,8,0,0"
                  Content="{l:Tr Watchdog.Ui.ChannelEnabled}"
                  IsChecked="{Binding Enabled}" />
        <TextBlock Grid.Row="3"
                   Style="{StaticResource Wd.FormLabel}"
                   Text="{l:Tr Watchdog.Ui.ChannelUrl}" />
        <wdv:WatchdogSecretFieldView x:Name="UrlField"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="0,8,0,0"
                                     AutomationProperties.Name="{l:Tr Watchdog.Ui.ChannelUrl}"
                                     DataContext="{Binding Url, Mode=OneWay}" />
        <TextBlock Grid.Row="4"
                   Style="{StaticResource Wd.FormLabel}"
                   Text="{l:Tr Watchdog.Ui.DetailLevel}" />
        <ComboBox Grid.Row="4"
                  Grid.Column="1"
                  Margin="0,8,0,0"
                  AutomationProperties.Name="{l:Tr Watchdog.Ui.DetailLevel}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding DetailLevels, Mode=OneWay}"
                  SelectedItem="{Binding DetailLevel}" />
      </Grid>
      <TextBlock Style="{StaticResource Wd.Hint}" Text="{l:Tr Watchdog.Ui.UrlIsSecret}" />

      <!-- Teams -->
      <StackPanel Visibility="{Binding IsTeams, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Style="{StaticResource Wd.TopLabel}"
                   FontWeight="SemiBold"
                   Text="{l:Tr Watchdog.Ui.TeamsAuthentication}" />
        <ComboBox x:Name="AuthModeBox"
                  AutomationProperties.Name="{l:Tr Watchdog.Ui.TeamsAuthentication}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding AuthModes, Mode=OneWay}"
                  SelectedItem="{Binding AuthMode}" />
        <Grid Visibility="{Binding IsEntraAuth, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Wd.FormLabel}" Text="{l:Tr Watchdog.Ui.EntraCloud}" />
          <ComboBox Grid.Column="1"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="{l:Tr Watchdog.Ui.EntraCloud}"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding Clouds, Mode=OneWay}"
                    SelectedItem="{Binding Cloud}" />
          <TextBlock Grid.Row="1"
                     Style="{StaticResource Wd.FormLabel}"
                     Text="{l:Tr Watchdog.Ui.TeamsScope}" />
          <ComboBox Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="{l:Tr Watchdog.Ui.TeamsScope}"
                    ItemsSource="{Binding Scopes, Mode=OneWay}"
                    SelectedItem="{Binding Scope}" />
          <TextBlock Grid.Row="2"
                     Style="{StaticResource Wd.FormLabel}"
                     Text="{l:Tr Watchdog.Ui.TenantId}" />
          <StackPanel Grid.Row="2" Grid.Column="1">
            <TextBox Margin="0,8,0,0"
                     AutomationProperties.Name="{l:Tr Watchdog.Ui.TenantId}"
                     Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[teams.tenantId], Mode=OneWay}" />
          </StackPanel>
          <TextBlock Grid.Row="3"
                     Style="{StaticResource Wd.FormLabel}"
                     Text="{l:Tr Watchdog.Ui.ClientId}" />
          <StackPanel Grid.Row="3" Grid.Column="1">
            <TextBox Margin="0,8,0,0"
                     AutomationProperties.Name="{l:Tr Watchdog.Ui.ClientId}"
                     Text="{Binding TeamsClientId, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[teams.clientId], Mode=OneWay}" />
          </StackPanel>
          <TextBlock Grid.Row="4"
                     Style="{StaticResource Wd.FormLabel}"
                     Text="{l:Tr Watchdog.Ui.CertificateThumbprint}" />
          <TextBox Grid.Row="4"
                   Grid.Column="1"
                   Margin="0,8,0,0"
                   AutomationProperties.Name="{l:Tr Watchdog.Ui.CertificateThumbprint}"
                   Text="{Binding CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="5"
                     Style="{StaticResource Wd.FormLabel}"
                     Text="{l:Tr Watchdog.Ui.ClientSecret}" />
          <wdv:WatchdogSecretFieldView x:Name="TeamsSecretField"
                                       Grid.Row="5"
                                       Grid.Column="1"
                                       Margin="0,8,0,0"
                                       AutomationProperties.Name="{l:Tr Watchdog.Ui.ClientSecret}"
                                       DataContext="{Binding ClientSecret, Mode=OneWay}" />
        </Grid>
      </StackPanel>

      <!-- Generic webhook (Standard Webhooks v1) -->
      <StackPanel Visibility="{Binding IsWebhook, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Style="{StaticResource Wd.TopLabel}"
                   FontWeight="SemiBold"
                   Text="{l:Tr Watchdog.Ui.SigningSecret}" />
        <DockPanel>
          <Button x:Name="GenerateSecretButton"
                  Margin="8,0,0,0"
                  VerticalAlignment="Top"
                  Command="{Binding GenerateSecretCommand}"
                  Content="{l:Tr Watchdog.Ui.GenerateSecret}"
                  DockPanel.Dock="Right" />
          <wdv:WatchdogSecretFieldView x:Name="SigningSecretField"
                                       AutomationProperties.Name="{l:Tr Watchdog.Ui.SigningSecret}"
                                       DataContext="{Binding SigningSecret, Mode=OneWay}" />
        </DockPanel>
        <!-- Shown once: copy it into the receiver now. -->
        <Border Margin="0,6,0,0"
                Padding="10,6"
                Style="{StaticResource Ad.WarningBar}"
                Visibility="{Binding HasGeneratedSecret, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{l:Tr Watchdog.Ui.GeneratedSecretHint}" TextWrapping="Wrap" />
            <DockPanel Margin="0,6,0,0">
              <Button Margin="6,0,0,0"
                      AutomationProperties.Name="{l:Tr Watchdog.Ui.CopySecret}"
                      Command="{Binding CopyGeneratedSecretCommand}"
                      Content="{x:Static c:Glyphs.Copy}"
                      DockPanel.Dock="Right"
                      Style="{StaticResource Ad.IconButton}"
                      ToolTip="{l:Tr Watchdog.Ui.CopySecret}" />
              <TextBox x:Name="GeneratedSecretBox"
                       AutomationProperties.Name="{l:Tr Watchdog.Ui.SigningSecret}"
                       FontFamily="Consolas"
                       IsReadOnly="True"
                       Text="{Binding GeneratedSecret, Mode=OneWay}" />
            </DockPanel>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Wd.TopLabel}" Text="{l:Tr Watchdog.Ui.PreviousSigningSecret}" />
        <wdv:WatchdogSecretFieldView x:Name="PreviousSecretField"
                                     AutomationProperties.Name="{l:Tr Watchdog.Ui.PreviousSigningSecret}"
                                     DataContext="{Binding PreviousSigningSecret, Mode=OneWay}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{l:Tr Watchdog.Ui.GitHubSignature}"
                  IsChecked="{Binding SendGitHubSignature}" />
        <CheckBox Margin="0,6,0,0"
                  Content="{l:Tr Watchdog.Ui.WebhookDigest}"
                  IsChecked="{Binding IncludeDigest}" />
        <TextBlock Style="{StaticResource Wd.TopLabel}" Text="{l:Tr Watchdog.Ui.AllowedHosts}" />
        <TextBox MinHeight="48"
                 AcceptsReturn="True"
                 AutomationProperties.Name="{l:Tr Watchdog.Ui.AllowedHosts}"
                 Text="{Binding AllowedHosts, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Wd.FormLabel}" Text="{l:Tr Watchdog.Ui.TimeoutSeconds}" />
          <TextBox Grid.Column="1"
                   AutomationProperties.Name="{l:Tr Watchdog.Ui.TimeoutSeconds}"
                   Style="{StaticResource NumberBox}"
                   Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="1"
                     Style="{StaticResource Wd.FormLabel}"
                     Text="{l:Tr Watchdog.Ui.HeartbeatMinutes}" />
          <TextBox Grid.Row="1"
                   Grid.Column="1"
                   AutomationProperties.Name="{l:Tr Watchdog.Ui.HeartbeatMinutes}"
                   Style="{StaticResource NumberBox}"
                   Text="{Binding HeartbeatMinutes, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      </StackPanel>

      <!-- Rate limits -->
      <TextBlock Style="{StaticResource Wd.TopLabel}"
                 FontWeight="SemiBold"
                 Text="{l:Tr Watchdog.Ui.RateLimits}" />
      <StackPanel Orientation="Horizontal">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{l:Tr Watchdog.Ui.PerSecond}" />
          <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.PerSecond}"
                   Style="{StaticResource NumberBox}"
                   Text="{Binding PerSecond, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{l:Tr Watchdog.Ui.PerMinute}" />
          <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.PerMinute}"
                   Style="{StaticResource NumberBox}"
                   Text="{Binding PerMinute, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{l:Tr Watchdog.Ui.PerHour}" />
          <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.PerHour}"
                   Style="{StaticResource NumberBox}"
                   Text="{Binding PerHour, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>
      <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding NumbersError, Mode=OneWay}" />
    </StackPanel>

    <!-- Test send with the unsaved settings -->
    <DockPanel Margin="0,14,0,0">
      <Button x:Name="TestButton"
              Command="{Binding TestCommand}"
              DockPanel.Dock="Left"
              Style="{StaticResource Wd.ToolButton}">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontSize="12"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Send}" />
          <TextBlock Margin="6,0,0,0" Text="{l:Tr Watchdog.Ui.SendTest}" />
        </StackPanel>
      </Button>
      <TextBlock VerticalAlignment="Center"
                 Style="{StaticResource Wd.Hint}"
                 Text="{l:Tr Watchdog.Ui.TestUsesUnsaved}" />
    </DockPanel>
    <wdv:WatchdogDeliveryTestView x:Name="TestResult"
                                  Margin="0,8,0,0"
                                  DataContext="{Binding Test, Mode=OneWay}" />
  </StackPanel>
</UserControl>
