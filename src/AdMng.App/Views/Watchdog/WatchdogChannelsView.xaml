<!--
  The "Channels and SMTP" sub-tab (WatchdogChannelsViewModel): the e-mail server (SMTP) with a test e-mail, the recipient
  groups and the Teams / webhook channels with their test sends, plus the save bar. Secrets are write-only fields.
-->
<UserControl x:Class="AdMng.App.Views.Watchdog.WatchdogChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AdMng.App.Controls"
             xmlns:l="clr-namespace:AdMng.App.Localization"
             xmlns:wdv="clr-namespace:AdMng.App.Views.Watchdog"
             AutomationProperties.Name="{l:Tr Watchdog.Tab.Channels}">
  <UserControl.Resources>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="110" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <wdv:WatchdogConfigBar x:Name="ConfigBar"
                           DataContext="{Binding Session}"
                           DockPanel.Dock="Bottom" />

    <ScrollViewer x:Name="ChannelsScroll"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="0,0,8,8">
        <!-- The SMTP card needs a label column and values of at least 250 px ("Nazwa użytkownika i hasło", the sender). -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="450" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Left: e-mail -->
        <StackPanel>
          <!-- SMTP -->
          <Border x:Name="SmtpCard"
                  DataContext="{Binding Smtp, Mode=OneWay}"
                  Style="{StaticResource Wd.Card}"
                  Visibility="{Binding Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}, FallbackValue=Collapsed}">
            <StackPanel IsEnabled="{Binding CanEdit, Mode=OneWay}">
              <TextBlock Style="{StaticResource Wd.CardTitle}" Text="{l:Tr Watchdog.Ui.SmtpTitle}" />
              <CheckBox x:Name="SmtpEnabledBox"
                        Content="{l:Tr Watchdog.Ui.SmtpEnabled}"
                        IsChecked="{Binding Enabled}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="170" />
                  <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Wd.FormLabel}" Text="{l:Tr Watchdog.Ui.SmtpHost}" />
                <StackPanel Grid.Column="1">
                  <TextBox x:Name="SmtpHostBox"
                           Margin="0,8,0,0"
                           AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpHost}"
                           Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[host], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpPort}" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                  <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpPort}"
                           Style="{StaticResource NumberBox}"
                           Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[port], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="2"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpSecurity}" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                  <ComboBox Margin="0,8,0,0"
                            AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpSecurity}"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding SecurityOptions, Mode=OneWay}"
                            SelectedItem="{Binding Security}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[security], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="3"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpAuthentication}" />
                <StackPanel Grid.Row="3" Grid.Column="1">
                  <ComboBox x:Name="SmtpAuthenticationBox"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpAuthentication}"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding AuthenticationOptions, Mode=OneWay}"
                            SelectedItem="{Binding Authentication}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[authentication], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="4"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpUserName}"
                           Visibility="{Binding UsesUserName, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                <StackPanel Grid.Row="4"
                            Grid.Column="1"
                            Visibility="{Binding UsesUserName, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                  <TextBox Margin="0,8,0,0"
                           AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpUserName}"
                           Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[userName], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="5"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpPassword}"
                           Visibility="{Binding IsBasic, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
                <Border Grid.Row="5"
                        Grid.Column="1"
                        Visibility="{Binding IsBasic, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                  <wdv:WatchdogSecretFieldView x:Name="SmtpPasswordField"
                                               Margin="0,8,0,0"
                                               AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpPassword}"
                                               DataContext="{Binding Password, Mode=OneWay}" />
                </Border>
                <TextBlock Grid.Row="6"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpFrom}" />
                <StackPanel Grid.Row="6" Grid.Column="1">
                  <TextBox x:Name="SmtpFromBox"
                           Margin="0,8,0,0"
                           AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpFrom}"
                           Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[from], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="7"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpReplyTo}" />
                <TextBox Grid.Row="7"
                         Grid.Column="1"
                         Margin="0,8,0,0"
                         AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpReplyTo}"
                         Text="{Binding ReplyTo, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="8"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.SmtpLocalDomain}" />
                <TextBox Grid.Row="8"
                         Grid.Column="1"
                         Margin="0,8,0,0"
                         AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpLocalDomain}"
                         Text="{Binding LocalDomain, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>

              <!-- Exchange Online OAuth2 (client credentials) -->
              <StackPanel Visibility="{Binding IsOAuth, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Wd.TopLabel}"
                           FontWeight="SemiBold"
                           Text="{l:Tr Watchdog.Ui.SmtpOAuth}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="170" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource Wd.FormLabel}" Text="{l:Tr Watchdog.Ui.EntraCloud}" />
                  <ComboBox Grid.Column="1"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="{l:Tr Watchdog.Ui.EntraCloud}"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding CloudOptions, Mode=OneWay}"
                            SelectedItem="{Binding Cloud}" />
                  <TextBlock Grid.Row="1"
                             Style="{StaticResource Wd.FormLabel}"
                             Text="{l:Tr Watchdog.Ui.TenantId}" />
                  <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBox Margin="0,8,0,0"
                             AutomationProperties.Name="{l:Tr Watchdog.Ui.TenantId}"
                             Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[oAuth.tenantId], Mode=OneWay}" />
                  </StackPanel>
                  <TextBlock Grid.Row="2"
                             Style="{StaticResource Wd.FormLabel}"
                             Text="{l:Tr Watchdog.Ui.ClientId}" />
                  <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBox Margin="0,8,0,0"
                             AutomationProperties.Name="{l:Tr Watchdog.Ui.ClientId}"
                             Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[oAuth.clientId], Mode=OneWay}" />
                  </StackPanel>
                  <TextBlock Grid.Row="3"
                             Style="{StaticResource Wd.FormLabel}"
                             Text="{l:Tr Watchdog.Ui.CertificateThumbprint}" />
                  <TextBox Grid.Row="3"
                           Grid.Column="1"
                           Margin="0,8,0,0"
                           AutomationProperties.Name="{l:Tr Watchdog.Ui.CertificateThumbprint}"
                           Text="{Binding CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Row="4"
                             Style="{StaticResource Wd.FormLabel}"
                             Text="{l:Tr Watchdog.Ui.ClientSecret}" />
                  <wdv:WatchdogSecretFieldView x:Name="SmtpClientSecretField"
                                               Grid.Row="4"
                                               Grid.Column="1"
                                               Margin="0,8,0,0"
                                               AutomationProperties.Name="{l:Tr Watchdog.Ui.ClientSecret}"
                                               DataContext="{Binding ClientSecret, Mode=OneWay}" />
                </Grid>
              </StackPanel>

              <!-- Certificate checks and limits -->
              <TextBlock Style="{StaticResource Wd.TopLabel}"
                         FontWeight="SemiBold"
                         Text="{l:Tr Watchdog.Ui.SmtpCertificate}" />
              <ComboBox AutomationProperties.Name="{l:Tr Watchdog.Ui.SmtpCertificate}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding CertificateOptions, Mode=OneWay}"
                        SelectedItem="{Binding CertificateValidation}" />
              <StackPanel Visibility="{Binding IsPinned, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Wd.TopLabel}" Text="{l:Tr Watchdog.Ui.PinnedSha256}" />
                <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.PinnedSha256}"
                         FontFamily="Consolas"
                         Text="{Binding PinnedSha256, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[pinnedSha256], Mode=OneWay}" />
              </StackPanel>
              <CheckBox Margin="0,8,0,0"
                        Content="{l:Tr Watchdog.Ui.CheckRevocation}"
                        IsChecked="{Binding CheckRevocation}" />
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Margin="0,6,0,0" Text="{l:Tr Watchdog.Ui.MaxMessagesPerMinute}" />
                  <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.MaxMessagesPerMinute}"
                           Style="{StaticResource NumberBox}"
                           Text="{Binding MaxMessagesPerMinute, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Margin="0,6,0,0" Text="{l:Tr Watchdog.Ui.MaxRecipients}" />
                  <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.MaxRecipients}"
                           Style="{StaticResource NumberBox}"
                           Text="{Binding MaxRecipientsPerMessage, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Margin="0,6,0,0" Text="{l:Tr Watchdog.Ui.TimeoutSeconds}" />
                  <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.TimeoutSeconds}"
                           Style="{StaticResource NumberBox}"
                           Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </StackPanel>
              <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding NumbersError, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <!-- Messages to users from AD Manager (README U1b) -->
          <Border x:Name="UserMessagingCard"
                  DataContext="{Binding UserMessaging, Mode=OneWay}"
                  Style="{StaticResource Wd.Card}"
                  Visibility="{Binding Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}, FallbackValue=Collapsed}">
            <StackPanel IsEnabled="{Binding CanEdit, Mode=OneWay}">
              <TextBlock Style="{StaticResource Wd.CardTitle}" Text="{l:Tr Watchdog.Ui.UserMessagingTitle}" />
              <TextBlock Style="{StaticResource Wd.Hint}" Text="{l:Tr Watchdog.Ui.UserMessagingHint}" />
              <CheckBox x:Name="UserMessagingEnabledBox"
                        Margin="0,8,0,0"
                        Content="{l:Tr Watchdog.Ui.UserMessagingEnabled}"
                        IsChecked="{Binding Enabled}" />
              <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[enabled], Mode=OneWay}" />
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Margin="0,6,0,0" Text="{l:Tr Watchdog.Ui.UserMessagingPerHour}" />
                  <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.UserMessagingPerHour}"
                           Style="{StaticResource NumberBox}"
                           Text="{Binding MaxMessagesPerHour, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Margin="0,6,0,0" Text="{l:Tr Watchdog.Ui.UserMessagingPerDay}" />
                  <TextBox AutomationProperties.Name="{l:Tr Watchdog.Ui.UserMessagingPerDay}"
                           Style="{StaticResource NumberBox}"
                           Text="{Binding MaxMessagesPerDay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </StackPanel>
              <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding NumbersError, Mode=OneWay}" />
              <TextBlock Style="{StaticResource Wd.TopLabel}" Text="{l:Tr Watchdog.Ui.UserMessagingSenders}" />
              <TextBox x:Name="UserMessagingSendersBox"
                       MinHeight="50"
                       MaxHeight="120"
                       AcceptsReturn="True"
                       AutomationProperties.Name="{l:Tr Watchdog.Ui.UserMessagingSenders}"
                       Text="{Binding AllowedSenders, UpdateSourceTrigger=PropertyChanged}"
                       VerticalScrollBarVisibility="Auto" />
              <TextBlock Style="{StaticResource Wd.Hint}" Text="{l:Tr Watchdog.Ui.UserMessagingSendersHint}" />
              <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding AllowedSendersError, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <!-- Test e-mail with the unsaved SMTP settings -->
          <Border x:Name="EmailTestCard" Style="{StaticResource Wd.Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Wd.CardTitle}" Text="{l:Tr Watchdog.Ui.TestEmail}" />
              <TextBlock Style="{StaticResource Wd.Hint}" Text="{l:Tr Watchdog.Ui.TestUsesUnsaved}" />
              <DockPanel Margin="0,8,0,0">
                <Button x:Name="SendTestEmailButton"
                        Margin="8,0,0,0"
                        Command="{Binding SendTestEmailCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Wd.ToolButton}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12"
                               Style="{StaticResource Ad.GlyphText}"
                               Text="{x:Static c:Glyphs.Send}" />
                    <TextBlock Margin="6,0,0,0" Text="{l:Tr Watchdog.Ui.SendTest}" />
                  </StackPanel>
                </Button>
                <Grid>
                  <TextBox x:Name="TestRecipientsBox"
                           AutomationProperties.Name="{l:Tr Watchdog.Ui.TestRecipients}"
                           Text="{Binding TestRecipients, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Ad.HintText}"
                             Text="{l:Tr Watchdog.Ui.TestRecipients}"
                             Visibility="{Binding Text, ElementName=TestRecipientsBox, Converter={StaticResource Ad.EmptyToVisible}}" />
                </Grid>
              </DockPanel>
              <wdv:WatchdogDeliveryTestView x:Name="EmailTestResult"
                                            Margin="0,8,0,0"
                                            DataContext="{Binding EmailTest, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <!-- Recipient groups -->
          <Border x:Name="RecipientGroupsCard"
                  DataContext="{Binding RecipientGroups, Mode=OneWay}"
                  Style="{StaticResource Wd.Card}"
                  Visibility="{Binding Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}, FallbackValue=Collapsed}">
            <StackPanel>
              <TextBlock Style="{StaticResource Wd.CardTitle}" Text="{l:Tr Watchdog.Ui.RecipientGroups}" />
              <DockPanel>
                <StackPanel Margin="8,0,0,0"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding CanEdit, Mode=OneWay}">
                  <Button Margin="0,0,0,6"
                          HorizontalAlignment="Stretch"
                          Command="{Binding AddGroupCommand}"
                          Content="{l:Tr Watchdog.Ui.AddGroup}" />
                  <Button HorizontalAlignment="Stretch"
                          Command="{Binding RemoveGroupCommand}"
                          Content="{l:Tr Watchdog.Groups.Remove}" />
                </StackPanel>
                <ListBox x:Name="GroupsList"
                         MaxHeight="150"
                         AutomationProperties.Name="{l:Tr Watchdog.Ui.RecipientGroups}"
                         DisplayMemberPath="DisplayText"
                         ItemsSource="{Binding Groups, Mode=OneWay}"
                         SelectedItem="{Binding SelectedGroup}" />
              </DockPanel>
              <Border IsEnabled="{Binding CanEdit, Mode=OneWay}">
              <Grid Margin="0,8,0,0"
                    DataContext="{Binding SelectedGroup, Mode=OneWay}"
                    Visibility="{Binding Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="170" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Wd.FormLabel}" Text="{l:Tr Common.Name}" />
                <StackPanel Grid.Column="1">
                  <TextBox Margin="0,8,0,0"
                           AutomationProperties.Name="{l:Tr Common.Name}"
                           Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[name], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.GroupId}" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                  <TextBox Margin="0,8,0,0"
                           AutomationProperties.Name="{l:Tr Watchdog.Ui.GroupId}"
                           Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[id], Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="2"
                           Style="{StaticResource Wd.FormLabel}"
                           Text="{l:Tr Watchdog.Ui.DetailLevel}" />
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,8,0,0"
                          AutomationProperties.Name="{l:Tr Watchdog.Ui.DetailLevel}"
                          DisplayMemberPath="Text"
                          ItemsSource="{Binding DetailLevels, Mode=OneWay}"
                          SelectedItem="{Binding DetailLevel}" />
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                  <TextBlock Style="{StaticResource Wd.TopLabel}" Text="{l:Tr Watchdog.Ui.GroupAddresses}" />
                  <TextBox x:Name="AddressesBox"
                           MinHeight="70"
                           MaxHeight="160"
                           AcceptsReturn="True"
                           AutomationProperties.Name="{l:Tr Watchdog.Ui.GroupAddresses}"
                           Text="{Binding Addresses, UpdateSourceTrigger=PropertyChanged}"
                           VerticalScrollBarVisibility="Auto" />
                  <TextBlock Style="{StaticResource Wd.FieldError}" Text="{Binding Errors[addresses], Mode=OneWay}" />
                </StackPanel>
              </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Right: Teams and webhook channels -->
        <Border x:Name="ChannelsCard"
                Grid.Column="2"
                VerticalAlignment="Top"
                Style="{StaticResource Wd.Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Wd.CardTitle}" Text="{l:Tr Watchdog.Ui.Channels}" />
            <DockPanel>
              <StackPanel Margin="8,0,0,0"
                          DockPanel.Dock="Right"
                          IsEnabled="{Binding Session.CanEdit, Mode=OneWay}">
                <Button Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        Command="{Binding AddTeamsChannelCommand}"
                        Content="{l:Tr Watchdog.Ui.AddTeams}" />
                <Button Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        Command="{Binding AddWebhookChannelCommand}"
                        Content="{l:Tr Watchdog.Ui.AddWebhook}" />
                <Button HorizontalAlignment="Stretch"
                        Command="{Binding RemoveChannelCommand}"
                        Content="{l:Tr Watchdog.Channel.Remove}" />
              </StackPanel>
              <ListBox x:Name="ChannelsList"
                       MinHeight="80"
                       MaxHeight="180"
                       AutomationProperties.Name="{l:Tr Watchdog.Ui.Channels}"
                       DisplayMemberPath="DisplayText"
                       ItemsSource="{Binding Channels, Mode=OneWay}"
                       SelectedItem="{Binding SelectedChannel}" />
            </DockPanel>
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource Wd.Hint}"
                       Text="{l:Tr Watchdog.Ui.NoChannels}"
                       Visibility="{Binding Channels.Count, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
            <wdv:WatchdogChannelEditorView x:Name="ChannelEditor"
                                           Margin="0,12,0,0"
                                           DataContext="{Binding SelectedChannel, Mode=OneWay}"
                                           Visibility="{Binding Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}, FallbackValue=Collapsed}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
