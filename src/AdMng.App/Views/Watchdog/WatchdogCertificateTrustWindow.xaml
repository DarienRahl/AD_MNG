<!--
  "Confirm the certificate of the Watchdog service" (WatchdogCertificateTrustViewModel, modal; stage B design 18 item 1):
  the SHA-256 fingerprint in groups of four hex digits to compare with "sudo admng-watchdog cert-fingerprint" on the
  server, subject, DNS names and validity; a changed certificate shows the old and the new fingerprint in red. Only
  "I trust this certificate" pins it; Enter and Esc cancel.
-->
<Window x:Class="AdMng.App.Views.Watchdog.WatchdogCertificateTrustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        Title="{Binding Title, Mode=OneWay}"
        Width="620"
        MinWidth="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Ad.SecondaryText}">
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>

    <Style x:Key="Fingerprint" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="ChangedFingerprint" TargetType="TextBlock" BasedOn="{StaticResource Fingerprint}">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="TrustButton"
                AutomationProperties.Name="{l:Tr Watchdog.Certificate.Trust}"
                Click="OnTrustClick"
                Content="{l:Tr Watchdog.Certificate.Trust}"
                Style="{StaticResource Ad.DialogButton}" />
        <Button x:Name="CancelButton"
                Click="OnCancelClick"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <StackPanel Margin="24,16,24,16">
      <DockPanel>
        <TextBlock Margin="0,0,12,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   FontSize="20"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Warning}" />
        <TextBlock x:Name="MessageText"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{Binding Message, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </DockPanel>

      <TextBlock Style="{StaticResource Label}" Text="{l:Tr Watchdog.Certificate.Service}" />
      <TextBlock x:Name="HostText" Text="{Binding HostText, Mode=OneWay}" />

      <!-- First connection: the fingerprint to compare. -->
      <StackPanel x:Name="FingerprintPanel" Visibility="{Binding IsChanged, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}">
        <TextBlock Style="{StaticResource Label}" Text="{l:Tr Watchdog.Certificate.Fingerprint}" />
        <TextBlock x:Name="FingerprintText"
                   AutomationProperties.Name="{l:Tr Watchdog.Certificate.Fingerprint}"
                   Style="{StaticResource Fingerprint}"
                   Text="{Binding Fingerprint, Mode=OneWay}" />
      </StackPanel>

      <!-- Changed certificate: the pinned and the new fingerprint, both in red. -->
      <StackPanel x:Name="ChangedPanel" Visibility="{Binding IsChanged, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock Style="{StaticResource Label}" Text="{l:Tr Watchdog.Certificate.PreviousFingerprint}" />
        <TextBlock x:Name="PreviousFingerprintText"
                   AutomationProperties.Name="{l:Tr Watchdog.Certificate.PreviousFingerprint}"
                   Style="{StaticResource ChangedFingerprint}"
                   Text="{Binding PreviousFingerprint, Mode=OneWay}" />
        <TextBlock Style="{StaticResource Label}" Text="{l:Tr Watchdog.Certificate.NewFingerprint}" />
        <TextBlock x:Name="NewFingerprintText"
                   AutomationProperties.Name="{l:Tr Watchdog.Certificate.NewFingerprint}"
                   Style="{StaticResource ChangedFingerprint}"
                   Text="{Binding Fingerprint, Mode=OneWay}" />
      </StackPanel>

      <TextBlock x:Name="CompareText"
                 Margin="0,8,0,0"
                 FontWeight="SemiBold"
                 Text="{Binding CompareText, Mode=OneWay}"
                 TextWrapping="Wrap" />

      <TextBlock Style="{StaticResource Label}" Text="{l:Tr Watchdog.Certificate.Subject}" />
      <TextBlock x:Name="SubjectText"
                 Text="{Binding Subject, Mode=OneWay}"
                 TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Label}" Text="{l:Tr Watchdog.Certificate.DnsNames}" />
      <TextBlock x:Name="DnsNamesText"
                 Text="{Binding DnsNames, Mode=OneWay}"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="ValidityText"
                 Margin="0,10,0,0"
                 Text="{Binding Validity, Mode=OneWay}"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="ValidityWarningText"
                 Style="{StaticResource Wd.FieldError}"
                 Text="{Binding ValidityWarning, Mode=OneWay}" />
    </StackPanel>
  </DockPanel>
</Window>
