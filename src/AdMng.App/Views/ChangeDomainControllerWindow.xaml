<!-- "Change Domain Controller" (modal, ChangeDomainControllerViewModel): the DCs of the domain, a typed name or any
     writable DC of this computer's site; the session moves to the chosen DC only after it answered. -->
<Window x:Class="AdMng.App.Views.ChangeDomainControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:conn="clr-namespace:AdMng.Presentation.Connection;assembly=AdMng.Presentation"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="680"
        Height="600"
        MinWidth="520"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <Style x:Key="DomainControllerRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName, Mode=OneWay, TargetNullValue=''}" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ChangeButton"
                  Command="{Binding ChangeCommand}"
                  Content="{l:Tr ChangeDc.ChangeButton}"
                  IsDefault="True"
                  Style="{StaticResource Ad.AccentDialogButton}" />
          <Button x:Name="CancelButton"
                  Command="{Binding CancelCommand}"
                  Content="{l:Tr Common.Cancel}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ProgressBar Width="72"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                       Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock x:Name="StatusTextBlock"
                     VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding StatusText, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="24,18,24,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Domain and the DC the session works with now -->
      <StackPanel Grid.Row="0">
        <TextBlock Style="{StaticResource Ad.Title}" Text="{Binding WindowTitle, Mode=OneWay}" />
        <TextBlock x:Name="DomainTextBlock"
                   Margin="0,4,0,0"
                   Text="{Binding DomainText, Mode=OneWay}"
                   Visibility="{Binding DomainText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
        <TextBlock x:Name="CurrentTextBlock"
                   Margin="0,2,0,0"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding CurrentText, Mode=OneWay}"
                   Visibility="{Binding CurrentText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      </StackPanel>

      <!-- Why the switch failed (the session stays on its DC), not connected, session ended -->
      <Border x:Name="ErrorBar"
              Grid.Row="1"
              Margin="0,12,0,0"
              Style="{StaticResource Ad.ErrorBar}"
              Visibility="{Binding ErrorText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <DockPanel>
          <TextBlock Margin="0,1,10,0"
                     VerticalAlignment="Top"
                     DockPanel.Dock="Left"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     Style="{StaticResource Ad.GlyphText}"
                     Text="{x:Static c:Glyphs.Error}" />
          <TextBlock x:Name="ErrorTextBlock"
                     AutomationProperties.LiveSetting="Assertive"
                     Text="{Binding ErrorText, Mode=OneWay}"
                     TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- The list could not be read: a name can still be typed -->
      <Border x:Name="ListNoteBar"
              Grid.Row="2"
              Margin="0,12,0,0"
              Style="{StaticResource Ad.WarningBar}"
              Visibility="{Binding ListNote, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock Text="{Binding ListNote, Mode=OneWay}" TextWrapping="Wrap" />
      </Border>

      <DockPanel Grid.Row="3" Margin="0,14,0,6">
        <Button x:Name="RefreshButton"
                AutomationProperties.Name="{l:Tr Commands.Refresh}"
                Command="{Binding RefreshCommand}"
                Content="{x:Static c:Glyphs.Refresh}"
                DockPanel.Dock="Right"
                Style="{StaticResource Ad.IconButton}"
                ToolTip="{l:Tr Commands.Refresh}" />
        <ProgressBar Width="60"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{l:Tr Common.Loading}"
                     DockPanel.Dock="Right"
                     IsIndeterminate="{Binding IsLoading, Mode=OneWay}"
                     Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <TextBlock VerticalAlignment="Center"
                   Style="{StaticResource Ad.SectionHeader}"
                   Text="{l:Tr ChangeDc.ListLabel}" />
      </DockPanel>

      <ListView x:Name="DomainControllerList"
                Grid.Row="4"
                AutomationProperties.Name="{l:Tr ChangeDc.ListLabel}"
                ItemContainerStyle="{StaticResource DomainControllerRowStyle}"
                ItemsSource="{Binding DomainControllers}"
                SelectedItem="{Binding SelectedDomainController}"
                SelectionMode="Single">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Width="250" Header="{l:Tr Common.Name}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type conn:DomainControllerItem}">
                  <TextBlock x:Name="HostNameText"
                             Text="{Binding HostName, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding HostName, Mode=OneWay}" />
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent, Mode=OneWay}" Value="True">
                      <Setter TargetName="HostNameText" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="130"
                            DisplayMemberBinding="{Binding SiteText, Mode=OneWay}"
                            Header="{l:Tr Connect.Site}" />
            <GridViewColumn Width="90"
                            DisplayMemberBinding="{Binding InClientSiteText, Mode=OneWay}"
                            Header="{l:Tr ChangeDc.ColumnYourSite}" />
            <GridViewColumn Width="200" Header="{l:Tr ChangeDc.ColumnRoles}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type conn:DomainControllerItem}">
                  <TextBlock Text="{Binding RolesText, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding RolesText, Mode=OneWay}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>

      <!-- This domain controller: an entry of the list or a typed name -->
      <StackPanel Grid.Row="5" Margin="0,12,0,0">
        <RadioButton x:Name="SpecificOption"
                     Content="{l:Tr ChangeDc.ThisDomainController}"
                     GroupName="Target"
                     IsChecked="{Binding UseSpecificDomainController}" />
        <Grid Margin="28,4,0,0" IsEnabled="{Binding UseSpecificDomainController, Mode=OneWay}">
          <TextBox x:Name="ServerBox"
                   AutomationProperties.Name="{l:Tr ChangeDc.ThisDomainController}"
                   Text="{Binding ServerText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Ad.HintText}"
                     Text="{l:Tr ChangeDc.ServerPlaceholder}"
                     Visibility="{Binding Text, ElementName=ServerBox, Converter={StaticResource Ad.EmptyToVisible}}" />
        </Grid>
        <TextBlock x:Name="TargetHintText"
                   Margin="28,4,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding TargetHint, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding TargetHint, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      </StackPanel>

      <!-- Any writable DC of this computer's site (DC locator) -->
      <StackPanel Grid.Row="6" Margin="0,10,0,0">
        <RadioButton x:Name="AnyWritableOption"
                     Content="{l:Tr ChangeDc.AnyWritableInSite}"
                     GroupName="Target"
                     IsChecked="{Binding UseAnyWritableInSite}"
                     IsEnabled="{Binding CanUseAnyWritableInSite, Mode=OneWay}" />
        <TextBlock x:Name="AnyWritableTextBlock"
                   Margin="28,2,0,0"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding AnyWritableText, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Remember in the profile the connection came from (only when asked) -->
      <CheckBox x:Name="UpdateProfileBox"
                Grid.Row="7"
                Margin="0,12,0,0"
                Content="{Binding UpdateProfileText, Mode=OneWay}"
                IsChecked="{Binding UpdateProfile}"
                Visibility="{Binding CanUpdateProfile, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</Window>
