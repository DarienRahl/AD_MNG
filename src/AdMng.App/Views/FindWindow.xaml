<!--
  ADUC "Find Users, Contacts, and Groups" (modeless): kind, search base, name (ambiguous name resolution), advanced
  field/condition/value rows and the generated (or hand-edited) LDAP filter. Results reuse the object list view.
-->
<Window x:Class="AdMng.App.Views.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:dlg="clr-namespace:AdMng.Presentation.Dialogs;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:v="clr-namespace:AdMng.App.Views"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="900"
        Height="680"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>

    <!-- The view model, for the remove buttons of the condition rows. -->
    <c:BindingProxy x:Key="DialogProxy" Data="{Binding}" />

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <TextBlock VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding Results.StatusText, Mode=OneWay}" />
        <Button x:Name="CloseButton"
                HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="{l:Tr Common.Close}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </DockPanel>
    </Border>

    <!-- The directory session this window was opened in ended: reopen the window to work in the current one. -->
    <Border Margin="16,12,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding SessionEndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock AutomationProperties.LiveSetting="Assertive"
                 Text="{Binding SessionEndedMessage, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Criteria | Find Now / Stop / Clear All -->
    <Grid Margin="16,12,16,8" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Margin="0,0,16,0">
        <DockPanel>
          <TextBlock Style="{StaticResource Label}" Text="{l:Tr ObjectDialogs.FindKind}" />
          <ComboBox x:Name="KindBox"
                    MinWidth="220"
                    AutomationProperties.Name="{l:Tr ObjectDialogs.FindKind}"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding Kinds, Mode=OneWay}"
                    SelectedItem="{Binding Kind}" />
          <TextBlock Margin="16,0,8,0"
                     Style="{StaticResource Label}"
                     Text="{l:Tr Find.In}" />
          <Button Margin="6,0,0,0"
                  Command="{Binding SearchEntireDomainCommand}"
                  Content="{l:Tr Csv.EntireDomain}"
                  DockPanel.Dock="Right" />
          <Button Margin="6,0,0,0"
                  Command="{Binding BrowseCommand}"
                  Content="{l:Tr Common.Browse}"
                  DockPanel.Dock="Right" />
          <TextBox AutomationProperties.Name="{l:Tr Find.In}"
                   IsReadOnly="True"
                   Text="{Binding SearchBaseText, Mode=OneWay}" />
        </DockPanel>
        <CheckBox Margin="0,8,0,0"
                  Content="{l:Tr Find.IncludeSubcontainers}"
                  IsChecked="{Binding IncludeSubcontainers}" />

        <!-- Name (ANR); not used by a custom search -->
        <DockPanel Margin="0,10,0,0" Visibility="{Binding IsCustom, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}">
          <TextBlock MinWidth="60"
                     Style="{StaticResource Label}"
                     Text="{l:Tr Common.Name}" />
          <TextBox x:Name="NameBox"
                   AutomationProperties.Name="{l:Tr Common.Name}"
                   Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Advanced: field / condition / value rows -->
        <Expander x:Name="AdvancedExpander"
                  Margin="0,10,0,0"
                  Header="{l:Tr Find.Advanced}"
                  Visibility="{Binding IsCustom, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}">
          <StackPanel Margin="0,6,0,0">
            <ItemsControl Focusable="False" ItemsSource="{Binding Conditions, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dlg:FindConditionViewModel}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="1.5*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox AutomationProperties.Name="{l:Tr Find.Field}"
                              DisplayMemberPath="Text"
                              ItemsSource="{Binding Fields, Mode=OneWay}"
                              SelectedItem="{Binding Field}" />
                    <ComboBox Grid.Column="2"
                              AutomationProperties.Name="{l:Tr Find.Condition}"
                              DisplayMemberPath="Text"
                              ItemsSource="{Binding Operators, Mode=OneWay}"
                              SelectedItem="{Binding Operator}" />
                    <TextBox Grid.Column="4"
                             AutomationProperties.Name="{l:Tr Labels.Value}"
                             IsEnabled="{Binding NeedsValue, Mode=OneWay}"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="5"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{l:Tr Common.Remove}"
                            Command="{Binding Data.RemoveConditionCommand, Source={StaticResource DialogProxy}}"
                            CommandParameter="{Binding Mode=OneWay}"
                            Content="{x:Static c:Glyphs.Delete}"
                            Style="{StaticResource Ad.IconButton}"
                            ToolTip="{l:Tr Common.Remove}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left"
                    Command="{Binding AddConditionCommand}"
                    Content="{l:Tr ObjectDialogs.AddCondition}" />
          </StackPanel>
        </Expander>

        <!-- The LDAP filter that will be used (editable) -->
        <DockPanel Margin="0,10,0,0">
          <Button Margin="6,0,0,0"
                  VerticalAlignment="Top"
                  Command="{Binding ResetFilterCommand}"
                  Content="{l:Tr ObjectDialogs.RebuildFilter}"
                  DockPanel.Dock="Right"
                  Visibility="{Binding IsRawFilter, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock Margin="0,6,8,0"
                     VerticalAlignment="Top"
                     Style="{StaticResource Label}"
                     Text="{l:Tr Find.LdapFilter}" />
          <TextBox x:Name="FilterBox"
                   AutomationProperties.Name="{l:Tr Find.LdapFilter}"
                   FontFamily="Cascadia Mono, Consolas"
                   Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                   TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock Margin="0,4,0,0"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr ObjectDialogs.RawFilterNote}"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsRawFilter, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <TextBlock Margin="0,4,0,0"
                   AutomationProperties.LiveSetting="Assertive"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding FilterError, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding FilterError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      </StackPanel>

      <StackPanel Grid.Column="1">
        <Button x:Name="FindNowButton"
                Command="{Binding FindNowCommand}"
                Content="{l:Tr Find.FindNow}"
                IsDefault="True"
                Style="{StaticResource SideButton}" />
        <Button Command="{Binding StopCommand}"
                Content="{l:Tr Common.Stop}"
                Style="{StaticResource SideButton}" />
        <Button Command="{Binding ClearAllCommand}"
                Content="{l:Tr Find.ClearAll}"
                Style="{StaticResource SideButton}" />
      </StackPanel>
    </Grid>

    <!-- Results -->
    <Border Margin="16,0,16,12"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding HasSearched, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <v:ObjectListView x:Name="ResultsView"
                        DataContext="{Binding Results, Mode=OneWay}"
                        ItemActivated="OnResultActivated" />
    </Border>
  </DockPanel>
</Window>
