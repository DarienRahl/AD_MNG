<!--
  "Porównaj z obiektem w innym połączeniu…" (ObjectComparisonViewModel, modeless, design note docs/dev/multi-window.md 8):
  the object of this connection (A) against the matching object of another open connection (B), read-only, side by side.
  Each side has its identity strip and badge in its own colour; differences have an accent background AND a glyph (never
  colour alone). Nothing here writes; CSV is written only on "Eksportuj CSV…".
-->
<Window x:Class="AdMng.App.Views.CompareObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:cmp="clr-namespace:AdMng.Presentation.Comparison;assembly=AdMng.Presentation"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1180"
        Height="780"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <c:BindingProxy x:Key="CompareProxy" Data="{Binding}" />

    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <Style x:Key="InlineLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Padding" Value="12,3" />
    </Style>

    <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A difference: accent background (and the glyph column). -->
    <Style x:Key="AttributeRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,2" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, Mode=OneWay}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding StateText, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDifference, Mode=OneWay}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MembershipRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding StateText, Mode=OneWay}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDifference, Mode=OneWay}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CandidateRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
    </Style>

    <!-- A value of the selected attribute row: read by its text, then its side and mark ("A: tylko A"). -->
    <Style x:Key="ValueRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Text, Mode=OneWay}" />
      <Setter Property="AutomationProperties.HelpText">
        <Setter.Value>
          <MultiBinding Mode="OneWay" StringFormat="{}{0}: {1}">
            <Binding Mode="OneWay" Path="Side" />
            <Binding Mode="OneWay" Path="MarkText" />
          </MultiBinding>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One side of the header: the strip and badge in that connection's colour, the object as that side reads it. -->
    <DataTemplate x:Key="SideTemplate" DataType="{x:Type cmp:ComparisonSideViewModel}">
      <Border Padding="0,0,0,8"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <StackPanel>
          <Border Height="4"
                  Background="{Binding Color, Mode=OneWay, Converter={StaticResource Ad.ConnectionBrush}}"
                  CornerRadius="6,6,0,0" />
          <DockPanel Margin="12,8,12,0">
            <Border Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{Binding Color, Mode=OneWay, Converter={StaticResource Ad.ConnectionBrush}}"
                    CornerRadius="10"
                    DockPanel.Dock="Left">
              <TextBlock FontWeight="SemiBold"
                         Foreground="White"
                         Text="{Binding Side, Mode=OneWay}" />
            </Border>
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding Label, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Label, Mode=OneWay}" />
          </DockPanel>
          <StackPanel Margin="12,6,12,0" Visibility="{Binding Summary, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
            <TextBlock FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding Summary.Name, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Ad.SecondaryText}" Text="{Binding Summary.TypeText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Ad.SecondaryText}"
                       Text="{Binding Summary.Path, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Summary.DistinguishedName, Mode=OneWay}" />
          </StackPanel>
          <Border Margin="12,8,12,0"
                  Style="{StaticResource Ad.WarningBar}"
                  Visibility="{Binding EndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
            <TextBlock AutomationProperties.LiveSetting="Assertive"
                       Text="{Binding EndedMessage, Mode=OneWay}"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TargetTemplate" DataType="{x:Type cmp:ComparisonTargetViewModel}">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="10"
                 Height="10"
                 Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 Fill="{Binding Color, Mode=OneTime, Converter={StaticResource Ad.ConnectionBrush}}" />
        <TextBlock VerticalAlignment="Center" Text="{Binding Label, Mode=OneTime}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ExportButton"
                  Command="{Binding ExportCsvCommand}"
                  Content="{l:Tr Comparison.ExportCsv}"
                  Style="{StaticResource Ad.DialogButton}" />
          <Button x:Name="CloseButton"
                  Command="{Binding CloseCommand}"
                  Content="{l:Tr Common.Close}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <ProgressBar Width="72"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       IsIndeterminate="True"
                       Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock x:Name="StatusLine"
                     VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding StatusText, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding StatusText, Mode=OneWay}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The session of this window ended: the results stay, nothing is read any more. -->
    <Border Margin="16,12,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding SessionEndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock AutomationProperties.LiveSetting="Assertive"
                 Text="{Binding SessionEndedMessage, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Connection and matching rule. -->
    <Grid Margin="16,12,16,0" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="160" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource InlineLabel}" Text="{l:Tr Comparison.Connection}" />
      <!-- The items are read and typed by their label (domain and account), never by the value-free ToString(). -->
      <ComboBox x:Name="TargetBox"
                Grid.Column="1"
                AutomationProperties.Name="{l:Tr Comparison.Connection}"
                IsEnabled="{Binding HasTargets, Mode=OneWay}"
                ItemTemplate="{StaticResource TargetTemplate}"
                ItemsSource="{Binding Targets}"
                SelectedItem="{Binding SelectedTarget}"
                TextSearch.TextPath="Label">
        <ComboBox.ItemContainerStyle>
          <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label, Mode=OneWay}" />
          </Style>
        </ComboBox.ItemContainerStyle>
      </ComboBox>
      <TextBlock Grid.Column="2"
                 Margin="16,0,8,0"
                 Style="{StaticResource InlineLabel}"
                 Text="{l:Tr Comparison.MatchBy}" />
      <ComboBox x:Name="RuleBox"
                Grid.Column="3"
                AutomationProperties.Name="{l:Tr Comparison.MatchBy}"
                DisplayMemberPath="Text"
                ItemsSource="{Binding MatchRules}"
                SelectedItem="{Binding SelectedRule}" />
      <StackPanel Grid.Column="4" Orientation="Horizontal">
        <Button x:Name="CompareButton"
                Command="{Binding CompareCommand}"
                Content="{l:Tr Comparison.Compare}"
                IsDefault="True"
                Style="{StaticResource BarButton}" />
        <Button x:Name="StopButton"
                Command="{Binding CompareCancelCommand}"
                Content="{l:Tr Comparison.Stop}"
                Style="{StaticResource BarButton}"
                Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="RefreshButton"
                Command="{Binding RefreshCommand}"
                Content="{l:Tr Comparison.Refresh}"
                Style="{StaticResource BarButton}" />
      </StackPanel>
      <Grid Grid.Row="1"
            Grid.Column="3"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0"
            Visibility="{Binding IsExplicit, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBox x:Name="ExplicitBox"
                 AutomationProperties.Name="{l:Tr Comparison.ExplicitHint}"
                 Text="{Binding ExplicitText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Ad.HintText}"
                   Text="{l:Tr Comparison.ExplicitHint}"
                   Visibility="{Binding Text, ElementName=ExplicitBox, Converter={StaticResource Ad.EmptyToVisible}}" />
      </Grid>
    </Grid>

    <!-- No other connection: how to open one. -->
    <Border x:Name="NoTargetsBar"
            Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding NoTargetsMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock Text="{Binding NoTargetsMessage, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>

    <Border Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding ErrorText, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock AutomationProperties.LiveSetting="Assertive"
                 Text="{Binding ErrorText, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Candidates of an ambiguous match: choosing one compares with it. -->
    <ListView x:Name="CandidatesList"
              MaxHeight="170"
              Margin="16,10,16,0"
              AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
              DockPanel.Dock="Top"
              ItemContainerStyle="{StaticResource CandidateRowStyle}"
              ItemsSource="{Binding Candidates}"
              SelectedItem="{Binding SelectedCandidate}"
              SelectionMode="Single"
              Visibility="{Binding Candidates.Count, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <ListView.View>
        <GridView AllowsColumnReorder="False">
          <GridViewColumn Width="220"
                          DisplayMemberBinding="{Binding Name, Mode=OneTime}"
                          Header="{l:Tr Comparison.ColumnName}" />
          <GridViewColumn Width="320"
                          DisplayMemberBinding="{Binding Path, Mode=OneTime}"
                          Header="{l:Tr Comparison.ColumnPath}" />
          <GridViewColumn Width="180"
                          DisplayMemberBinding="{Binding SamAccountName, Mode=OneTime}"
                          Header="sAMAccountName" />
          <GridViewColumn Width="240"
                          DisplayMemberBinding="{Binding Mail, Mode=OneTime}"
                          Header="{l:Tr Comparison.ColumnMail}" />
        </GridView>
      </ListView.View>
    </ListView>

    <!-- Header: side A and side B. -->
    <Grid Margin="16,12,16,0" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ContentControl x:Name="SideAHeader"
                      Content="{Binding SideA, Mode=OneTime}"
                      ContentTemplate="{StaticResource SideTemplate}"
                      Focusable="False" />
      <ContentControl x:Name="SideBHeader"
                      Grid.Column="2"
                      Content="{Binding SideB, Mode=OneTime}"
                      ContentTemplate="{StaticResource SideTemplate}"
                      Focusable="False" />
    </Grid>

    <Border x:Name="SameObjectBar"
            Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding IsSameObject, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <TextBlock Text="{l:Tr Comparison.SameObject}" TextWrapping="Wrap" />
    </Border>

    <TabControl x:Name="Tabs" Margin="16,12,16,12">
      <!-- ==== Attributes ==== -->
      <TabItem x:Name="AttributesTab" Header="{Binding AttributesTabHeader, Mode=OneWay}">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <Grid Width="220" DockPanel.Dock="Right">
              <TextBox x:Name="FilterBox"
                       AutomationProperties.Name="{l:Tr Comparison.Filter}"
                       Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
              <TextBlock Style="{StaticResource Ad.HintText}"
                         Text="{l:Tr Comparison.Filter}"
                         Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource Ad.EmptyToVisible}}" />
            </Grid>
            <WrapPanel VerticalAlignment="Center">
              <CheckBox x:Name="OnlyDifferencesBox"
                        Content="{l:Tr Comparison.OnlyDifferences}"
                        IsChecked="{Binding OnlyDifferences}"
                        Style="{StaticResource Toggle}" />
              <CheckBox x:Name="ShowVolatileBox"
                        Content="{l:Tr Comparison.ShowVolatile}"
                        IsChecked="{Binding ShowVolatile}"
                        Style="{StaticResource Toggle}" />
              <CheckBox x:Name="AddressesBox"
                        Content="{l:Tr Comparison.AddressesWithoutDomain}"
                        IsChecked="{Binding CompareAddressesWithoutDomain}"
                        Style="{StaticResource Toggle}" />
            </WrapPanel>
          </DockPanel>
          <ListView x:Name="AttributesList"
                    Grid.Row="1"
                    AutomationProperties.Name="{l:Tr Comparison.TabAttributes}"
                    ItemContainerStyle="{StaticResource AttributeRowStyle}"
                    ItemsSource="{Binding AttributeRows}"
                    SelectedItem="{Binding SelectedAttributeRow}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.InputBindings>
              <KeyBinding Key="C"
                          Command="{Binding Data.CopyRowCommand, Source={StaticResource CompareProxy}}"
                          Modifiers="Control" />
            </ListView.InputBindings>
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="CopyRowMenuItem"
                          Command="{Binding Data.CopyRowCommand, Source={StaticResource CompareProxy}}"
                          Header="{l:Tr Copy.CopyEntry}"
                          InputGestureText="Ctrl+C" />
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="30">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cmp:AttributeComparisonRowViewModel}">
                      <TextBlock FontWeight="Bold"
                                 Text="{Binding Glyph, Mode=OneTime}"
                                 ToolTip="{Binding StateText, Mode=OneTime}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="200" Header="{l:Tr Comparison.ColumnAttribute}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cmp:AttributeComparisonRowViewModel}">
                      <TextBlock Text="{Binding DisplayName, Mode=OneTime}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding LdapName, Mode=OneTime}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="330" Header="{Binding Data.SideA.Label, Source={StaticResource CompareProxy}}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cmp:AttributeComparisonRowViewModel}">
                      <TextBlock x:Name="ValueA"
                                 Text="{Binding ValueTextA, Mode=OneTime}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="Wrap" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasValueA, Mode=OneTime}" Value="False">
                          <Setter TargetName="ValueA" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                          <Setter TargetName="ValueA" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="330" Header="{Binding Data.SideB.Label, Source={StaticResource CompareProxy}}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cmp:AttributeComparisonRowViewModel}">
                      <TextBlock x:Name="ValueB"
                                 Text="{Binding ValueTextB, Mode=OneTime}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="Wrap" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasValueB, Mode=OneTime}" Value="False">
                          <Setter TargetName="ValueB" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                          <Setter TargetName="ValueB" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="190"
                                DisplayMemberBinding="{Binding StateText, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnState}" />
              </GridView>
            </ListView.View>
          </ListView>

          <!-- All values of the selected row, marked "tylko A" / "tylko B" / "wspólne". -->
          <TextBlock Grid.Row="2"
                     Margin="0,10,0,4"
                     FontWeight="SemiBold"
                     Text="{Binding SelectedValuesHeader, Mode=OneWay}" />
          <ListView x:Name="ValuesList"
                    Grid.Row="3"
                    AutomationProperties.Name="{Binding ValuesListName, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource ValueRowStyle}"
                    ItemsSource="{Binding SelectedAttributeRow.Details, Mode=OneWay}">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="50"
                                DisplayMemberBinding="{Binding Side, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnSide}" />
                <GridViewColumn Width="620"
                                DisplayMemberBinding="{Binding Text, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnValue}" />
                <GridViewColumn Width="140"
                                DisplayMemberBinding="{Binding MarkText, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnState}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <!-- ==== Membership ==== -->
      <TabItem x:Name="MembershipTab" Header="{Binding MembershipTabHeader, Mode=OneWay}">
        <DockPanel Margin="0,8,0,0">
          <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
            <CheckBox x:Name="OnlyMembershipDifferencesBox"
                      Content="{l:Tr Comparison.OnlyDifferences}"
                      IsChecked="{Binding OnlyMembershipDifferences}"
                      Style="{StaticResource Toggle}" />
            <CheckBox x:Name="ShowNestedBox"
                      Content="{l:Tr Comparison.ShowNested}"
                      IsChecked="{Binding ShowNested}"
                      Style="{StaticResource Toggle}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsNestedLoading, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
              <ProgressBar Width="60"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           IsIndeterminate="True" />
              <TextBlock VerticalAlignment="Center"
                         Style="{StaticResource Ad.SecondaryText}"
                         Text="{l:Tr Comparison.NestedLoading}" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Margin="0,8,0,0"
                     DockPanel.Dock="Bottom"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding MembershipNotes, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <ListView x:Name="MembershipList"
                    AutomationProperties.Name="{l:Tr Comparison.TabMembership}"
                    ItemContainerStyle="{StaticResource MembershipRowStyle}"
                    ItemsSource="{Binding MembershipRows}">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="30">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cmp:MembershipComparisonRowViewModel}">
                      <TextBlock FontWeight="Bold"
                                 Text="{Binding Glyph, Mode=OneTime}"
                                 ToolTip="{Binding StateText, Mode=OneTime}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="340"
                                DisplayMemberBinding="{Binding Name, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnGroup}" />
                <GridViewColumn Width="230"
                                DisplayMemberBinding="{Binding KindTextA, Mode=OneTime}"
                                Header="{Binding Data.SideA.Label, Source={StaticResource CompareProxy}}" />
                <GridViewColumn Width="230"
                                DisplayMemberBinding="{Binding KindTextB, Mode=OneTime}"
                                Header="{Binding Data.SideB.Label, Source={StaticResource CompareProxy}}" />
                <GridViewColumn Width="180"
                                DisplayMemberBinding="{Binding StateText, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnState}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>

      <!-- ==== Members (groups only) ==== -->
      <TabItem x:Name="MembersTab"
               Header="{Binding MembersTabHeader, Mode=OneWay}"
               Visibility="{Binding IsGroup, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <DockPanel Margin="0,8,0,0">
          <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
            <CheckBox x:Name="OnlyMemberDifferencesBox"
                      Content="{l:Tr Comparison.OnlyDifferences}"
                      IsChecked="{Binding OnlyMemberDifferences}"
                      Style="{StaticResource Toggle}" />
            <CheckBox x:Name="ShowNestedMembersBox"
                      Content="{l:Tr Comparison.ShowNestedMembers}"
                      IsChecked="{Binding ShowNestedMembers}"
                      Style="{StaticResource Toggle}" />
          </WrapPanel>
          <TextBlock Margin="0,8,0,0"
                     DockPanel.Dock="Bottom"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding MemberNotes, Mode=OneWay}"
                     TextWrapping="Wrap" />
          <ListView x:Name="MembersList"
                    AutomationProperties.Name="{l:Tr Comparison.TabMembers}"
                    ItemContainerStyle="{StaticResource MembershipRowStyle}"
                    ItemsSource="{Binding MemberRows}">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="30">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type cmp:MembershipComparisonRowViewModel}">
                      <TextBlock FontWeight="Bold"
                                 Text="{Binding Glyph, Mode=OneTime}"
                                 ToolTip="{Binding StateText, Mode=OneTime}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="340"
                                DisplayMemberBinding="{Binding Name, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnMember}" />
                <GridViewColumn Width="230"
                                DisplayMemberBinding="{Binding KindTextA, Mode=OneTime}"
                                Header="{Binding Data.SideA.Label, Source={StaticResource CompareProxy}}" />
                <GridViewColumn Width="230"
                                DisplayMemberBinding="{Binding KindTextB, Mode=OneTime}"
                                Header="{Binding Data.SideB.Label, Source={StaticResource CompareProxy}}" />
                <GridViewColumn Width="180"
                                DisplayMemberBinding="{Binding StateText, Mode=OneTime}"
                                Header="{l:Tr Comparison.ColumnState}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
