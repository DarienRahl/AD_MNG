<!--
  The change plan preview (ChangePlanPreviewViewModel, modal; design note docs/dev/k-computers-and-gpo.md 3.3): every GPO
  operation is shown here first - "Zmiany ustawień" of an editor's save (K6, collapsed when long), the rows of the plan
  (SYSVOL files with their sizes, the version row, folder and permission steps), the differences of a selected file
  (settings with secrets masked, text lines or "binary"), the PowerShell equivalent - then Execute (typed confirmation
  for destructive operations), the results and Undo.

  Feedback (track V, stage V2b): one status line under the title (PageStatus) - at rest the summary of the plan, the
  execution with the part done, its result with the domain (Undo as its action where something was made), that the
  session of the window ended. "Execute" is an action button: while the execution runs it is its Cancel. "The undo plan
  is shown" is a note above the rows.
-->
<Window x:Class="AdMng.App.Views.ChangePlanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:batch="clr-namespace:AdMng.Presentation.BatchEditing;assembly=AdMng.Presentation"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:changes="clr-namespace:AdMng.Presentation.Changes;assembly=AdMng.Presentation"
        xmlns:conv="clr-namespace:AdMng.App.Converters"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1080"
        Height="736"
        MinWidth="760"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>
    <conv:RowSeverityToGlyphConverter x:Key="RowSeverityGlyph" />
    <conv:NotEmptyToBooleanConverter x:Key="NotEmpty" />
    <Style x:Key="PreviewRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Attribute, Mode=OneWay}" />
    </Style>
    <Style x:Key="SettingChangeRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Setting, Mode=OneWay}" />
    </Style>
    <!-- A setting in the operator's language (its technical line as tool tip, K6), or a text line of the file -->
    <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type changes:PreviewDiffLineViewModel}">
      <TextBlock x:Name="LineText" FontFamily="Consolas" Text="{Binding Text, Mode=OneWay}" ToolTip="{Binding ToolTip, Mode=OneWay}" />
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static changes:PreviewDiffKind.Added}">
          <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static changes:PreviewDiffKind.Removed}">
          <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
          <Setter TargetName="LineText" Property="TextDecorations" Value="Strikethrough" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static changes:PreviewDiffKind.Changed}">
          <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="{x:Static changes:PreviewDiffKind.Unchanged}">
          <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!--
      Footer. "Execute" is an action button: while the execution it started runs, the same button is its Cancel (it
      keeps the keyboard focus), then "Stopping…" until the execution ended. The summary of the plan and the progress
      are said in the status line.
    -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <c:ActionButton x:Name="ExecuteButton"
                        CancelCommand="{Binding Status.CancelCommand, Mode=OneWay}"
                        Command="{Binding ExecuteCommand}"
                        Content="{l:Tr PlanPreview.Execute}"
                        IsCancelling="{Binding Status.IsCancelling, Mode=OneWay}"
                        IsDefault="True"
                        IsRunning="{Binding IsExecutingStep, Mode=OneWay}"
                        Style="{StaticResource Ad.AccentDialogActionButton}"
                        Visibility="{Binding IsExecuteStep, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="UndoButton"
                Command="{Binding UndoCommand}"
                Content="{l:Tr PlanPreview.Undo}"
                Style="{StaticResource Ad.DialogButton}"
                Visibility="{Binding IsResultsStep, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="CloseButton"
                Command="{Binding CloseCommand}"
                Content="{l:Tr PlanPreview.Close}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <!-- Header: the title of the change -->
    <TextBlock x:Name="TitleText"
               Margin="16,12,16,0"
               DockPanel.Dock="Top"
               Style="{StaticResource Ad.Title}"
               Text="{Binding ChangeTitle, Mode=OneWay}"
               TextTrimming="CharacterEllipsis" />

    <!--
      Status line (design note 6.1): the summary of the plan shown, the running execution, how it ended - and that the
      session of this window ended. Always present, so nothing under it moves.
    -->
    <c:StatusLine x:Name="PageStatus"
                  Margin="8,8,8,0"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  DockPanel.Dock="Top"
                  Status="{Binding Status.Current, Mode=OneWay}" />

    <DockPanel Margin="16,8,16,8">
      <ItemsControl x:Name="NotesList"
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Focusable="False"
                    ItemsSource="{Binding Notes, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,4" Padding="12,6" Style="{StaticResource Ad.Card}">
              <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- A note: what the plan shown is, while it waits to be executed. -->
      <ContentControl x:Name="RollbackNote"
                      Margin="0,0,0,6"
                      DockPanel.Dock="Top"
                      Style="{StaticResource Ad.Note.Attention}"
                      Visibility="{Binding IsRollbackNoteShown, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <TextBlock x:Name="RollbackNoteText"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{l:Tr PlanPreview.RollbackShown}"
                   TextWrapping="Wrap" />
      </ContentControl>

      <TabControl x:Name="PreviewTabs">
        <TabItem x:Name="ChangesTab" Header="{l:Tr PlanPreview.Changes}">
          <Grid Margin="0,6,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="2*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="90" />
            </Grid.RowDefinitions>

            <!-- "Zmiany ustawień": what an editor's save changes, in its language -->
            <Expander x:Name="SettingChangesExpander"
                      Margin="0,0,0,8"
                      Header="{Binding SettingChangesTitle, Mode=OneWay}"
                      IsExpanded="{Binding AreSettingChangesExpanded, Mode=OneTime}"
                      Visibility="{Binding HasSettingChanges, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
              <ListView x:Name="SettingChangesList"
                        MaxHeight="220"
                        Margin="0,4,0,0"
                        AutomationProperties.Name="{Binding SettingChangesTitle, Mode=OneWay}"
                        ItemContainerStyle="{StaticResource SettingChangeRowStyle}"
                        ItemsSource="{Binding SettingChanges, Mode=OneTime}">
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="240" Header="{l:Tr GpEditing.ColumnArea}">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate DataType="{x:Type changes:GroupPolicySettingChange}">
                            <TextBlock Text="{Binding Group, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Group, Mode=OneWay}" />
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                    <GridViewColumn Width="280" Header="{l:Tr AdmTemplates.ColumnSetting}">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate DataType="{x:Type changes:GroupPolicySettingChange}">
                            <TextBlock Text="{Binding Setting, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Setting, Mode=OneWay}" />
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                    <GridViewColumn Width="220" Header="{l:Tr Batch.Before}">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate DataType="{x:Type changes:GroupPolicySettingChange}">
                            <TextBlock Text="{Binding Before, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Before, Mode=OneWay}" />
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                    <GridViewColumn Width="220" Header="{l:Tr Batch.After}">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate DataType="{x:Type changes:GroupPolicySettingChange}">
                            <TextBlock Text="{Binding After, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding After, Mode=OneWay}" />
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
            </Expander>

            <ListView x:Name="RowsList"
                      Grid.Row="1"
                      AutomationProperties.Name="{l:Tr PlanPreview.Changes}"
                      ItemContainerStyle="{StaticResource PreviewRowStyle}"
                      ItemsSource="{Binding Rows, Mode=OneWay}"
                      SelectedItem="{Binding SelectedRow}"
                      SelectionMode="Single">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="34">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type batch:PreviewRowViewModel}">
                        <TextBlock x:Name="SeverityGlyph"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Style="{StaticResource Ad.GlyphText}"
                                   Text="{Binding Severity, Mode=OneWay, Converter={StaticResource RowSeverityGlyph}}"
                                   ToolTip="{Binding IssueText, Mode=OneWay}"
                                   ToolTipService.IsEnabled="{Binding IssueText, Mode=OneWay, Converter={StaticResource NotEmpty}}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static batch:RowSeverity.Warning}">
                            <Setter TargetName="SeverityGlyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static batch:RowSeverity.Error}">
                            <Setter TargetName="SeverityGlyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="210" Header="{l:Tr PlanPreview.Object}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type batch:PreviewRowViewModel}">
                        <TextBlock x:Name="NameText"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Dn, Mode=OneWay}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsFirstOfObject, Mode=OneWay}" Value="True">
                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="170" DisplayMemberBinding="{Binding Action, Mode=OneWay}" Header="{l:Tr Batch.Action}" />
                  <GridViewColumn Width="230" Header="{l:Tr PlanPreview.Item}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type batch:PreviewRowViewModel}">
                        <TextBlock Text="{Binding Attribute, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Attribute, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="170" Header="{l:Tr Batch.Before}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type batch:PreviewRowViewModel}">
                        <TextBlock Text="{Binding Before, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Before, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="170" Header="{l:Tr Batch.After}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type batch:PreviewRowViewModel}">
                        <TextBlock Text="{Binding After, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding After, Mode=OneWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock x:Name="DiffHeaderText"
                       Grid.Row="2"
                       Margin="0,8,0,4"
                       Style="{StaticResource Ad.SectionHeader}"
                       Text="{Binding DiffHeader, Mode=OneWay}" />
            <ListBox x:Name="DiffList"
                     Grid.Row="3"
                     AutomationProperties.Name="{l:Tr PlanPreview.Diff}"
                     ItemTemplate="{StaticResource DiffLineTemplate}"
                     ItemsSource="{Binding DiffLines, Mode=OneWay}"
                     VirtualizingPanel.IsVirtualizing="True" />
          </Grid>
        </TabItem>
        <TabItem x:Name="PowerShellTab" Header="{l:Tr PlanPreview.PowerShell}">
          <DockPanel Margin="0,6,0,0">
            <Button x:Name="CopyPowerShellButton"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Right"
                    Command="{Binding CopyPowerShellCommand}"
                    Content="{l:Tr PlanPreview.CopyPowerShell}"
                    DockPanel.Dock="Top" />
            <TextBox x:Name="PowerShellBox"
                     AutomationProperties.Name="{l:Tr PlanPreview.PowerShell}"
                     FontFamily="Consolas"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     Text="{Binding PowerShellScript, Mode=OneWay}"
                     VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </TabItem>
        <TabItem x:Name="ResultsTab"
                 Header="{l:Tr PlanPreview.Results}"
                 Visibility="{Binding IsResultsStep, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
          <ListView x:Name="ResultsList"
                    Margin="0,6,0,0"
                    AutomationProperties.Name="{l:Tr PlanPreview.Results}"
                    ItemsSource="{Binding ResultRows, Mode=OneWay}">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Width="260" DisplayMemberBinding="{Binding Name, Mode=OneWay}" Header="{l:Tr PlanPreview.Object}" />
                <GridViewColumn Width="160" DisplayMemberBinding="{Binding StatusText, Mode=OneWay}" Header="{l:Tr GroupPolicy.ColumnResult}" />
                <GridViewColumn Width="560" Header="{l:Tr GroupPolicy.ColumnDescription}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type batch:ResultRowViewModel}">
                      <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</Window>
