<!--
  Saved filters (SavedFiltersViewModel, modeless, one window, README U4): the operator's filters of the filter builder -
  new, edit (double click), delete, export and import as JSON for the team (text only). They are used as chips of the
  object lists, as the extra filter of the account review and as "mark as privileged" rules.
-->
<Window x:Class="AdMng.App.Views.SavedFiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="900"
        Height="480"
        MinWidth="600"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <c:BindingProxy x:Key="FiltersProxy" Data="{Binding}" />

    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="FilterRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnFilterDoubleClick" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <Button x:Name="CloseButton"
              HorizontalAlignment="Right"
              Command="{Binding CloseCommand}"
              Content="{l:Tr Common.Close}"
              IsCancel="True"
              Style="{StaticResource Ad.DialogButton}" />
    </Border>

    <WrapPanel Margin="16,12,16,8" DockPanel.Dock="Top">
      <Button x:Name="NewButton"
              Command="{Binding NewCommand}"
              Content="{l:Tr Filters.New}"
              Style="{StaticResource ToolButton}" />
      <Button x:Name="EditButton"
              Command="{Binding EditCommand}"
              Content="{l:Tr Common.Edit}"
              Style="{StaticResource ToolButton}" />
      <Button x:Name="DeleteButton"
              Command="{Binding DeleteCommand}"
              Content="{l:Tr Common.Delete}"
              Style="{StaticResource ToolButton}" />
      <Button x:Name="ExportButton"
              Margin="18,0,6,0"
              Command="{Binding ExportCommand}"
              Content="{l:Tr Filters.Export}"
              Style="{StaticResource ToolButton}" />
      <Button x:Name="ImportButton"
              Command="{Binding ImportCommand}"
              Content="{l:Tr Filters.Import}"
              Style="{StaticResource ToolButton}" />
    </WrapPanel>

    <Grid Margin="16,0,16,12">
      <ListView x:Name="FiltersList"
                AutomationProperties.Name="{Binding WindowTitle, Mode=OneWay}"
                ItemContainerStyle="{StaticResource FilterRowStyle}"
                ItemsSource="{Binding Items, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem}"
                SelectionMode="Single">
        <ListView.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding Data.EditCommand, Source={StaticResource FiltersProxy}}" />
          <KeyBinding Key="Delete" Command="{Binding Data.DeleteCommand, Source={StaticResource FiltersProxy}}" />
        </ListView.InputBindings>
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Width="220"
                            DisplayMemberBinding="{Binding Name, Mode=OneWay}"
                            Header="{l:Tr Common.Name}" />
            <GridViewColumn Width="240"
                            DisplayMemberBinding="{Binding Description, Mode=OneWay}"
                            Header="{l:Tr Common.Description}" />
            <GridViewColumn Width="380"
                            DisplayMemberBinding="{Binding Summary, Mode=OneWay}"
                            Header="{l:Tr Filters.Conditions}" />
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock x:Name="EmptyHint"
                 MaxWidth="460"
                 Margin="0,60,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr Filters.Empty}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</Window>
