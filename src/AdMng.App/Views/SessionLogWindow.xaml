<!-- Session log (SessionLogViewModel): every change made in this session, live, filterable, exportable on request. -->
<Window x:Class="AdMng.App.Views.SessionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:conv="clr-namespace:AdMng.App.Converters"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:dialogs="clr-namespace:AdMng.Presentation.Dialogs;assembly=AdMng.Presentation"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1140"
        Height="640"
        MinWidth="720"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- Commands for the context menu and key bindings, independent of their DataContext. -->
    <c:BindingProxy x:Key="LogProxy" Data="{Binding}" />

    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <conv:SucceededToGlyphConverter x:Key="SucceededGlyph" />
    <conv:NotEmptyToBooleanConverter x:Key="NotEmpty" />

    <Style x:Key="EntryRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnEntryDoubleClick" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ExportButton"
                  Command="{Binding ExportCommand}"
                  Content="{l:Tr Commands.ExportList}"
                  Style="{StaticResource Ad.DialogButton}" />
          <Button x:Name="CloseButton"
                  Command="{Binding CloseCommand}"
                  Content="{l:Tr Common.Close}"
                  IsCancel="True"
                  Style="{StaticResource Ad.DialogButton}" />
        </StackPanel>
        <TextBlock x:Name="CountText"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{Binding CountText, Mode=OneWay}" />
      </DockPanel>
    </Border>

    <!-- The directory session this window was opened in ended: reopen the window to work in the current one. -->
    <Border Margin="16,12,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding SessionEndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock AutomationProperties.LiveSetting="Assertive"
                 Text="{Binding SessionEndedMessage, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Border>

    <DockPanel Margin="16,12,16,8" DockPanel.Dock="Top">
      <CheckBox x:Name="FailuresOnlyBox"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Content="{l:Tr SessionLog.FailuresOnly}"
                DockPanel.Dock="Right"
                IsChecked="{Binding ShowFailuresOnly}" />
      <Grid>
        <TextBox x:Name="FilterBox"
                 AutomationProperties.Name="{l:Tr Common.Filter}"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
        <TextBlock Style="{StaticResource Ad.HintText}"
                   Text="{l:Tr ToolsUi.LogFilterHint}"
                   Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource Ad.EmptyToVisible}}" />
      </Grid>
    </DockPanel>

    <Grid Margin="16,0,16,12">
      <ListView x:Name="EntriesList"
                AutomationProperties.Name="{Binding WindowTitle, Mode=OneWay}"
                ItemContainerStyle="{StaticResource EntryRowStyle}"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Single"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding Data.OpenCommand, Source={StaticResource LogProxy}}" />
          <KeyBinding Key="C"
                      Command="{Binding Data.CopyDnCommand, Source={StaticResource LogProxy}}"
                      Modifiers="Control" />
        </ListView.InputBindings>
        <ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Command="{Binding Data.OpenCommand, Source={StaticResource LogProxy}}"
                      FontWeight="SemiBold"
                      Header="{l:Tr Commands.Properties}"
                      InputGestureText="Enter" />
            <MenuItem Command="{Binding Data.CopyDnCommand, Source={StaticResource LogProxy}}"
                      Header="{l:Tr Commands.CopyDn}"
                      InputGestureText="Ctrl+C" />
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Width="34">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dialogs:AuditEntryViewModel}">
                  <TextBlock x:Name="ResultGlyph"
                             FontSize="13"
                             Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                             Style="{StaticResource Ad.GlyphText}"
                             Text="{Binding Succeeded, Mode=OneWay, Converter={StaticResource SucceededGlyph}}"
                             ToolTip="{Binding ResultText, Mode=OneWay}" />
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Succeeded, Mode=OneWay}" Value="False">
                      <Setter TargetName="ResultGlyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="150"
                            DisplayMemberBinding="{Binding Timestamp, Mode=OneWay}"
                            Header="{l:Tr ToolsUi.Time}" />
            <GridViewColumn Width="200" Header="{l:Tr BatchUi.Object}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dialogs:AuditEntryViewModel}">
                  <TextBlock Text="{Binding Name, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Dn, Mode=OneWay}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="130"
                            DisplayMemberBinding="{Binding Action, Mode=OneWay}"
                            Header="{l:Tr Batch.Action}" />
            <GridViewColumn Width="150"
                            DisplayMemberBinding="{Binding Attribute, Mode=OneWay}"
                            Header="{l:Tr Labels.Attribute}" />
            <GridViewColumn Width="170" Header="{l:Tr Batch.Before}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dialogs:AuditEntryViewModel}">
                  <TextBlock Text="{Binding OldValue, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding OldValue, Mode=OneWay}"
                             ToolTipService.IsEnabled="{Binding OldValue, Mode=OneWay, Converter={StaticResource NotEmpty}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="170" Header="{l:Tr Batch.After}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dialogs:AuditEntryViewModel}">
                  <TextBlock Text="{Binding NewValue, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding NewValue, Mode=OneWay}"
                             ToolTipService.IsEnabled="{Binding NewValue, Mode=OneWay, Converter={StaticResource NotEmpty}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="160"
                            DisplayMemberBinding="{Binding Operator, Mode=OneWay}"
                            Header="{l:Tr ToolsUi.Operator}" />
            <GridViewColumn Width="150"
                            DisplayMemberBinding="{Binding Server, Mode=OneWay}"
                            Header="{l:Tr ToolsUi.Server}" />
            <GridViewColumn Width="260" Header="{l:Tr Common.Error}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dialogs:AuditEntryViewModel}">
                  <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                             Text="{Binding Error, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Error, Mode=OneWay}"
                             ToolTipService.IsEnabled="{Binding Error, Mode=OneWay, Converter={StaticResource NotEmpty}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock Margin="0,60,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr ToolsUi.LogEmpty}"
                 Visibility="{Binding Entries.Count, Mode=OneWay, Converter={StaticResource Ad.EmptyToVisible}}" />
    </Grid>
  </DockPanel>
</Window>
