<!--
  ADUC "Select Users, Contacts, Computers, or Groups" (modal): object types, location, names resolved with Check Names
  (';'-separated, ambiguous names listed below), Find Now and the chosen objects returned by OK.
  Feedback (design note 6.7 and "V2b-2 as built"): one status line at the top - the search of Find Now and the check of
  the names (each with Stop), how many objects the list shows, which names were not resolved, why a search failed, and
  that the session of the dialog ended.
-->
<Window x:Class="AdMng.App.Views.ObjectPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:dlg="clr-namespace:AdMng.Presentation.Dialogs;assembly=AdMng.Presentation"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="720"
        Height="676"
        MinWidth="540"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>

    <!-- The view model, for the remove buttons of the chosen objects. -->
    <c:BindingProxy x:Key="DialogProxy" Data="{Binding}" />

    <Style x:Key="ResultRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnResultDoubleClick" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="OkButton"
                Command="{Binding OkCommand}"
                Content="{l:Tr Common.Ok}"
                IsDefault="True"
                Style="{StaticResource Ad.AccentDialogButton}" />
        <Button Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <!--
      Status line (design note 6.1 and "V2b-2 as built", Dialogs): at the top, above the object types; declared after
      the footer, so Tab goes from the buttons to what the line offers and then to the fields. It says what the row
      under the names box said. Its picture stands over the left edge of the fields.
    -->
    <c:StatusLine x:Name="PageStatus"
                  Margin="12,8,12,0"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  DockPanel.Dock="Top"
                  Status="{Binding Status.Current, Mode=OneWay}" />

    <Grid Margin="20,8,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Object types -->
      <StackPanel>
        <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr Picker.ObjectTypes}" />
        <ItemsControl Focusable="False" ItemsSource="{Binding ObjectTypes, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type dlg:ObjectTypeOption}">
              <CheckBox Margin="0,0,16,4"
                        Content="{Binding Text, Mode=OneWay}"
                        IsChecked="{Binding IsChecked}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Location -->
      <StackPanel Grid.Row="1" Margin="0,8,0,0">
        <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr Picker.Location}" />
        <DockPanel>
          <Button Margin="6,0,0,0"
                  Command="{Binding BrowseLocationCommand}"
                  Content="{l:Tr Common.Browse}"
                  DockPanel.Dock="Right" />
          <TextBox x:Name="LocationBox"
                   AutomationProperties.Name="{l:Tr Picker.Location}"
                   IsReadOnly="True"
                   Text="{Binding LocationText, Mode=OneWay}" />
        </DockPanel>
      </StackPanel>

      <!-- Names -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr Picker.EnterNames}" />
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="CheckNamesButton"
                    Margin="6,0,0,0"
                    Command="{Binding CheckNamesCommand}"
                    Content="{l:Tr Picker.CheckNames}" />
            <Button x:Name="FindNowButton"
                    Margin="6,0,0,0"
                    Command="{Binding FindNowCommand}"
                    Content="{l:Tr Find.FindNow}" />
          </StackPanel>
          <TextBox x:Name="SearchBox"
                   AutomationProperties.Name="{l:Tr Picker.EnterNames}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
      </StackPanel>

      <!-- Chosen objects (returned by OK) -->
      <StackPanel Grid.Row="3"
                  Margin="0,10,0,0"
                  Visibility="{Binding Chosen.Count, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
        <TextBlock Style="{StaticResource Ad.SectionHeader}" Text="{l:Tr ObjectDialogs.SelectedObjects}" />
        <ItemsControl Focusable="False" ItemsSource="{Binding Chosen, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
              <Border Margin="0,0,6,6"
                      Padding="8,2,2,2"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="12"
                      ToolTip="{Binding Dn, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <c:ObjectIconView Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Icon="{Binding Icon, Mode=OneWay}"
                                    Size="16" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}" />
                  <Button Margin="4,0,0,0"
                          AutomationProperties.Name="{l:Tr Common.Remove}"
                          Command="{Binding Data.RemoveChosenCommand, Source={StaticResource DialogProxy}}"
                          CommandParameter="{Binding Mode=OneWay}"
                          Content="{x:Static c:Glyphs.Close}"
                          Style="{StaticResource Ad.SmallIconButton}"
                          ToolTip="{l:Tr Common.Remove}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Search results / matches of an ambiguous name -->
      <DockPanel Grid.Row="4" Margin="0,10,0,4">
        <Button Command="{Binding AddSelectedCommand}"
                Content="{l:Tr Common.Add}"
                DockPanel.Dock="Right" />
        <TextBlock VerticalAlignment="Center"
                   Style="{StaticResource Ad.SectionHeader}"
                   Text="{l:Tr ObjectDialogs.SearchResults}" />
      </DockPanel>
      <ListView x:Name="ResultsList"
                Grid.Row="5"
                AutomationProperties.Name="{l:Tr ObjectDialogs.SearchResults}"
                ItemContainerStyle="{StaticResource ResultRow}"
                ItemsSource="{Binding Results, Mode=OneWay}"
                SelectedItem="{Binding SelectedResult}"
                SelectionChanged="OnResultsSelectionChanged"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Width="200" Header="{l:Tr Common.Name}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
                  <DockPanel>
                    <c:ObjectIconView Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      DockPanel.Dock="Left"
                                      Icon="{Binding Icon, Mode=OneWay}"
                                      Size="16" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Name, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="130" Header="{l:Tr Columns.Type}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
                  <TextBlock Text="{Binding TypeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="170" Header="{l:Tr Attribute.mail}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
                  <TextBlock Text="{Binding Mail, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="200" Header="{l:Tr Labels.Folder}">
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type dlg:DirectoryItem}">
                  <TextBlock Text="{Binding Path, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
  </DockPanel>
</Window>
