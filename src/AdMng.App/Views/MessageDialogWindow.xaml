<Window x:Class="AdMng.App.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        Title="{Binding Title, Mode=OneTime}"
        MinWidth="380"
        MaxWidth="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="ConfirmButton"
                AutomationProperties.Name="{Binding ConfirmText, Mode=OneTime}"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText, Mode=OneTime}"
                Style="{StaticResource Ad.DialogButton}" />
        <Button x:Name="CancelButton"
                AutomationProperties.Name="{Binding CancelText, Mode=OneTime}"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText, Mode=OneTime}"
                Style="{StaticResource Ad.DialogButton}"
                Visibility="{Binding HasCancel, Mode=OneTime, Converter={StaticResource Ad.BoolToVisibility}}" />
      </StackPanel>
    </Border>

    <Grid Margin="24,20,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="KindGlyph"
                 Grid.RowSpan="2"
                 Margin="0,2,16,0"
                 VerticalAlignment="Top"
                 FontSize="28"
                 Style="{StaticResource Ad.GlyphText}"
                 Text="{Binding Glyph, Mode=OneTime}" />

      <TextBlock x:Name="MessageText"
                 Grid.Column="1"
                 MaxWidth="520"
                 Text="{Binding Message, Mode=OneTime}"
                 TextWrapping="Wrap" />

      <TextBox x:Name="TypedInput"
               Grid.Row="1"
               Grid.Column="1"
               Margin="0,12,0,0"
               AutomationProperties.Name="{l:Tr Ui.ConfirmationText}"
               Text="{Binding TypedText, UpdateSourceTrigger=PropertyChanged}"
               Visibility="{Binding RequiresTypedConfirmation, Mode=OneTime, Converter={StaticResource Ad.BoolToVisibility}}" />
    </Grid>
  </DockPanel>
</Window>
