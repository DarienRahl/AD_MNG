<!--
  ADUC "Browse for Container" (modal): the domain tree with lazily loaded containers.
  Feedback (design note 6.7 and "V2b-2 as built"): one status line at the top - the read of the tree when the dialog
  opens, that the dialog has no session, or that the selected container could not be read. A container that is being
  read, or could not be read, is marked in its own row as well (the progress and the state of a row stay in the row).
-->
<Window x:Class="AdMng.App.Views.ContainerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:nav="clr-namespace:AdMng.Presentation.Navigation;assembly=AdMng.Presentation"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="460"
        Height="596"
        MinWidth="360"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type nav:ContainerNodeViewModel}" ItemsSource="{Binding Children, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding Description, Mode=OneWay}">
        <c:ObjectIconView Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Icon="{Binding Icon, Mode=OneWay}"
                          Size="16" />
        <TextBlock VerticalAlignment="Center" Text="{Binding Name, Mode=OneWay}" />
        <TextBlock Margin="6,0,0,0"
                   FontSize="10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Refresh}"
                   Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <TextBlock Margin="6,0,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Style="{StaticResource Ad.GlyphText}"
                   Text="{x:Static c:Glyphs.Error}"
                   ToolTip="{Binding LoadError, Mode=OneWay}"
                   Visibility="{Binding LoadError, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      </StackPanel>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type nav:PlaceholderNodeViewModel}">
      <TextBlock FontStyle="Italic"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding Name, Mode=OneWay}" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="OkButton"
                Command="{Binding OkCommand}"
                Content="{l:Tr Common.Ok}"
                IsDefault="True"
                Style="{StaticResource Ad.AccentDialogButton}" />
        <Button Command="{Binding CancelCommand}"
                Content="{l:Tr Common.Cancel}"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
      </StackPanel>
    </Border>

    <!--
      Status line (design note 6.1 and "V2b-2 as built", Dialogs): at the top, above the tree; declared after the
      footer, so Tab goes from the buttons to what the line offers and then to the tree. Its picture stands over the
      left edge of the tree.
    -->
    <c:StatusLine x:Name="PageStatus"
                  Margin="12,8,12,0"
                  CloseCommand="{Binding Status.CloseCommand, Mode=OneWay}"
                  DockPanel.Dock="Top"
                  Status="{Binding Status.Current, Mode=OneWay}" />

    <TextBlock x:Name="PromptText"
               Margin="20,8,20,6"
               DockPanel.Dock="Top"
               Text="{l:Tr Ui.PickContainer}"
               TextWrapping="Wrap" />
    <TextBlock x:Name="SelectedPathText"
               Margin="20,6,20,10"
               DockPanel.Dock="Bottom"
               Style="{StaticResource Ad.SecondaryText}"
               Text="{Binding SelectedPath, Mode=OneWay}"
               TextWrapping="Wrap" />

    <TreeView x:Name="ContainerTree"
              Margin="20,0,20,0"
              AutomationProperties.Name="{l:Tr Ui.PickContainer}"
              ItemsSource="{Binding Roots, Mode=OneWay}">
      <TreeView.Resources>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
          <Setter Property="Margin" Value="0" />
          <Setter Property="Padding" Value="2" />
          <EventSetter Event="Selected" Handler="OnContainerSelected" />
        </Style>
      </TreeView.Resources>
    </TreeView>
  </DockPanel>
</Window>
