<!--
  Account review (AccountReviewViewModel, modeless, one window, README U2): scope, parameters and checks, one run with
  streamed results, tiles with the number of findings per check and the list of the selected check with its own columns
  (built by the code-behind from ViewModel.Columns). Every action goes through the change plan or the batch editor; the
  results exist only in memory.
-->
<Window x:Class="AdMng.App.Views.AccountReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ar="clr-namespace:AdMng.Presentation.AccountReview;assembly=AdMng.Presentation"
        xmlns:c="clr-namespace:AdMng.App.Controls"
        xmlns:l="clr-namespace:AdMng.App.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1240"
        Height="800"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- Commands for the column headers, the context menu and key bindings, independent of their DataContext. -->
    <c:BindingProxy x:Key="ReviewProxy" Data="{Binding}" />

    <sys:Double x:Key="TextControlThemeMinHeight">30</sys:Double>
    <Thickness x:Key="TextControlThemePadding">10,4,6,5</Thickness>
    <sys:Double x:Key="GridViewColumnHeaderMinHeight">28</sys:Double>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DaysBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="64" />
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="ReviewRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneWay}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
    </Style>

    <!-- The name column: icon (disabled / locked) and name; the DN as tooltip. -->
    <DataTemplate x:Key="NameCell" DataType="{x:Type ar:AccountReviewRowViewModel}">
      <DockPanel ToolTip="{Binding Dn, Mode=OneWay}">
        <c:ObjectIconView Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          DockPanel.Dock="Left"
                          Icon="{Binding Icon, Mode=OneWay}"
                          Size="16" />
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding Name, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </DataTemplate>

    <!-- A tile: area, number of findings, check; the accent follows the severity while there are findings. -->
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type ar:AccountCheckTileViewModel}">
      <Grid Width="172" Height="76" ToolTip="{Binding Hint, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Accent"
                Margin="0,4"
                Background="Transparent"
                CornerRadius="2" />
        <StackPanel Grid.Column="1" Margin="10,4,6,4">
          <TextBlock FontSize="11"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding AreaTitle, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="CountText"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Text="{Binding CountText, Mode=OneWay}" />
          <TextBlock Text="{Binding Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasFindings, Mode=OneWay}" Value="True" />
            <Condition Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static ar:AccountCheckSeverity.Critical}" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasFindings, Mode=OneWay}" Value="True" />
            <Condition Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static ar:AccountCheckSeverity.Warning}" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasFindings, Mode=OneWay}" Value="True" />
            <Condition Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static ar:AccountCheckSeverity.Info}" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Accent" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding HasFindings, Mode=OneWay}" Value="False">
          <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RunCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Footer: progress, "stan na godz.", selection, Close. -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Ad.DialogFooter}">
      <DockPanel>
        <Button x:Name="CloseButton"
                Command="{Binding CloseCommand}"
                Content="{l:Tr Common.Close}"
                DockPanel.Dock="Right"
                IsCancel="True"
                Style="{StaticResource Ad.DialogButton}" />
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ProgressBar x:Name="RunProgress"
                       Width="60"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
          <TextBlock x:Name="StatusText"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding StatusText, Mode=OneWay}" />
          <TextBlock x:Name="SelectionText"
                     Margin="16,0,0,0"
                     Style="{StaticResource Ad.SecondaryText}"
                     Text="{Binding SelectionText, Mode=OneWay}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Scope and Check / Stop. -->
    <Grid Margin="16,12,16,0" DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource Label}" Text="{l:Tr AccountReview.ScopeLabel}" />
      <ComboBox x:Name="ScopeKindBox"
                Grid.Column="1"
                MinWidth="260"
                AutomationProperties.Name="{l:Tr AccountReview.ScopeLabel}"
                DisplayMemberPath="Text"
                ItemsSource="{Binding ScopeKinds, Mode=OneWay}"
                SelectedItem="{Binding ScopeKind}" />
      <DockPanel Grid.Column="2" Margin="12,0,12,0">
        <Button x:Name="ChooseScopeButton"
                Command="{Binding BrowseScopeCommand}"
                Content="{l:Tr AccountReview.ChooseScope}"
                DockPanel.Dock="Right"
                Visibility="{Binding NeedsScopeTarget, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <ComboBox x:Name="SavedViewBox"
                  MinWidth="220"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="{l:Tr AccountReview.SavedViewLabel}"
                  DisplayMemberPath="Text"
                  ItemsSource="{Binding SavedViews, Mode=OneWay}"
                  SelectedItem="{Binding SavedView}"
                  Visibility="{Binding IsViewScope, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <TextBlock x:Name="ScopeText"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Text="{Binding ScopeText, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ScopeDn, Mode=OneWay}"
                   Visibility="{Binding IsViewScope, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
      </DockPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button x:Name="StopButton"
                Margin="0,0,8,0"
                Command="{Binding StopCommand}"
                Content="{l:Tr Common.Stop}"
                Style="{StaticResource Ad.CollapsedWhenDisabledButton}" />
        <Button x:Name="RunButton"
                MinWidth="120"
                Command="{Binding RunCommand}"
                Content="{l:Tr AccountReview.Run}"
                Style="{StaticResource Ad.AccentDialogButton}" />
      </StackPanel>
    </Grid>

    <!-- Parameters, checks and named check sets. -->
    <Expander x:Name="ParametersExpander"
              Margin="16,10,16,0"
              DockPanel.Dock="Top"
              Header="{l:Tr AccountReview.Parameters}"
              IsExpanded="True">
      <StackPanel Margin="0,8,0,0">
        <WrapPanel>
          <TextBlock Style="{StaticResource Label}" Text="{l:Tr AccountReview.PasswordExpiringDays}" />
          <TextBox x:Name="PasswordExpiringDaysBox"
                   AutomationProperties.Name="{l:Tr AccountReview.PasswordExpiringDays}"
                   Style="{StaticResource DaysBox}"
                   Text="{Binding PasswordExpiringDays, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Label}" Text="{l:Tr AccountReview.AccountExpiringDays}" />
          <TextBox AutomationProperties.Name="{l:Tr AccountReview.AccountExpiringDays}"
                   Style="{StaticResource DaysBox}"
                   Text="{Binding AccountExpiringDays, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Label}" Text="{l:Tr AccountReview.InactiveDays}" />
          <TextBox AutomationProperties.Name="{l:Tr AccountReview.InactiveDays}"
                   Style="{StaticResource DaysBox}"
                   Text="{Binding InactiveDays, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Label}" Text="{l:Tr AccountReview.PasswordAgeDays}" />
          <TextBox AutomationProperties.Name="{l:Tr AccountReview.PasswordAgeDays}"
                   Style="{StaticResource DaysBox}"
                   Text="{Binding PasswordAgeDays, UpdateSourceTrigger=PropertyChanged}" />
        </WrapPanel>
        <TextBlock Margin="0,10,0,4"
                   Style="{StaticResource Ad.SecondaryText}"
                   Text="{l:Tr AccountReview.Checks}" />
        <ItemsControl x:Name="CheckOptionsList" Focusable="False" ItemsSource="{Binding CheckOptions, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type ar:AccountCheckOptionViewModel}">
              <CheckBox Width="236"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                        Content="{Binding Title, Mode=OneWay}"
                        IsChecked="{Binding IsEnabled}"
                        ToolTip="{Binding AreaTitle, Mode=OneWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,8,0,0">
          <TextBlock Style="{StaticResource Label}" Text="{l:Tr AccountReview.CheckSet}" />
          <ComboBox x:Name="CheckSetBox"
                    MinWidth="220"
                    AutomationProperties.Name="{l:Tr AccountReview.CheckSet}"
                    DisplayMemberPath="Text"
                    ItemsSource="{Binding CheckSets, Mode=OneWay}"
                    SelectedItem="{Binding SelectedCheckSet}" />
          <Button Margin="6,0,0,0"
                  Command="{Binding DeleteCheckSetCommand}"
                  Content="{x:Static c:Glyphs.Delete}"
                  AutomationProperties.Name="{l:Tr AccountReview.DeleteCheckSet}"
                  Style="{StaticResource Ad.IconButton}"
                  ToolTip="{l:Tr AccountReview.DeleteCheckSet}" />
          <TextBox x:Name="CheckSetNameBox"
                   MinWidth="220"
                   Margin="18,0,6,0"
                   AutomationProperties.Name="{l:Tr AccountReview.CheckSetName}"
                   Text="{Binding CheckSetName, UpdateSourceTrigger=PropertyChanged}" />
          <Button x:Name="SaveCheckSetButton"
                  HorizontalAlignment="Left"
                  Command="{Binding SaveCheckSetCommand}"
                  Content="{l:Tr AccountReview.SaveCheckSet}" />
        </DockPanel>
      </StackPanel>
    </Expander>

    <!-- Session ended (the window belongs to the previous session) or the run failed. -->
    <Border x:Name="SessionEndedBar"
            Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.WarningBar}"
            Visibility="{Binding SessionEndedMessage, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock Text="{Binding SessionEndedMessage, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>
    <Border x:Name="ErrorBar"
            Margin="16,10,16,0"
            DockPanel.Dock="Top"
            Style="{StaticResource Ad.ErrorBar}"
            Visibility="{Binding Error, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}">
      <TextBlock x:Name="ErrorText"
                 AutomationProperties.LiveSetting="Assertive"
                 Text="{Binding Error, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Tiles: one per check of the run; the selected one shows its list. -->
    <ListBox x:Name="TilesList"
             MaxHeight="190"
             Margin="16,10,16,0"
             AutomationProperties.Name="{l:Tr AccountReview.Checks}"
             DockPanel.Dock="Top"
             ItemTemplate="{StaticResource TileTemplate}"
             ItemsSource="{Binding Tiles, Mode=OneWay}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectedItem="{Binding SelectedTile}"
             Visibility="{Binding HasRun, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneWay}" />
          <Setter Property="Margin" Value="0,0,6,6" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>

    <!-- The list of the selected check with its actions. -->
    <Grid Margin="16,10,16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <WrapPanel x:Name="ActionsPanel" Visibility="{Binding HasRun, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}">
        <Button x:Name="PropertiesButton"
                Command="{Binding OpenCommand}"
                Content="{l:Tr Commands.Properties}"
                Style="{StaticResource ActionButton}" />
        <Button x:Name="BatchEditButton"
                Command="{Binding BatchEditCommand}"
                Content="{l:Tr Commands.BatchEdit}"
                Style="{StaticResource ActionButton}" />
        <Button x:Name="ExportButton"
                Command="{Binding ExportCsvCommand}"
                Content="{l:Tr AccountReview.ExportCsv}"
                Style="{StaticResource ActionButton}" />
        <Button x:Name="UnlockButton"
                Command="{Binding UnlockCommand}"
                Content="{l:Tr Commands.Unlock}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowUnlock, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="RequirePasswordChangeButton"
                Command="{Binding RequirePasswordChangeCommand}"
                Content="{l:Tr AccountReview.RequirePasswordChange}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowRequirePasswordChange, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="ExtendButton"
                Command="{Binding ExtendCommand}"
                Content="{l:Tr AccountReview.Extend}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowExtend, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="DisableButton"
                Command="{Binding DisableCommand}"
                Content="{l:Tr Commands.Disable}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowDisable, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="ExactLastLogonButton"
                Command="{Binding ReadExactLastLogonCommand}"
                Content="{l:Tr AccountReview.ExactLastLogon}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowExactLastLogon, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="ClearFlagButton"
                Command="{Binding ClearFlagCommand}"
                Content="{l:Tr AccountReview.ClearFlag}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowClearFlag, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="RemoveFromGroupsButton"
                Command="{Binding RemoveFromGroupsCommand}"
                Content="{l:Tr AccountReview.RemoveFromGroups}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowRemoveFromGroups, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <Button x:Name="HideFromGalButton"
                Command="{Binding HideFromGalCommand}"
                Content="{l:Tr AccountReview.HideFromGal}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding ShowHideFromGal, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
        <!-- U1 hook: hidden until path U1 registers a message launcher. -->
        <Button x:Name="SendMessageButton"
                Command="{Binding SendMessageCommand}"
                Content="{l:Tr AccountReview.SendMessage}"
                Style="{StaticResource ActionButton}"
                Visibility="{Binding CanSendMessages, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      </WrapPanel>
      <TextBlock x:Name="ListHintText"
                 Grid.Row="1"
                 Margin="0,0,0,6"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{Binding ListHint, Mode=OneWay}"
                 TextWrapping="Wrap"
                 Visibility="{Binding ListHint, Mode=OneWay, Converter={StaticResource Ad.EmptyToCollapsed}}" />
      <ListView x:Name="ItemsList"
                Grid.Row="2"
                AutomationProperties.Name="{Binding WindowTitle, Mode=OneWay}"
                ItemContainerStyle="{StaticResource ReviewRowStyle}"
                ItemsSource="{Binding Items, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem}"
                SelectionChanged="OnItemsSelectionChanged"
                SelectionMode="Extended"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding Data.OpenCommand, Source={StaticResource ReviewProxy}}" />
        </ListView.InputBindings>
        <ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Command="{Binding Data.OpenCommand, Source={StaticResource ReviewProxy}}"
                      FontWeight="SemiBold"
                      Header="{l:Tr Commands.Properties}"
                      InputGestureText="Enter" />
            <MenuItem Command="{Binding Data.BatchEditCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr Commands.BatchEdit}" />
            <MenuItem Command="{Binding Data.ExportCsvCommand, Source={StaticResource ReviewProxy}}" Header="{l:Tr AccountReview.ExportCsv}" />
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
          <GridView x:Name="ItemsGrid" AllowsColumnReorder="False" />
        </ListView.View>
      </ListView>
      <ProgressBar Grid.Row="2"
                   Height="3"
                   VerticalAlignment="Top"
                   IsIndeterminate="True"
                   Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <TextBlock x:Name="EmptyHint"
                 Grid.Row="2"
                 Margin="0,60,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr AccountReview.Empty}"
                 Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource Ad.BoolToVisibility}}" />
      <TextBlock x:Name="NotRunHint"
                 Grid.Row="2"
                 MaxWidth="520"
                 Margin="0,60,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Style="{StaticResource Ad.SecondaryText}"
                 Text="{l:Tr AccountReview.NotRun}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasRun, Mode=OneWay, Converter={StaticResource Ad.InverseBoolToVisibility}}" />
    </Grid>
  </DockPanel>
</Window>
