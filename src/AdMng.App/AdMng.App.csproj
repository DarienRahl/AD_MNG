<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell (Windows 11 Fluent theme). Views, DI host and Windows-specific services only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AdMng.App</RootNamespace>
    <AssemblyName>AdMng</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdMng.Core\AdMng.Core.csproj" />
    <ProjectReference Include="..\AdMng.Directory\AdMng.Directory.csproj" />
    <ProjectReference Include="..\AdMng.Presentation\AdMng.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AdMng.App.UiTests" />
  </ItemGroup>
</Project>
