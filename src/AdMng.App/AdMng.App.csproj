<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell (Windows 11 Fluent theme). Views, DI host and Windows-specific services only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AdMng.App</RootNamespace>
    <AssemblyName>AdMng</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sources and build script: tools/icon (SVG → multi-size ICO). -->
    <ApplicationIcon>Assets\AdMng.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdMng.Core\AdMng.Core.csproj" />
    <ProjectReference Include="..\AdMng.Directory\AdMng.Directory.csproj" />
    <ProjectReference Include="..\AdMng.Mail\AdMng.Mail.csproj" />
    <ProjectReference Include="..\AdMng.Presentation\AdMng.Presentation.csproj" />
    <ProjectReference Include="..\AdMng.Remote\AdMng.Remote.csproj" />
    <ProjectReference Include="..\AdMng.Watchdog.Client\AdMng.Watchdog.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AdMng.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AdMng.App.UiTests" />
  </ItemGroup>
</Project>
