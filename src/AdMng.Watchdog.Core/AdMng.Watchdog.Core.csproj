<Project Sdk="Microsoft.NET.Sdk">
  <!-- AdMng Watchdog engine: detection, attribution parsing/correlation, rules, notification planning, formatting.
       Pure logic against the abstractions in Abstractions/ (stores, directory session provider, event-log source,
       transports are implemented by AdMng.Watchdog.Service and by the test fakes). Persists nothing itself. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdMng.Watchdog.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdMng.Core\AdMng.Core.csproj" />
    <ProjectReference Include="..\AdMng.Watchdog.Contracts\AdMng.Watchdog.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AdMng.Watchdog.Core.Tests" />
  </ItemGroup>
</Project>
