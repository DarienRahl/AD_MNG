<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- AdMng Watchdog service host (Windows service "AdMngWatchdog", console mode for dev/lab): ASP.NET Core API, job
       hosts, SQLite store, transports. The only project that stores directory data (snapshots, events, DC log records,
       outbox) - in its own data folder, under the conditions of ADR-0008.
       Never reference packages the ASP.NET Core shared framework already supplies (Microsoft.Extensions.*,
       System.Diagnostics.EventLog, ...): .NET 10 package pruning reports them as NU1510 (an error here). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdMng.Watchdog.Service</RootNamespace>
    <AssemblyName>AdMng.Watchdog</AssemblyName>
    <!-- LibraryImport (the logon package of HTTP.sys callers, WindowsLogonPackageResolver). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdMng.Watchdog.Core\AdMng.Watchdog.Core.csproj" />
    <ProjectReference Include="..\AdMng.Directory\AdMng.Directory.csproj" />
    <ProjectReference Include="..\AdMng.Watchdog.Contracts\AdMng.Watchdog.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="MailKitLite" />
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>
  <ItemGroup>
    <!-- The install/uninstall scripts ship next to AdMng.Watchdog.exe (spec 19.6, 19.7). -->
    <None Include="Deploy\*.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AdMng.Watchdog.Service.Tests" />
    <InternalsVisibleTo Include="AdMng.Watchdog.IntegrationTests" />
  </ItemGroup>
</Project>
