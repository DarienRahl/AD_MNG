<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure domain logic: LDAP primitives, AD semantics, schema model, batch engine contracts.
       No dependency on any LDAP client library so that it is fully unit-testable on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdMng.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- U1c: the HTML5 parser of MessageHtmlSanitizer (pure parser, no network or LDAP code). -->
    <PackageReference Include="AngleSharp" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AdMng.Core.Tests" />
  </ItemGroup>
</Project>
