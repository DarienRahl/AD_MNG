# Runs only when admng-watchdog.service enters "failed" (a RestartPreventExitStatus= exit: the start-up check needs a
# human). Logs at priority crit; the best-effort notification through the health channels ("notify-failure") follows
# in a later milestone (docs/dev/watchdog-linux-design.md 12.1).
[Unit]
Description=AdMng Watchdog - report that admng-watchdog.service has stopped
Documentation=file:/usr/share/doc/admng-watchdog/README.Debian

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-cat --identifier=admng-watchdog --priority=crit /usr/bin/echo "AdMng Watchdog zatrzymany – sprawdź systemctl status admng-watchdog"
DynamicUser=yes
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
IPAddressDeny=any
