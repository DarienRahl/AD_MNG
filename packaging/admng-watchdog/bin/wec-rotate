#!/bin/bash
# AdMng Watchdog: rotation and clean-up of the OpenWEC output files (docs/dev/watchdog-linux-design.md 7.4, 12.4), run
# hourly as root by admng-wec-rotate.service (capabilities CAP_DAC_OVERRIDE and CAP_DAC_READ_SEARCH only):
#   1. every non-empty <out>/<client>/security.jsonl is renamed to security.jsonl.<UTC yyyyMMddTHHmmssZ> (same inode);
#   2. the unit reloads openwecd afterwards (ExecStartPost: SIGHUP – OpenWEC reopens the path on its next write);
#   3. a rotated file of an earlier run is deleted when the service's progress file lists it complete with the same
#      device, inode, first-line SHA-256 and size, and it was not written for 5 minutes;
#   4. a rotated file older than MAX_UNCONSUMED_DAYS (1–30, default 7) is deleted anyway, and the oldest ones while all
#      rotated files together exceed MAX_UNCONSUMED_MB (default 8192) – each with a warning (names only); the service
#      reports the loss;
#   5. without a readable progress file (the service is stopped) nothing counts as consumed: steps 1, 2 and 4 still run.
# It only renames and deletes regular files below the output directory; symbolic links and other names are left alone.
set -euo pipefail
umask 027

OUT=${WEC_OUT_DIR:-/var/lib/openwec/out}
PROGRESS=${WEC_PROGRESS_FILE:-/run/admng-watchdog/wec-progress.json}
NAME=security.jsonl
IDLE_SECONDS=300
NOW=${WEC_ROTATE_NOW:-$(date -u +%s)}

log() { printf '<%s>wec-rotate: %s\n' "$1" "$2"; }

days=${MAX_UNCONSUMED_DAYS:-7}
if ! [[ "$days" =~ ^[0-9]+$ ]] || [ "$days" -lt 1 ]; then
    log 4 "MAX_UNCONSUMED_DAYS=$days is not a number of days 1-30 - using 7"
    days=7
elif [ "$days" -gt 30 ]; then
    log 4 "MAX_UNCONSUMED_DAYS=$days is above the maximum of 30 (ADR-0009) - using 30"
    days=30
fi
max_mb=${MAX_UNCONSUMED_MB:-8192}
if ! [[ "$max_mb" =~ ^[0-9]+$ ]] || [ "$max_mb" -lt 64 ]; then
    log 4 "MAX_UNCONSUMED_MB=$max_mb is not a number >= 64 - using 8192"
    max_mb=8192
fi

[ -d "$OUT" ] && [ ! -L "$OUT" ] || { log 6 "$OUT does not exist - nothing to do"; exit 0; }
stamp=$(date -u -d "@$NOW" +%Y%m%dT%H%M%SZ)
declare -A rotated_now=()

# 1. Rotation.
for dir in "$OUT"/*; do
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    active="$dir/$NAME"
    if [ -f "$active" ] && [ ! -L "$active" ] && [ -s "$active" ]; then
        target="$active.$stamp"
        if [ -e "$target" ] || [ -L "$target" ]; then
            log 4 "${dir##*/}/${target##*/} exists - ${dir##*/}/$NAME not rotated this time"
            continue
        fi
        mv -T -n -- "$active" "$target"
        rotated_now["$target"]=1
    fi
done

# 3. Files the service confirmed (device:inode:sha256:size of every entry with "complete":true).
declare -A complete=()
if [ -f "$PROGRESS" ] && [ ! -L "$PROGRESS" ] && [ -r "$PROGRESS" ]; then
    while IFS= read -r line; do
        case "$line" in
            *'"complete":true'*) ;;
            *) continue ;;
        esac
        dev=$(sed -n 's/.*"device":\([0-9][0-9]*\).*/\1/p' <<< "$line")
        ino=$(sed -n 's/.*"inode":\([0-9][0-9]*\).*/\1/p' <<< "$line")
        sha=$(sed -n 's/.*"firstLineSha256":"\([0-9a-f]\{64\}\)".*/\1/p' <<< "$line")
        size=$(sed -n 's/.*"size":\([0-9][0-9]*\).*/\1/p' <<< "$line")
        offset=$(sed -n 's/.*"offset":\([0-9][0-9]*\).*/\1/p' <<< "$line")
        if [ -n "$dev" ] && [ -n "$ino" ] && [ -n "$sha" ] && [ -n "$size" ] && [ "$offset" = "$size" ]; then
            complete["$dev:$ino:$sha:$size"]=1
        fi
    done < "$PROGRESS"
else
    log 5 "no progress file of the service - nothing counts as consumed (is admng-watchdog running?)"
fi

# Rotated files of earlier runs: deleted when confirmed, otherwise kept for step 4 ("<epoch> <size> <path>").
remaining=()
for file in "$OUT"/*/"$NAME".*; do
    [ -f "$file" ] && [ ! -L "$file" ] || continue
    suffix=${file##*/$NAME.}
    [[ "$suffix" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$ ]] || continue
    [ -z "${rotated_now[$file]:-}" ] || continue
    read -r dev ino size mtime < <(stat -c '%d %i %s %Y' -- "$file")
    if [ "${#complete[@]}" -gt 0 ] && [ $((NOW - mtime)) -ge "$IDLE_SECONDS" ]; then
        sha=$(head -n 1 -- "$file" | sha256sum | cut -d ' ' -f 1)
        if [ -n "${complete[$dev:$ino:$sha:$size]:-}" ]; then
            rm -f -- "$file"
            log 6 "deleted ${file#"$OUT"/} (consumed)"
            continue
        fi
    fi
    rotated_at=$(date -u -d "${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]} ${BASH_REMATCH[4]}:${BASH_REMATCH[5]}:${BASH_REMATCH[6]}" +%s)
    remaining+=("$rotated_at $size $file")
done

# 4. Limits for files the service did not consume.
total=0
kept=()
if [ "${#remaining[@]}" -gt 0 ]; then
    while read -r rotated_at size file; do
        if [ $((NOW - rotated_at)) -gt $((days * 86400)) ]; then
            rm -f -- "$file"
            log 4 "deleted ${file#"$OUT"/} unread: older than MAX_UNCONSUMED_DAYS=$days"
            continue
        fi
        kept+=("$size $file")
        total=$((total + size))
    done < <(printf '%s\n' "${remaining[@]}" | sort -n -k1,1)
fi

limit=$((max_mb * 1024 * 1024))
for entry in "${kept[@]}"; do
    [ "$total" -gt "$limit" ] || break
    size=${entry%% *}
    file=${entry#* }
    rm -f -- "$file"
    total=$((total - size))
    log 4 "deleted ${file#"$OUT"/} unread: rotated files exceed MAX_UNCONSUMED_MB=$max_mb"
done

exit 0
