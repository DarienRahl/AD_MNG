<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared test utilities: an honest in-memory IDirectorySession, a builder for sample directories with
       Polish names and a manual clock. Referenced by test projects only; never shipped. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdMng.Testing</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdMng.Core\AdMng.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- P1: a fake of a Presentation interface; the Presentation and UI tests compile it (this library references Core only). -->
    <Compile Remove="Pki\FakePkiHealthProbe.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- U1c: clipboard HTML transcribed from Outlook, Word and browsers (structure verbatim, Polish sample text). -->
    <EmbeddedResource Include="RichHtml\Fixtures\*.html" />
    <EmbeddedResource Include="RichHtml\Expected\*.html" />
    <!-- U5: template bodies for the sanitizer and editor round-trip tests. -->
    <EmbeddedResource Include="RichHtml\Templates\*.html" />
  </ItemGroup>
</Project>
