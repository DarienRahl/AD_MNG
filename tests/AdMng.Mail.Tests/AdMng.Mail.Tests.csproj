<Project Sdk="Microsoft.NET.Sdk">
  <!-- Direct SMTP transport of messages to users: MIME, classification, in-process SMTP servers of AdMng.Watchdog.Testing
       (always), and Mailpit (skipped unless ADMNG_TEST_SMTP_HOST and ADMNG_TEST_MAILPIT_API are set - see
       tools/testlab/watchdog/README.md, start-mailpit.sh). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdMng.Mail\AdMng.Mail.csproj" />
    <ProjectReference Include="..\AdMng.Testing\AdMng.Testing.csproj" />
    <ProjectReference Include="..\AdMng.Watchdog.Testing\AdMng.Watchdog.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
