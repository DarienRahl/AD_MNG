<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF UI tests: real windows over the real host, backed by the in-memory FakeDirectorySession, rendered off-screen
       on a dedicated STA thread. Windows only: on other systems the project is compiled but `dotnet test` skips it
       (and every test also skips itself at runtime). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>AdMng.App.UiTests</RootNamespace>
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdMng.App\AdMng.App.csproj" />
    <ProjectReference Include="..\AdMng.Testing\AdMng.Testing.csproj" />
    <ProjectReference Include="..\AdMng.Watchdog.Testing\AdMng.Watchdog.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- One list of the per-connection services for the Presentation and the App registration tests. -->
    <Compile Include="..\AdMng.Presentation.Tests\Connections\ConnectionLifetimes.cs" Link="Infrastructure\ConnectionLifetimes.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The XAML sources, for checks of the localization keys they use. -->
    <AssemblyMetadata Include="AdMng.AppSourceDirectory" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\AdMng.App'))" />
  </ItemGroup>
</Project>
