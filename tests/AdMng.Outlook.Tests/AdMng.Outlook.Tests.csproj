<Project Sdk="Microsoft.NET.Sdk">
  <!-- U5 Outlook engine (AdMng.Outlook): a CLR fake of the Outlook object model drives the sessions, error classification,
       campaigns and the platform guards. Runs on Linux and Windows; nothing here starts or attaches to Outlook. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdMng.Outlook\AdMng.Outlook.csproj" />
    <ProjectReference Include="..\AdMng.Testing\AdMng.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
