<Project Sdk="Microsoft.NET.Sdk">
  <!-- Watchdog against the Samba lab (and Mailpit): real LDAP, real engines resolved through AddWatchdogCore().
       Skipped unless ADMNG_TEST_LDAP_SERVER is set - see tools/testlab/README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport of gss_krb5_ccache_name / krb5_cc_destroy (keytab lab tests). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdMng.Watchdog.Service\AdMng.Watchdog.Service.csproj" />
    <ProjectReference Include="..\..\src\AdMng.Watchdog.Core\AdMng.Watchdog.Core.csproj" />
    <ProjectReference Include="..\..\src\AdMng.Watchdog.Keytab\AdMng.Watchdog.Keytab.csproj" />
    <ProjectReference Include="..\..\src\AdMng.Directory\AdMng.Directory.csproj" />
    <ProjectReference Include="..\AdMng.Watchdog.Testing\AdMng.Watchdog.Testing.csproj" />
    <ProjectReference Include="..\AdMng.Testing\AdMng.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lab cleanup shared with AdMng.Directory.IntegrationTests (unit-tested there): client-side tree deletes, run OUs
         that name their owner process. -->
    <Compile Include="..\AdMng.Directory.IntegrationTests\Infrastructure\LabCleanup.cs" Link="Infrastructure\LabCleanup.cs" />
    <Compile Include="..\AdMng.Directory.IntegrationTests\Infrastructure\LabRuns.cs" Link="Infrastructure\LabRuns.cs" />
  </ItemGroup>
</Project>
