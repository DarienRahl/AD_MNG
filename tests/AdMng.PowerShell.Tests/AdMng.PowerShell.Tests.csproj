<Project Sdk="Microsoft.NET.Sdk">
  <!-- R1 part 1 (docs/dev/r1-powershell-window.md 9.1): the embedded engine - the session, the host, the language mode, the
       guards, the environment, the history policy, syntax, completion and the command catalog - against the real
       PowerShell engine. Runs on Linux and Windows; nothing here contacts a directory or a computer. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdMng.PowerShell\AdMng.PowerShell.csproj" />
    <ProjectReference Include="..\AdMng.Testing\AdMng.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <!-- The same exclusion every consumer of the engine imports (ADR-0010, "Package licenses"). -->
  <Import Project="..\..\src\AdMng.PowerShell\PowerShellEngineConsumer.props" />
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
