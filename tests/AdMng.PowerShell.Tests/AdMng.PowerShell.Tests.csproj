<Project Sdk="Microsoft.NET.Sdk">
  <!-- R1 part 1 (docs/dev/r1-powershell-window.md 9.1): the embedded engine - the session, the host, the language mode, the
       guards, the environment, the history policy, syntax, completion and the command catalog - against the real
       PowerShell engine. Runs on Linux and Windows; nothing here contacts a directory or a computer, except the lab tests of
       the read commands (Lab/), which are skipped unless ADMNG_TEST_LDAP_SERVER is set (the CI lab job sets it). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdMng.PowerShell\AdMng.PowerShell.csproj" />
    <ProjectReference Include="..\AdMng.Testing\AdMng.Testing.csproj" />
    <!-- The real session of the lab tests (Lab/PowerShellReadLabTests), opened by the connector as the program opens it. -->
    <ProjectReference Include="..\..\src\AdMng.Directory\AdMng.Directory.csproj" />
    <!-- Started as a child process by NoFilesTests (copied beside this assembly). -->
    <ProjectReference Include="..\AdMng.PowerShell.Probe\AdMng.PowerShell.Probe.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <!-- The same exclusion every consumer of the engine imports (ADR-0010, "Package licenses"). -->
  <Import Project="..\..\src\AdMng.PowerShell\PowerShellEngineConsumer.props" />
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lab cleanup shared with AdMng.Directory.IntegrationTests (unit-tested there): client-side tree deletes, run OUs that
         name their owner process. -->
    <Compile Include="..\AdMng.Directory.IntegrationTests\Infrastructure\LabCleanup.cs" Link="Lab\LabCleanup.cs" />
    <Compile Include="..\AdMng.Directory.IntegrationTests\Infrastructure\LabRuns.cs" Link="Lab\LabRuns.cs" />
  </ItemGroup>
</Project>
